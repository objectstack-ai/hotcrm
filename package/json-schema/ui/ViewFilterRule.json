{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "field": {
      "type": "string",
      "description": "Field name to filter on"
    },
    "operator": {
      "type": "string",
      "description": "Filter operator (e.g. equals, not_equals, contains, this_quarter)"
    },
    "value": {
      "description": "Filter value",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          }
        }
      ]
    }
  },
  "required": [
    "field",
    "operator"
  ],
  "additionalProperties": false,
  "description": "View filter rule",
  "$id": "https://schema.objectstack.io/v3.0.11/ui/ViewFilterRule.json",
  "x-spec-version": "3.0.11"
}