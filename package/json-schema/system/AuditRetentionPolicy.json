{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "retentionDays": {
      "default": 180,
      "description": "Retention period in days",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "archiveAfterRetention": {
      "default": true,
      "description": "Archive logs after retention period",
      "type": "boolean"
    },
    "archiveStorage": {
      "description": "Archive storage configuration",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "s3",
            "gcs",
            "azure_blob",
            "filesystem"
          ],
          "description": "Archive storage type"
        },
        "endpoint": {
          "description": "Storage endpoint URL",
          "type": "string"
        },
        "bucket": {
          "description": "Storage bucket/container name",
          "type": "string"
        },
        "path": {
          "description": "Storage path prefix",
          "type": "string"
        },
        "credentials": {
          "description": "Storage credentials",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "customRetention": {
      "description": "Custom retention by event type",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      }
    },
    "minimumRetentionDays": {
      "description": "Minimum retention for compliance",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "retentionDays",
    "archiveAfterRetention"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/system/AuditRetentionPolicy.json",
  "x-spec-version": "3.0.11"
}