{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": false,
      "type": "boolean"
    },
    "watchPatterns": {
      "description": "Glob patterns to watch for changes",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "debounceDelay": {
      "default": 1000,
      "description": "Wait time after change detection before reload",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "preserveState": {
      "default": true,
      "description": "Keep plugin state across reloads",
      "type": "boolean"
    },
    "stateStrategy": {
      "default": "memory",
      "description": "How to preserve state during reload",
      "type": "string",
      "enum": [
        "memory",
        "disk",
        "distributed",
        "none"
      ]
    },
    "distributedConfig": {
      "description": "Configuration for distributed state management",
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "redis",
            "etcd",
            "custom"
          ],
          "description": "Distributed state backend provider"
        },
        "endpoints": {
          "description": "Backend connection endpoints",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "keyPrefix": {
          "description": "Prefix for all keys (e.g., \"plugin:my-plugin:\")",
          "type": "string"
        },
        "ttl": {
          "description": "State expiration time in seconds",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "auth": {
          "type": "object",
          "properties": {
            "username": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "token": {
              "type": "string"
            },
            "certificate": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "replication": {
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "minReplicas": {
              "default": 1,
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "enabled",
            "minReplicas"
          ],
          "additionalProperties": false
        },
        "customConfig": {
          "description": "Provider-specific configuration",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "provider"
      ],
      "additionalProperties": false
    },
    "shutdownTimeout": {
      "default": 30000,
      "description": "Maximum time to wait for graceful shutdown",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "beforeReload": {
      "description": "Hook names to call before reload",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "afterReload": {
      "description": "Hook names to call after reload",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "enabled",
    "debounceDelay",
    "preserveState",
    "stateStrategy",
    "shutdownTimeout"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/HotReloadConfig.json",
  "x-spec-version": "3.0.11"
}