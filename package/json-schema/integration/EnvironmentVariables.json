{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Environment variable name"
    },
    "value": {
      "type": "string",
      "description": "Environment variable value"
    },
    "target": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "production",
          "preview",
          "development"
        ]
      },
      "description": "Target environments"
    },
    "isSecret": {
      "default": false,
      "description": "Encrypt this variable",
      "type": "boolean"
    },
    "gitBranch": {
      "description": "Specific git branch",
      "type": "string"
    }
  },
  "required": [
    "key",
    "value",
    "target",
    "isSecret"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/integration/EnvironmentVariables.json",
  "x-spec-version": "3.0.11"
}