{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "framework": {
      "type": "string",
      "enum": [
        "gdpr",
        "hipaa",
        "sox",
        "pci_dss",
        "ccpa",
        "iso27001"
      ],
      "description": "Compliance framework identifier"
    },
    "requiredEvents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Audit event types required by this framework (e.g., \"data.delete\", \"auth.login\")"
    },
    "retentionDays": {
      "type": "number",
      "minimum": 1,
      "description": "Minimum audit log retention period required by this framework (in days)"
    },
    "alertOnMissing": {
      "default": true,
      "description": "Raise alert if a required audit event is not being captured",
      "type": "boolean"
    }
  },
  "required": [
    "framework",
    "requiredEvents",
    "retentionDays",
    "alertOnMissing"
  ],
  "additionalProperties": false,
  "description": "Compliance framework audit event requirements",
  "$id": "https://schema.objectstack.io/v3.0.11/system/ComplianceAuditRequirement.json",
  "x-spec-version": "3.0.11"
}