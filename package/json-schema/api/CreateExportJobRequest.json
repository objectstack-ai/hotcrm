{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "object": {
      "type": "string",
      "description": "Object name to export"
    },
    "format": {
      "default": "csv",
      "description": "Export file format",
      "type": "string",
      "enum": [
        "csv",
        "json",
        "jsonl",
        "xlsx",
        "parquet"
      ]
    },
    "fields": {
      "description": "Specific fields to include (omit for all fields)",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "filter": {
      "description": "Filter criteria for records to export",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "sort": {
      "description": "Sort order for exported records",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "Field name to sort by"
          },
          "direction": {
            "default": "asc",
            "description": "Sort direction",
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          }
        },
        "required": [
          "field",
          "direction"
        ],
        "additionalProperties": false
      }
    },
    "limit": {
      "description": "Maximum number of records to export",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "includeHeaders": {
      "default": true,
      "description": "Include header row (CSV/XLSX)",
      "type": "boolean"
    },
    "encoding": {
      "default": "utf-8",
      "description": "Character encoding for the export file",
      "type": "string"
    },
    "templateId": {
      "description": "Export template ID for predefined field mappings",
      "type": "string"
    }
  },
  "required": [
    "object",
    "format",
    "includeHeaders",
    "encoding"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/CreateExportJobRequest.json",
  "x-spec-version": "3.0.11"
}