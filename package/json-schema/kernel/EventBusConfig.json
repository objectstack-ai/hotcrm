{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "persistence": {
      "description": "Event persistence configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "description": "Enable event persistence",
          "type": "boolean"
        },
        "retention": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Days to retain persisted events"
        },
        "filter": {
          "description": "Optional filter function to select which events to persist"
        },
        "storage": {
          "default": "database",
          "description": "Storage backend for persisted events",
          "type": "string",
          "enum": [
            "database",
            "file",
            "s3",
            "custom"
          ]
        }
      },
      "required": [
        "enabled",
        "retention",
        "storage"
      ],
      "additionalProperties": false
    },
    "queue": {
      "description": "Event queue configuration",
      "type": "object",
      "properties": {
        "name": {
          "default": "events",
          "description": "Event queue name",
          "type": "string"
        },
        "concurrency": {
          "default": 10,
          "description": "Max concurrent event handlers",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "retryPolicy": {
          "description": "Default retry policy for events",
          "type": "object",
          "properties": {
            "maxRetries": {
              "default": 3,
              "description": "Max retries for failed events",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "backoffStrategy": {
              "default": "exponential",
              "description": "Backoff strategy",
              "type": "string",
              "enum": [
                "fixed",
                "linear",
                "exponential"
              ]
            },
            "initialDelayMs": {
              "default": 1000,
              "description": "Initial retry delay",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxDelayMs": {
              "default": 60000,
              "description": "Maximum retry delay",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "maxRetries",
            "backoffStrategy",
            "initialDelayMs",
            "maxDelayMs"
          ],
          "additionalProperties": false
        },
        "deadLetterQueue": {
          "description": "Dead letter queue name for failed events",
          "type": "string"
        },
        "priorityEnabled": {
          "default": true,
          "description": "Process events based on priority",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "concurrency",
        "priorityEnabled"
      ],
      "additionalProperties": false
    },
    "eventSourcing": {
      "description": "Event sourcing configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "description": "Enable event sourcing",
          "type": "boolean"
        },
        "snapshotInterval": {
          "default": 100,
          "description": "Create snapshot every N events",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "snapshotRetention": {
          "default": 10,
          "description": "Number of snapshots to retain",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "retention": {
          "default": 365,
          "description": "Days to retain events",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "aggregateTypes": {
          "description": "Aggregate types to enable event sourcing for",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "storage": {
          "description": "Event store configuration",
          "type": "object",
          "properties": {
            "type": {
              "default": "database",
              "description": "Storage backend",
              "type": "string",
              "enum": [
                "database",
                "file",
                "s3",
                "eventstore"
              ]
            },
            "options": {
              "description": "Storage-specific options",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "enabled",
        "snapshotInterval",
        "snapshotRetention",
        "retention"
      ],
      "additionalProperties": false
    },
    "replay": {
      "description": "Event replay configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Enable event replay capability",
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
    },
    "webhooks": {
      "description": "Webhook configurations",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "description": "Unique webhook identifier",
            "type": "string"
          },
          "eventPattern": {
            "type": "string",
            "description": "Event name pattern (supports wildcards)"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Webhook endpoint URL"
          },
          "method": {
            "default": "POST",
            "description": "HTTP method",
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH"
            ]
          },
          "headers": {
            "description": "HTTP headers",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "authentication": {
            "description": "Authentication configuration",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "none",
                  "bearer",
                  "basic",
                  "api-key"
                ],
                "description": "Auth type"
              },
              "credentials": {
                "description": "Auth credentials",
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          "retryPolicy": {
            "description": "Retry policy",
            "type": "object",
            "properties": {
              "maxRetries": {
                "default": 3,
                "description": "Max retry attempts",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "backoffStrategy": {
                "default": "exponential",
                "type": "string",
                "enum": [
                  "fixed",
                  "linear",
                  "exponential"
                ]
              },
              "initialDelayMs": {
                "default": 1000,
                "description": "Initial retry delay",
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "maxDelayMs": {
                "default": 60000,
                "description": "Max retry delay",
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "maxRetries",
              "backoffStrategy",
              "initialDelayMs",
              "maxDelayMs"
            ],
            "additionalProperties": false
          },
          "timeoutMs": {
            "default": 30000,
            "description": "Request timeout in milliseconds",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "transform": {
            "description": "Transform event before sending"
          },
          "enabled": {
            "default": true,
            "description": "Whether webhook is enabled",
            "type": "boolean"
          }
        },
        "required": [
          "eventPattern",
          "url",
          "method",
          "timeoutMs",
          "enabled"
        ],
        "additionalProperties": false
      }
    },
    "messageQueue": {
      "description": "Message queue integration",
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "kafka",
            "rabbitmq",
            "aws-sqs",
            "redis-pubsub",
            "google-pubsub",
            "azure-service-bus"
          ],
          "description": "Message queue provider"
        },
        "topic": {
          "type": "string",
          "description": "Topic or queue name"
        },
        "eventPattern": {
          "default": "*",
          "description": "Event name pattern to publish (supports wildcards)",
          "type": "string"
        },
        "partitionKey": {
          "description": "JSON path for partition key (e.g., \"metadata.tenantId\")",
          "type": "string"
        },
        "format": {
          "default": "json",
          "description": "Message serialization format",
          "type": "string",
          "enum": [
            "json",
            "avro",
            "protobuf"
          ]
        },
        "includeMetadata": {
          "default": true,
          "description": "Include event metadata in message",
          "type": "boolean"
        },
        "compression": {
          "default": "none",
          "description": "Message compression",
          "type": "string",
          "enum": [
            "none",
            "gzip",
            "snappy",
            "lz4"
          ]
        },
        "batchSize": {
          "default": 1,
          "description": "Batch size for publishing",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "flushIntervalMs": {
          "default": 1000,
          "description": "Flush interval for batching",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "provider",
        "topic",
        "eventPattern",
        "format",
        "includeMetadata",
        "compression",
        "batchSize",
        "flushIntervalMs"
      ],
      "additionalProperties": false
    },
    "realtime": {
      "description": "Real-time notification configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Enable real-time notifications",
          "type": "boolean"
        },
        "protocol": {
          "default": "websocket",
          "description": "Real-time protocol",
          "type": "string",
          "enum": [
            "websocket",
            "sse",
            "long-polling"
          ]
        },
        "eventPattern": {
          "default": "*",
          "description": "Event pattern to broadcast",
          "type": "string"
        },
        "userFilter": {
          "default": true,
          "description": "Filter events by user",
          "type": "boolean"
        },
        "tenantFilter": {
          "default": true,
          "description": "Filter events by tenant",
          "type": "boolean"
        },
        "channels": {
          "description": "Named channels for event broadcasting",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Channel name"
              },
              "eventPattern": {
                "type": "string",
                "description": "Event pattern for channel"
              },
              "filter": {
                "description": "Additional filter function"
              }
            },
            "required": [
              "name",
              "eventPattern"
            ],
            "additionalProperties": false
          }
        },
        "rateLimit": {
          "description": "Rate limiting configuration",
          "type": "object",
          "properties": {
            "maxEventsPerSecond": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "Max events per second per client"
            },
            "windowMs": {
              "default": 1000,
              "description": "Rate limit window",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "maxEventsPerSecond",
            "windowMs"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "enabled",
        "protocol",
        "eventPattern",
        "userFilter",
        "tenantFilter"
      ],
      "additionalProperties": false
    },
    "eventTypes": {
      "description": "Event type definitions",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "pattern": "^[a-z][a-z0-9_.]*$",
            "description": "Event type name (lowercase with dots)"
          },
          "version": {
            "default": "1.0.0",
            "description": "Event schema version",
            "type": "string"
          },
          "schema": {
            "description": "JSON Schema for event payload validation"
          },
          "description": {
            "description": "Event type description",
            "type": "string"
          },
          "deprecated": {
            "default": false,
            "description": "Whether this event type is deprecated",
            "type": "boolean"
          },
          "tags": {
            "description": "Event type tags",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "version",
          "deprecated"
        ],
        "additionalProperties": false
      }
    },
    "handlers": {
      "description": "Global event handlers",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "description": "Unique handler identifier",
            "type": "string"
          },
          "eventName": {
            "type": "string",
            "description": "Name of event to handle (supports wildcards like user.*)"
          },
          "handler": {
            "description": "Handler function"
          },
          "priority": {
            "default": 0,
            "description": "Execution priority (lower numbers execute first)",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "async": {
            "default": true,
            "description": "Execute in background (true) or block (false)",
            "type": "boolean"
          },
          "retry": {
            "description": "Retry policy for failed handlers",
            "type": "object",
            "properties": {
              "maxRetries": {
                "default": 3,
                "description": "Maximum retry attempts",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "backoffMs": {
                "default": 1000,
                "description": "Initial backoff delay",
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "backoffMultiplier": {
                "default": 2,
                "description": "Backoff multiplier",
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "maxRetries",
              "backoffMs",
              "backoffMultiplier"
            ],
            "additionalProperties": false
          },
          "timeoutMs": {
            "description": "Handler timeout in milliseconds",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "filter": {
            "description": "Optional filter to determine if handler should execute"
          }
        },
        "required": [
          "eventName",
          "handler",
          "priority",
          "async"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/EventBusConfig.json",
  "x-spec-version": "3.0.11"
}