{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "currentObjectCount": {
      "default": 0,
      "description": "Current number of custom objects",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "currentRecordCount": {
      "default": 0,
      "description": "Total records across all objects",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "currentStorageBytes": {
      "default": 0,
      "description": "Current storage usage in bytes",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "deploymentsToday": {
      "default": 0,
      "description": "Deployments executed today",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "currentUsers": {
      "default": 0,
      "description": "Current number of active users",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "apiRequestsThisMinute": {
      "default": 0,
      "description": "API requests in the current minute",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "lastUpdatedAt": {
      "description": "Last usage update time",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "currentObjectCount",
    "currentRecordCount",
    "currentStorageBytes",
    "deploymentsToday",
    "currentUsers",
    "apiRequestsThisMinute"
  ],
  "additionalProperties": false,
  "description": "Current tenant resource usage",
  "$id": "https://schema.objectstack.io/v3.0.11/system/TenantUsage.json",
  "x-spec-version": "3.0.11"
}