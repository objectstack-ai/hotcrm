{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "unavailable",
        "degraded",
        "stub"
      ],
      "description": "available = fully operational, unavailable = not installed, degraded = partial, stub = placeholder that throws"
    },
    "route": {
      "description": "e.g. /api/v1/analytics",
      "type": "string"
    },
    "provider": {
      "description": "e.g. \"objectql\", \"plugin-redis\", \"driver-memory\"",
      "type": "string"
    },
    "version": {
      "description": "Semantic version of the service implementation (e.g. \"3.0.6\")",
      "type": "string"
    },
    "message": {
      "description": "e.g. \"Install plugin-workflow to enable\"",
      "type": "string"
    },
    "rateLimit": {
      "description": "Rate limit and quota info for this service",
      "type": "object",
      "properties": {
        "requestsPerMinute": {
          "description": "Maximum requests per minute",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "requestsPerHour": {
          "description": "Maximum requests per hour",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "burstLimit": {
          "description": "Maximum burst request count",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "retryAfterMs": {
          "description": "Suggested retry-after delay in milliseconds when rate-limited",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "enabled",
    "status"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/ServiceInfo.json",
  "x-spec-version": "3.0.11"
}