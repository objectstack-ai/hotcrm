{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Submission ID"
    },
    "packageId": {
      "type": "string",
      "description": "Package identifier"
    },
    "version": {
      "type": "string",
      "description": "Version being submitted"
    },
    "publisherId": {
      "type": "string",
      "description": "Publisher submitting"
    },
    "status": {
      "default": "pending",
      "description": "Review status",
      "type": "string",
      "enum": [
        "pending",
        "scanning",
        "in-review",
        "changes-requested",
        "approved",
        "rejected"
      ]
    },
    "artifactUrl": {
      "type": "string",
      "description": "Package artifact URL for review"
    },
    "releaseNotes": {
      "description": "Release notes for this version",
      "type": "string"
    },
    "isNewListing": {
      "default": false,
      "description": "Whether this is a new listing submission",
      "type": "boolean"
    },
    "scanResults": {
      "description": "Automated scan results",
      "type": "object",
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "securityScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "compatibilityCheck": {
          "type": "boolean"
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": {
                "type": "string",
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low",
                  "info"
                ]
              },
              "message": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "line": {
                "type": "number"
              }
            },
            "required": [
              "severity",
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "passed"
      ],
      "additionalProperties": false
    },
    "reviewerNotes": {
      "description": "Notes from the platform reviewer",
      "type": "string"
    },
    "submittedAt": {
      "description": "Submission timestamp",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "reviewedAt": {
      "description": "Review completion timestamp",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "id",
    "packageId",
    "version",
    "publisherId",
    "status",
    "artifactUrl",
    "isNewListing"
  ],
  "additionalProperties": false,
  "description": "Developer submission of a package version for review",
  "$id": "https://schema.objectstack.io/v3.0.11/cloud/PackageSubmission.json",
  "x-spec-version": "3.0.11"
}