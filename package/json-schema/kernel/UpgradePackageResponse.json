{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "success": {
      "type": "boolean",
      "description": "Whether the upgrade succeeded"
    },
    "phase": {
      "type": "string",
      "enum": [
        "pending",
        "analyzing",
        "snapshot",
        "executing",
        "migrating",
        "validating",
        "completed",
        "failed",
        "rolling-back",
        "rolled-back"
      ],
      "description": "Current upgrade phase"
    },
    "plan": {
      "description": "Upgrade plan",
      "type": "object",
      "properties": {
        "packageId": {
          "type": "string",
          "description": "Package identifier"
        },
        "fromVersion": {
          "type": "string",
          "description": "Currently installed version"
        },
        "toVersion": {
          "type": "string",
          "description": "Target upgrade version"
        },
        "impactLevel": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "critical"
          ],
          "description": "Severity assessment from none (seamless) to critical (breaking changes)"
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "Metadata type"
              },
              "name": {
                "type": "string",
                "description": "Metadata name"
              },
              "changeType": {
                "type": "string",
                "enum": [
                  "added",
                  "modified",
                  "removed",
                  "renamed"
                ],
                "description": "Category of metadata modification (added, modified, removed, or renamed)"
              },
              "hasConflict": {
                "default": false,
                "description": "Whether this change may conflict with customizations",
                "type": "boolean"
              },
              "summary": {
                "description": "Human-readable change summary",
                "type": "string"
              },
              "previousName": {
                "description": "Previous name if renamed",
                "type": "string"
              }
            },
            "required": [
              "type",
              "name",
              "changeType",
              "hasConflict"
            ],
            "additionalProperties": false,
            "description": "Single metadata change between package versions"
          },
          "description": "All metadata changes"
        },
        "affectedCustomizations": {
          "default": 0,
          "description": "Count of customizations that may be affected",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requiresMigration": {
          "default": false,
          "description": "Whether data migration scripts are needed",
          "type": "boolean"
        },
        "migrationScripts": {
          "description": "Paths to migration scripts",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencyUpgrades": {
          "description": "Dependent packages that also need upgrading",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "packageId": {
                "type": "string"
              },
              "fromVersion": {
                "type": "string"
              },
              "toVersion": {
                "type": "string"
              }
            },
            "required": [
              "packageId",
              "fromVersion",
              "toVersion"
            ],
            "additionalProperties": false
          }
        },
        "estimatedDuration": {
          "description": "Estimated upgrade duration in seconds",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "summary": {
          "description": "Human-readable upgrade summary",
          "type": "string"
        }
      },
      "required": [
        "packageId",
        "fromVersion",
        "toVersion",
        "impactLevel",
        "changes",
        "affectedCustomizations",
        "requiresMigration"
      ],
      "additionalProperties": false
    },
    "snapshotId": {
      "description": "Snapshot ID for rollback",
      "type": "string"
    },
    "conflicts": {
      "description": "Unresolved merge conflicts",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "baseValue": {},
          "incomingValue": {},
          "customValue": {}
        },
        "required": [
          "path",
          "baseValue",
          "incomingValue",
          "customValue"
        ],
        "additionalProperties": false
      }
    },
    "errorMessage": {
      "description": "Error message if upgrade failed",
      "type": "string"
    },
    "message": {
      "description": "Human-readable status message",
      "type": "string"
    }
  },
  "required": [
    "success",
    "phase"
  ],
  "additionalProperties": false,
  "description": "Upgrade package response",
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/UpgradePackageResponse.json",
  "x-spec-version": "3.0.11"
}