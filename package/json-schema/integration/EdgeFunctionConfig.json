{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Edge function name"
    },
    "path": {
      "type": "string",
      "description": "Function path (e.g., /api/*)"
    },
    "regions": {
      "description": "Specific regions for this function",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "memoryLimit": {
      "default": 1024,
      "description": "Memory limit in MB",
      "type": "integer",
      "minimum": 128,
      "maximum": 3008
    },
    "timeout": {
      "default": 10,
      "description": "Timeout in seconds",
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    }
  },
  "required": [
    "name",
    "path",
    "memoryLimit",
    "timeout"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/integration/EdgeFunctionConfig.json",
  "x-spec-version": "3.0.11"
}