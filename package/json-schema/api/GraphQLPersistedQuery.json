{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": false,
      "description": "Enable persisted queries",
      "type": "boolean"
    },
    "mode": {
      "default": "optional",
      "description": "Persisted query mode (optional: allow both, required: only persisted)",
      "type": "string",
      "enum": [
        "optional",
        "required"
      ]
    },
    "store": {
      "description": "Query store configuration",
      "type": "object",
      "properties": {
        "type": {
          "default": "memory",
          "description": "Query store type",
          "type": "string",
          "enum": [
            "memory",
            "redis",
            "database",
            "file"
          ]
        },
        "connection": {
          "description": "Store connection string or path",
          "type": "string"
        },
        "ttl": {
          "description": "TTL in seconds for stored queries",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "apq": {
      "description": "Automatic Persisted Queries configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Enable Automatic Persisted Queries",
          "type": "boolean"
        },
        "hashAlgorithm": {
          "default": "sha256",
          "description": "Hash algorithm for query IDs",
          "type": "string",
          "enum": [
            "sha256",
            "sha1",
            "md5"
          ]
        },
        "cache": {
          "description": "APQ cache configuration",
          "type": "object",
          "properties": {
            "ttl": {
              "default": 3600,
              "description": "Cache TTL in seconds",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maxSize": {
              "description": "Maximum number of cached queries",
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "ttl"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "enabled",
        "hashAlgorithm"
      ],
      "additionalProperties": false
    },
    "allowlist": {
      "description": "Query allow list configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "description": "Enable query allow list (reject queries not in list)",
          "type": "boolean"
        },
        "queries": {
          "description": "Allowed queries",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Query ID or hash"
              },
              "operation": {
                "description": "Operation name",
                "type": "string"
              },
              "query": {
                "description": "Query string",
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          }
        },
        "source": {
          "description": "External allow list source (file path or URL)",
          "type": "string"
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
    },
    "security": {
      "description": "Security configuration",
      "type": "object",
      "properties": {
        "maxQuerySize": {
          "description": "Maximum query string size in bytes",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "rejectIntrospection": {
          "default": false,
          "description": "Reject introspection queries",
          "type": "boolean"
        }
      },
      "required": [
        "rejectIntrospection"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "enabled",
    "mode"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/GraphQLPersistedQuery.json",
  "x-spec-version": "3.0.11"
}