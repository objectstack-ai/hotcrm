{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$",
      "description": "SLI name (snake_case)"
    },
    "label": {
      "type": "string",
      "description": "Display label"
    },
    "description": {
      "description": "SLI description",
      "type": "string"
    },
    "metric": {
      "type": "string",
      "description": "Base metric name"
    },
    "type": {
      "type": "string",
      "enum": [
        "availability",
        "latency",
        "throughput",
        "error_rate",
        "saturation",
        "custom"
      ],
      "description": "SLI type"
    },
    "successCriteria": {
      "type": "object",
      "properties": {
        "threshold": {
          "type": "number",
          "description": "Threshold value"
        },
        "operator": {
          "type": "string",
          "enum": [
            "lt",
            "lte",
            "gt",
            "gte",
            "eq"
          ],
          "description": "Comparison operator"
        },
        "percentile": {
          "description": "Percentile (0-1)",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "threshold",
        "operator"
      ],
      "additionalProperties": false,
      "description": "Success criteria"
    },
    "window": {
      "type": "object",
      "properties": {
        "size": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Window size in seconds"
        },
        "rolling": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "size",
        "rolling"
      ],
      "additionalProperties": false,
      "description": "Measurement window"
    },
    "enabled": {
      "default": true,
      "type": "boolean"
    }
  },
  "required": [
    "name",
    "label",
    "metric",
    "type",
    "successCriteria",
    "window",
    "enabled"
  ],
  "additionalProperties": false,
  "description": "Service Level Indicator",
  "$id": "https://schema.objectstack.io/v3.0.11/system/ServiceLevelIndicator.json",
  "x-spec-version": "3.0.11"
}