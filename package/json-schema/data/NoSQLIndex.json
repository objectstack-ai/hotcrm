{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Index name"
    },
    "type": {
      "type": "string",
      "enum": [
        "single",
        "compound",
        "unique",
        "text",
        "geospatial",
        "hashed",
        "ttl",
        "sparse"
      ],
      "description": "Index type"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "Field name"
          },
          "order": {
            "description": "Index order or type",
            "type": "string",
            "enum": [
              "asc",
              "desc",
              "text",
              "2dsphere"
            ]
          }
        },
        "required": [
          "field"
        ],
        "additionalProperties": false
      },
      "description": "Fields to index"
    },
    "unique": {
      "default": false,
      "description": "Enforce uniqueness",
      "type": "boolean"
    },
    "sparse": {
      "default": false,
      "description": "Sparse index",
      "type": "boolean"
    },
    "expireAfterSeconds": {
      "description": "TTL in seconds",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "partialFilterExpression": {
      "description": "Partial index filter",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "background": {
      "default": false,
      "description": "Create index in background",
      "type": "boolean"
    }
  },
  "required": [
    "name",
    "type",
    "fields",
    "unique",
    "sparse",
    "background"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/data/NoSQLIndex.json",
  "x-spec-version": "3.0.11"
}