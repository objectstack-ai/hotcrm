{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Unique service name identifier"
    },
    "scope": {
      "default": "singleton",
      "description": "Service scope type",
      "type": "string",
      "enum": [
        "singleton",
        "transient",
        "scoped"
      ]
    },
    "factoryType": {
      "default": "sync",
      "description": "Whether factory is synchronous or asynchronous",
      "type": "string",
      "enum": [
        "sync",
        "async"
      ]
    },
    "singleton": {
      "default": true,
      "description": "Whether to cache the factory result (singleton pattern)",
      "type": "boolean"
    }
  },
  "required": [
    "name",
    "scope",
    "factoryType",
    "singleton"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/ServiceFactoryRegistration.json",
  "x-spec-version": "3.0.11"
}