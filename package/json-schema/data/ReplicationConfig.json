{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": false,
      "description": "Enable replication",
      "type": "boolean"
    },
    "replicaSetName": {
      "description": "Replica set name",
      "type": "string"
    },
    "replicas": {
      "description": "Number of replicas",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "readPreference": {
      "description": "Read preference for replica set",
      "type": "string",
      "enum": [
        "primary",
        "primaryPreferred",
        "secondary",
        "secondaryPreferred",
        "nearest"
      ]
    },
    "writeConcern": {
      "description": "Write concern level",
      "type": "string",
      "enum": [
        "majority",
        "acknowledged",
        "unacknowledged"
      ]
    }
  },
  "required": [
    "enabled"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/data/ReplicationConfig.json",
  "x-spec-version": "3.0.11"
}