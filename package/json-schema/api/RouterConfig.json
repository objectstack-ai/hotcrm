{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "basePath": {
      "default": "/api",
      "description": "Global API prefix",
      "type": "string"
    },
    "mounts": {
      "default": {
        "data": "/data",
        "metadata": "/meta",
        "auth": "/auth",
        "automation": "/automation",
        "storage": "/storage",
        "analytics": "/analytics",
        "graphql": "/graphql",
        "ui": "/ui",
        "workflow": "/workflow",
        "realtime": "/realtime",
        "notifications": "/notifications",
        "ai": "/ai",
        "i18n": "/i18n",
        "packages": "/packages"
      },
      "type": "object",
      "properties": {
        "data": {
          "default": "/data",
          "description": "Data Protocol (CRUD)",
          "type": "string"
        },
        "metadata": {
          "default": "/meta",
          "description": "Metadata Protocol (Schemas)",
          "type": "string"
        },
        "auth": {
          "default": "/auth",
          "description": "Auth Protocol",
          "type": "string"
        },
        "automation": {
          "default": "/automation",
          "description": "Automation Protocol",
          "type": "string"
        },
        "storage": {
          "default": "/storage",
          "description": "Storage Protocol",
          "type": "string"
        },
        "analytics": {
          "default": "/analytics",
          "description": "Analytics Protocol",
          "type": "string"
        },
        "graphql": {
          "default": "/graphql",
          "description": "GraphQL Endpoint",
          "type": "string"
        },
        "ui": {
          "default": "/ui",
          "description": "UI Metadata Protocol (Views, Layouts)",
          "type": "string"
        },
        "workflow": {
          "default": "/workflow",
          "description": "Workflow Engine Protocol",
          "type": "string"
        },
        "realtime": {
          "default": "/realtime",
          "description": "Realtime/WebSocket Protocol",
          "type": "string"
        },
        "notifications": {
          "default": "/notifications",
          "description": "Notification Protocol",
          "type": "string"
        },
        "ai": {
          "default": "/ai",
          "description": "AI Engine Protocol (NLQ, Chat, Suggest)",
          "type": "string"
        },
        "i18n": {
          "default": "/i18n",
          "description": "Internationalization Protocol",
          "type": "string"
        },
        "packages": {
          "default": "/packages",
          "description": "Package Management Protocol",
          "type": "string"
        }
      },
      "required": [
        "data",
        "metadata",
        "auth",
        "automation",
        "storage",
        "analytics",
        "graphql",
        "ui",
        "workflow",
        "realtime",
        "notifications",
        "ai",
        "i18n",
        "packages"
      ],
      "additionalProperties": false
    },
    "cors": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Enable CORS",
          "type": "boolean"
        },
        "origins": {
          "default": "*",
          "description": "Allowed origins (* for all)",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "methods": {
          "description": "Allowed HTTP methods",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "DELETE",
              "PATCH",
              "HEAD",
              "OPTIONS"
            ]
          }
        },
        "credentials": {
          "default": false,
          "description": "Allow credentials (cookies, authorization headers)",
          "type": "boolean"
        },
        "maxAge": {
          "description": "Preflight cache duration in seconds",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "enabled",
        "origins",
        "credentials"
      ],
      "additionalProperties": false
    },
    "staticMounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "URL path to serve from"
          },
          "directory": {
            "type": "string",
            "description": "Physical directory to serve"
          },
          "cacheControl": {
            "description": "Cache-Control header value",
            "type": "string"
          }
        },
        "required": [
          "path",
          "directory"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "basePath",
    "mounts"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/RouterConfig.json",
  "x-spec-version": "3.0.11"
}