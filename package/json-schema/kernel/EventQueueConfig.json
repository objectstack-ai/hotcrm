{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "default": "events",
      "description": "Event queue name",
      "type": "string"
    },
    "concurrency": {
      "default": 10,
      "description": "Max concurrent event handlers",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "retryPolicy": {
      "description": "Default retry policy for events",
      "type": "object",
      "properties": {
        "maxRetries": {
          "default": 3,
          "description": "Max retries for failed events",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "backoffStrategy": {
          "default": "exponential",
          "description": "Backoff strategy",
          "type": "string",
          "enum": [
            "fixed",
            "linear",
            "exponential"
          ]
        },
        "initialDelayMs": {
          "default": 1000,
          "description": "Initial retry delay",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxDelayMs": {
          "default": 60000,
          "description": "Maximum retry delay",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "maxRetries",
        "backoffStrategy",
        "initialDelayMs",
        "maxDelayMs"
      ],
      "additionalProperties": false
    },
    "deadLetterQueue": {
      "description": "Dead letter queue name for failed events",
      "type": "string"
    },
    "priorityEnabled": {
      "default": true,
      "description": "Process events based on priority",
      "type": "boolean"
    }
  },
  "required": [
    "name",
    "concurrency",
    "priorityEnabled"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/EventQueueConfig.json",
  "x-spec-version": "3.0.11"
}