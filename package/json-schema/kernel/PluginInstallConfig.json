{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pluginId": {
      "type": "string"
    },
    "version": {
      "description": "Defaults to latest",
      "type": "string"
    },
    "config": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "autoUpdate": {
      "default": false,
      "type": "boolean"
    },
    "options": {
      "type": "object",
      "properties": {
        "skipDependencies": {
          "default": false,
          "type": "boolean"
        },
        "force": {
          "default": false,
          "type": "boolean"
        },
        "target": {
          "default": "space",
          "type": "string",
          "enum": [
            "system",
            "space",
            "user"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "pluginId"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/PluginInstallConfig.json",
  "x-spec-version": "3.0.11"
}