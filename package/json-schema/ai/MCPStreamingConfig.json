{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "description": "Enable streaming for MCP communication"
    },
    "chunkSize": {
      "description": "Size of each streamed chunk in bytes",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "heartbeatIntervalMs": {
      "default": 30000,
      "description": "Heartbeat interval in milliseconds",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "backpressure": {
      "description": "Backpressure handling strategy",
      "type": "string",
      "enum": [
        "drop",
        "buffer",
        "block"
      ]
    }
  },
  "required": [
    "enabled",
    "heartbeatIntervalMs"
  ],
  "additionalProperties": false,
  "description": "Streaming configuration for MCP communication",
  "$id": "https://schema.objectstack.io/v3.0.11/ai/MCPStreamingConfig.json",
  "x-spec-version": "3.0.11"
}