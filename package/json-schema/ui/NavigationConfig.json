{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mode": {
      "default": "page",
      "type": "string",
      "enum": [
        "page",
        "drawer",
        "modal",
        "split",
        "popover",
        "new_window",
        "none"
      ]
    },
    "view": {
      "description": "Name of the form view to use for details (e.g. \"summary_view\", \"edit_form\")",
      "type": "string"
    },
    "preventNavigation": {
      "default": false,
      "description": "Disable standard navigation entirely",
      "type": "boolean"
    },
    "openNewTab": {
      "default": false,
      "description": "Force open in new tab (applies to page mode)",
      "type": "boolean"
    },
    "width": {
      "description": "Width of the drawer/modal (e.g. \"600px\", \"50%\")",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        }
      ]
    }
  },
  "required": [
    "mode",
    "preventNavigation",
    "openNewTab"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ui/NavigationConfig.json",
  "x-spec-version": "3.0.11"
}