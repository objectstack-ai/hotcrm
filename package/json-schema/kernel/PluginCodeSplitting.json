{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": true,
      "type": "boolean"
    },
    "strategy": {
      "default": "feature",
      "type": "string",
      "enum": [
        "route",
        "feature",
        "size",
        "custom"
      ]
    },
    "chunkNaming": {
      "default": "hashed",
      "type": "string",
      "enum": [
        "hashed",
        "named",
        "sequential"
      ]
    },
    "maxChunkSize": {
      "description": "Max chunk size in KB",
      "type": "integer",
      "minimum": 10,
      "maximum": 9007199254740991
    },
    "sharedDependencies": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "minChunks": {
          "default": 2,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "enabled",
        "minChunks"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "enabled",
    "strategy",
    "chunkNaming"
  ],
  "additionalProperties": false,
  "description": "Plugin code splitting configuration",
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/PluginCodeSplitting.json",
  "x-spec-version": "3.0.11"
}