{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "fieldName": {
      "type": "string",
      "description": "Field name"
    },
    "dataSource": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Data source ID"
        },
        "name": {
          "type": "string",
          "description": "Data source name"
        },
        "type": {
          "type": "string",
          "enum": [
            "odata",
            "rest-api",
            "graphql",
            "custom"
          ],
          "description": "Protocol type"
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "description": "API endpoint URL"
        },
        "authentication": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "oauth2",
                "api-key",
                "basic",
                "none"
              ],
              "description": "Auth type"
            },
            "config": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {},
              "description": "Auth configuration"
            }
          },
          "required": [
            "type",
            "config"
          ],
          "additionalProperties": false,
          "description": "Authentication"
        }
      },
      "required": [
        "id",
        "name",
        "type",
        "endpoint",
        "authentication"
      ],
      "additionalProperties": false,
      "description": "External data source"
    },
    "query": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string",
          "description": "Query endpoint path"
        },
        "method": {
          "default": "GET",
          "description": "HTTP method",
          "type": "string",
          "enum": [
            "GET",
            "POST"
          ]
        },
        "parameters": {
          "description": "Query parameters",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "endpoint",
        "method"
      ],
      "additionalProperties": false,
      "description": "Query configuration"
    },
    "fieldMappings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "description": "Source field name"
          },
          "target": {
            "type": "string",
            "description": "Target field name"
          },
          "transform": {
            "description": "Transformation to apply",
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "constant"
                  },
                  "value": {
                    "description": "Constant value to use"
                  }
                },
                "required": [
                  "type",
                  "value"
                ],
                "additionalProperties": false,
                "description": "Set a constant value"
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "cast"
                  },
                  "targetType": {
                    "type": "string",
                    "enum": [
                      "string",
                      "number",
                      "boolean",
                      "date"
                    ],
                    "description": "Target data type"
                  }
                },
                "required": [
                  "type",
                  "targetType"
                ],
                "additionalProperties": false,
                "description": "Cast to a specific data type"
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "lookup"
                  },
                  "table": {
                    "type": "string",
                    "description": "Lookup table name"
                  },
                  "keyField": {
                    "type": "string",
                    "description": "Field to match on"
                  },
                  "valueField": {
                    "type": "string",
                    "description": "Field to retrieve"
                  }
                },
                "required": [
                  "type",
                  "table",
                  "keyField",
                  "valueField"
                ],
                "additionalProperties": false,
                "description": "Lookup value from another table"
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "javascript"
                  },
                  "expression": {
                    "type": "string",
                    "description": "JavaScript expression (e.g., \"value.toUpperCase()\")"
                  }
                },
                "required": [
                  "type",
                  "expression"
                ],
                "additionalProperties": false,
                "description": "Custom JavaScript transformation"
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "map"
                  },
                  "mappings": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {},
                    "description": "Value mappings (e.g., {\"Active\": \"active\"})"
                  }
                },
                "required": [
                  "type",
                  "mappings"
                ],
                "additionalProperties": false,
                "description": "Map values using a dictionary"
              }
            ]
          },
          "defaultValue": {
            "description": "Default if source is null/undefined"
          },
          "type": {
            "description": "Field type",
            "type": "string"
          },
          "readonly": {
            "default": true,
            "description": "Read-only field",
            "type": "boolean"
          }
        },
        "required": [
          "source",
          "target",
          "readonly"
        ],
        "additionalProperties": false
      },
      "description": "Field mappings"
    },
    "caching": {
      "description": "Caching configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Cache enabled",
          "type": "boolean"
        },
        "ttl": {
          "default": 300,
          "description": "Cache TTL (seconds)",
          "type": "number"
        },
        "strategy": {
          "default": "ttl",
          "description": "Cache strategy",
          "type": "string",
          "enum": [
            "lru",
            "lfu",
            "ttl"
          ]
        }
      },
      "required": [
        "enabled",
        "ttl",
        "strategy"
      ],
      "additionalProperties": false
    },
    "fallback": {
      "description": "Fallback configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Fallback enabled",
          "type": "boolean"
        },
        "defaultValue": {
          "description": "Default fallback value"
        },
        "showError": {
          "default": true,
          "description": "Show error to user",
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "showError"
      ],
      "additionalProperties": false
    },
    "rateLimit": {
      "description": "Rate limiting",
      "type": "object",
      "properties": {
        "requestsPerSecond": {
          "type": "number",
          "description": "Requests per second limit"
        },
        "burstSize": {
          "description": "Burst size",
          "type": "number"
        }
      },
      "required": [
        "requestsPerSecond"
      ],
      "additionalProperties": false
    },
    "retry": {
      "description": "Retry configuration with exponential backoff",
      "type": "object",
      "properties": {
        "maxRetries": {
          "default": 3,
          "description": "Maximum retry attempts",
          "type": "number",
          "minimum": 0
        },
        "initialDelayMs": {
          "default": 1000,
          "description": "Initial retry delay in milliseconds",
          "type": "number"
        },
        "maxDelayMs": {
          "default": 30000,
          "description": "Maximum retry delay in milliseconds",
          "type": "number"
        },
        "backoffMultiplier": {
          "default": 2,
          "description": "Exponential backoff multiplier",
          "type": "number"
        },
        "retryableStatusCodes": {
          "default": [
            429,
            500,
            502,
            503,
            504
          ],
          "description": "HTTP status codes that are retryable",
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "maxRetries",
        "initialDelayMs",
        "maxDelayMs",
        "backoffMultiplier",
        "retryableStatusCodes"
      ],
      "additionalProperties": false
    },
    "transform": {
      "description": "Request/response transformation pipeline",
      "type": "object",
      "properties": {
        "request": {
          "description": "Request transformation",
          "type": "object",
          "properties": {
            "headers": {
              "description": "Additional request headers",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "queryParams": {
              "description": "Additional query parameters",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "response": {
          "description": "Response transformation",
          "type": "object",
          "properties": {
            "dataPath": {
              "description": "JSONPath to extract data (e.g., \"$.data.results\")",
              "type": "string"
            },
            "totalPath": {
              "description": "JSONPath to extract total count (e.g., \"$.meta.total\")",
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "pagination": {
      "description": "Pagination configuration for external data",
      "type": "object",
      "properties": {
        "type": {
          "default": "offset",
          "description": "Pagination type",
          "type": "string",
          "enum": [
            "offset",
            "cursor",
            "page"
          ]
        },
        "pageSize": {
          "default": 100,
          "description": "Items per page",
          "type": "number"
        },
        "maxPages": {
          "description": "Maximum number of pages to fetch",
          "type": "number"
        }
      },
      "required": [
        "type",
        "pageSize"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "fieldName",
    "dataSource",
    "query",
    "fieldMappings"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/data/ExternalLookup.json",
  "x-spec-version": "3.0.11"
}