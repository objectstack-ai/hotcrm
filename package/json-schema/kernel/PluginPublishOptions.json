{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "artifactPath": {
      "type": "string",
      "description": "Path to the artifact file to publish"
    },
    "registryUrl": {
      "description": "Marketplace API base URL",
      "type": "string",
      "format": "uri"
    },
    "token": {
      "description": "Authentication token for marketplace API",
      "type": "string"
    },
    "releaseNotes": {
      "description": "Release notes for this version",
      "type": "string"
    },
    "preRelease": {
      "default": false,
      "description": "Whether this is a pre-release version",
      "type": "boolean"
    },
    "skipValidation": {
      "default": false,
      "description": "Whether to skip local validation before publish",
      "type": "boolean"
    },
    "access": {
      "default": "public",
      "description": "Package access level on the marketplace",
      "type": "string",
      "enum": [
        "public",
        "restricted"
      ]
    },
    "tags": {
      "description": "Tags for marketplace categorization",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "artifactPath",
    "preRelease",
    "skipValidation",
    "access"
  ],
  "additionalProperties": false,
  "description": "Options for the os plugin publish command",
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/PluginPublishOptions.json",
  "x-spec-version": "3.0.11"
}