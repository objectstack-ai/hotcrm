{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mode": {
      "default": "active_passive",
      "description": "Failover mode",
      "type": "string",
      "enum": [
        "active_passive",
        "active_active",
        "pilot_light",
        "warm_standby"
      ]
    },
    "autoFailover": {
      "default": true,
      "description": "Enable automatic failover",
      "type": "boolean"
    },
    "healthCheckInterval": {
      "default": 30,
      "description": "Health check interval in seconds",
      "type": "number"
    },
    "failureThreshold": {
      "default": 3,
      "description": "Consecutive failures before failover",
      "type": "number"
    },
    "regions": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Region identifier (e.g., \"us-east-1\", \"eu-west-1\")"
          },
          "role": {
            "type": "string",
            "enum": [
              "primary",
              "secondary",
              "witness"
            ],
            "description": "Region role"
          },
          "endpoint": {
            "description": "Region endpoint URL",
            "type": "string"
          },
          "priority": {
            "description": "Failover priority (lower = higher priority)",
            "type": "number"
          }
        },
        "required": [
          "name",
          "role"
        ],
        "additionalProperties": false
      },
      "description": "Multi-region configuration (minimum 2 regions)"
    },
    "dns": {
      "description": "DNS failover settings",
      "type": "object",
      "properties": {
        "ttl": {
          "default": 60,
          "description": "DNS TTL in seconds for failover",
          "type": "number"
        },
        "provider": {
          "description": "DNS provider for automatic failover",
          "type": "string",
          "enum": [
            "route53",
            "cloudflare",
            "azure_dns",
            "custom"
          ]
        }
      },
      "required": [
        "ttl"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "mode",
    "autoFailover",
    "healthCheckInterval",
    "failureThreshold",
    "regions"
  ],
  "additionalProperties": false,
  "description": "Failover configuration",
  "$id": "https://schema.objectstack.io/v3.0.11/system/FailoverConfig.json",
  "x-spec-version": "3.0.11"
}