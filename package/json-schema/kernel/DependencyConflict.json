{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "version-mismatch",
        "missing-dependency",
        "circular-dependency",
        "incompatible-versions",
        "conflicting-interfaces"
      ]
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pluginId": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "requirement": {
            "description": "What this plugin requires",
            "type": "string"
          }
        },
        "required": [
          "pluginId",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "description": {
      "type": "string"
    },
    "resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "strategy": {
            "type": "string",
            "enum": [
              "upgrade",
              "downgrade",
              "replace",
              "disable",
              "manual"
            ]
          },
          "description": {
            "type": "string"
          },
          "automaticResolution": {
            "default": false,
            "type": "boolean"
          },
          "riskLevel": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        },
        "required": [
          "strategy",
          "description",
          "automaticResolution",
          "riskLevel"
        ],
        "additionalProperties": false
      }
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "error",
        "warning",
        "info"
      ]
    }
  },
  "required": [
    "type",
    "plugins",
    "description",
    "severity"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/DependencyConflict.json",
  "x-spec-version": "3.0.11"
}