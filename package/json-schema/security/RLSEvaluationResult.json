{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "policyName": {
      "type": "string",
      "description": "Policy name"
    },
    "granted": {
      "type": "boolean",
      "description": "Whether access was granted"
    },
    "durationMs": {
      "description": "Evaluation duration in milliseconds",
      "type": "number"
    },
    "error": {
      "description": "Error message if evaluation failed",
      "type": "string"
    },
    "usingResult": {
      "description": "USING clause evaluation result",
      "type": "boolean"
    },
    "checkResult": {
      "description": "CHECK clause evaluation result",
      "type": "boolean"
    }
  },
  "required": [
    "policyName",
    "granted"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/security/RLSEvaluationResult.json",
  "x-spec-version": "3.0.11"
}