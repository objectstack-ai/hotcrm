{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error"
      ],
      "description": "Diagnostic severity"
    },
    "message": {
      "type": "string",
      "description": "Diagnostic message"
    },
    "bpmnElementId": {
      "description": "BPMN element ID related to this diagnostic",
      "type": "string"
    },
    "nodeId": {
      "description": "ObjectStack node ID related to this diagnostic",
      "type": "string"
    }
  },
  "required": [
    "severity",
    "message"
  ],
  "additionalProperties": false,
  "description": "Diagnostic message from BPMN import/export",
  "$id": "https://schema.objectstack.io/v3.0.11/automation/BpmnDiagnostic.json",
  "x-spec-version": "3.0.11"
}