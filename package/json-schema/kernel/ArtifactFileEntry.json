{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "description": "Relative file path within the artifact"
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "File size in bytes"
    },
    "category": {
      "description": "Metadata category this file belongs to",
      "type": "string",
      "enum": [
        "objects",
        "views",
        "pages",
        "flows",
        "dashboards",
        "permissions",
        "agents",
        "reports",
        "actions",
        "translations",
        "themes",
        "datasets",
        "apis",
        "triggers",
        "workflows"
      ]
    }
  },
  "required": [
    "path",
    "size"
  ],
  "additionalProperties": false,
  "description": "A single file entry within the artifact",
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/ArtifactFileEntry.json",
  "x-spec-version": "3.0.11"
}