{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "minLength": {
      "default": 8,
      "type": "number"
    },
    "requireUppercase": {
      "default": true,
      "type": "boolean"
    },
    "requireLowercase": {
      "default": true,
      "type": "boolean"
    },
    "requireNumbers": {
      "default": true,
      "type": "boolean"
    },
    "requireSymbols": {
      "default": false,
      "type": "boolean"
    },
    "expirationDays": {
      "description": "Force password change every X days",
      "type": "number"
    },
    "historyCount": {
      "default": 3,
      "description": "Prevent reusing last X passwords",
      "type": "number"
    }
  },
  "required": [
    "minLength",
    "requireUppercase",
    "requireLowercase",
    "requireNumbers",
    "requireSymbols",
    "historyCount"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/security/PasswordPolicy.json",
  "x-spec-version": "3.0.11"
}