{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "url": {
      "type": "string",
      "format": "uri",
      "description": "Upstream registry endpoint"
    },
    "syncPolicy": {
      "default": "auto",
      "type": "string",
      "enum": [
        "manual",
        "auto",
        "proxy"
      ],
      "description": "Registry synchronization strategy"
    },
    "syncInterval": {
      "description": "Auto-sync interval in seconds",
      "type": "integer",
      "minimum": 60,
      "maximum": 9007199254740991
    },
    "auth": {
      "type": "object",
      "properties": {
        "type": {
          "default": "none",
          "type": "string",
          "enum": [
            "none",
            "basic",
            "bearer",
            "api-key",
            "oauth2"
          ]
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "apiKey": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "tls": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "verifyCertificate": {
          "default": true,
          "type": "boolean"
        },
        "certificate": {
          "type": "string"
        },
        "privateKey": {
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "verifyCertificate"
      ],
      "additionalProperties": false
    },
    "timeout": {
      "default": 30000,
      "description": "Request timeout in milliseconds",
      "type": "integer",
      "minimum": 1000,
      "maximum": 9007199254740991
    },
    "retry": {
      "type": "object",
      "properties": {
        "maxAttempts": {
          "default": 3,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "backoff": {
          "default": "exponential",
          "type": "string",
          "enum": [
            "fixed",
            "linear",
            "exponential"
          ]
        }
      },
      "required": [
        "maxAttempts",
        "backoff"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "url",
    "syncPolicy",
    "timeout"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/system/RegistryUpstream.json",
  "x-spec-version": "3.0.11"
}