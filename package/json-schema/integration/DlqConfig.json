{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": false,
      "description": "Enable DLQ",
      "type": "boolean"
    },
    "queueName": {
      "type": "string",
      "description": "Dead letter queue/topic name"
    },
    "maxRetries": {
      "default": 3,
      "description": "Max retries before DLQ",
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "retryDelayMs": {
      "default": 60000,
      "description": "Retry delay in ms",
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "enabled",
    "queueName",
    "maxRetries",
    "retryDelayMs"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/integration/DlqConfig.json",
  "x-spec-version": "3.0.11"
}