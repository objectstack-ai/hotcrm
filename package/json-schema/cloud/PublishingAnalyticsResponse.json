{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "listingId": {
      "type": "string"
    },
    "timeRange": {
      "type": "string",
      "enum": [
        "last_7d",
        "last_30d",
        "last_90d",
        "last_365d",
        "all_time"
      ]
    },
    "summary": {
      "type": "object",
      "properties": {
        "totalInstalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "activeInstalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "totalUninstalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "averageRating": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "totalRatings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "totalRevenue": {
          "description": "Revenue in cents",
          "type": "number",
          "minimum": 0
        },
        "pageViews": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "totalInstalls",
        "activeInstalls",
        "totalUninstalls",
        "totalRatings",
        "pageViews"
      ],
      "additionalProperties": false
    },
    "timeSeries": {
      "description": "Time series keyed by metric name",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "date",
            "value"
          ],
          "additionalProperties": false
        }
      }
    },
    "ratingDistribution": {
      "type": "object",
      "properties": {
        "1": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "2": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "3": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "4": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "5": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "1",
        "2",
        "3",
        "4",
        "5"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "listingId",
    "timeRange",
    "summary"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/cloud/PublishingAnalyticsResponse.json",
  "x-spec-version": "3.0.11"
}