{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": true,
      "description": "Enable consumer",
      "type": "boolean"
    },
    "consumerGroup": {
      "description": "Consumer group ID",
      "type": "string"
    },
    "concurrency": {
      "default": 1,
      "description": "Number of concurrent consumers",
      "type": "number",
      "minimum": 1,
      "maximum": 100
    },
    "prefetchCount": {
      "default": 10,
      "description": "Prefetch count",
      "type": "number",
      "minimum": 1,
      "maximum": 1000
    },
    "ackMode": {
      "default": "manual",
      "type": "string",
      "enum": [
        "auto",
        "manual",
        "client"
      ],
      "description": "Message acknowledgment mode"
    },
    "autoCommit": {
      "default": false,
      "description": "Auto-commit offsets",
      "type": "boolean"
    },
    "autoCommitIntervalMs": {
      "default": 5000,
      "description": "Auto-commit interval in ms",
      "type": "number",
      "minimum": 100
    },
    "sessionTimeoutMs": {
      "default": 30000,
      "description": "Session timeout in ms",
      "type": "number",
      "minimum": 1000
    },
    "rebalanceTimeoutMs": {
      "description": "Rebalance timeout in ms",
      "type": "number",
      "minimum": 1000
    }
  },
  "required": [
    "enabled",
    "concurrency",
    "prefetchCount",
    "ackMode",
    "autoCommit",
    "autoCommitIntervalMs",
    "sessionTimeoutMs"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/integration/ConsumerConfig.json",
  "x-spec-version": "3.0.11"
}