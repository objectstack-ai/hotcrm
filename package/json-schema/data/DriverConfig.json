{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Driver instance name"
    },
    "type": {
      "type": "string",
      "enum": [
        "sql",
        "nosql",
        "cache",
        "search",
        "graph",
        "timeseries"
      ],
      "description": "Driver type category"
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "create": {
          "default": true,
          "description": "Supports CREATE operations",
          "type": "boolean"
        },
        "read": {
          "default": true,
          "description": "Supports READ operations",
          "type": "boolean"
        },
        "update": {
          "default": true,
          "description": "Supports UPDATE operations",
          "type": "boolean"
        },
        "delete": {
          "default": true,
          "description": "Supports DELETE operations",
          "type": "boolean"
        },
        "bulkCreate": {
          "default": false,
          "description": "Supports bulk CREATE operations",
          "type": "boolean"
        },
        "bulkUpdate": {
          "default": false,
          "description": "Supports bulk UPDATE operations",
          "type": "boolean"
        },
        "bulkDelete": {
          "default": false,
          "description": "Supports bulk DELETE operations",
          "type": "boolean"
        },
        "transactions": {
          "default": false,
          "description": "Supports ACID transactions",
          "type": "boolean"
        },
        "savepoints": {
          "default": false,
          "description": "Supports transaction savepoints",
          "type": "boolean"
        },
        "isolationLevels": {
          "description": "Supported isolation levels",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "read_uncommitted",
              "read_committed",
              "repeatable_read",
              "serializable",
              "snapshot"
            ],
            "description": "Transaction isolation levels (snake_case standard)"
          }
        },
        "queryFilters": {
          "default": true,
          "description": "Supports WHERE clause filtering",
          "type": "boolean"
        },
        "queryAggregations": {
          "default": false,
          "description": "Supports GROUP BY and aggregation functions",
          "type": "boolean"
        },
        "querySorting": {
          "default": true,
          "description": "Supports ORDER BY sorting",
          "type": "boolean"
        },
        "queryPagination": {
          "default": true,
          "description": "Supports LIMIT/OFFSET pagination",
          "type": "boolean"
        },
        "queryWindowFunctions": {
          "default": false,
          "description": "Supports window functions with OVER clause",
          "type": "boolean"
        },
        "querySubqueries": {
          "default": false,
          "description": "Supports subqueries",
          "type": "boolean"
        },
        "queryCTE": {
          "default": false,
          "description": "Supports Common Table Expressions (WITH clause)",
          "type": "boolean"
        },
        "joins": {
          "default": false,
          "description": "Supports SQL joins",
          "type": "boolean"
        },
        "fullTextSearch": {
          "default": false,
          "description": "Supports full-text search",
          "type": "boolean"
        },
        "jsonQuery": {
          "default": false,
          "description": "Supports JSON field querying",
          "type": "boolean"
        },
        "geospatialQuery": {
          "default": false,
          "description": "Supports geospatial queries",
          "type": "boolean"
        },
        "streaming": {
          "default": false,
          "description": "Supports result streaming (cursors/iterators)",
          "type": "boolean"
        },
        "jsonFields": {
          "default": false,
          "description": "Supports JSON field types",
          "type": "boolean"
        },
        "arrayFields": {
          "default": false,
          "description": "Supports array field types",
          "type": "boolean"
        },
        "vectorSearch": {
          "default": false,
          "description": "Supports vector embeddings and similarity search",
          "type": "boolean"
        },
        "schemaSync": {
          "default": false,
          "description": "Supports automatic schema synchronization",
          "type": "boolean"
        },
        "migrations": {
          "default": false,
          "description": "Supports database migrations",
          "type": "boolean"
        },
        "indexes": {
          "default": false,
          "description": "Supports index creation and management",
          "type": "boolean"
        },
        "connectionPooling": {
          "default": false,
          "description": "Supports connection pooling",
          "type": "boolean"
        },
        "preparedStatements": {
          "default": false,
          "description": "Supports prepared statements (SQL injection prevention)",
          "type": "boolean"
        },
        "queryCache": {
          "default": false,
          "description": "Supports query result caching",
          "type": "boolean"
        }
      },
      "required": [
        "create",
        "read",
        "update",
        "delete",
        "bulkCreate",
        "bulkUpdate",
        "bulkDelete",
        "transactions",
        "savepoints",
        "queryFilters",
        "queryAggregations",
        "querySorting",
        "queryPagination",
        "queryWindowFunctions",
        "querySubqueries",
        "queryCTE",
        "joins",
        "fullTextSearch",
        "jsonQuery",
        "geospatialQuery",
        "streaming",
        "jsonFields",
        "arrayFields",
        "vectorSearch",
        "schemaSync",
        "migrations",
        "indexes",
        "connectionPooling",
        "preparedStatements",
        "queryCache"
      ],
      "additionalProperties": false,
      "description": "Driver capability flags"
    },
    "connectionString": {
      "description": "Database connection string (driver-specific format)",
      "type": "string"
    },
    "poolConfig": {
      "description": "Connection pool configuration",
      "type": "object",
      "properties": {
        "min": {
          "default": 2,
          "description": "Minimum number of connections in pool",
          "type": "number",
          "minimum": 0
        },
        "max": {
          "default": 10,
          "description": "Maximum number of connections in pool",
          "type": "number",
          "minimum": 1
        },
        "idleTimeoutMillis": {
          "default": 30000,
          "description": "Time in ms before idle connection is closed",
          "type": "number",
          "minimum": 0
        },
        "connectionTimeoutMillis": {
          "default": 5000,
          "description": "Time in ms to wait for available connection",
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "min",
        "max",
        "idleTimeoutMillis",
        "connectionTimeoutMillis"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "type",
    "capabilities"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/data/DriverConfig.json",
  "x-spec-version": "3.0.11"
}