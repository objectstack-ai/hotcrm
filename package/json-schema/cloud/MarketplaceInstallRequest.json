{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "listingId": {
      "type": "string",
      "description": "Marketplace listing ID"
    },
    "version": {
      "description": "Version to install",
      "type": "string"
    },
    "licenseKey": {
      "description": "License key for paid packages",
      "type": "string"
    },
    "settings": {
      "description": "User-provided settings at install time",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "enableOnInstall": {
      "default": true,
      "description": "Whether to enable immediately after install",
      "type": "boolean"
    },
    "artifactRef": {
      "description": "Artifact reference for direct installation",
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Artifact download URL"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA256 checksum"
        },
        "size": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Artifact size in bytes"
        },
        "format": {
          "default": "tgz",
          "description": "Artifact format",
          "type": "string",
          "enum": [
            "tgz",
            "zip"
          ]
        },
        "uploadedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
          "description": "Upload timestamp"
        }
      },
      "required": [
        "url",
        "sha256",
        "size",
        "format",
        "uploadedAt"
      ],
      "additionalProperties": false
    },
    "tenantId": {
      "description": "Tenant identifier",
      "type": "string"
    }
  },
  "required": [
    "listingId",
    "enableOnInstall"
  ],
  "additionalProperties": false,
  "description": "Install from marketplace request",
  "$id": "https://schema.objectstack.io/v3.0.11/cloud/MarketplaceInstallRequest.json",
  "x-spec-version": "3.0.11"
}