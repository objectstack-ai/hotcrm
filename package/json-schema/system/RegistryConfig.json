{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "public",
        "private",
        "hybrid"
      ],
      "description": "Registry deployment type"
    },
    "upstream": {
      "description": "Upstream registries to sync from or proxy to",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Upstream registry endpoint"
          },
          "syncPolicy": {
            "default": "auto",
            "type": "string",
            "enum": [
              "manual",
              "auto",
              "proxy"
            ],
            "description": "Registry synchronization strategy"
          },
          "syncInterval": {
            "description": "Auto-sync interval in seconds",
            "type": "integer",
            "minimum": 60,
            "maximum": 9007199254740991
          },
          "auth": {
            "type": "object",
            "properties": {
              "type": {
                "default": "none",
                "type": "string",
                "enum": [
                  "none",
                  "basic",
                  "bearer",
                  "api-key",
                  "oauth2"
                ]
              },
              "username": {
                "type": "string"
              },
              "password": {
                "type": "string"
              },
              "token": {
                "type": "string"
              },
              "apiKey": {
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          "tls": {
            "type": "object",
            "properties": {
              "enabled": {
                "default": true,
                "type": "boolean"
              },
              "verifyCertificate": {
                "default": true,
                "type": "boolean"
              },
              "certificate": {
                "type": "string"
              },
              "privateKey": {
                "type": "string"
              }
            },
            "required": [
              "enabled",
              "verifyCertificate"
            ],
            "additionalProperties": false
          },
          "timeout": {
            "default": 30000,
            "description": "Request timeout in milliseconds",
            "type": "integer",
            "minimum": 1000,
            "maximum": 9007199254740991
          },
          "retry": {
            "type": "object",
            "properties": {
              "maxAttempts": {
                "default": 3,
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "backoff": {
                "default": "exponential",
                "type": "string",
                "enum": [
                  "fixed",
                  "linear",
                  "exponential"
                ]
              }
            },
            "required": [
              "maxAttempts",
              "backoff"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "url",
          "syncPolicy",
          "timeout"
        ],
        "additionalProperties": false
      }
    },
    "scope": {
      "description": "npm-style scopes managed by this registry (e.g., @my-corp, @enterprise)",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "defaultScope": {
      "description": "Default scope prefix for new plugins",
      "type": "string"
    },
    "storage": {
      "type": "object",
      "properties": {
        "backend": {
          "default": "local",
          "type": "string",
          "enum": [
            "local",
            "s3",
            "gcs",
            "azure-blob",
            "oss"
          ]
        },
        "path": {
          "type": "string"
        },
        "credentials": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "backend"
      ],
      "additionalProperties": false
    },
    "visibility": {
      "default": "private",
      "description": "Who can access this registry",
      "type": "string",
      "enum": [
        "public",
        "private",
        "internal"
      ]
    },
    "accessControl": {
      "type": "object",
      "properties": {
        "requireAuthForRead": {
          "default": false,
          "type": "boolean"
        },
        "requireAuthForWrite": {
          "default": true,
          "type": "boolean"
        },
        "allowedPrincipals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "requireAuthForRead",
        "requireAuthForWrite"
      ],
      "additionalProperties": false
    },
    "cache": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "ttl": {
          "default": 3600,
          "description": "Cache TTL in seconds",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxSize": {
          "description": "Maximum cache size in bytes",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "enabled",
        "ttl"
      ],
      "additionalProperties": false
    },
    "mirrors": {
      "description": "Mirror registries for redundancy",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "priority": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "url",
          "priority"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "type",
    "visibility"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/system/RegistryConfig.json",
  "x-spec-version": "3.0.11"
}