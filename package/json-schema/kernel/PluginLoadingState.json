{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pluginId": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "pending",
        "loading",
        "loaded",
        "initializing",
        "ready",
        "failed",
        "reloading",
        "unloading",
        "unloaded"
      ]
    },
    "progress": {
      "default": 0,
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "startedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "completedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "lastError": {
      "type": "string"
    },
    "retryCount": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "pluginId",
    "state",
    "progress",
    "retryCount"
  ],
  "additionalProperties": false,
  "description": "Plugin loading state",
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/PluginLoadingState.json",
  "x-spec-version": "3.0.11"
}