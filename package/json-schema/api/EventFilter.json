{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "conditions": {
      "description": "Array of filter conditions",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "Field path to filter on (supports dot notation, e.g., \"user.email\")"
          },
          "operator": {
            "type": "string",
            "enum": [
              "eq",
              "ne",
              "gt",
              "gte",
              "lt",
              "lte",
              "in",
              "nin",
              "contains",
              "startsWith",
              "endsWith",
              "exists",
              "regex"
            ],
            "description": "Comparison operator"
          },
          "value": {
            "description": "Value to compare against (not needed for \"exists\" operator)"
          }
        },
        "required": [
          "field",
          "operator"
        ],
        "additionalProperties": false
      }
    },
    "and": {
      "description": "AND logical combination of filters",
      "type": "array",
      "items": {
        "$ref": "#"
      }
    },
    "or": {
      "description": "OR logical combination of filters",
      "type": "array",
      "items": {
        "$ref": "#"
      }
    },
    "not": {
      "description": "NOT logical negation of filter",
      "$ref": "#"
    }
  },
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/EventFilter.json",
  "x-spec-version": "3.0.11"
}