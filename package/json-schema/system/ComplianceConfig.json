{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "gdpr": {
      "description": "GDPR compliance settings",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable GDPR compliance controls"
        },
        "dataSubjectRights": {
          "type": "object",
          "properties": {
            "rightToAccess": {
              "default": true,
              "description": "Allow data subjects to access their data",
              "type": "boolean"
            },
            "rightToRectification": {
              "default": true,
              "description": "Allow data subjects to correct their data",
              "type": "boolean"
            },
            "rightToErasure": {
              "default": true,
              "description": "Allow data subjects to request deletion",
              "type": "boolean"
            },
            "rightToRestriction": {
              "default": true,
              "description": "Allow data subjects to restrict processing",
              "type": "boolean"
            },
            "rightToPortability": {
              "default": true,
              "description": "Allow data subjects to export their data",
              "type": "boolean"
            },
            "rightToObjection": {
              "default": true,
              "description": "Allow data subjects to object to processing",
              "type": "boolean"
            }
          },
          "required": [
            "rightToAccess",
            "rightToRectification",
            "rightToErasure",
            "rightToRestriction",
            "rightToPortability",
            "rightToObjection"
          ],
          "additionalProperties": false,
          "description": "Data subject rights configuration per GDPR Articles 15-21"
        },
        "legalBasis": {
          "type": "string",
          "enum": [
            "consent",
            "contract",
            "legal-obligation",
            "vital-interests",
            "public-task",
            "legitimate-interests"
          ],
          "description": "Legal basis for data processing under GDPR Article 6"
        },
        "consentTracking": {
          "default": true,
          "description": "Track and record user consent",
          "type": "boolean"
        },
        "dataRetentionDays": {
          "description": "Maximum data retention period in days",
          "type": "number"
        },
        "dataProcessingAgreement": {
          "description": "URL or reference to the data processing agreement",
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "dataSubjectRights",
        "legalBasis",
        "consentTracking"
      ],
      "additionalProperties": false
    },
    "hipaa": {
      "description": "HIPAA compliance settings",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable HIPAA compliance controls"
        },
        "phi": {
          "type": "object",
          "properties": {
            "encryption": {
              "default": true,
              "description": "Encrypt Protected Health Information at rest",
              "type": "boolean"
            },
            "accessControl": {
              "default": true,
              "description": "Enforce role-based access to PHI",
              "type": "boolean"
            },
            "auditTrail": {
              "default": true,
              "description": "Log all PHI access events",
              "type": "boolean"
            },
            "backupAndRecovery": {
              "default": true,
              "description": "Enable PHI backup and disaster recovery",
              "type": "boolean"
            }
          },
          "required": [
            "encryption",
            "accessControl",
            "auditTrail",
            "backupAndRecovery"
          ],
          "additionalProperties": false,
          "description": "Protected Health Information safeguards"
        },
        "businessAssociateAgreement": {
          "default": false,
          "description": "BAA is in place with third-party processors",
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "phi",
        "businessAssociateAgreement"
      ],
      "additionalProperties": false
    },
    "pciDss": {
      "description": "PCI-DSS compliance settings",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable PCI-DSS compliance controls"
        },
        "level": {
          "type": "string",
          "enum": [
            "1",
            "2",
            "3",
            "4"
          ],
          "description": "PCI-DSS compliance level (1 = highest)"
        },
        "cardDataFields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Field names containing cardholder data"
        },
        "tokenization": {
          "default": true,
          "description": "Replace card data with secure tokens",
          "type": "boolean"
        },
        "encryptionInTransit": {
          "default": true,
          "description": "Encrypt cardholder data during transmission",
          "type": "boolean"
        },
        "encryptionAtRest": {
          "default": true,
          "description": "Encrypt stored cardholder data",
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "level",
        "cardDataFields",
        "tokenization",
        "encryptionInTransit",
        "encryptionAtRest"
      ],
      "additionalProperties": false
    },
    "auditLog": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Enable audit logging",
          "type": "boolean"
        },
        "retentionDays": {
          "default": 365,
          "description": "Number of days to retain audit logs",
          "type": "number"
        },
        "immutable": {
          "default": true,
          "description": "Prevent modification or deletion of audit logs",
          "type": "boolean"
        },
        "signLogs": {
          "default": false,
          "description": "Cryptographically sign log entries for tamper detection",
          "type": "boolean"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "create",
              "read",
              "update",
              "delete",
              "export",
              "permission-change",
              "login",
              "logout",
              "failed-login"
            ]
          },
          "description": "Event types to capture in the audit log"
        }
      },
      "required": [
        "enabled",
        "retentionDays",
        "immutable",
        "signLogs",
        "events"
      ],
      "additionalProperties": false,
      "description": "Audit log configuration"
    },
    "auditSchedules": {
      "description": "Scheduled compliance audits (A.5.35)",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique audit schedule identifier"
          },
          "title": {
            "type": "string",
            "description": "Audit title"
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Audit scope areas"
          },
          "framework": {
            "type": "string",
            "enum": [
              "gdpr",
              "hipaa",
              "sox",
              "pci_dss",
              "ccpa",
              "iso27001"
            ],
            "description": "Target compliance framework"
          },
          "scheduledAt": {
            "type": "number",
            "description": "Scheduled audit timestamp"
          },
          "completedAt": {
            "description": "Completion timestamp",
            "type": "number"
          },
          "assessor": {
            "type": "string",
            "description": "Assessor or audit team"
          },
          "isExternal": {
            "default": false,
            "description": "Whether this is an external audit",
            "type": "boolean"
          },
          "recurrenceMonths": {
            "default": 0,
            "description": "Recurrence interval in months (0 = one-time)",
            "type": "number"
          },
          "findings": {
            "description": "Audit findings",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique finding identifier"
                },
                "title": {
                  "type": "string",
                  "description": "Finding title"
                },
                "description": {
                  "type": "string",
                  "description": "Finding description"
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "critical",
                    "major",
                    "minor",
                    "observation"
                  ],
                  "description": "Finding severity"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "open",
                    "in_remediation",
                    "remediated",
                    "verified",
                    "accepted_risk",
                    "closed"
                  ],
                  "description": "Finding status"
                },
                "controlReference": {
                  "description": "ISO 27001 control reference",
                  "type": "string"
                },
                "framework": {
                  "description": "Related compliance framework",
                  "type": "string",
                  "enum": [
                    "gdpr",
                    "hipaa",
                    "sox",
                    "pci_dss",
                    "ccpa",
                    "iso27001"
                  ]
                },
                "identifiedAt": {
                  "type": "number",
                  "description": "Identification timestamp"
                },
                "identifiedBy": {
                  "type": "string",
                  "description": "Identifier (auditor name or system)"
                },
                "remediationPlan": {
                  "description": "Remediation plan",
                  "type": "string"
                },
                "remediationDeadline": {
                  "description": "Remediation deadline timestamp",
                  "type": "number"
                },
                "verifiedAt": {
                  "description": "Verification timestamp",
                  "type": "number"
                },
                "verifiedBy": {
                  "description": "Verifier name or role",
                  "type": "string"
                },
                "notes": {
                  "description": "Additional notes",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "description",
                "severity",
                "status",
                "identifiedAt",
                "identifiedBy"
              ],
              "additionalProperties": false,
              "description": "Audit finding with remediation tracking per ISO 27001:2022 A.5.35"
            }
          }
        },
        "required": [
          "id",
          "title",
          "scope",
          "framework",
          "scheduledAt",
          "assessor",
          "isExternal",
          "recurrenceMonths"
        ],
        "additionalProperties": false,
        "description": "Audit schedule for independent security reviews per ISO 27001:2022 A.5.35"
      }
    }
  },
  "required": [
    "auditLog"
  ],
  "additionalProperties": false,
  "description": "Unified compliance configuration spanning GDPR, HIPAA, PCI-DSS, and audit governance",
  "$id": "https://schema.objectstack.io/v3.0.11/system/ComplianceConfig.json",
  "x-spec-version": "3.0.11"
}