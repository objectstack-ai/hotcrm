{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pluginId": {
      "type": "string",
      "pattern": "^([a-z][a-z0-9]*\\.)+[a-z][a-z0-9-]+$",
      "description": "Required plugin identifier"
    },
    "version": {
      "type": "string",
      "description": "Semantic version constraint"
    },
    "optional": {
      "default": false,
      "type": "boolean"
    },
    "reason": {
      "type": "string"
    },
    "requiredCapabilities": {
      "description": "Protocol IDs the dependency must support",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "pluginId",
    "version",
    "optional"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/PluginDependency.json",
  "x-spec-version": "3.0.11"
}