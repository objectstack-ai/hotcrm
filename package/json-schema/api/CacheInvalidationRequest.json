{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "target": {
      "type": "string",
      "enum": [
        "all",
        "object",
        "field",
        "permission",
        "layout",
        "custom"
      ],
      "description": "What to invalidate"
    },
    "identifiers": {
      "description": "Specific resources to invalidate (e.g., object names)",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cascade": {
      "default": false,
      "description": "If true, invalidate dependent resources",
      "type": "boolean"
    },
    "pattern": {
      "description": "Pattern for custom invalidation (supports wildcards)",
      "type": "string"
    }
  },
  "required": [
    "target",
    "cascade"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/CacheInvalidationRequest.json",
  "x-spec-version": "3.0.11"
}