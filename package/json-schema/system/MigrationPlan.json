{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "statements": {
      "default": [],
      "description": "Ordered DDL statements",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sql": {
            "type": "string",
            "minLength": 1,
            "description": "SQL DDL statement"
          },
          "reversible": {
            "default": true,
            "description": "Whether the statement can be reversed",
            "type": "boolean"
          },
          "rollbackSql": {
            "description": "Reverse SQL for rollback",
            "type": "string"
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Execution order"
          }
        },
        "required": [
          "sql",
          "reversible",
          "order"
        ],
        "additionalProperties": false,
        "description": "Single DDL migration statement"
      }
    },
    "dialect": {
      "type": "string",
      "minLength": 1,
      "description": "Target SQL dialect"
    },
    "reversible": {
      "default": true,
      "description": "Whether the plan can be fully rolled back",
      "type": "boolean"
    },
    "estimatedDurationMs": {
      "description": "Estimated execution time",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "statements",
    "dialect",
    "reversible"
  ],
  "additionalProperties": false,
  "description": "Ordered migration plan",
  "$id": "https://schema.objectstack.io/v3.0.11/system/MigrationPlan.json",
  "x-spec-version": "3.0.11"
}