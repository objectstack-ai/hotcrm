{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "maxBatchSize": {
      "default": 100,
      "description": "Maximum number of keys per batch load",
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "batchScheduleFn": {
      "default": "microtask",
      "description": "Scheduling strategy for collecting batch keys",
      "type": "string",
      "enum": [
        "microtask",
        "timeout",
        "manual"
      ]
    },
    "cacheEnabled": {
      "default": true,
      "description": "Enable per-request result caching",
      "type": "boolean"
    },
    "cacheKeyFn": {
      "description": "Name or identifier of the cache key function",
      "type": "string"
    },
    "cacheTtl": {
      "description": "Cache time-to-live in seconds (0 = no expiration)",
      "type": "number",
      "minimum": 0
    },
    "coalesceRequests": {
      "default": true,
      "description": "Deduplicate identical requests within a batch window",
      "type": "boolean"
    },
    "maxConcurrency": {
      "description": "Maximum parallel batch requests",
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "maxBatchSize",
    "batchScheduleFn",
    "cacheEnabled",
    "coalesceRequests"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/DataLoaderConfig.json",
  "x-spec-version": "3.0.11"
}