{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "collection": {
      "type": "string",
      "description": "Collection/table name"
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "operator": {
            "type": "string",
            "description": "Aggregation operator (e.g., $match, $group, $sort)"
          },
          "options": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {},
            "description": "Stage-specific options"
          }
        },
        "required": [
          "operator",
          "options"
        ],
        "additionalProperties": false
      },
      "description": "Aggregation pipeline stages"
    },
    "options": {
      "description": "Query options",
      "type": "object",
      "properties": {
        "consistency": {
          "description": "Consistency level override",
          "type": "string",
          "enum": [
            "all",
            "quorum",
            "one",
            "local_quorum",
            "each_quorum",
            "eventual"
          ]
        },
        "readFromSecondary": {
          "description": "Allow reading from secondary replicas",
          "type": "boolean"
        },
        "projection": {
          "description": "Field projection",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number",
                "const": 0
              },
              {
                "type": "number",
                "const": 1
              }
            ]
          }
        },
        "timeout": {
          "description": "Query timeout (ms)",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "useCursor": {
          "description": "Use cursor instead of loading all results",
          "type": "boolean"
        },
        "batchSize": {
          "description": "Cursor batch size",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "profile": {
          "description": "Enable query profiling",
          "type": "boolean"
        },
        "hint": {
          "description": "Index hint for query optimization",
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "collection",
    "stages"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/data/AggregationPipeline.json",
  "x-spec-version": "3.0.11"
}