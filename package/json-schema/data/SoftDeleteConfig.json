{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "description": "Enable soft delete (trash/recycle bin)"
    },
    "field": {
      "default": "deleted_at",
      "description": "Field name for soft delete timestamp",
      "type": "string"
    },
    "cascadeDelete": {
      "default": false,
      "description": "Cascade soft delete to related records",
      "type": "boolean"
    }
  },
  "required": [
    "enabled",
    "field",
    "cascadeDelete"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/data/SoftDeleteConfig.json",
  "x-spec-version": "3.0.11"
}