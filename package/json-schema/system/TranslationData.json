{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "objects": {
      "description": "Object translations keyed by object name",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "Translated singular label"
          },
          "pluralLabel": {
            "description": "Translated plural label",
            "type": "string"
          },
          "fields": {
            "description": "Field-level translations",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "label": {
                  "description": "Translated field label",
                  "type": "string"
                },
                "help": {
                  "description": "Translated help text",
                  "type": "string"
                },
                "options": {
                  "description": "Option value to translated label map",
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false,
              "description": "Translation data for a single field"
            }
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": false,
        "description": "Translation data for a single object"
      }
    },
    "apps": {
      "description": "App translations keyed by app name",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "Translated app label"
          },
          "description": {
            "description": "Translated app description",
            "type": "string"
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": false
      }
    },
    "messages": {
      "description": "UI message translations keyed by message ID",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "validationMessages": {
      "description": "Translatable validation error messages keyed by rule name (e.g., {\"discount_limit\": \"折扣不能超过40%\"})",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "description": "Translation data for objects, apps, and UI messages",
  "$id": "https://schema.objectstack.io/v3.0.11/system/TranslationData.json",
  "x-spec-version": "3.0.11"
}