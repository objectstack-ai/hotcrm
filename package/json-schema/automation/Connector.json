{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$",
      "description": "Connector ID (snake_case)"
    },
    "name": {
      "type": "string",
      "description": "Connector name"
    },
    "description": {
      "description": "Connector description",
      "type": "string"
    },
    "version": {
      "description": "Connector version",
      "type": "string"
    },
    "icon": {
      "description": "Connector icon",
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "crm",
        "payment",
        "communication",
        "storage",
        "analytics",
        "database",
        "marketing",
        "accounting",
        "hr",
        "productivity",
        "ecommerce",
        "support",
        "devtools",
        "social",
        "other"
      ],
      "description": "Connector category"
    },
    "baseUrl": {
      "description": "API base URL",
      "type": "string",
      "format": "uri"
    },
    "authentication": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "none",
            "apiKey",
            "basic",
            "bearer",
            "oauth1",
            "oauth2",
            "custom"
          ],
          "description": "Authentication type"
        },
        "fields": {
          "description": "Authentication fields",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z_][a-z0-9_]*$",
                "description": "Field name (snake_case)"
              },
              "label": {
                "type": "string",
                "description": "Field label"
              },
              "type": {
                "default": "text",
                "description": "Field type",
                "type": "string",
                "enum": [
                  "text",
                  "password",
                  "url",
                  "select"
                ]
              },
              "description": {
                "description": "Field description",
                "type": "string"
              },
              "required": {
                "default": true,
                "description": "Required field",
                "type": "boolean"
              },
              "default": {
                "description": "Default value",
                "type": "string"
              },
              "options": {
                "description": "Select field options",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "label",
                    "value"
                  ],
                  "additionalProperties": false
                }
              },
              "placeholder": {
                "description": "Placeholder text",
                "type": "string"
              }
            },
            "required": [
              "name",
              "label",
              "type",
              "required"
            ],
            "additionalProperties": false
          }
        },
        "oauth2": {
          "description": "OAuth 2.0 configuration",
          "type": "object",
          "properties": {
            "authorizationUrl": {
              "type": "string",
              "format": "uri",
              "description": "Authorization endpoint URL"
            },
            "tokenUrl": {
              "type": "string",
              "format": "uri",
              "description": "Token endpoint URL"
            },
            "scopes": {
              "description": "OAuth scopes",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "clientIdField": {
              "default": "client_id",
              "description": "Client ID field name",
              "type": "string"
            },
            "clientSecretField": {
              "default": "client_secret",
              "description": "Client secret field name",
              "type": "string"
            }
          },
          "required": [
            "authorizationUrl",
            "tokenUrl",
            "clientIdField",
            "clientSecretField"
          ],
          "additionalProperties": false
        },
        "test": {
          "description": "Authentication test configuration",
          "type": "object",
          "properties": {
            "url": {
              "description": "Test endpoint URL",
              "type": "string"
            },
            "method": {
              "default": "GET",
              "description": "HTTP method",
              "type": "string",
              "enum": [
                "GET",
                "POST",
                "PUT",
                "DELETE"
              ]
            }
          },
          "required": [
            "method"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "description": "Authentication config"
    },
    "operations": {
      "description": "Connector operations",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_]*$",
            "description": "Operation ID (snake_case)"
          },
          "name": {
            "type": "string",
            "description": "Operation name"
          },
          "description": {
            "description": "Operation description",
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "read",
              "write",
              "delete",
              "search",
              "trigger",
              "action"
            ],
            "description": "Operation type"
          },
          "inputSchema": {
            "description": "Input parameters",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Parameter name"
                },
                "label": {
                  "type": "string",
                  "description": "Parameter label"
                },
                "description": {
                  "description": "Parameter description",
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "string",
                    "number",
                    "boolean",
                    "array",
                    "object",
                    "date",
                    "file"
                  ],
                  "description": "Parameter type"
                },
                "required": {
                  "default": false,
                  "description": "Required parameter",
                  "type": "boolean"
                },
                "default": {
                  "description": "Default value"
                },
                "validation": {
                  "description": "Validation rules",
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "dynamicOptions": {
                  "description": "Function to load dynamic options",
                  "type": "string"
                }
              },
              "required": [
                "name",
                "label",
                "type",
                "required"
              ],
              "additionalProperties": false
            }
          },
          "outputSchema": {
            "description": "Output schema",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "sampleOutput": {
            "description": "Sample output"
          },
          "supportsPagination": {
            "default": false,
            "description": "Supports pagination",
            "type": "boolean"
          },
          "supportsFiltering": {
            "default": false,
            "description": "Supports filtering",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "supportsPagination",
          "supportsFiltering"
        ],
        "additionalProperties": false
      }
    },
    "triggers": {
      "description": "Connector triggers",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_]*$",
            "description": "Trigger ID (snake_case)"
          },
          "name": {
            "type": "string",
            "description": "Trigger name"
          },
          "description": {
            "description": "Trigger description",
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "webhook",
              "polling",
              "stream"
            ],
            "description": "Trigger mechanism"
          },
          "config": {
            "description": "Trigger configuration",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "outputSchema": {
            "description": "Event payload schema",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "pollingIntervalMs": {
            "description": "Polling interval in ms",
            "type": "integer",
            "minimum": 1000,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "name",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "rateLimit": {
      "description": "Rate limiting",
      "type": "object",
      "properties": {
        "requestsPerSecond": {
          "description": "Max requests per second",
          "type": "number"
        },
        "requestsPerMinute": {
          "description": "Max requests per minute",
          "type": "number"
        },
        "requestsPerHour": {
          "description": "Max requests per hour",
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "author": {
      "description": "Connector author",
      "type": "string"
    },
    "documentation": {
      "description": "Documentation URL",
      "type": "string",
      "format": "uri"
    },
    "homepage": {
      "description": "Homepage URL",
      "type": "string",
      "format": "uri"
    },
    "license": {
      "description": "License (SPDX identifier)",
      "type": "string"
    },
    "tags": {
      "description": "Connector tags",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verified": {
      "default": false,
      "description": "Verified connector",
      "type": "boolean"
    },
    "metadata": {
      "description": "Custom metadata",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "id",
    "name",
    "category",
    "authentication",
    "verified"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/automation/Connector.json",
  "x-spec-version": "3.0.11"
}