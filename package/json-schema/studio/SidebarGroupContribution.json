{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Unique group key"
    },
    "label": {
      "type": "string",
      "description": "Group display label"
    },
    "icon": {
      "description": "Lucide icon name",
      "type": "string"
    },
    "metadataTypes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Metadata types in this group"
    },
    "order": {
      "default": 100,
      "description": "Sort order (lower = higher)",
      "type": "number"
    }
  },
  "required": [
    "key",
    "label",
    "metadataTypes",
    "order"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/studio/SidebarGroupContribution.json",
  "x-spec-version": "3.0.11"
}