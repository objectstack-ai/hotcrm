{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "trackHistory": {
      "default": false,
      "description": "Enable field history tracking for audit compliance",
      "type": "boolean"
    },
    "searchable": {
      "default": true,
      "description": "Index records for global search",
      "type": "boolean"
    },
    "apiEnabled": {
      "default": true,
      "description": "Expose object via automatic APIs",
      "type": "boolean"
    },
    "apiMethods": {
      "description": "Whitelist of allowed API operations",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "get",
          "list",
          "create",
          "update",
          "delete",
          "upsert",
          "bulk",
          "aggregate",
          "history",
          "search",
          "restore",
          "purge",
          "import",
          "export"
        ]
      }
    },
    "files": {
      "default": false,
      "description": "Enable file attachments and document management",
      "type": "boolean"
    },
    "feeds": {
      "default": false,
      "description": "Enable social feed, comments, and mentions (Chatter-like)",
      "type": "boolean"
    },
    "activities": {
      "default": false,
      "description": "Enable standard tasks and events tracking",
      "type": "boolean"
    },
    "trash": {
      "default": true,
      "description": "Enable soft-delete with restore capability",
      "type": "boolean"
    },
    "mru": {
      "default": true,
      "description": "Track Most Recently Used (MRU) list for users",
      "type": "boolean"
    },
    "clone": {
      "default": true,
      "description": "Allow record deep cloning",
      "type": "boolean"
    }
  },
  "required": [
    "trackHistory",
    "searchable",
    "apiEnabled",
    "files",
    "feeds",
    "activities",
    "trash",
    "mru",
    "clone"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/data/ObjectCapabilities.json",
  "x-spec-version": "3.0.11"
}