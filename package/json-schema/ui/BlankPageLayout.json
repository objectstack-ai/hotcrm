{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "columns": {
      "default": 12,
      "description": "Number of grid columns",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "rowHeight": {
      "default": 40,
      "description": "Height of each grid row in pixels",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "gap": {
      "default": 8,
      "description": "Gap between grid items in pixels",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "componentId": {
            "type": "string",
            "description": "Reference to a PageComponent.id in the page"
          },
          "x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Grid column position (0-based)"
          },
          "y": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Grid row position (0-based)"
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Width in grid columns"
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Height in grid rows"
          }
        },
        "required": [
          "componentId",
          "x",
          "y",
          "width",
          "height"
        ],
        "additionalProperties": false
      },
      "description": "Positioned components on the canvas"
    }
  },
  "required": [
    "columns",
    "rowHeight",
    "gap",
    "items"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ui/BlankPageLayout.json",
  "x-spec-version": "3.0.11"
}