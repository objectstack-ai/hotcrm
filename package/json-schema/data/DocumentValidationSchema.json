{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": false,
      "description": "Enable schema validation",
      "type": "boolean"
    },
    "validationLevel": {
      "description": "Validation strictness",
      "type": "string",
      "enum": [
        "strict",
        "moderate",
        "off"
      ]
    },
    "validationAction": {
      "description": "Action on validation failure",
      "type": "string",
      "enum": [
        "error",
        "warn"
      ]
    },
    "jsonSchema": {
      "description": "JSON Schema for validation",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "enabled"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/data/DocumentValidationSchema.json",
  "x-spec-version": "3.0.11"
}