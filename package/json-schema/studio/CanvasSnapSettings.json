{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": true,
      "description": "Enable snap-to-grid",
      "type": "boolean"
    },
    "gridSize": {
      "default": 8,
      "description": "Snap grid size in pixels",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "showGrid": {
      "default": true,
      "description": "Show grid overlay on canvas",
      "type": "boolean"
    },
    "showGuides": {
      "default": true,
      "description": "Show alignment guides when dragging",
      "type": "boolean"
    }
  },
  "required": [
    "enabled",
    "gridSize",
    "showGrid",
    "showGuides"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/studio/CanvasSnapSettings.json",
  "x-spec-version": "3.0.11"
}