{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "object": {
      "type": "string",
      "description": "Object name"
    },
    "recordId": {
      "type": "string",
      "description": "Record ID"
    },
    "userId": {
      "type": "string",
      "description": "Subscribing user ID"
    },
    "events": {
      "default": [
        "all"
      ],
      "description": "Event types to receive notifications for",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "comment",
          "mention",
          "field_change",
          "task",
          "approval",
          "all"
        ]
      }
    },
    "channels": {
      "default": [
        "in_app"
      ],
      "description": "Notification delivery channels",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "in_app",
          "email",
          "push",
          "slack"
        ]
      }
    },
    "active": {
      "default": true,
      "description": "Whether the subscription is active",
      "type": "boolean"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "description": "Subscription creation timestamp"
    }
  },
  "required": [
    "object",
    "recordId",
    "userId",
    "events",
    "channels",
    "active",
    "createdAt"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/data/RecordSubscription.json",
  "x-spec-version": "3.0.11"
}