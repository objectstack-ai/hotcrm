{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "field": {
      "type": "string",
      "description": "Field name (snake_case)"
    },
    "label": {
      "description": "Display label override",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Translation key (e.g., \"views.task_list.label\")"
            },
            "defaultValue": {
              "description": "Fallback value when translation key is not found",
              "type": "string"
            },
            "params": {
              "description": "Interpolation parameters (e.g., { count: 5 })",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        }
      ]
    },
    "width": {
      "description": "Column width in pixels",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "align": {
      "description": "Text alignment",
      "type": "string",
      "enum": [
        "left",
        "center",
        "right"
      ]
    },
    "hidden": {
      "description": "Hide column by default",
      "type": "boolean"
    },
    "sortable": {
      "description": "Allow sorting by this column",
      "type": "boolean"
    },
    "resizable": {
      "description": "Allow resizing this column",
      "type": "boolean"
    },
    "wrap": {
      "description": "Allow text wrapping",
      "type": "boolean"
    },
    "type": {
      "description": "Renderer type override (e.g., \"currency\", \"date\")",
      "type": "string"
    },
    "pinned": {
      "description": "Pin/freeze column to left or right side",
      "type": "string",
      "enum": [
        "left",
        "right"
      ]
    },
    "summary": {
      "description": "Footer aggregation function for this column",
      "type": "string",
      "enum": [
        "none",
        "count",
        "count_empty",
        "count_filled",
        "count_unique",
        "percent_empty",
        "percent_filled",
        "sum",
        "avg",
        "min",
        "max"
      ]
    },
    "link": {
      "description": "Functions as the primary navigation link (triggers View navigation)",
      "type": "boolean"
    },
    "action": {
      "description": "Registered Action ID to execute when clicked",
      "type": "string"
    }
  },
  "required": [
    "field"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ui/ListColumn.json",
  "x-spec-version": "3.0.11"
}