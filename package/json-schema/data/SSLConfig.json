{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "rejectUnauthorized": {
      "default": true,
      "description": "Reject connections with invalid certificates",
      "type": "boolean"
    },
    "ca": {
      "description": "CA certificate file path or content",
      "type": "string"
    },
    "cert": {
      "description": "Client certificate file path or content",
      "type": "string"
    },
    "key": {
      "description": "Client private key file path or content",
      "type": "string"
    }
  },
  "required": [
    "rejectUnauthorized"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/data/SSLConfig.json",
  "x-spec-version": "3.0.11"
}