{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workflowName": {
      "type": "string",
      "description": "Orchestration to execute"
    },
    "recordIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Records to process"
    },
    "batchSize": {
      "default": 10,
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "parallelism": {
      "default": 3,
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "priority": {
      "default": "normal",
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high"
      ]
    }
  },
  "required": [
    "workflowName",
    "recordIds",
    "batchSize",
    "parallelism",
    "priority"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/BatchAIOrchestrationExecution.json",
  "x-spec-version": "3.0.11"
}