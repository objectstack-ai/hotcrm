{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "executionId": {
      "type": "string",
      "description": "Execution ID of the paused flow"
    },
    "checkpointId": {
      "type": "string",
      "description": "Checkpoint ID to resume from"
    },
    "nodeId": {
      "type": "string",
      "description": "Wait node ID being resumed"
    },
    "eventType": {
      "type": "string",
      "enum": [
        "timer",
        "signal",
        "webhook",
        "manual",
        "condition"
      ],
      "description": "Event type that triggered resume"
    },
    "signalName": {
      "description": "Signal name (when eventType is signal)",
      "type": "string"
    },
    "webhookPayload": {
      "description": "Webhook request payload (when eventType is webhook)",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "resumedBy": {
      "description": "User ID or system identifier that triggered resume",
      "type": "string"
    },
    "resumedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "description": "ISO 8601 timestamp of the resume event"
    },
    "variables": {
      "description": "Variables to merge into flow context upon resume",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "executionId",
    "checkpointId",
    "nodeId",
    "eventType",
    "resumedAt"
  ],
  "additionalProperties": false,
  "description": "Payload for resuming a paused wait node",
  "$id": "https://schema.objectstack.io/v3.0.11/automation/WaitResumePayload.json",
  "x-spec-version": "3.0.11"
}