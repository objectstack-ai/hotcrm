{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Document ID"
    },
    "name": {
      "type": "string",
      "description": "Document name"
    },
    "description": {
      "description": "Document description",
      "type": "string"
    },
    "fileType": {
      "type": "string",
      "description": "File MIME type"
    },
    "fileSize": {
      "type": "number",
      "description": "File size in bytes"
    },
    "category": {
      "description": "Document category",
      "type": "string"
    },
    "tags": {
      "description": "Document tags",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "versioning": {
      "description": "Version control",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Versioning enabled"
        },
        "versions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "versionNumber": {
                "type": "number",
                "description": "Version number"
              },
              "createdAt": {
                "type": "number",
                "description": "Creation timestamp"
              },
              "createdBy": {
                "type": "string",
                "description": "Creator user ID"
              },
              "size": {
                "type": "number",
                "description": "File size in bytes"
              },
              "checksum": {
                "type": "string",
                "description": "File checksum"
              },
              "downloadUrl": {
                "type": "string",
                "format": "uri",
                "description": "Download URL"
              },
              "isLatest": {
                "default": false,
                "description": "Is latest version",
                "type": "boolean"
              }
            },
            "required": [
              "versionNumber",
              "createdAt",
              "createdBy",
              "size",
              "checksum",
              "downloadUrl",
              "isLatest"
            ],
            "additionalProperties": false
          },
          "description": "Version history"
        },
        "majorVersion": {
          "type": "number",
          "description": "Major version"
        },
        "minorVersion": {
          "type": "number",
          "description": "Minor version"
        }
      },
      "required": [
        "enabled",
        "versions",
        "majorVersion",
        "minorVersion"
      ],
      "additionalProperties": false
    },
    "template": {
      "description": "Document template",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Template ID"
        },
        "name": {
          "type": "string",
          "description": "Template name"
        },
        "description": {
          "description": "Template description",
          "type": "string"
        },
        "fileUrl": {
          "type": "string",
          "format": "uri",
          "description": "Template file URL"
        },
        "fileType": {
          "type": "string",
          "description": "File MIME type"
        },
        "placeholders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "description": "Placeholder key"
              },
              "label": {
                "type": "string",
                "description": "Placeholder label"
              },
              "type": {
                "type": "string",
                "enum": [
                  "text",
                  "number",
                  "date",
                  "image"
                ],
                "description": "Placeholder type"
              },
              "required": {
                "default": false,
                "description": "Is required",
                "type": "boolean"
              }
            },
            "required": [
              "key",
              "label",
              "type",
              "required"
            ],
            "additionalProperties": false
          },
          "description": "Template placeholders"
        }
      },
      "required": [
        "id",
        "name",
        "fileUrl",
        "fileType",
        "placeholders"
      ],
      "additionalProperties": false
    },
    "eSignature": {
      "description": "E-signature config",
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "docusign",
            "adobe-sign",
            "hellosign",
            "custom"
          ],
          "description": "E-signature provider"
        },
        "enabled": {
          "default": false,
          "description": "E-signature enabled",
          "type": "boolean"
        },
        "signers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "email": {
                "type": "string",
                "format": "email",
                "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
                "description": "Signer email"
              },
              "name": {
                "type": "string",
                "description": "Signer name"
              },
              "role": {
                "type": "string",
                "description": "Signer role"
              },
              "order": {
                "type": "number",
                "description": "Signing order"
              }
            },
            "required": [
              "email",
              "name",
              "role",
              "order"
            ],
            "additionalProperties": false
          },
          "description": "Document signers"
        },
        "expirationDays": {
          "default": 30,
          "description": "Expiration days",
          "type": "number"
        },
        "reminderDays": {
          "default": 7,
          "description": "Reminder interval days",
          "type": "number"
        }
      },
      "required": [
        "provider",
        "enabled",
        "signers",
        "expirationDays",
        "reminderDays"
      ],
      "additionalProperties": false
    },
    "access": {
      "description": "Access control",
      "type": "object",
      "properties": {
        "isPublic": {
          "default": false,
          "description": "Public access",
          "type": "boolean"
        },
        "sharedWith": {
          "description": "Shared with",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expiresAt": {
          "description": "Access expiration",
          "type": "number"
        }
      },
      "required": [
        "isPublic"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "description": "Custom metadata",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "id",
    "name",
    "fileType",
    "fileSize"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/data/Document.json",
  "x-spec-version": "3.0.11"
}