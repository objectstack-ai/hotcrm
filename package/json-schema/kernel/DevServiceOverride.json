{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "service": {
      "type": "string",
      "minLength": 1,
      "description": "Target service identifier"
    },
    "enabled": {
      "default": true,
      "description": "Enable or disable this service",
      "type": "boolean"
    },
    "strategy": {
      "default": "memory",
      "description": "Implementation strategy for development",
      "type": "string",
      "enum": [
        "mock",
        "memory",
        "stub",
        "passthrough"
      ]
    },
    "config": {
      "description": "Strategy-specific configuration for this service override",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "service",
    "enabled",
    "strategy"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/DevServiceOverride.json",
  "x-spec-version": "3.0.11"
}