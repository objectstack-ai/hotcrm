{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": false,
      "description": "Enable cache warmup",
      "type": "boolean"
    },
    "strategy": {
      "default": "lazy",
      "description": "Warmup strategy: eager (at startup), lazy (on first access), scheduled (cron)",
      "type": "string",
      "enum": [
        "eager",
        "lazy",
        "scheduled"
      ]
    },
    "schedule": {
      "description": "Cron expression for scheduled warmup",
      "type": "string"
    },
    "patterns": {
      "description": "Key patterns to warm up (e.g., \"user:*\", \"config:*\")",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "concurrency": {
      "default": 10,
      "description": "Maximum concurrent warmup operations",
      "type": "number"
    }
  },
  "required": [
    "enabled",
    "strategy",
    "concurrency"
  ],
  "additionalProperties": false,
  "description": "Cache warmup strategy",
  "$id": "https://schema.objectstack.io/v3.0.11/system/CacheWarmup.json",
  "x-spec-version": "3.0.11"
}