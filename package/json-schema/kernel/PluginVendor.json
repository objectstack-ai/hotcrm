{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$",
      "description": "Vendor identifier (reverse domain)"
    },
    "name": {
      "type": "string"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "email": {
      "type": "string",
      "format": "email",
      "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
    },
    "verified": {
      "default": false,
      "description": "Whether vendor is verified by ObjectStack",
      "type": "boolean"
    },
    "trustLevel": {
      "default": "unverified",
      "type": "string",
      "enum": [
        "official",
        "verified",
        "community",
        "unverified"
      ]
    }
  },
  "required": [
    "id",
    "name",
    "verified",
    "trustLevel"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/PluginVendor.json",
  "x-spec-version": "3.0.11"
}