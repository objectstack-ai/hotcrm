        },
        "requiredPermissions": {
          "description": "Permissions required to access this app",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "objects": {
          "description": "Objects belonging to this app",
          "type": "array",
          "items": {}
        },
        "apis": {
          "description": "Custom APIs belonging to this app",
          "type": "array",
          "items": {}
        },
        "sharing": {
          "description": "Public sharing configuration",
          "type": "object",
          "properties": {
            "enabled": {
              "default": false,
              "description": "Enable public sharing",
              "type": "boolean"
            },
            "publicLink": {
              "description": "Generated public share URL",
              "type": "string"
            },
            "password": {
              "description": "Password required to access shared link",
              "type": "string"
            },
            "allowedDomains": {
              "description": "Restrict access to specific email domains (e.g. [\"example.com\"])",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "expiresAt": {
              "description": "Expiration date/time in ISO 8601 format",
              "type": "string"
            },
            "allowAnonymous": {
              "default": false,
              "description": "Allow access without authentication",
              "type": "boolean"
            }
          },
          "required": [
            "enabled",
            "allowAnonymous"
          ],
          "additionalProperties": false
        },
        "embed": {
          "description": "Iframe embedding configuration",
          "type": "object",
          "properties": {
            "enabled": {
              "default": false,
              "description": "Enable iframe embedding",
              "type": "boolean"
            },
            "allowedOrigins": {
              "description": "Allowed iframe parent origins (e.g. [\"https://example.com\"])",
