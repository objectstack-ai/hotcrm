{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "plugin": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": {},
      "description": "Plugin metadata"
    },
    "success": {
      "type": "boolean",
      "description": "Whether the plugin started successfully"
    },
    "duration": {
      "type": "number",
      "minimum": 0,
      "description": "Time taken to start the plugin in milliseconds"
    },
    "error": {
      "description": "Serializable error representation if startup failed",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Error class name"
        },
        "message": {
          "type": "string",
          "description": "Error message"
        },
        "stack": {
          "description": "Stack trace",
          "type": "string"
        },
        "code": {
          "description": "Error code",
          "type": "string"
        }
      },
      "required": [
        "name",
        "message"
      ],
      "additionalProperties": false
    },
    "health": {
      "description": "Health status after startup if health check was enabled",
      "type": "object",
      "properties": {
        "healthy": {
          "type": "boolean",
          "description": "Whether the plugin is healthy"
        },
        "timestamp": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Unix timestamp in milliseconds when health check was performed"
        },
        "details": {
          "description": "Optional plugin-specific health details",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "message": {
          "description": "Error message if plugin is unhealthy",
          "type": "string"
        }
      },
      "required": [
        "healthy",
        "timestamp"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "plugin",
    "success",
    "duration"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/PluginStartupResult.json",
  "x-spec-version": "3.0.11"
}