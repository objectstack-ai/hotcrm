{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "enum": [
        "pinecone",
        "weaviate",
        "qdrant",
        "milvus",
        "chroma",
        "pgvector",
        "redis",
        "opensearch",
        "elasticsearch",
        "custom"
      ]
    },
    "indexName": {
      "type": "string",
      "description": "Index/collection name"
    },
    "namespace": {
      "description": "Namespace for multi-tenancy",
      "type": "string"
    },
    "host": {
      "description": "Vector store host",
      "type": "string"
    },
    "port": {
      "description": "Vector store port",
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "secretRef": {
      "description": "Reference to stored secret",
      "type": "string"
    },
    "apiKey": {
      "description": "API key or reference to secret",
      "type": "string"
    },
    "dimensions": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "Vector dimensions"
    },
    "metric": {
      "default": "cosine",
      "type": "string",
      "enum": [
        "cosine",
        "euclidean",
        "dotproduct"
      ]
    },
    "batchSize": {
      "default": 100,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "connectionPoolSize": {
      "default": 10,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "timeout": {
      "default": 30000,
      "description": "Timeout in milliseconds",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "provider",
    "indexName",
    "dimensions",
    "metric",
    "batchSize",
    "connectionPoolSize",
    "timeout"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/VectorStoreConfig.json",
  "x-spec-version": "3.0.11"
}