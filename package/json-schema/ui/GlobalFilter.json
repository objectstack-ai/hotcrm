{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "field": {
      "type": "string",
      "description": "Field name to filter on"
    },
    "label": {
      "description": "Display label for the filter",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Translation key (e.g., \"views.task_list.label\")"
            },
            "defaultValue": {
              "description": "Fallback value when translation key is not found",
              "type": "string"
            },
            "params": {
              "description": "Interpolation parameters (e.g., { count: 5 })",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        }
      ]
    },
    "type": {
      "description": "Filter input type",
      "type": "string",
      "enum": [
        "text",
        "select",
        "date",
        "number",
        "lookup"
      ]
    },
    "options": {
      "description": "Static filter options",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ],
            "description": "Option value"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "description": "Translation key (e.g., \"views.task_list.label\")"
                  },
                  "defaultValue": {
                    "description": "Fallback value when translation key is not found",
                    "type": "string"
                  },
                  "params": {
                    "description": "Interpolation parameters (e.g., { count: 5 })",
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "key"
                ],
                "additionalProperties": false
              }
            ],
            "description": "Display label: plain string or i18n translation object"
          }
        },
        "required": [
          "value",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "optionsFrom": {
      "description": "Dynamic filter options from object",
      "type": "object",
      "properties": {
        "object": {
          "type": "string",
          "description": "Source object name"
        },
        "valueField": {
          "type": "string",
          "description": "Field to use as option value"
        },
        "labelField": {
          "type": "string",
          "description": "Field to use as option label"
        },
        "filter": {
          "description": "Filter to apply to source object",
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "object",
        "valueField",
        "labelField"
      ],
      "additionalProperties": false
    },
    "defaultValue": {
      "description": "Default filter value",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "scope": {
      "default": "dashboard",
      "description": "Filter application scope",
      "type": "string",
      "enum": [
        "dashboard",
        "widget"
      ]
    },
    "targetWidgets": {
      "description": "Widget IDs to apply this filter to",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "field",
    "scope"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "allOf": [
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "$and": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            },
            "$or": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            },
            "$not": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "$id": "https://schema.objectstack.io/v3.0.11/ui/GlobalFilter.json",
  "x-spec-version": "3.0.11"
}