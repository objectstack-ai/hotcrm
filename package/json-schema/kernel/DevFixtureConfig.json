{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": true,
      "description": "Load fixture data on startup",
      "type": "boolean"
    },
    "paths": {
      "description": "Glob patterns for fixture files",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resetBeforeLoad": {
      "default": true,
      "description": "Clear existing data before loading fixtures",
      "type": "boolean"
    },
    "envFilter": {
      "description": "Only load fixtures matching these environment tags",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "enabled",
    "resetBeforeLoad"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/DevFixtureConfig.json",
  "x-spec-version": "3.0.11"
}