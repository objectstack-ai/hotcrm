{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "description": "Provisioned tenant ID"
    },
    "connectionUrl": {
      "type": "string",
      "minLength": 1,
      "description": "Database connection URL"
    },
    "status": {
      "type": "string",
      "enum": [
        "provisioning",
        "active",
        "suspended",
        "failed",
        "destroying"
      ],
      "description": "Tenant provisioning lifecycle status"
    },
    "region": {
      "type": "string",
      "enum": [
        "us-east",
        "us-west",
        "eu-west",
        "eu-central",
        "ap-southeast",
        "ap-northeast"
      ],
      "description": "Available deployment region"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "pro",
        "enterprise"
      ],
      "description": "Tenant subscription plan"
    },
    "steps": {
      "default": [],
      "description": "Pipeline step statuses",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Step name (e.g., create_database, sync_schema)"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "completed",
              "failed",
              "skipped"
            ],
            "description": "Step status"
          },
          "startedAt": {
            "description": "Step start time",
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          },
          "completedAt": {
            "description": "Step completion time",
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          },
          "durationMs": {
            "description": "Step duration in ms",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "error": {
            "description": "Error message on failure",
            "type": "string"
          }
        },
        "required": [
          "name",
          "status"
        ],
        "additionalProperties": false,
        "description": "Individual provisioning step status"
      }
    },
    "totalDurationMs": {
      "description": "Total provisioning duration",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "provisionedAt": {
      "description": "Provisioning completion time",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "error": {
      "description": "Error message on failure",
      "type": "string"
    }
  },
  "required": [
    "tenantId",
    "connectionUrl",
    "status",
    "region",
    "plan",
    "steps"
  ],
  "additionalProperties": false,
  "description": "Tenant provisioning result",
  "$id": "https://schema.objectstack.io/v3.0.11/system/TenantProvisioningResult.json",
  "x-spec-version": "3.0.11"
}