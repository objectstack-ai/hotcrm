{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "openapi": {
      "default": "3.0.0",
      "description": "OpenAPI specification version",
      "type": "string"
    },
    "info": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "API title"
        },
        "version": {
          "type": "string",
          "description": "API version"
        },
        "description": {
          "description": "API description",
          "type": "string"
        },
        "termsOfService": {
          "description": "Terms of service URL",
          "type": "string",
          "format": "uri"
        },
        "contact": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "email": {
              "type": "string",
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            }
          },
          "additionalProperties": false
        },
        "license": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "title",
        "version"
      ],
      "additionalProperties": false,
      "description": "API metadata"
    },
    "servers": {
      "default": [],
      "description": "API servers",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Server base URL"
          },
          "description": {
            "description": "Server description",
            "type": "string"
          },
          "variables": {
            "description": "URL template variables",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "default": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "enum": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "default"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      }
    },
    "paths": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {},
      "description": "API paths and operations"
    },
    "components": {
      "description": "Reusable components",
      "type": "object",
      "properties": {
        "schemas": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "responses": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "examples": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "requestBodies": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "headers": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "securitySchemes": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "apiKey",
                  "http",
                  "oauth2",
                  "openIdConnect"
                ],
                "description": "Security type"
              },
              "scheme": {
                "description": "HTTP auth scheme (bearer, basic, etc.)",
                "type": "string"
              },
              "bearerFormat": {
                "description": "Bearer token format (e.g., JWT)",
                "type": "string"
              },
              "name": {
                "description": "API key parameter name",
                "type": "string"
              },
              "in": {
                "description": "API key location",
                "type": "string",
                "enum": [
                  "header",
                  "query",
                  "cookie"
                ]
              },
              "flows": {
                "description": "OAuth2 flows",
                "type": "object",
                "properties": {
                  "implicit": {},
                  "password": {},
                  "clientCredentials": {},
                  "authorizationCode": {}
                },
                "additionalProperties": false
              },
              "openIdConnectUrl": {
                "description": "OpenID Connect discovery URL",
                "type": "string",
                "format": "uri"
              },
              "description": {
                "description": "Security scheme description",
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        },
        "links": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "callbacks": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "additionalProperties": false
    },
    "security": {
      "description": "Global security requirements",
      "type": "array",
      "items": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tags": {
      "description": "Tag definitions",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "externalDocs": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "url"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "externalDocs": {
      "description": "External documentation",
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "openapi",
    "info",
    "servers",
    "paths"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/OpenApiSpec.json",
  "x-spec-version": "3.0.11"
}