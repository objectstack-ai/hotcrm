{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Unique identifier for this navigation item (lowercase snake_case)"
    },
    "label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Translation key (e.g., \"views.task_list.label\")"
            },
            "defaultValue": {
              "description": "Fallback value when translation key is not found",
              "type": "string"
            },
            "params": {
              "description": "Interpolation parameters (e.g., { count: 5 })",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Display proper label"
    },
    "icon": {
      "description": "Icon name",
      "type": "string"
    },
    "order": {
      "description": "Sort order within the same level (lower = first)",
      "type": "number"
    },
    "badge": {
      "description": "Badge text or count displayed on the item",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        }
      ]
    },
    "visible": {
      "description": "Visibility formula condition",
      "type": "string"
    },
    "requiredPermissions": {
      "description": "Permissions required to access this item",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "type": {
      "type": "string",
      "const": "action"
    },
    "actionDef": {
      "type": "object",
      "properties": {
        "actionName": {
          "type": "string",
          "description": "Action machine name to execute"
        },
        "params": {
          "description": "Parameters passed to the action",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "actionName"
      ],
      "additionalProperties": false,
      "description": "Action definition to execute when clicked"
    }
  },
  "required": [
    "id",
    "label",
    "type",
    "actionDef"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ui/ActionNavItem.json",
  "x-spec-version": "3.0.11"
}