{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Mutation field name (camelCase recommended)"
    },
    "object": {
      "type": "string",
      "description": "Source ObjectQL object name"
    },
    "type": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "delete",
        "upsert",
        "custom"
      ],
      "description": "Mutation type"
    },
    "description": {
      "description": "Mutation description",
      "type": "string"
    },
    "input": {
      "description": "Input configuration",
      "type": "object",
      "properties": {
        "typeName": {
          "description": "Custom input type name",
          "type": "string"
        },
        "fields": {
          "description": "Input field configuration",
          "type": "object",
          "properties": {
            "include": {
              "description": "Fields to include",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "exclude": {
              "description": "Fields to exclude",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "required": {
              "description": "Required input fields",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "validation": {
          "description": "Input validation",
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "description": "Enable input validation",
              "type": "boolean"
            },
            "rules": {
              "description": "Custom validation rules",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "enabled"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "output": {
      "description": "Output configuration",
      "type": "object",
      "properties": {
        "type": {
          "default": "object",
          "description": "Output type",
          "type": "string",
          "enum": [
            "object",
            "payload",
            "boolean",
            "custom"
          ]
        },
        "includeEnvelope": {
          "default": false,
          "description": "Wrap in success/error payload",
          "type": "boolean"
        },
        "customType": {
          "description": "Custom output type name",
          "type": "string"
        }
      },
      "required": [
        "type",
        "includeEnvelope"
      ],
      "additionalProperties": false
    },
    "transaction": {
      "description": "Transaction configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Use database transaction",
          "type": "boolean"
        },
        "isolationLevel": {
          "description": "Transaction isolation level",
          "type": "string",
          "enum": [
            "read_uncommitted",
            "read_committed",
            "repeatable_read",
            "serializable"
          ]
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
    },
    "authRequired": {
      "default": true,
      "description": "Require authentication",
      "type": "boolean"
    },
    "permissions": {
      "description": "Required permissions",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hooks": {
      "description": "Lifecycle hooks",
      "type": "object",
      "properties": {
        "before": {
          "description": "Pre-mutation hooks",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "after": {
          "description": "Post-mutation hooks",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "object",
    "type",
    "authRequired"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/GraphQLMutationConfig.json",
  "x-spec-version": "3.0.11"
}