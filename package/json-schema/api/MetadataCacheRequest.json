{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ifNoneMatch": {
      "description": "ETag value for conditional request (If-None-Match header)",
      "type": "string"
    },
    "ifModifiedSince": {
      "description": "Timestamp for conditional request (If-Modified-Since header)",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "cacheControl": {
      "description": "Client cache control preferences",
      "type": "object",
      "properties": {
        "directives": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "public",
              "private",
              "no-cache",
              "no-store",
              "must-revalidate",
              "max-age"
            ]
          },
          "description": "Cache control directives"
        },
        "maxAge": {
          "description": "Maximum cache age in seconds",
          "type": "number"
        },
        "staleWhileRevalidate": {
          "description": "Allow serving stale content while revalidating (seconds)",
          "type": "number"
        },
        "staleIfError": {
          "description": "Allow serving stale content on error (seconds)",
          "type": "number"
        }
      },
      "required": [
        "directives"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/MetadataCacheRequest.json",
  "x-spec-version": "3.0.11"
}