{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Parameter name"
    },
    "label": {
      "type": "string",
      "description": "Parameter label"
    },
    "description": {
      "description": "Parameter description",
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "string",
        "number",
        "boolean",
        "array",
        "object",
        "date",
        "file"
      ],
      "description": "Parameter type"
    },
    "required": {
      "default": false,
      "description": "Required parameter",
      "type": "boolean"
    },
    "default": {
      "description": "Default value"
    },
    "validation": {
      "description": "Validation rules",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "dynamicOptions": {
      "description": "Function to load dynamic options",
      "type": "string"
    }
  },
  "required": [
    "name",
    "label",
    "type",
    "required"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/automation/OperationParameter.json",
  "x-spec-version": "3.0.11"
}