{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "description": "Enable LLM sampling"
    },
    "maxTokens": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "Maximum tokens to generate"
    },
    "temperature": {
      "description": "Sampling temperature",
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "stopSequences": {
      "description": "Stop sequences to end generation",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modelPreferences": {
      "description": "Preferred model IDs in priority order",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "systemPrompt": {
      "description": "System prompt for sampling context",
      "type": "string"
    }
  },
  "required": [
    "enabled",
    "maxTokens"
  ],
  "additionalProperties": false,
  "description": "Sampling configuration for MCP",
  "$id": "https://schema.objectstack.io/v3.0.11/ai/MCPSamplingConfig.json",
  "x-spec-version": "3.0.11"
}