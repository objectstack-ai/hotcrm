{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "intent": {
      "type": "string",
      "description": "Intent pattern (e.g., \"open_new_record_form\")"
    },
    "examples": {
      "description": "Example user queries",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actionTemplate": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Unique action ID",
          "type": "string"
        },
        "type": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "navigate_to_object_list",
                "navigate_to_object_form",
                "navigate_to_record_detail",
                "navigate_to_dashboard",
                "navigate_to_report",
                "navigate_to_app",
                "navigate_back",
                "navigate_home",
                "open_tab",
                "close_tab"
              ]
            },
            {
              "type": "string",
              "enum": [
                "change_view_mode",
                "apply_filter",
                "clear_filter",
                "apply_sort",
                "change_grouping",
                "show_columns",
                "expand_record",
                "collapse_record",
                "refresh_view",
                "export_data"
              ]
            },
            {
              "type": "string",
              "enum": [
                "create_record",
                "update_record",
                "delete_record",
                "fill_field",
                "clear_field",
                "submit_form",
                "cancel_form",
                "validate_form",
                "save_draft"
              ]
            },
            {
              "type": "string",
              "enum": [
                "select_record",
                "deselect_record",
                "select_all",
                "deselect_all",
                "bulk_update",
                "bulk_delete",
                "bulk_export"
              ]
            },
            {
              "type": "string",
              "enum": [
                "trigger_flow",
                "trigger_approval",
                "trigger_webhook",
                "run_report",
                "send_email",
                "send_notification",
                "schedule_task"
              ]
            },
            {
              "type": "string",
              "enum": [
                "open_modal",
                "close_modal",
                "open_sidebar",
                "close_sidebar",
                "show_notification",
                "hide_notification",
                "open_dropdown",
                "close_dropdown",
                "toggle_section"
              ]
            }
          ],
          "description": "Type of UI action to perform"
        },
        "params": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "object": {
                  "description": "Object name (for object-specific navigation)",
                  "type": "string"
                },
                "recordId": {
                  "description": "Record ID (for detail page)",
                  "type": "string"
                },
                "viewType": {
                  "type": "string",
                  "enum": [
                    "list",
                    "form",
                    "detail",
                    "kanban",
                    "calendar",
                    "gantt"
                  ]
                },
                "dashboardId": {
                  "description": "Dashboard ID",
                  "type": "string"
                },
                "reportId": {
                  "description": "Report ID",
                  "type": "string"
                },
                "appName": {
                  "description": "App name",
                  "type": "string"
                },
                "mode": {
                  "description": "Form mode",
                  "type": "string",
                  "enum": [
                    "new",
                    "edit",
                    "view"
                  ]
                },
                "openInNewTab": {
                  "description": "Open in new tab",
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "viewMode": {
                  "type": "string",
                  "enum": [
                    "list",
                    "kanban",
                    "calendar",
                    "gantt",
                    "pivot"
                  ]
                },
                "filters": {
                  "description": "Filter conditions",
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "sort": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "field": {
                        "type": "string"
                      },
                      "order": {
                        "type": "string",
                        "enum": [
                          "asc",
                          "desc"
                        ]
                      }
                    },
                    "required": [
                      "field",
                      "order"
                    ],
                    "additionalProperties": false
                  }
                },
                "groupBy": {
                  "description": "Field to group by",
                  "type": "string"
                },
                "columns": {
                  "description": "Columns to show/hide",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "recordId": {
                  "description": "Record to expand/collapse",
                  "type": "string"
                },
                "exportFormat": {
                  "type": "string",
                  "enum": [
                    "csv",
                    "xlsx",
                    "pdf",
                    "json"
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "object": {
                  "description": "Object name",
                  "type": "string"
                },
                "recordId": {
                  "description": "Record ID (for edit/delete)",
                  "type": "string"
                },
                "fieldValues": {
                  "description": "Field name-value pairs",
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "fieldName": {
                  "description": "Specific field to fill/clear",
                  "type": "string"
                },
                "fieldValue": {
                  "description": "Value to set"
                },
                "validateOnly": {
                  "description": "Validate without saving",
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "recordIds": {
                  "description": "Record IDs to select/operate on",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "filters": {
                  "description": "Filter for bulk operations",
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "updateData": {
                  "description": "Data for bulk update",
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "exportFormat": {
                  "type": "string",
                  "enum": [
                    "csv",
                    "xlsx",
                    "pdf",
                    "json"
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "flowName": {
                  "description": "Flow/workflow name",
                  "type": "string"
                },
                "approvalProcessName": {
                  "description": "Approval process name",
                  "type": "string"
                },
                "webhookUrl": {
                  "description": "Webhook URL",
                  "type": "string"
                },
                "reportName": {
                  "description": "Report name",
                  "type": "string"
                },
                "emailTemplate": {
                  "description": "Email template",
                  "type": "string"
                },
                "recipients": {
                  "description": "Email recipients",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "subject": {
                  "description": "Email subject",
                  "type": "string"
                },
                "message": {
                  "description": "Notification/email message",
                  "type": "string"
                },
                "taskData": {
                  "description": "Task creation data",
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "scheduleTime": {
                  "description": "Schedule time (ISO 8601)",
                  "type": "string"
                },
                "contextData": {
                  "description": "Additional context data",
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "componentId": {
                  "description": "Component ID",
                  "type": "string"
                },
                "modalConfig": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "content": {},
                    "size": {
                      "type": "string",
                      "enum": [
                        "small",
                        "medium",
                        "large",
                        "fullscreen"
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                "notificationConfig": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "info",
                        "success",
                        "warning",
                        "error"
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "duration": {
                      "description": "Duration in ms",
                      "type": "number"
                    }
                  },
                  "required": [
                    "message"
                  ],
                  "additionalProperties": false
                },
                "sidebarConfig": {
                  "type": "object",
                  "properties": {
                    "position": {
                      "type": "string",
                      "enum": [
                        "left",
                        "right"
                      ]
                    },
                    "width": {
                      "type": "string"
                    },
                    "content": {}
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          ],
          "description": "Action-specific parameters"
        },
        "requireConfirmation": {
          "default": false,
          "description": "Require user confirmation before executing",
          "type": "boolean"
        },
        "confirmationMessage": {
          "description": "Message to show in confirmation dialog",
          "type": "string"
        },
        "successMessage": {
          "description": "Message to show on success",
          "type": "string"
        },
        "onError": {
          "default": "abort",
          "description": "Error handling strategy",
          "type": "string",
          "enum": [
            "retry",
            "skip",
            "abort"
          ]
        },
        "metadata": {
          "type": "object",
          "properties": {
            "intent": {
              "description": "Original user intent/query",
              "type": "string"
            },
            "confidence": {
              "description": "Confidence score (0-1)",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "agentName": {
              "description": "Agent that generated this action",
              "type": "string"
            },
            "timestamp": {
              "description": "Generation timestamp (ISO 8601)",
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "params",
        "requireConfirmation",
        "onError"
      ],
      "additionalProperties": false,
      "description": "Action to execute"
    },
    "paramExtraction": {
      "description": "Rules for extracting parameters from user input",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "entity",
              "slot",
              "context"
            ]
          },
          "required": {
            "default": false,
            "type": "boolean"
          },
          "default": {}
        },
        "required": [
          "type",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "minConfidence": {
      "default": 0.7,
      "description": "Minimum confidence to execute",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "intent",
    "actionTemplate",
    "minConfidence"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/IntentActionMapping.json",
  "x-spec-version": "3.0.11"
}