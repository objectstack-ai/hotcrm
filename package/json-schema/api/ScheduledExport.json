{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "description": "Scheduled export ID",
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$",
      "description": "Schedule name (snake_case)"
    },
    "label": {
      "description": "Human-readable label",
      "type": "string"
    },
    "object": {
      "type": "string",
      "description": "Object name to export"
    },
    "format": {
      "default": "csv",
      "description": "Export file format",
      "type": "string",
      "enum": [
        "csv",
        "json",
        "jsonl",
        "xlsx",
        "parquet"
      ]
    },
    "fields": {
      "description": "Fields to include",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "filter": {
      "description": "Record filter criteria",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "templateId": {
      "description": "Export template ID for field mappings",
      "type": "string"
    },
    "schedule": {
      "type": "object",
      "properties": {
        "cronExpression": {
          "type": "string",
          "description": "Cron expression for schedule"
        },
        "timezone": {
          "default": "UTC",
          "description": "IANA timezone",
          "type": "string"
        }
      },
      "required": [
        "cronExpression",
        "timezone"
      ],
      "additionalProperties": false,
      "description": "Schedule timing configuration"
    },
    "delivery": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "email",
            "storage",
            "webhook"
          ],
          "description": "How to deliver the export file"
        },
        "recipients": {
          "description": "Email recipients (for email delivery)",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "storagePath": {
          "description": "Storage path (for storage delivery)",
          "type": "string"
        },
        "webhookUrl": {
          "description": "Webhook URL (for webhook delivery)",
          "type": "string"
        }
      },
      "required": [
        "method"
      ],
      "additionalProperties": false,
      "description": "Export delivery configuration"
    },
    "enabled": {
      "default": true,
      "description": "Whether the scheduled export is active",
      "type": "boolean"
    },
    "lastRunAt": {
      "description": "Last execution timestamp",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "nextRunAt": {
      "description": "Next scheduled execution",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "createdAt": {
      "description": "Creation timestamp",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "createdBy": {
      "description": "User who created the schedule",
      "type": "string"
    }
  },
  "required": [
    "name",
    "object",
    "format",
    "schedule",
    "delivery",
    "enabled"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/ScheduledExport.json",
  "x-spec-version": "3.0.11"
}