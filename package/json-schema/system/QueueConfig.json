{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Queue name (snake_case)"
    },
    "concurrency": {
      "default": 5,
      "description": "Max concurrent task executions",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "rateLimit": {
      "description": "Rate limit configuration",
      "type": "object",
      "properties": {
        "max": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Maximum tasks per duration"
        },
        "duration": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Duration in milliseconds"
        }
      },
      "required": [
        "max",
        "duration"
      ],
      "additionalProperties": false
    },
    "defaultRetryPolicy": {
      "description": "Default retry policy for tasks",
      "type": "object",
      "properties": {
        "maxRetries": {
          "default": 3,
          "description": "Maximum retry attempts",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "backoffStrategy": {
          "default": "exponential",
          "description": "Backoff strategy between retries",
          "type": "string",
          "enum": [
            "fixed",
            "linear",
            "exponential"
          ]
        },
        "initialDelayMs": {
          "default": 1000,
          "description": "Initial retry delay in milliseconds",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxDelayMs": {
          "default": 60000,
          "description": "Maximum retry delay in milliseconds",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "backoffMultiplier": {
          "default": 2,
          "description": "Multiplier for exponential backoff",
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "maxRetries",
        "backoffStrategy",
        "initialDelayMs",
        "maxDelayMs",
        "backoffMultiplier"
      ],
      "additionalProperties": false
    },
    "deadLetterQueue": {
      "description": "Dead letter queue name",
      "type": "string"
    },
    "priority": {
      "default": 0,
      "description": "Queue priority (lower = higher priority)",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "autoScale": {
      "description": "Auto-scaling configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "description": "Enable auto-scaling",
          "type": "boolean"
        },
        "minWorkers": {
          "default": 1,
          "description": "Minimum workers",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxWorkers": {
          "default": 10,
          "description": "Maximum workers",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "scaleUpThreshold": {
          "default": 100,
          "description": "Queue size to scale up",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "scaleDownThreshold": {
          "default": 10,
          "description": "Queue size to scale down",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "enabled",
        "minWorkers",
        "maxWorkers",
        "scaleUpThreshold",
        "scaleDownThreshold"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "concurrency",
    "priority"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/system/QueueConfig.json",
  "x-spec-version": "3.0.11"
}