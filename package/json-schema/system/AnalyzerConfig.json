{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "standard",
        "simple",
        "whitespace",
        "keyword",
        "pattern",
        "language"
      ],
      "description": "Text analyzer type"
    },
    "language": {
      "description": "Language for language-specific analysis",
      "type": "string"
    },
    "stopwords": {
      "description": "Custom stopwords to filter during analysis",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "customFilters": {
      "description": "Additional token filter names to apply",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "type"
  ],
  "additionalProperties": false,
  "description": "Text analyzer configuration for index tokenization and normalization",
  "$id": "https://schema.objectstack.io/v3.0.11/system/AnalyzerConfig.json",
  "x-spec-version": "3.0.11"
}