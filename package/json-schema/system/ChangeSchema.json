{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "entityType": {
      "type": "string",
      "enum": [
        "object",
        "field",
        "index",
        "view",
        "flow",
        "permission"
      ],
      "description": "Entity type"
    },
    "entityName": {
      "type": "string",
      "minLength": 1,
      "description": "Entity name"
    },
    "parentEntity": {
      "description": "Parent entity name",
      "type": "string"
    },
    "changeType": {
      "type": "string",
      "enum": [
        "added",
        "modified",
        "removed"
      ],
      "description": "Change type"
    },
    "oldValue": {
      "description": "Previous value"
    },
    "newValue": {
      "description": "New value"
    }
  },
  "required": [
    "entityType",
    "entityName",
    "changeType"
  ],
  "additionalProperties": false,
  "description": "Individual schema change",
  "$id": "https://schema.objectstack.io/v3.0.11/system/ChangeSchema.json",
  "x-spec-version": "3.0.11"
}