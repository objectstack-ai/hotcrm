{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "description": "Enable RLS audit logging"
    },
    "logLevel": {
      "type": "string",
      "enum": [
        "all",
        "denied_only",
        "granted_only",
        "none"
      ],
      "description": "Which evaluations to log"
    },
    "destination": {
      "type": "string",
      "enum": [
        "system_log",
        "audit_trail",
        "external"
      ],
      "description": "Audit log destination"
    },
    "sampleRate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Sampling rate (0-1) for high-traffic environments"
    },
    "retentionDays": {
      "default": 90,
      "description": "Audit log retention period in days",
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "includeRowData": {
      "default": false,
      "description": "Include row data in audit logs (security-sensitive)",
      "type": "boolean"
    },
    "alertOnDenied": {
      "default": true,
      "description": "Send alerts when access is denied",
      "type": "boolean"
    }
  },
  "required": [
    "enabled",
    "logLevel",
    "destination",
    "sampleRate",
    "retentionDays",
    "includeRowData",
    "alertOnDenied"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/security/RLSAuditConfig.json",
  "x-spec-version": "3.0.11"
}