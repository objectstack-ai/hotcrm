{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "modelName": {
      "type": "string",
      "description": "Model to use for prediction"
    },
    "recordIds": {
      "description": "Specific records to predict (if not provided, uses all)",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inputData": {
      "description": "Direct input data (alternative to recordIds)",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "returnConfidence": {
      "default": true,
      "type": "boolean"
    },
    "returnExplanation": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "modelName",
    "returnConfidence",
    "returnExplanation"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/PredictionRequest.json",
  "x-spec-version": "3.0.11"
}