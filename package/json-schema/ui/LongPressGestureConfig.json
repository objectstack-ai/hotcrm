{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "duration": {
      "default": 500,
      "description": "Hold duration in milliseconds to trigger long press",
      "type": "number"
    },
    "moveTolerance": {
      "description": "Max movement in pixels allowed during press",
      "type": "number"
    }
  },
  "required": [
    "duration"
  ],
  "additionalProperties": false,
  "description": "Long press gesture recognition settings",
  "$id": "https://schema.objectstack.io/v3.0.11/ui/LongPressGestureConfig.json",
  "x-spec-version": "3.0.11"
}