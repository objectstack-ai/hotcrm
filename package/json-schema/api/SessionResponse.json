{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "success": {
      "type": "boolean",
      "description": "Operation success status"
    },
    "error": {
      "description": "Error details if success is false",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Error code (e.g. validation_error)"
        },
        "message": {
          "type": "string",
          "description": "Readable error message"
        },
        "category": {
          "description": "Error category (e.g. validation, authorization)",
          "type": "string"
        },
        "details": {
          "description": "Additional error context (e.g. field validation errors)"
        },
        "requestId": {
          "description": "Request ID for tracking",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "meta": {
      "description": "Response metadata",
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "string"
        },
        "duration": {
          "type": "number"
        },
        "requestId": {
          "type": "string"
        },
        "traceId": {
          "type": "string"
        }
      },
      "required": [
        "timestamp"
      ],
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "properties": {
        "session": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
            },
            "token": {
              "type": "string"
            },
            "ipAddress": {
              "type": "string"
            },
            "userAgent": {
              "type": "string"
            },
            "userId": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "expiresAt",
            "userId"
          ],
          "additionalProperties": false,
          "description": "Active Session Info"
        },
        "user": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "User ID"
            },
            "email": {
              "type": "string",
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
              "description": "Email address"
            },
            "emailVerified": {
              "default": false,
              "description": "Is email verified?",
              "type": "boolean"
            },
            "name": {
              "type": "string",
              "description": "Display name"
            },
            "image": {
              "description": "Avatar URL",
              "type": "string"
            },
            "username": {
              "description": "Username (optional)",
              "type": "string"
            },
            "roles": {
              "default": [],
              "description": "Assigned role IDs",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tenantId": {
              "description": "Current tenant ID",
              "type": "string"
            },
            "language": {
              "default": "en",
              "description": "Preferred language",
              "type": "string"
            },
            "timezone": {
              "description": "Preferred timezone",
              "type": "string"
            },
            "createdAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
            }
          },
          "required": [
            "id",
            "email",
            "emailVerified",
            "name",
            "roles",
            "language"
          ],
          "additionalProperties": false,
          "description": "Current User Details"
        },
        "token": {
          "description": "Bearer token if not using cookies",
          "type": "string"
        }
      },
      "required": [
        "session",
        "user"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "success",
    "data"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/SessionResponse.json",
  "x-spec-version": "3.0.11"
}