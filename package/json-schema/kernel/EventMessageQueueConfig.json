{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "enum": [
        "kafka",
        "rabbitmq",
        "aws-sqs",
        "redis-pubsub",
        "google-pubsub",
        "azure-service-bus"
      ],
      "description": "Message queue provider"
    },
    "topic": {
      "type": "string",
      "description": "Topic or queue name"
    },
    "eventPattern": {
      "default": "*",
      "description": "Event name pattern to publish (supports wildcards)",
      "type": "string"
    },
    "partitionKey": {
      "description": "JSON path for partition key (e.g., \"metadata.tenantId\")",
      "type": "string"
    },
    "format": {
      "default": "json",
      "description": "Message serialization format",
      "type": "string",
      "enum": [
        "json",
        "avro",
        "protobuf"
      ]
    },
    "includeMetadata": {
      "default": true,
      "description": "Include event metadata in message",
      "type": "boolean"
    },
    "compression": {
      "default": "none",
      "description": "Message compression",
      "type": "string",
      "enum": [
        "none",
        "gzip",
        "snappy",
        "lz4"
      ]
    },
    "batchSize": {
      "default": 1,
      "description": "Batch size for publishing",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "flushIntervalMs": {
      "default": 1000,
      "description": "Flush interval for batching",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "provider",
    "topic",
    "eventPattern",
    "format",
    "includeMetadata",
    "compression",
    "batchSize",
    "flushIntervalMs"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/EventMessageQueueConfig.json",
  "x-spec-version": "3.0.11"
}