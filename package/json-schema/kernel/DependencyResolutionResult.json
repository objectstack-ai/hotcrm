{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "packageId": {
            "type": "string",
            "description": "Dependency package identifier"
          },
          "requiredRange": {
            "type": "string",
            "description": "SemVer range required (e.g. \"^2.0.0\")"
          },
          "resolvedVersion": {
            "description": "Actual version resolved from registry",
            "type": "string"
          },
          "installedVersion": {
            "description": "Currently installed version",
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "satisfied",
              "needs_install",
              "needs_upgrade",
              "conflict"
            ],
            "description": "Resolution status"
          },
          "conflictReason": {
            "description": "Explanation of the conflict",
            "type": "string"
          }
        },
        "required": [
          "packageId",
          "requiredRange",
          "status"
        ],
        "additionalProperties": false,
        "description": "Resolution result for a single dependency"
      },
      "description": "Resolution result for each dependency"
    },
    "canProceed": {
      "type": "boolean",
      "description": "Whether installation can proceed"
    },
    "requiredActions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "install",
              "upgrade",
              "confirm_conflict"
            ],
            "description": "Type of action required"
          },
          "packageId": {
            "type": "string",
            "description": "Target package identifier"
          },
          "description": {
            "type": "string",
            "description": "Human-readable action description"
          }
        },
        "required": [
          "type",
          "packageId",
          "description"
        ],
        "additionalProperties": false,
        "description": "Action required before installation can proceed"
      },
      "description": "Actions required before proceeding"
    },
    "installOrder": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Topologically sorted package IDs for installation"
    },
    "circularDependencies": {
      "description": "Circular dependency chains detected (e.g. [[\"A\", \"B\", \"A\"]])",
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "dependencies",
    "canProceed",
    "requiredActions",
    "installOrder"
  ],
  "additionalProperties": false,
  "description": "Complete dependency resolution result",
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/DependencyResolutionResult.json",
  "x-spec-version": "3.0.11"
}