{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "database",
        "elasticsearch",
        "mongodb",
        "clickhouse",
        "s3",
        "gcs",
        "azure_blob",
        "custom"
      ],
      "description": "Storage backend type"
    },
    "connectionString": {
      "description": "Connection string",
      "type": "string"
    },
    "config": {
      "description": "Storage-specific configuration",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "bufferEnabled": {
      "default": true,
      "description": "Enable buffering",
      "type": "boolean"
    },
    "bufferSize": {
      "default": 100,
      "description": "Buffer size",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "flushIntervalSeconds": {
      "default": 5,
      "description": "Flush interval in seconds",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "compression": {
      "default": true,
      "description": "Enable compression",
      "type": "boolean"
    }
  },
  "required": [
    "type",
    "bufferEnabled",
    "bufferSize",
    "flushIntervalSeconds",
    "compression"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/system/AuditStorageConfig.json",
  "x-spec-version": "3.0.11"
}