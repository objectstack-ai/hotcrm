{
  "name": "@hotcrm/community",
  "version": "1.0.0",
  "description": "Community module - Customer Portal, Forums, Ideas, Events, and Gamification",
  "license": "MIT",
  "main": "./dist/plugin.js",
  "types": "./dist/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "objectstack dev",
    "start": "objectstack serve",
    "build": "tsc && objectstack compile",
    "typecheck": "tsc --noEmit",
    "test": "objectstack test"
  },
  "keywords": [
    "community",
    "forums",
    "ideas",
    "gamification",
    "portal"
  ],
  "author": "HotCRM Team",
  "dependencies": {
    "@objectstack/spec": "^3.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@objectstack/cli": "^3.0.3",
    "typescript": "^5.9.3"
  }
}
