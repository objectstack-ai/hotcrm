{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$",
      "description": "Operation ID (snake_case)"
    },
    "name": {
      "type": "string",
      "description": "Operation name"
    },
    "description": {
      "description": "Operation description",
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "read",
        "write",
        "delete",
        "search",
        "trigger",
        "action"
      ],
      "description": "Operation type"
    },
    "inputSchema": {
      "description": "Input parameters",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Parameter name"
          },
          "label": {
            "type": "string",
            "description": "Parameter label"
          },
          "description": {
            "description": "Parameter description",
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "boolean",
              "array",
              "object",
              "date",
              "file"
            ],
            "description": "Parameter type"
          },
          "required": {
            "default": false,
            "description": "Required parameter",
            "type": "boolean"
          },
          "default": {
            "description": "Default value"
          },
          "validation": {
            "description": "Validation rules",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "dynamicOptions": {
            "description": "Function to load dynamic options",
            "type": "string"
          }
        },
        "required": [
          "name",
          "label",
          "type",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "outputSchema": {
      "description": "Output schema",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "sampleOutput": {
      "description": "Sample output"
    },
    "supportsPagination": {
      "default": false,
      "description": "Supports pagination",
      "type": "boolean"
    },
    "supportsFiltering": {
      "default": false,
      "description": "Supports filtering",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "name",
    "type",
    "supportsPagination",
    "supportsFiltering"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/automation/ConnectorOperation.json",
  "x-spec-version": "3.0.11"
}