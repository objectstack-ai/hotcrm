{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$",
      "description": "Pipeline identifier (snake_case)"
    },
    "label": {
      "description": "Pipeline display name",
      "type": "string"
    },
    "description": {
      "description": "Pipeline description",
      "type": "string"
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "database",
            "api",
            "file",
            "stream",
            "object",
            "warehouse",
            "storage",
            "spreadsheet"
          ],
          "description": "Source type"
        },
        "connector": {
          "description": "Connector ID",
          "type": "string"
        },
        "config": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {},
          "description": "Source configuration"
        },
        "incremental": {
          "description": "Incremental extraction config",
          "type": "object",
          "properties": {
            "enabled": {
              "default": false,
              "type": "boolean"
            },
            "cursorField": {
              "type": "string",
              "description": "Field to track progress (e.g., updated_at)"
            },
            "cursorValue": {
              "description": "Last processed value"
            }
          },
          "required": [
            "enabled",
            "cursorField"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "config"
      ],
      "additionalProperties": false,
      "description": "Data source"
    },
    "destination": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "database",
            "api",
            "file",
            "stream",
            "object",
            "warehouse",
            "storage",
            "spreadsheet"
          ],
          "description": "Destination type"
        },
        "connector": {
          "description": "Connector ID",
          "type": "string"
        },
        "config": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {},
          "description": "Destination configuration"
        },
        "writeMode": {
          "default": "append",
          "description": "How to write data",
          "type": "string",
          "enum": [
            "append",
            "overwrite",
            "upsert",
            "merge"
          ]
        },
        "primaryKey": {
          "description": "Primary key fields",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "config",
        "writeMode"
      ],
      "additionalProperties": false,
      "description": "Data destination"
    },
    "transformations": {
      "description": "Transformation pipeline",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "description": "Transformation name",
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "map",
              "filter",
              "aggregate",
              "join",
              "script",
              "lookup",
              "split",
              "merge",
              "normalize",
              "deduplicate"
            ],
            "description": "Transformation type"
          },
          "config": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {},
            "description": "Transformation config"
          },
          "continueOnError": {
            "default": false,
            "description": "Continue on error",
            "type": "boolean"
          }
        },
        "required": [
          "type",
          "config",
          "continueOnError"
        ],
        "additionalProperties": false
      }
    },
    "syncMode": {
      "default": "full",
      "description": "Sync mode",
      "type": "string",
      "enum": [
        "full",
        "incremental",
        "cdc"
      ]
    },
    "schedule": {
      "description": "Cron schedule expression",
      "type": "string"
    },
    "enabled": {
      "default": true,
      "description": "Pipeline enabled status",
      "type": "boolean"
    },
    "retry": {
      "description": "Retry configuration",
      "type": "object",
      "properties": {
        "maxAttempts": {
          "default": 3,
          "description": "Max retry attempts",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "backoffMs": {
          "default": 60000,
          "description": "Backoff in milliseconds",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "maxAttempts",
        "backoffMs"
      ],
      "additionalProperties": false
    },
    "notifications": {
      "description": "Notification settings",
      "type": "object",
      "properties": {
        "onSuccess": {
          "description": "Email addresses for success notifications",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "onFailure": {
          "description": "Email addresses for failure notifications",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "tags": {
      "description": "Pipeline tags",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "description": "Custom metadata",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "name",
    "source",
    "destination",
    "syncMode",
    "enabled"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/automation/ETLPipeline.json",
  "x-spec-version": "3.0.11"
}