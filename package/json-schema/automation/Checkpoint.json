{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Checkpoint ID"
    },
    "executionId": {
      "type": "string",
      "description": "Parent execution ID"
    },
    "flowName": {
      "type": "string",
      "description": "Flow machine name"
    },
    "currentNodeId": {
      "type": "string",
      "description": "Node ID where execution is paused"
    },
    "variables": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {},
      "description": "Flow variable state at checkpoint"
    },
    "completedNodeIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of node IDs already executed"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "description": "Checkpoint creation timestamp"
    },
    "expiresAt": {
      "description": "Checkpoint expiration (auto-cleanup)",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "reason": {
      "type": "string",
      "enum": [
        "wait",
        "screen_input",
        "approval",
        "error",
        "manual_pause",
        "parallel_join",
        "boundary_event"
      ],
      "description": "Why the execution was checkpointed"
    }
  },
  "required": [
    "id",
    "executionId",
    "flowName",
    "currentNodeId",
    "variables",
    "completedNodeIds",
    "createdAt",
    "reason"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/automation/Checkpoint.json",
  "x-spec-version": "3.0.11"
}