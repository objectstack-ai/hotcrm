{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "success": {
      "type": "boolean",
      "description": "Operation success status"
    },
    "error": {
      "description": "Error details if success is false",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Error code (e.g. validation_error)"
        },
        "message": {
          "type": "string",
          "description": "Readable error message"
        },
        "category": {
          "description": "Error category (e.g. validation, authorization)",
          "type": "string"
        },
        "details": {
          "description": "Additional error context (e.g. field validation errors)"
        },
        "requestId": {
          "description": "Request ID for tracking",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "meta": {
      "description": "Response metadata",
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "string"
        },
        "duration": {
          "type": "number"
        },
        "requestId": {
          "type": "string"
        },
        "traceId": {
          "type": "string"
        }
      },
      "required": [
        "timestamp"
      ],
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Changelog entry ID"
              },
              "object": {
                "type": "string",
                "description": "Object name"
              },
              "recordId": {
                "type": "string",
                "description": "Record ID"
              },
              "actor": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "user",
                      "system",
                      "service",
                      "automation"
                    ],
                    "description": "Actor type"
                  },
                  "id": {
                    "type": "string",
                    "description": "Actor ID"
                  },
                  "name": {
                    "description": "Actor display name",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "id"
                ],
                "additionalProperties": false,
                "description": "Who made the change"
              },
              "changes": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "description": "Field machine name"
                    },
                    "fieldLabel": {
                      "description": "Field display label",
                      "type": "string"
                    },
                    "oldValue": {
                      "description": "Previous value"
                    },
                    "newValue": {
                      "description": "New value"
                    },
                    "oldDisplayValue": {
                      "description": "Human-readable old value",
                      "type": "string"
                    },
                    "newDisplayValue": {
                      "description": "Human-readable new value",
                      "type": "string"
                    }
                  },
                  "required": [
                    "field"
                  ],
                  "additionalProperties": false
                },
                "description": "Field-level changes"
              },
              "timestamp": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
                "description": "When the change occurred"
              },
              "source": {
                "description": "Change source (e.g., \"API\", \"UI\", \"automation\")",
                "type": "string"
              }
            },
            "required": [
              "id",
              "object",
              "recordId",
              "actor",
              "changes",
              "timestamp"
            ],
            "additionalProperties": false
          },
          "description": "Changelog entries in reverse chronological order"
        },
        "total": {
          "description": "Total changelog entries matching filter",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "nextCursor": {
          "description": "Cursor for the next page",
          "type": "string"
        },
        "hasMore": {
          "type": "boolean",
          "description": "Whether more entries are available"
        }
      },
      "required": [
        "entries",
        "hasMore"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "success",
    "data"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/GetChangelogResponse.json",
  "x-spec-version": "3.0.11"
}