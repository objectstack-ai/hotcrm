{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "description": "Unique action ID",
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "change_view_mode",
        "apply_filter",
        "clear_filter",
        "apply_sort",
        "change_grouping",
        "show_columns",
        "expand_record",
        "collapse_record",
        "refresh_view",
        "export_data"
      ]
    },
    "params": {
      "type": "object",
      "properties": {
        "viewMode": {
          "type": "string",
          "enum": [
            "list",
            "kanban",
            "calendar",
            "gantt",
            "pivot"
          ]
        },
        "filters": {
          "description": "Filter conditions",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "sort": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string"
              },
              "order": {
                "type": "string",
                "enum": [
                  "asc",
                  "desc"
                ]
              }
            },
            "required": [
              "field",
              "order"
            ],
            "additionalProperties": false
          }
        },
        "groupBy": {
          "description": "Field to group by",
          "type": "string"
        },
        "columns": {
          "description": "Columns to show/hide",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recordId": {
          "description": "Record to expand/collapse",
          "type": "string"
        },
        "exportFormat": {
          "type": "string",
          "enum": [
            "csv",
            "xlsx",
            "pdf",
            "json"
          ]
        }
      },
      "additionalProperties": false
    },
    "requireConfirmation": {
      "default": false,
      "description": "Require user confirmation before executing",
      "type": "boolean"
    },
    "confirmationMessage": {
      "description": "Message to show in confirmation dialog",
      "type": "string"
    },
    "successMessage": {
      "description": "Message to show on success",
      "type": "string"
    },
    "onError": {
      "default": "abort",
      "description": "Error handling strategy",
      "type": "string",
      "enum": [
        "retry",
        "skip",
        "abort"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "intent": {
          "description": "Original user intent/query",
          "type": "string"
        },
        "confidence": {
          "description": "Confidence score (0-1)",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "agentName": {
          "description": "Agent that generated this action",
          "type": "string"
        },
        "timestamp": {
          "description": "Generation timestamp (ISO 8601)",
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "params",
    "requireConfirmation",
    "onError"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/ViewAgentAction.json",
  "x-spec-version": "3.0.11"
}