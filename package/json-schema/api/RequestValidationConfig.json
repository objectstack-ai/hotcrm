{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": true,
      "description": "Enable automatic request validation",
      "type": "boolean"
    },
    "mode": {
      "default": "strict",
      "description": "How to handle validation errors",
      "type": "string",
      "enum": [
        "strict",
        "permissive",
        "strip"
      ]
    },
    "validateBody": {
      "default": true,
      "description": "Validate request body against schema",
      "type": "boolean"
    },
    "validateQuery": {
      "default": true,
      "description": "Validate query string parameters",
      "type": "boolean"
    },
    "validateParams": {
      "default": true,
      "description": "Validate URL path parameters",
      "type": "boolean"
    },
    "validateHeaders": {
      "default": false,
      "description": "Validate request headers",
      "type": "boolean"
    },
    "includeFieldErrors": {
      "default": true,
      "description": "Include field-level error details in response",
      "type": "boolean"
    },
    "errorPrefix": {
      "description": "Custom prefix for validation error messages",
      "type": "string"
    },
    "schemaRegistry": {
      "description": "Schema registry name to use for validation",
      "type": "string"
    }
  },
  "required": [
    "enabled",
    "mode",
    "validateBody",
    "validateQuery",
    "validateParams",
    "validateHeaders",
    "includeFieldErrors"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/RequestValidationConfig.json",
  "x-spec-version": "3.0.11"
}