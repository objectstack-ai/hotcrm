{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "valid": {
      "type": "boolean",
      "description": "Whether the bundle is valid"
    },
    "issues": {
      "default": [],
      "description": "Validation issues",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "info"
            ],
            "description": "Issue severity"
          },
          "path": {
            "type": "string",
            "description": "Entity path (e.g., objects.project_task.fields.name)"
          },
          "message": {
            "type": "string",
            "description": "Issue description"
          },
          "code": {
            "description": "Validation error code",
            "type": "string"
          }
        },
        "required": [
          "severity",
          "path",
          "message"
        ],
        "additionalProperties": false,
        "description": "Validation issue"
      }
    },
    "errorCount": {
      "default": 0,
      "description": "Number of errors",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "warningCount": {
      "default": 0,
      "description": "Number of warnings",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "valid",
    "issues",
    "errorCount",
    "warningCount"
  ],
  "additionalProperties": false,
  "description": "Bundle validation result",
  "$id": "https://schema.objectstack.io/v3.0.11/system/DeployValidationResult.json",
  "x-spec-version": "3.0.11"
}