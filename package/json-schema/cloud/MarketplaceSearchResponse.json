{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Listing ID (matches package manifest ID)"
          },
          "packageId": {
            "type": "string",
            "description": "Package identifier"
          },
          "publisherId": {
            "type": "string",
            "description": "Publisher ID"
          },
          "status": {
            "default": "draft",
            "description": "Publication state: draft, published, under-review, suspended, deprecated, or unlisted",
            "type": "string",
            "enum": [
              "draft",
              "submitted",
              "in-review",
              "approved",
              "published",
              "rejected",
              "suspended",
              "deprecated",
              "unlisted"
            ]
          },
          "name": {
            "type": "string",
            "description": "Display name"
          },
          "tagline": {
            "description": "Short tagline (max 120 chars)",
            "type": "string",
            "maxLength": 120
          },
          "description": {
            "description": "Full description (Markdown)",
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "crm",
              "erp",
              "hr",
              "finance",
              "project",
              "collaboration",
              "analytics",
              "integration",
              "automation",
              "ai",
              "security",
              "developer-tools",
              "ui-theme",
              "storage",
              "other"
            ],
            "description": "Package category"
          },
          "tags": {
            "description": "Search tags",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "iconUrl": {
            "description": "Package icon URL",
            "type": "string",
            "format": "uri"
          },
          "screenshots": {
            "description": "Screenshots",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "caption": {
                  "type": "string"
                }
              },
              "required": [
                "url"
              ],
              "additionalProperties": false
            }
          },
          "documentationUrl": {
            "description": "Documentation URL",
            "type": "string",
            "format": "uri"
          },
          "supportUrl": {
            "description": "Support URL",
            "type": "string",
            "format": "uri"
          },
          "repositoryUrl": {
            "description": "Source repository URL",
            "type": "string",
            "format": "uri"
          },
          "pricing": {
            "default": "free",
            "description": "Pricing model",
            "type": "string",
            "enum": [
              "free",
              "freemium",
              "paid",
              "subscription",
              "usage-based",
              "contact-sales"
            ]
          },
          "priceInCents": {
            "description": "Price in cents (e.g. 999 = $9.99)",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "latestVersion": {
            "type": "string",
            "description": "Latest published version"
          },
          "minPlatformVersion": {
            "description": "Minimum ObjectStack platform version",
            "type": "string"
          },
          "versions": {
            "description": "Published versions",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "version": {
                  "type": "string",
                  "description": "Version string"
                },
                "releaseDate": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
                  "description": "Release date"
                },
                "releaseNotes": {
                  "description": "Release notes",
                  "type": "string"
                },
                "minPlatformVersion": {
                  "description": "Minimum platform version",
                  "type": "string"
                },
                "deprecated": {
                  "default": false,
                  "description": "Whether this version is deprecated",
                  "type": "boolean"
                },
                "artifact": {
                  "description": "Downloadable artifact for this version",
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri",
                      "description": "Artifact download URL"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$",
                      "description": "SHA256 checksum"
                    },
                    "size": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991,
                      "description": "Artifact size in bytes"
                    },
                    "format": {
                      "default": "tgz",
                      "description": "Artifact format",
                      "type": "string",
                      "enum": [
                        "tgz",
                        "zip"
                      ]
                    },
                    "uploadedAt": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
                      "description": "Upload timestamp"
                    }
                  },
                  "required": [
                    "url",
                    "sha256",
                    "size",
                    "format",
                    "uploadedAt"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "version",
                "releaseDate",
                "deprecated"
              ],
              "additionalProperties": false
            }
          },
          "stats": {
            "description": "Aggregate marketplace statistics",
            "type": "object",
            "properties": {
              "totalInstalls": {
                "default": 0,
                "description": "Total installs",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "activeInstalls": {
                "default": 0,
                "description": "Active installs",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "averageRating": {
                "description": "Average user rating (0-5)",
                "type": "number",
                "minimum": 0,
                "maximum": 5
              },
              "totalRatings": {
                "default": 0,
                "description": "Total ratings count",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "totalReviews": {
                "default": 0,
                "description": "Total reviews count",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "totalInstalls",
              "activeInstalls",
              "totalRatings",
              "totalReviews"
            ],
            "additionalProperties": false
          },
          "publishedAt": {
            "description": "First published timestamp",
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          },
          "updatedAt": {
            "description": "Last updated timestamp",
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "packageId",
          "publisherId",
          "status",
          "name",
          "category",
          "pricing",
          "latestVersion"
        ],
        "additionalProperties": false,
        "description": "Public-facing package listing on the marketplace"
      },
      "description": "Search result listings"
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Total matching results"
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Current page number"
    },
    "pageSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Items per page"
    },
    "facets": {
      "description": "Aggregation facets for refining search",
      "type": "object",
      "properties": {
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string",
                "enum": [
                  "crm",
                  "erp",
                  "hr",
                  "finance",
                  "project",
                  "collaboration",
                  "analytics",
                  "integration",
                  "automation",
                  "ai",
                  "security",
                  "developer-tools",
                  "ui-theme",
                  "storage",
                  "other"
                ],
                "description": "Marketplace package category"
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "category",
              "count"
            ],
            "additionalProperties": false
          }
        },
        "pricing": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "model": {
                "type": "string",
                "enum": [
                  "free",
                  "freemium",
                  "paid",
                  "subscription",
                  "usage-based",
                  "contact-sales"
                ],
                "description": "Package pricing model"
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "model",
              "count"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "items",
    "total",
    "page",
    "pageSize"
  ],
  "additionalProperties": false,
  "description": "Marketplace search response",
  "$id": "https://schema.objectstack.io/v3.0.11/cloud/MarketplaceSearchResponse.json",
  "x-spec-version": "3.0.11"
}