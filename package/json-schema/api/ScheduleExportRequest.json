{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$",
      "description": "Schedule name (snake_case)"
    },
    "label": {
      "description": "Human-readable label",
      "type": "string"
    },
    "object": {
      "type": "string",
      "description": "Object name to export"
    },
    "format": {
      "default": "csv",
      "description": "Export file format",
      "type": "string",
      "enum": [
        "csv",
        "json",
        "jsonl",
        "xlsx",
        "parquet"
      ]
    },
    "fields": {
      "description": "Fields to include",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "filter": {
      "description": "Record filter criteria",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "templateId": {
      "description": "Export template ID for field mappings",
      "type": "string"
    },
    "schedule": {
      "type": "object",
      "properties": {
        "cronExpression": {
          "type": "string",
          "description": "Cron expression for schedule"
        },
        "timezone": {
          "default": "UTC",
          "description": "IANA timezone",
          "type": "string"
        }
      },
      "required": [
        "cronExpression",
        "timezone"
      ],
      "additionalProperties": false,
      "description": "Schedule timing configuration"
    },
    "delivery": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "email",
            "storage",
            "webhook"
          ],
          "description": "How to deliver the export file"
        },
        "recipients": {
          "description": "Email recipients (for email delivery)",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "storagePath": {
          "description": "Storage path (for storage delivery)",
          "type": "string"
        },
        "webhookUrl": {
          "description": "Webhook URL (for webhook delivery)",
          "type": "string"
        }
      },
      "required": [
        "method"
      ],
      "additionalProperties": false,
      "description": "Export delivery configuration"
    }
  },
  "required": [
    "name",
    "object",
    "format",
    "schedule",
    "delivery"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/ScheduleExportRequest.json",
  "x-spec-version": "3.0.11"
}