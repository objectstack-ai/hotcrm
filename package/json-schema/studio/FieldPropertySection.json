{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Section key (e.g., \"basics\", \"constraints\", \"security\")"
    },
    "label": {
      "type": "string",
      "description": "Section display label"
    },
    "icon": {
      "description": "Lucide icon name",
      "type": "string"
    },
    "defaultExpanded": {
      "default": true,
      "description": "Whether section is expanded by default",
      "type": "boolean"
    },
    "order": {
      "default": 0,
      "description": "Sort order (lower = higher)",
      "type": "number"
    }
  },
  "required": [
    "key",
    "label",
    "defaultExpanded",
    "order"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/studio/FieldPropertySection.json",
  "x-spec-version": "3.0.11"
}