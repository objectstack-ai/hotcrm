{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "hotReload": {
      "default": true,
      "description": "Enable HMR / live-reload",
      "type": "boolean"
    },
    "requestInspector": {
      "default": false,
      "description": "Enable request inspector",
      "type": "boolean"
    },
    "dbExplorer": {
      "default": false,
      "description": "Enable database explorer UI",
      "type": "boolean"
    },
    "verboseLogging": {
      "default": true,
      "description": "Enable verbose logging",
      "type": "boolean"
    },
    "apiDocs": {
      "default": true,
      "description": "Serve OpenAPI docs at /_dev/docs",
      "type": "boolean"
    },
    "mailCatcher": {
      "default": false,
      "description": "Capture outbound emails in dev",
      "type": "boolean"
    }
  },
  "required": [
    "hotReload",
    "requestInspector",
    "dbExplorer",
    "verboseLogging",
    "apiDocs",
    "mailCatcher"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/DevToolsConfig.json",
  "x-spec-version": "3.0.11"
}