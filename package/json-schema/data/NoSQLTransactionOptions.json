{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "readConcern": {
      "description": "Read concern level",
      "type": "string",
      "enum": [
        "local",
        "majority",
        "linearizable",
        "snapshot"
      ]
    },
    "writeConcern": {
      "description": "Write concern level",
      "type": "string",
      "enum": [
        "majority",
        "acknowledged",
        "unacknowledged"
      ]
    },
    "readPreference": {
      "description": "Read preference",
      "type": "string",
      "enum": [
        "primary",
        "primaryPreferred",
        "secondary",
        "secondaryPreferred",
        "nearest"
      ]
    },
    "maxCommitTimeMS": {
      "description": "Transaction commit timeout (ms)",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/data/NoSQLTransactionOptions.json",
  "x-spec-version": "3.0.11"
}