{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$",
      "description": "Model unique identifier (snake_case)"
    },
    "label": {
      "type": "string",
      "description": "Model display name"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "classification",
        "regression",
        "clustering",
        "forecasting",
        "anomaly_detection",
        "recommendation",
        "ranking"
      ]
    },
    "algorithm": {
      "description": "Specific algorithm (e.g., \"random_forest\", \"xgboost\", \"lstm\")",
      "type": "string"
    },
    "objectName": {
      "type": "string",
      "description": "Target object for predictions"
    },
    "target": {
      "type": "string",
      "description": "Target field to predict"
    },
    "targetType": {
      "description": "Target field type",
      "type": "string",
      "enum": [
        "numeric",
        "categorical",
        "binary"
      ]
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_]*$",
            "description": "Feature name (snake_case)"
          },
          "label": {
            "description": "Human-readable label",
            "type": "string"
          },
          "field": {
            "type": "string",
            "description": "Source field name"
          },
          "object": {
            "description": "Source object (if different from target)",
            "type": "string"
          },
          "dataType": {
            "type": "string",
            "enum": [
              "numeric",
              "categorical",
              "text",
              "datetime",
              "boolean"
            ],
            "description": "Feature data type"
          },
          "transformation": {
            "default": "none",
            "type": "string",
            "enum": [
              "none",
              "normalize",
              "standardize",
              "one_hot_encode",
              "label_encode",
              "log_transform",
              "binning",
              "embedding"
            ]
          },
          "required": {
            "default": true,
            "type": "boolean"
          },
          "defaultValue": {},
          "description": {
            "type": "string"
          },
          "importance": {
            "description": "Feature importance score (0-1)",
            "type": "number"
          }
        },
        "required": [
          "name",
          "field",
          "dataType",
          "transformation",
          "required"
        ],
        "additionalProperties": false
      },
      "description": "Input features for the model"
    },
    "hyperparameters": {
      "type": "object",
      "properties": {
        "learningRate": {
          "description": "Learning rate for training",
          "type": "number"
        },
        "epochs": {
          "description": "Number of training epochs",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "batchSize": {
          "description": "Training batch size",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "maxDepth": {
          "description": "Maximum tree depth",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "numTrees": {
          "description": "Number of trees in ensemble",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "minSamplesSplit": {
          "description": "Minimum samples to split node",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "minSamplesLeaf": {
          "description": "Minimum samples in leaf node",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "hiddenLayers": {
          "description": "Hidden layer sizes",
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "activation": {
          "description": "Activation function",
          "type": "string"
        },
        "dropout": {
          "description": "Dropout rate",
          "type": "number"
        },
        "l1Regularization": {
          "description": "L1 regularization strength",
          "type": "number"
        },
        "l2Regularization": {
          "description": "L2 regularization strength",
          "type": "number"
        },
        "numClusters": {
          "description": "Number of clusters (k-means, etc.)",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "seasonalPeriod": {
          "description": "Seasonal period for time series",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "forecastHorizon": {
          "description": "Number of periods to forecast",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "custom": {
          "description": "Algorithm-specific parameters",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "additionalProperties": false
    },
    "training": {
      "type": "object",
      "properties": {
        "trainingDataRatio": {
          "default": 0.8,
          "description": "Proportion of data for training",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "validationDataRatio": {
          "default": 0.1,
          "description": "Proportion for validation",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "testDataRatio": {
          "default": 0.1,
          "description": "Proportion for testing",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dataFilter": {
          "description": "Formula to filter training data",
          "type": "string"
        },
        "minRecords": {
          "default": 100,
          "description": "Minimum records required",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "maxRecords": {
          "description": "Maximum records to use",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "strategy": {
          "default": "full",
          "type": "string",
          "enum": [
            "full",
            "incremental",
            "online",
            "transfer_learning"
          ]
        },
        "crossValidation": {
          "default": true,
          "type": "boolean"
        },
        "folds": {
          "default": 5,
          "description": "Cross-validation folds",
          "type": "integer",
          "minimum": 2,
          "maximum": 10
        },
        "earlyStoppingEnabled": {
          "default": true,
          "type": "boolean"
        },
        "earlyStoppingPatience": {
          "default": 10,
          "description": "Epochs without improvement before stopping",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "maxTrainingTime": {
          "description": "Maximum training time in seconds",
          "type": "number"
        },
        "gpuEnabled": {
          "default": false,
          "type": "boolean"
        },
        "randomSeed": {
          "description": "Random seed for reproducibility",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "trainingDataRatio",
        "validationDataRatio",
        "testDataRatio",
        "minRecords",
        "strategy",
        "crossValidation",
        "folds",
        "earlyStoppingEnabled",
        "earlyStoppingPatience",
        "gpuEnabled"
      ],
      "additionalProperties": false
    },
    "metrics": {
      "description": "Evaluation metrics from last training",
      "type": "object",
      "properties": {
        "accuracy": {
          "type": "number"
        },
        "precision": {
          "type": "number"
        },
        "recall": {
          "type": "number"
        },
        "f1Score": {
          "type": "number"
        },
        "auc": {
          "description": "Area Under ROC Curve",
          "type": "number"
        },
        "mse": {
          "description": "Mean Squared Error",
          "type": "number"
        },
        "rmse": {
          "description": "Root Mean Squared Error",
          "type": "number"
        },
        "mae": {
          "description": "Mean Absolute Error",
          "type": "number"
        },
        "r2Score": {
          "description": "R-squared score",
          "type": "number"
        },
        "silhouetteScore": {
          "type": "number"
        },
        "daviesBouldinIndex": {
          "type": "number"
        },
        "mape": {
          "description": "Mean Absolute Percentage Error",
          "type": "number"
        },
        "smape": {
          "description": "Symmetric MAPE",
          "type": "number"
        },
        "custom": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "additionalProperties": false
    },
    "deploymentStatus": {
      "default": "draft",
      "type": "string",
      "enum": [
        "draft",
        "training",
        "trained",
        "deployed",
        "deprecated"
      ]
    },
    "version": {
      "default": "1.0.0",
      "type": "string"
    },
    "predictionField": {
      "description": "Field to store predictions",
      "type": "string"
    },
    "confidenceField": {
      "description": "Field to store confidence scores",
      "type": "string"
    },
    "updateTrigger": {
      "default": "on_create",
      "type": "string",
      "enum": [
        "on_create",
        "on_update",
        "manual",
        "scheduled"
      ]
    },
    "autoRetrain": {
      "default": false,
      "type": "boolean"
    },
    "retrainSchedule": {
      "description": "Cron expression for auto-retraining",
      "type": "string"
    },
    "retrainThreshold": {
      "description": "Performance threshold to trigger retraining",
      "type": "number"
    },
    "enableExplainability": {
      "default": false,
      "description": "Generate feature importance & explanations",
      "type": "boolean"
    },
    "enableMonitoring": {
      "default": true,
      "type": "boolean"
    },
    "alertOnDrift": {
      "default": true,
      "description": "Alert when model drift is detected",
      "type": "boolean"
    },
    "active": {
      "default": true,
      "type": "boolean"
    },
    "owner": {
      "description": "User ID of model owner",
      "type": "string"
    },
    "permissions": {
      "description": "User/group IDs with access",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "description": "Model category (e.g., \"sales\", \"marketing\", \"operations\")",
      "type": "string"
    },
    "lastTrainedAt": {
      "description": "ISO timestamp",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "createdAt": {
      "description": "ISO timestamp",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "updatedAt": {
      "description": "ISO timestamp",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "name",
    "label",
    "type",
    "objectName",
    "target",
    "features",
    "deploymentStatus",
    "version",
    "updateTrigger",
    "autoRetrain",
    "enableExplainability",
    "enableMonitoring",
    "alertOnDrift",
    "active"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/PredictiveModel.json",
  "x-spec-version": "3.0.11"
}