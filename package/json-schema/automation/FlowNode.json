{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Node unique ID"
    },
    "type": {
      "type": "string",
      "enum": [
        "start",
        "end",
        "decision",
        "assignment",
        "loop",
        "create_record",
        "update_record",
        "delete_record",
        "get_record",
        "http_request",
        "script",
        "screen",
        "wait",
        "subflow",
        "connector_action",
        "parallel_gateway",
        "join_gateway",
        "boundary_event"
      ],
      "description": "Action type"
    },
    "label": {
      "type": "string",
      "description": "Node label"
    },
    "config": {
      "description": "Node configuration",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "connectorConfig": {
      "type": "object",
      "properties": {
        "connectorId": {
          "type": "string"
        },
        "actionId": {
          "type": "string"
        },
        "input": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {},
          "description": "Mapped inputs for the action"
        }
      },
      "required": [
        "connectorId",
        "actionId",
        "input"
      ],
      "additionalProperties": false
    },
    "position": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "timeoutMs": {
      "description": "Maximum execution time for this node in milliseconds",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "inputSchema": {
      "description": "Input parameter schema for this node",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "boolean",
              "object",
              "array"
            ],
            "description": "Parameter type"
          },
          "required": {
            "default": false,
            "description": "Whether the parameter is required",
            "type": "boolean"
          },
          "description": {
            "description": "Parameter description",
            "type": "string"
          }
        },
        "required": [
          "type",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "outputSchema": {
      "description": "Output schema declaration for this node",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "boolean",
              "object",
              "array"
            ],
            "description": "Output type"
          },
          "description": {
            "description": "Output description",
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false
      }
    },
    "waitEventConfig": {
      "description": "Configuration for wait node event resumption",
      "type": "object",
      "properties": {
        "eventType": {
          "type": "string",
          "enum": [
            "timer",
            "signal",
            "webhook",
            "manual",
            "condition"
          ],
          "description": "What kind of event resumes the execution"
        },
        "timerDuration": {
          "description": "ISO 8601 duration (e.g., \"PT1H\") or wait time for timer events",
          "type": "string"
        },
        "signalName": {
          "description": "Named signal or webhook event to wait for",
          "type": "string"
        },
        "timeoutMs": {
          "description": "Maximum wait time before timeout (ms)",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "onTimeout": {
          "default": "fail",
          "description": "Behavior when the wait times out",
          "type": "string",
          "enum": [
            "fail",
            "continue"
          ]
        }
      },
      "required": [
        "eventType",
        "onTimeout"
      ],
      "additionalProperties": false
    },
    "boundaryConfig": {
      "description": "Configuration for boundary events attached to host nodes",
      "type": "object",
      "properties": {
        "attachedToNodeId": {
          "type": "string",
          "description": "Host node ID this boundary event monitors"
        },
        "eventType": {
          "type": "string",
          "enum": [
            "error",
            "timer",
            "signal",
            "cancel"
          ],
          "description": "Boundary event trigger type"
        },
        "interrupting": {
          "default": true,
          "description": "If true, the host activity is cancelled when this event fires",
          "type": "boolean"
        },
        "errorCode": {
          "description": "Specific error code to catch (empty = catch all errors)",
          "type": "string"
        },
        "timerDuration": {
          "description": "ISO 8601 duration for timer boundary events",
          "type": "string"
        },
        "signalName": {
          "description": "Named signal to catch",
          "type": "string"
        }
      },
      "required": [
        "attachedToNodeId",
        "eventType",
        "interrupting"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "type",
    "label"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/automation/FlowNode.json",
  "x-spec-version": "3.0.11"
}