{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "subscriptionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "Unique subscription identifier"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z*][a-z0-9_.*]*$",
        "description": "Event pattern (supports wildcards like \"record.*\" or \"*.created\")"
      },
      "description": "Event patterns to subscribe to (supports wildcards, e.g., \"record.*\", \"user.created\")"
    },
    "objects": {
      "description": "Object names to filter events by (e.g., [\"account\", \"contact\"])",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "filters": {
      "description": "Advanced filter conditions for event payloads",
      "$ref": "#/$defs/__schema0"
    },
    "channels": {
      "description": "Channel names for scoped subscriptions",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "subscriptionId",
    "events"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "conditions": {
          "description": "Array of filter conditions",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "description": "Field path to filter on (supports dot notation, e.g., \"user.email\")"
              },
              "operator": {
                "type": "string",
                "enum": [
                  "eq",
                  "ne",
                  "gt",
                  "gte",
                  "lt",
                  "lte",
                  "in",
                  "nin",
                  "contains",
                  "startsWith",
                  "endsWith",
                  "exists",
                  "regex"
                ],
                "description": "Comparison operator"
              },
              "value": {
                "description": "Value to compare against (not needed for \"exists\" operator)"
              }
            },
            "required": [
              "field",
              "operator"
            ],
            "additionalProperties": false
          }
        },
        "and": {
          "description": "AND logical combination of filters",
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "or": {
          "description": "OR logical combination of filters",
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "not": {
          "description": "NOT logical negation of filter",
          "$ref": "#/$defs/__schema0"
        }
      },
      "additionalProperties": false
    }
  },
  "$id": "https://schema.objectstack.io/v3.0.11/api/EventSubscription.json",
  "x-spec-version": "3.0.11"
}