{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "description": "Minimum severity to trigger notification"
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "email",
          "sms",
          "slack",
          "pagerduty",
          "webhook"
        ]
      },
      "description": "Notification channels"
    },
    "recipients": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Roles or teams to notify"
    },
    "withinMinutes": {
      "type": "number",
      "minimum": 1,
      "description": "Notification deadline in minutes from detection"
    },
    "notifyRegulators": {
      "default": false,
      "description": "Whether to notify regulatory authorities",
      "type": "boolean"
    },
    "regulatorDeadlineHours": {
      "description": "Regulatory notification deadline in hours",
      "type": "number"
    }
  },
  "required": [
    "severity",
    "channels",
    "recipients",
    "withinMinutes",
    "notifyRegulators"
  ],
  "additionalProperties": false,
  "description": "Incident notification rule per severity level",
  "$id": "https://schema.objectstack.io/v3.0.11/system/IncidentNotificationRule.json",
  "x-spec-version": "3.0.11"
}