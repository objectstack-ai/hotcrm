{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "titleTemplate": {
      "description": "PR title template",
      "type": "string"
    },
    "bodyTemplate": {
      "description": "PR body template",
      "type": "string"
    },
    "defaultReviewers": {
      "description": "Default reviewers (usernames)",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "defaultAssignees": {
      "description": "Default assignees (usernames)",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "defaultLabels": {
      "description": "Default labels",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "draftByDefault": {
      "default": false,
      "description": "Create draft PRs by default",
      "type": "boolean"
    },
    "deleteHeadBranch": {
      "default": true,
      "description": "Delete head branch after merge",
      "type": "boolean"
    }
  },
  "required": [
    "draftByDefault",
    "deleteHeadBranch"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/integration/GitHubPullRequestConfig.json",
  "x-spec-version": "3.0.11"
}