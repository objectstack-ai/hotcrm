{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "strategy": {
      "type": "string",
      "const": "isolated_schema",
      "description": "Schema-level isolation strategy"
    },
    "schema": {
      "description": "Schema configuration",
      "type": "object",
      "properties": {
        "namingPattern": {
          "default": "tenant_{tenant_id}",
          "description": "Schema naming pattern",
          "type": "string"
        },
        "includePublicSchema": {
          "default": true,
          "description": "Include public schema",
          "type": "boolean"
        },
        "sharedSchema": {
          "default": "public",
          "description": "Schema for shared resources",
          "type": "string"
        },
        "autoCreateSchema": {
          "default": true,
          "description": "Auto-create schema",
          "type": "boolean"
        }
      },
      "required": [
        "namingPattern",
        "includePublicSchema",
        "sharedSchema",
        "autoCreateSchema"
      ],
      "additionalProperties": false
    },
    "migrations": {
      "description": "Migration configuration",
      "type": "object",
      "properties": {
        "strategy": {
          "default": "parallel",
          "description": "Migration strategy",
          "type": "string",
          "enum": [
            "parallel",
            "sequential",
            "on_demand"
          ]
        },
        "maxConcurrent": {
          "default": 10,
          "description": "Max concurrent migrations",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "rollbackOnError": {
          "default": true,
          "description": "Rollback on error",
          "type": "boolean"
        }
      },
      "required": [
        "strategy",
        "maxConcurrent",
        "rollbackOnError"
      ],
      "additionalProperties": false
    },
    "performance": {
      "description": "Performance settings",
      "type": "object",
      "properties": {
        "poolPerSchema": {
          "default": false,
          "description": "Separate pool per schema",
          "type": "boolean"
        },
        "schemaCacheTTL": {
          "default": 3600,
          "description": "Schema cache TTL",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "poolPerSchema",
        "schemaCacheTTL"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "strategy"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/system/LevelIsolationStrategySchema.json",
  "x-spec-version": "3.0.11"
}