{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "algorithm": {
      "default": "RSA-SHA256",
      "description": "Signing algorithm used",
      "type": "string",
      "enum": [
        "RSA-SHA256",
        "RSA-SHA384",
        "RSA-SHA512",
        "ECDSA-SHA256"
      ]
    },
    "publicKeyRef": {
      "type": "string",
      "description": "Public key reference (URL or fingerprint) for signature verification"
    },
    "signature": {
      "type": "string",
      "description": "Base64-encoded digital signature"
    },
    "signedAt": {
      "description": "ISO 8601 timestamp of when the artifact was signed",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "signedBy": {
      "description": "Identity of the signer (publisher ID or email)",
      "type": "string"
    }
  },
  "required": [
    "algorithm",
    "publicKeyRef",
    "signature"
  ],
  "additionalProperties": false,
  "description": "Digital signature for artifact authenticity verification",
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/ArtifactSignature.json",
  "x-spec-version": "3.0.11"
}