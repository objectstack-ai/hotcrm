# No trailing slash. `node_modules/` matches directories only, so a *symlink*
# named `node_modules` — what a containerised checkout leaves behind when deps
# live outside the tree — is a plain blob to git and slips past the ignore. One
# got committed that way, and CI died on `ERR_PNPM_ENOENT … mkdir
# node_modules/@objectstack`: checkout restores a dangling symlink and pnpm
# cannot mkdir through it.
node_modules
dist/
.env
*.log
.DS_Store
coverage/
.vscode/
.idea/
*.swp
*.swo
*~
.cache/
tmp/

# Monorepo specific
packages/*/node_modules
packages/*/dist/
packages/*/.turbo/
.pnpm-store/

# TypeScript build info
*.tsbuildinfo
*.backup

# Build artifacts (compiled .js from .ts in source)
packages/server/objectstack.config.js

# Vercel
.vercel/
*.tgz
package/

# SPA static assets copied during Vercel build (build artifacts, not source)
public/console/
public/_studio/

.objectstack
# Playwright MCP browser artifacts (transient screenshots/snapshots/logs)
.playwright-mcp/

# Test outputs
test-results/
playwright-report/
*.v0.bak
