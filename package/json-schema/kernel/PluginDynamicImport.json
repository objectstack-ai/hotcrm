{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": true,
      "type": "boolean"
    },
    "mode": {
      "default": "async",
      "type": "string",
      "enum": [
        "async",
        "sync",
        "eager",
        "lazy"
      ]
    },
    "prefetch": {
      "default": false,
      "description": "Prefetch module in idle time",
      "type": "boolean"
    },
    "preload": {
      "default": false,
      "description": "Preload module in parallel with parent",
      "type": "boolean"
    },
    "webpackChunkName": {
      "description": "Custom chunk name for webpack",
      "type": "string"
    },
    "timeout": {
      "default": 30000,
      "description": "Dynamic import timeout (ms)",
      "type": "integer",
      "minimum": 100,
      "maximum": 9007199254740991
    },
    "retry": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "maxAttempts": {
          "default": 3,
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "backoffMs": {
          "default": 1000,
          "description": "Exponential backoff base delay",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "enabled",
        "maxAttempts",
        "backoffMs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "enabled",
    "mode",
    "prefetch",
    "preload",
    "timeout"
  ],
  "additionalProperties": false,
  "description": "Plugin dynamic import configuration",
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/PluginDynamicImport.json",
  "x-spec-version": "3.0.11"
}