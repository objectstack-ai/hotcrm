{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$",
      "description": "Metric name (snake_case)"
    },
    "label": {
      "description": "Display label",
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "counter",
        "gauge",
        "histogram",
        "summary"
      ],
      "description": "Metric type"
    },
    "unit": {
      "description": "Metric unit",
      "type": "string",
      "enum": [
        "nanoseconds",
        "microseconds",
        "milliseconds",
        "seconds",
        "minutes",
        "hours",
        "days",
        "bytes",
        "kilobytes",
        "megabytes",
        "gigabytes",
        "terabytes",
        "requests_per_second",
        "events_per_second",
        "bytes_per_second",
        "percent",
        "ratio",
        "count",
        "operations",
        "custom"
      ]
    },
    "description": {
      "description": "Metric description",
      "type": "string"
    },
    "labelNames": {
      "default": [],
      "description": "Label names",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "histogram": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "linear",
            "exponential",
            "explicit"
          ],
          "description": "Bucket type"
        },
        "linear": {
          "type": "object",
          "properties": {
            "start": {
              "type": "number",
              "description": "Start value"
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Bucket width"
            },
            "count": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "Number of buckets"
            }
          },
          "required": [
            "start",
            "width",
            "count"
          ],
          "additionalProperties": false
        },
        "exponential": {
          "type": "object",
          "properties": {
            "start": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Start value"
            },
            "factor": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Growth factor"
            },
            "count": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "Number of buckets"
            }
          },
          "required": [
            "start",
            "factor",
            "count"
          ],
          "additionalProperties": false
        },
        "explicit": {
          "type": "object",
          "properties": {
            "boundaries": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "description": "Bucket boundaries"
            }
          },
          "required": [
            "boundaries"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "description": "Histogram bucket configuration"
    },
    "summary": {
      "type": "object",
      "properties": {
        "quantiles": {
          "default": [
            0.5,
            0.9,
            0.99
          ],
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "maxAge": {
          "default": 600,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "ageBuckets": {
          "default": 5,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "quantiles",
        "maxAge",
        "ageBuckets"
      ],
      "additionalProperties": false
    },
    "enabled": {
      "default": true,
      "type": "boolean"
    }
  },
  "required": [
    "name",
    "type",
    "labelNames",
    "enabled"
  ],
  "additionalProperties": false,
  "description": "Metric definition",
  "$id": "https://schema.objectstack.io/v3.0.11/system/MetricDefinition.json",
  "x-spec-version": "3.0.11"
}