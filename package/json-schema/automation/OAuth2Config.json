{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "authorizationUrl": {
      "type": "string",
      "format": "uri",
      "description": "Authorization endpoint URL"
    },
    "tokenUrl": {
      "type": "string",
      "format": "uri",
      "description": "Token endpoint URL"
    },
    "scopes": {
      "description": "OAuth scopes",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "clientIdField": {
      "default": "client_id",
      "description": "Client ID field name",
      "type": "string"
    },
    "clientSecretField": {
      "default": "client_secret",
      "description": "Client secret field name",
      "type": "string"
    }
  },
  "required": [
    "authorizationUrl",
    "tokenUrl",
    "clientIdField",
    "clientSecretField"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/automation/OAuth2Config.json",
  "x-spec-version": "3.0.11"
}