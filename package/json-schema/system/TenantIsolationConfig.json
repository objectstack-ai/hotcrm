{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "const": "shared_schema",
          "description": "Row-level isolation strategy"
        },
        "database": {
          "description": "Database configuration",
          "type": "object",
          "properties": {
            "enableRLS": {
              "default": true,
              "description": "Enable PostgreSQL Row-Level Security",
              "type": "boolean"
            },
            "contextMethod": {
              "default": "session_variable",
              "description": "How to set tenant context",
              "type": "string",
              "enum": [
                "session_variable",
                "search_path",
                "application_name"
              ]
            },
            "contextVariable": {
              "default": "app.current_tenant",
              "description": "Session variable name",
              "type": "string"
            },
            "applicationValidation": {
              "default": true,
              "description": "Application-level tenant validation",
              "type": "boolean"
            }
          },
          "required": [
            "enableRLS",
            "contextMethod",
            "contextVariable",
            "applicationValidation"
          ],
          "additionalProperties": false
        },
        "performance": {
          "description": "Performance settings",
          "type": "object",
          "properties": {
            "usePartialIndexes": {
              "default": true,
              "description": "Use partial indexes per tenant",
              "type": "boolean"
            },
            "usePartitioning": {
              "default": false,
              "description": "Use table partitioning by tenant_id",
              "type": "boolean"
            },
            "poolSizePerTenant": {
              "description": "Connection pool size per tenant",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "usePartialIndexes",
            "usePartitioning"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "strategy"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "const": "isolated_schema",
          "description": "Schema-level isolation strategy"
        },
        "schema": {
          "description": "Schema configuration",
          "type": "object",
          "properties": {
            "namingPattern": {
              "default": "tenant_{tenant_id}",
              "description": "Schema naming pattern",
              "type": "string"
            },
            "includePublicSchema": {
              "default": true,
              "description": "Include public schema",
              "type": "boolean"
            },
            "sharedSchema": {
              "default": "public",
              "description": "Schema for shared resources",
              "type": "string"
            },
            "autoCreateSchema": {
              "default": true,
              "description": "Auto-create schema",
              "type": "boolean"
            }
          },
          "required": [
            "namingPattern",
            "includePublicSchema",
            "sharedSchema",
            "autoCreateSchema"
          ],
          "additionalProperties": false
        },
        "migrations": {
          "description": "Migration configuration",
          "type": "object",
          "properties": {
            "strategy": {
              "default": "parallel",
              "description": "Migration strategy",
              "type": "string",
              "enum": [
                "parallel",
                "sequential",
                "on_demand"
              ]
            },
            "maxConcurrent": {
              "default": 10,
              "description": "Max concurrent migrations",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "rollbackOnError": {
              "default": true,
              "description": "Rollback on error",
              "type": "boolean"
            }
          },
          "required": [
            "strategy",
            "maxConcurrent",
            "rollbackOnError"
          ],
          "additionalProperties": false
        },
        "performance": {
          "description": "Performance settings",
          "type": "object",
          "properties": {
            "poolPerSchema": {
              "default": false,
              "description": "Separate pool per schema",
              "type": "boolean"
            },
            "schemaCacheTTL": {
              "default": 3600,
              "description": "Schema cache TTL",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "poolPerSchema",
            "schemaCacheTTL"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "strategy"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "const": "isolated_db",
          "description": "Database-level isolation strategy"
        },
        "database": {
          "description": "Database configuration",
          "type": "object",
          "properties": {
            "namingPattern": {
              "default": "tenant_{tenant_id}",
              "description": "Database naming pattern",
              "type": "string"
            },
            "serverStrategy": {
              "default": "shared",
              "description": "Server assignment strategy",
              "type": "string",
              "enum": [
                "shared",
                "sharded",
                "dedicated"
              ]
            },
            "separateCredentials": {
              "default": true,
              "description": "Separate credentials per tenant",
              "type": "boolean"
            },
            "autoCreateDatabase": {
              "default": true,
              "description": "Auto-create database",
              "type": "boolean"
            }
          },
          "required": [
            "namingPattern",
            "serverStrategy",
            "separateCredentials",
            "autoCreateDatabase"
          ],
          "additionalProperties": false
        },
        "connectionPool": {
          "description": "Connection pool configuration",
          "type": "object",
          "properties": {
            "poolSize": {
              "default": 10,
              "description": "Connection pool size",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxActivePools": {
              "default": 100,
              "description": "Max active pools",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "idleTimeout": {
              "default": 300,
              "description": "Idle pool timeout",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "usePooler": {
              "default": true,
              "description": "Use connection pooler",
              "type": "boolean"
            }
          },
          "required": [
            "poolSize",
            "maxActivePools",
            "idleTimeout",
            "usePooler"
          ],
          "additionalProperties": false
        },
        "backup": {
          "description": "Backup configuration",
          "type": "object",
          "properties": {
            "strategy": {
              "default": "individual",
              "description": "Backup strategy",
              "type": "string",
              "enum": [
                "individual",
                "consolidated",
                "on_demand"
              ]
            },
            "frequencyHours": {
              "default": 24,
              "description": "Backup frequency",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "retentionDays": {
              "default": 30,
              "description": "Backup retention days",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "strategy",
            "frequencyHours",
            "retentionDays"
          ],
          "additionalProperties": false
        },
        "encryption": {
          "description": "Encryption configuration",
          "type": "object",
          "properties": {
            "perTenantKeys": {
              "default": false,
              "description": "Per-tenant encryption keys",
              "type": "boolean"
            },
            "algorithm": {
              "default": "AES-256-GCM",
              "description": "Encryption algorithm",
              "type": "string"
            },
            "keyManagement": {
              "description": "Key management service",
              "type": "string",
              "enum": [
                "aws_kms",
                "azure_key_vault",
                "gcp_kms",
                "hashicorp_vault",
                "custom"
              ]
            }
          },
          "required": [
            "perTenantKeys",
            "algorithm"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "strategy"
      ],
      "additionalProperties": false
    }
  ],
  "$id": "https://schema.objectstack.io/v3.0.11/system/TenantIsolationConfig.json",
  "x-spec-version": "3.0.11"
}