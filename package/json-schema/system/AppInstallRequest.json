{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "description": "Target tenant ID"
    },
    "appId": {
      "type": "string",
      "minLength": 1,
      "description": "App identifier"
    },
    "configOverrides": {
      "description": "Configuration overrides",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "skipSeedData": {
      "default": false,
      "description": "Skip seed data population",
      "type": "boolean"
    }
  },
  "required": [
    "tenantId",
    "appId",
    "skipSeedData"
  ],
  "additionalProperties": false,
  "description": "App install request",
  "$id": "https://schema.objectstack.io/v3.0.11/system/AppInstallRequest.json",
  "x-spec-version": "3.0.11"
}