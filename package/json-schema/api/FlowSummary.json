{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Flow machine name"
    },
    "label": {
      "type": "string",
      "description": "Flow display label"
    },
    "type": {
      "type": "string",
      "description": "Flow type"
    },
    "status": {
      "type": "string",
      "description": "Flow deployment status"
    },
    "version": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "description": "Flow version number"
    },
    "enabled": {
      "type": "boolean",
      "description": "Whether the flow is enabled for execution"
    },
    "nodeCount": {
      "description": "Number of nodes in the flow",
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "lastRunAt": {
      "description": "Last execution timestamp",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "name",
    "label",
    "type",
    "status",
    "version",
    "enabled"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/FlowSummary.json",
  "x-spec-version": "3.0.11"
}