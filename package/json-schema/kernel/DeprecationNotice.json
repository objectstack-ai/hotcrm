{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "feature": {
      "type": "string",
      "description": "Deprecated feature identifier"
    },
    "deprecatedIn": {
      "type": "string"
    },
    "removeIn": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "alternative": {
      "description": "What to use instead",
      "type": "string"
    },
    "migrationPath": {
      "description": "How to migrate to alternative",
      "type": "string"
    }
  },
  "required": [
    "feature",
    "deprecatedIn",
    "reason"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/DeprecationNotice.json",
  "x-spec-version": "3.0.11"
}