{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "label": {
      "description": "Accessible label for the drop zone",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Translation key (e.g., \"views.task_list.label\")"
            },
            "defaultValue": {
              "description": "Fallback value when translation key is not found",
              "type": "string"
            },
            "params": {
              "description": "Interpolation parameters (e.g., { count: 5 })",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        }
      ]
    },
    "accept": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Accepted drag item types"
    },
    "maxItems": {
      "description": "Maximum items allowed in drop zone",
      "type": "number"
    },
    "highlightOnDragOver": {
      "default": true,
      "description": "Highlight drop zone when dragging over",
      "type": "boolean"
    },
    "dropEffect": {
      "default": "move",
      "description": "Visual effect on drop",
      "type": "string",
      "enum": [
        "move",
        "copy",
        "link",
        "none"
      ]
    },
    "ariaLabel": {
      "description": "Accessible label for screen readers (WAI-ARIA aria-label)",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Translation key (e.g., \"views.task_list.label\")"
            },
            "defaultValue": {
              "description": "Fallback value when translation key is not found",
              "type": "string"
            },
            "params": {
              "description": "Interpolation parameters (e.g., { count: 5 })",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ariaDescribedBy": {
      "description": "ID of element providing additional description (WAI-ARIA aria-describedby)",
      "type": "string"
    },
    "role": {
      "description": "WAI-ARIA role attribute (e.g., \"dialog\", \"navigation\", \"alert\")",
      "type": "string"
    }
  },
  "required": [
    "accept",
    "highlightOnDragOver",
    "dropEffect"
  ],
  "additionalProperties": false,
  "description": "Drop zone configuration",
  "$id": "https://schema.objectstack.io/v3.0.11/ui/DropZone.json",
  "x-spec-version": "3.0.11"
}