{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string"
    },
    "totalMessages": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "userMessages": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "assistantMessages": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "systemMessages": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "totalTokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "averageTokensPerMessage": {
      "type": "number",
      "minimum": 0
    },
    "peakTokenUsage": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "pruningEvents": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "summarizationEvents": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tokensSavedByPruning": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tokensSavedBySummarization": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "duration": {
      "description": "Session duration in seconds",
      "type": "number",
      "minimum": 0
    },
    "firstMessageAt": {
      "description": "ISO 8601 timestamp",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "lastMessageAt": {
      "description": "ISO 8601 timestamp",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "sessionId",
    "totalMessages",
    "userMessages",
    "assistantMessages",
    "systemMessages",
    "totalTokens",
    "averageTokensPerMessage",
    "peakTokenUsage",
    "pruningEvents",
    "summarizationEvents",
    "tokensSavedByPruning",
    "tokensSavedBySummarization"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/ConversationAnalytics.json",
  "x-spec-version": "3.0.11"
}