{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "dimensions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000,
      "description": "Vector dimensionality (e.g., 1536 for OpenAI embeddings)"
    },
    "distanceMetric": {
      "default": "cosine",
      "description": "Distance/similarity metric for vector search",
      "type": "string",
      "enum": [
        "cosine",
        "euclidean",
        "dotProduct",
        "manhattan"
      ]
    },
    "normalized": {
      "default": false,
      "description": "Whether vectors are normalized (unit length)",
      "type": "boolean"
    },
    "indexed": {
      "default": true,
      "description": "Whether to create a vector index for fast similarity search",
      "type": "boolean"
    },
    "indexType": {
      "description": "Vector index algorithm (HNSW for high accuracy, IVFFlat for large datasets)",
      "type": "string",
      "enum": [
        "hnsw",
        "ivfflat",
        "flat"
      ]
    }
  },
  "required": [
    "dimensions",
    "distanceMetric",
    "normalized",
    "indexed"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/data/VectorConfig.json",
  "x-spec-version": "3.0.11"
}