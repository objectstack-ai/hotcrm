{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "strategy": {
      "type": "string",
      "const": "isolated_db",
      "description": "Database-level isolation strategy"
    },
    "database": {
      "description": "Database configuration",
      "type": "object",
      "properties": {
        "namingPattern": {
          "default": "tenant_{tenant_id}",
          "description": "Database naming pattern",
          "type": "string"
        },
        "serverStrategy": {
          "default": "shared",
          "description": "Server assignment strategy",
          "type": "string",
          "enum": [
            "shared",
            "sharded",
            "dedicated"
          ]
        },
        "separateCredentials": {
          "default": true,
          "description": "Separate credentials per tenant",
          "type": "boolean"
        },
        "autoCreateDatabase": {
          "default": true,
          "description": "Auto-create database",
          "type": "boolean"
        }
      },
      "required": [
        "namingPattern",
        "serverStrategy",
        "separateCredentials",
        "autoCreateDatabase"
      ],
      "additionalProperties": false
    },
    "connectionPool": {
      "description": "Connection pool configuration",
      "type": "object",
      "properties": {
        "poolSize": {
          "default": 10,
          "description": "Connection pool size",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxActivePools": {
          "default": 100,
          "description": "Max active pools",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "idleTimeout": {
          "default": 300,
          "description": "Idle pool timeout",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "usePooler": {
          "default": true,
          "description": "Use connection pooler",
          "type": "boolean"
        }
      },
      "required": [
        "poolSize",
        "maxActivePools",
        "idleTimeout",
        "usePooler"
      ],
      "additionalProperties": false
    },
    "backup": {
      "description": "Backup configuration",
      "type": "object",
      "properties": {
        "strategy": {
          "default": "individual",
          "description": "Backup strategy",
          "type": "string",
          "enum": [
            "individual",
            "consolidated",
            "on_demand"
          ]
        },
        "frequencyHours": {
          "default": 24,
          "description": "Backup frequency",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "retentionDays": {
          "default": 30,
          "description": "Backup retention days",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "strategy",
        "frequencyHours",
        "retentionDays"
      ],
      "additionalProperties": false
    },
    "encryption": {
      "description": "Encryption configuration",
      "type": "object",
      "properties": {
        "perTenantKeys": {
          "default": false,
          "description": "Per-tenant encryption keys",
          "type": "boolean"
        },
        "algorithm": {
          "default": "AES-256-GCM",
          "description": "Encryption algorithm",
          "type": "string"
        },
        "keyManagement": {
          "description": "Key management service",
          "type": "string",
          "enum": [
            "aws_kms",
            "azure_key_vault",
            "gcp_kms",
            "hashicorp_vault",
            "custom"
          ]
        }
      },
      "required": [
        "perTenantKeys",
        "algorithm"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "strategy"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/system/DatabaseLevelIsolationStrategy.json",
  "x-spec-version": "3.0.11"
}