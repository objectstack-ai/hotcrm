{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "object",
        "field",
        "value",
        "operator",
        "function",
        "timeframe"
      ]
    },
    "text": {
      "type": "string",
      "description": "Original text from query"
    },
    "value": {
      "description": "Normalized value"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence score"
    },
    "span": {
      "description": "Character span in query",
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ]
    }
  },
  "required": [
    "type",
    "text",
    "value",
    "confidence"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/Entity.json",
  "x-spec-version": "3.0.11"
}