{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "description": "Enable Change Data Capture"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "insert",
          "update",
          "delete"
        ]
      },
      "description": "Event types to capture"
    },
    "destination": {
      "type": "string",
      "description": "Destination endpoint (e.g., \"kafka://topic\", \"webhook://url\")"
    }
  },
  "required": [
    "enabled",
    "events",
    "destination"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/data/CDCConfig.json",
  "x-spec-version": "3.0.11"
}