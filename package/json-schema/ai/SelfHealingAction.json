{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "restart",
        "scale",
        "rollback",
        "clear-cache",
        "adjust-config",
        "execute-script",
        "notify"
      ]
    },
    "trigger": {
      "type": "object",
      "properties": {
        "healthStatus": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "healthy",
              "degraded",
              "unhealthy",
              "failed",
              "recovering",
              "unknown"
            ],
            "description": "Current health status of the plugin"
          }
        },
        "anomalyTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "errorPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "customCondition": {
          "description": "Custom trigger condition (e.g., \"errorRate > 0.1\")",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "parameters": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "maxAttempts": {
      "default": 3,
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "cooldown": {
      "default": 60,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "timeout": {
      "default": 300,
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "requireApproval": {
      "default": false,
      "type": "boolean"
    },
    "priority": {
      "default": 5,
      "description": "Action priority (lower number = higher priority)",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "type",
    "trigger",
    "maxAttempts",
    "cooldown",
    "timeout",
    "requireApproval",
    "priority"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/SelfHealingAction.json",
  "x-spec-version": "3.0.11"
}