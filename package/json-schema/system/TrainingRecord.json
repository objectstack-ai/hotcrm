{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "courseId": {
      "type": "string",
      "description": "Training course identifier"
    },
    "userId": {
      "type": "string",
      "description": "User identifier"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed",
        "failed",
        "expired"
      ],
      "description": "Training completion status"
    },
    "assignedAt": {
      "type": "number",
      "description": "Assignment timestamp"
    },
    "completedAt": {
      "description": "Completion timestamp",
      "type": "number"
    },
    "score": {
      "description": "Assessment score percentage",
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "expiresAt": {
      "description": "Certification expiry timestamp",
      "type": "number"
    },
    "notes": {
      "description": "Training notes or comments",
      "type": "string"
    }
  },
  "required": [
    "courseId",
    "userId",
    "status",
    "assignedAt"
  ],
  "additionalProperties": false,
  "description": "Individual training completion record",
  "$id": "https://schema.objectstack.io/v3.0.11/system/TrainingRecord.json",
  "x-spec-version": "3.0.11"
}