{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "accessKeyId": {
      "description": "AWS access key ID or MinIO access key",
      "type": "string"
    },
    "secretAccessKey": {
      "description": "AWS secret access key or MinIO secret key",
      "type": "string"
    },
    "sessionToken": {
      "description": "AWS session token for temporary credentials",
      "type": "string"
    },
    "accountName": {
      "description": "Azure storage account name",
      "type": "string"
    },
    "accountKey": {
      "description": "Azure storage account key",
      "type": "string"
    },
    "sasToken": {
      "description": "Azure SAS token",
      "type": "string"
    },
    "projectId": {
      "description": "GCP project ID",
      "type": "string"
    },
    "credentials": {
      "description": "GCP service account credentials JSON",
      "type": "string"
    },
    "endpoint": {
      "description": "Custom endpoint URL",
      "type": "string"
    },
    "region": {
      "description": "Default region",
      "type": "string"
    },
    "useSSL": {
      "default": true,
      "description": "Use SSL/TLS for connections",
      "type": "boolean"
    },
    "timeout": {
      "description": "Connection timeout in milliseconds",
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "useSSL"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/system/StorageConnection.json",
  "x-spec-version": "3.0.11"
}