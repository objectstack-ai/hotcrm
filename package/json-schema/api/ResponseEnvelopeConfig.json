{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": true,
      "description": "Enable automatic response envelope wrapping",
      "type": "boolean"
    },
    "includeMetadata": {
      "default": true,
      "description": "Include meta object in responses",
      "type": "boolean"
    },
    "includeTimestamp": {
      "default": true,
      "description": "Include timestamp in response metadata",
      "type": "boolean"
    },
    "includeRequestId": {
      "default": true,
      "description": "Include requestId in response metadata",
      "type": "boolean"
    },
    "includeDuration": {
      "default": false,
      "description": "Include request duration in ms",
      "type": "boolean"
    },
    "includeTraceId": {
      "default": false,
      "description": "Include distributed traceId",
      "type": "boolean"
    },
    "customMetadata": {
      "description": "Additional metadata fields to include",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "skipIfWrapped": {
      "default": true,
      "description": "Skip wrapping if response already has success field",
      "type": "boolean"
    }
  },
  "required": [
    "enabled",
    "includeMetadata",
    "includeTimestamp",
    "includeRequestId",
    "includeDuration",
    "includeTraceId",
    "skipIfWrapped"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/ResponseEnvelopeConfig.json",
  "x-spec-version": "3.0.11"
}