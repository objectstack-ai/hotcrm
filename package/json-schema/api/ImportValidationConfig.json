{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mode": {
      "default": "strict",
      "description": "Validation mode for the import",
      "type": "string",
      "enum": [
        "strict",
        "lenient",
        "dry_run"
      ]
    },
    "deduplication": {
      "description": "Deduplication configuration",
      "type": "object",
      "properties": {
        "strategy": {
          "default": "skip",
          "description": "How to handle duplicate records",
          "type": "string",
          "enum": [
            "skip",
            "update",
            "create_new",
            "fail"
          ]
        },
        "matchFields": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Fields used to identify duplicates (e.g., \"email\", \"external_id\")"
        }
      },
      "required": [
        "strategy",
        "matchFields"
      ],
      "additionalProperties": false
    },
    "maxErrors": {
      "default": 100,
      "description": "Maximum validation errors before aborting",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "trimWhitespace": {
      "default": true,
      "description": "Trim leading/trailing whitespace from string fields",
      "type": "boolean"
    },
    "dateFormat": {
      "description": "Expected date format in import data (e.g., \"YYYY-MM-DD\")",
      "type": "string"
    },
    "nullValues": {
      "description": "Strings to treat as null (e.g., [\"\", \"N/A\", \"null\"])",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "mode",
    "maxErrors",
    "trimWhitespace"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/ImportValidationConfig.json",
  "x-spec-version": "3.0.11"
}