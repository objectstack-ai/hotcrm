{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "description": "Optional task ID for referencing",
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Human-readable task name"
    },
    "type": {
      "type": "string",
      "enum": [
        "classify",
        "extract",
        "summarize",
        "generate",
        "predict",
        "translate",
        "sentiment",
        "entity_recognition",
        "anomaly_detection",
        "recommendation"
      ]
    },
    "model": {
      "description": "Model ID from registry (uses default if not specified)",
      "type": "string"
    },
    "promptTemplate": {
      "description": "Prompt template ID for this task",
      "type": "string"
    },
    "inputFields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Source fields to process (e.g., [\"description\", \"comments\"])"
    },
    "inputSchema": {
      "description": "Validation schema for inputs",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "inputContext": {
      "description": "Additional context for the AI model",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "outputField": {
      "type": "string",
      "description": "Target field to store the result"
    },
    "outputSchema": {
      "description": "Validation schema for output",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "outputFormat": {
      "default": "text",
      "type": "string",
      "enum": [
        "text",
        "json",
        "number",
        "boolean",
        "array"
      ]
    },
    "classes": {
      "description": "Valid classes for classification tasks",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "multiClass": {
      "default": false,
      "description": "Allow multiple classes to be selected",
      "type": "boolean"
    },
    "extractionSchema": {
      "description": "JSON schema for structured extraction",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "maxLength": {
      "description": "Maximum length for generated content",
      "type": "number"
    },
    "temperature": {
      "description": "Model temperature override",
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "fallbackValue": {
      "description": "Fallback value if AI task fails"
    },
    "retryAttempts": {
      "default": 1,
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "condition": {
      "description": "Formula condition - task only runs if TRUE",
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "active": {
      "default": true,
      "type": "boolean"
    }
  },
  "required": [
    "name",
    "type",
    "inputFields",
    "outputField",
    "outputFormat",
    "multiClass",
    "retryAttempts",
    "active"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/AITask.json",
  "x-spec-version": "3.0.11"
}