{
  "name": "@hotcrm/crm",
  "version": "1.0.0",
  "type": "module",
  "description": "CRM module - Account, Contact, Lead, Opportunity management with hooks and actions",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "objectstack dev",
    "start": "objectstack serve",
    "build": "tsc && objectstack compile",
    "typecheck": "tsc --noEmit",
    "test": "objectstack test"
  },
  "keywords": [
    "crm",
    "sales",
    "marketing",
    "accounts",
    "contacts"
  ],
  "author": "HotCRM Team",
  "dependencies": {
    "@hotcrm/ai": "workspace:*",
    "@objectstack/spec": "^3.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@objectstack/cli": "^3.3.1",
    "typescript": "^5.9.3"
  }
}
