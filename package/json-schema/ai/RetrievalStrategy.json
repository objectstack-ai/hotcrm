{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "similarity"
        },
        "topK": {
          "default": 5,
          "description": "Number of results to retrieve",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "scoreThreshold": {
          "description": "Minimum similarity score",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "type",
        "topK"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "mmr"
        },
        "topK": {
          "default": 5,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "fetchK": {
          "default": 20,
          "description": "Initial fetch size",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "lambda": {
          "default": 0.5,
          "description": "Diversity vs relevance (0=diverse, 1=relevant)",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "type",
        "topK",
        "fetchK",
        "lambda"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "hybrid"
        },
        "topK": {
          "default": 5,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "vectorWeight": {
          "default": 0.7,
          "description": "Weight for vector search",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "keywordWeight": {
          "default": 0.3,
          "description": "Weight for keyword search",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "type",
        "topK",
        "vectorWeight",
        "keywordWeight"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "parent_document"
        },
        "topK": {
          "default": 5,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "retrieveParent": {
          "default": true,
          "description": "Retrieve full parent document",
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "topK",
        "retrieveParent"
      ],
      "additionalProperties": false
    }
  ],
  "$id": "https://schema.objectstack.io/v3.0.11/ai/RetrievalStrategy.json",
  "x-spec-version": "3.0.11"
}