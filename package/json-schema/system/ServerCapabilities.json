{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "httpVersions": {
      "default": [
        "1.1"
      ],
      "description": "Supported HTTP versions",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "1.0",
          "1.1",
          "2.0",
          "3.0"
        ]
      }
    },
    "websocket": {
      "default": false,
      "description": "WebSocket support",
      "type": "boolean"
    },
    "sse": {
      "default": false,
      "description": "Server-Sent Events support",
      "type": "boolean"
    },
    "serverPush": {
      "default": false,
      "description": "HTTP/2 Server Push support",
      "type": "boolean"
    },
    "streaming": {
      "default": true,
      "description": "Response streaming support",
      "type": "boolean"
    },
    "middleware": {
      "default": true,
      "description": "Middleware chain support",
      "type": "boolean"
    },
    "routeParams": {
      "default": true,
      "description": "URL parameter support (/users/:id)",
      "type": "boolean"
    },
    "compression": {
      "default": true,
      "description": "Built-in compression support",
      "type": "boolean"
    }
  },
  "required": [
    "httpVersions",
    "websocket",
    "sse",
    "serverPush",
    "streaming",
    "middleware",
    "routeParams",
    "compression"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/system/ServerCapabilities.json",
  "x-spec-version": "3.0.11"
}