{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "value": {
      "type": "string",
      "description": "Phone number"
    },
    "type": {
      "description": "Phone number type",
      "type": "string",
      "enum": [
        "work",
        "home",
        "mobile",
        "fax",
        "pager",
        "other"
      ]
    },
    "display": {
      "description": "Display label",
      "type": "string"
    },
    "primary": {
      "default": false,
      "description": "Primary phone indicator",
      "type": "boolean"
    }
  },
  "required": [
    "value",
    "primary"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/identity/SCIMPhoneNumber.json",
  "x-spec-version": "3.0.11"
}