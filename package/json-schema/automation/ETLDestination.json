{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "database",
        "api",
        "file",
        "stream",
        "object",
        "warehouse",
        "storage",
        "spreadsheet"
      ],
      "description": "Destination type"
    },
    "connector": {
      "description": "Connector ID",
      "type": "string"
    },
    "config": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {},
      "description": "Destination configuration"
    },
    "writeMode": {
      "default": "append",
      "description": "How to write data",
      "type": "string",
      "enum": [
        "append",
        "overwrite",
        "upsert",
        "merge"
      ]
    },
    "primaryKey": {
      "description": "Primary key fields",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "type",
    "config",
    "writeMode"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/automation/ETLDestination.json",
  "x-spec-version": "3.0.11"
}