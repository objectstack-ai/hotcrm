{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "trigger": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "delete",
        "manual"
      ],
      "description": "Event that triggers invalidation"
    },
    "scope": {
      "type": "string",
      "enum": [
        "key",
        "pattern",
        "tag",
        "all"
      ],
      "description": "Invalidation scope"
    },
    "pattern": {
      "description": "Key pattern for pattern-based invalidation",
      "type": "string"
    },
    "tags": {
      "description": "Cache tags to invalidate",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "trigger",
    "scope"
  ],
  "additionalProperties": false,
  "description": "Rule defining when and how cached entries are invalidated",
  "$id": "https://schema.objectstack.io/v3.0.11/system/CacheInvalidation.json",
  "x-spec-version": "3.0.11"
}