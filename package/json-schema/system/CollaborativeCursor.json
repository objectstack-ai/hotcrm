{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "description": "User identifier"
    },
    "sessionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "Session identifier"
    },
    "documentId": {
      "type": "string",
      "description": "Document identifier"
    },
    "userName": {
      "type": "string",
      "description": "Display name of user"
    },
    "position": {
      "type": "object",
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Cursor line number (0-indexed)"
        },
        "column": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Cursor column number (0-indexed)"
        }
      },
      "required": [
        "line",
        "column"
      ],
      "additionalProperties": false,
      "description": "Current cursor position"
    },
    "selection": {
      "description": "Current text selection",
      "type": "object",
      "properties": {
        "anchor": {
          "type": "object",
          "properties": {
            "line": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Anchor line number"
            },
            "column": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Anchor column number"
            }
          },
          "required": [
            "line",
            "column"
          ],
          "additionalProperties": false,
          "description": "Selection anchor (start point)"
        },
        "focus": {
          "type": "object",
          "properties": {
            "line": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Focus line number"
            },
            "column": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Focus column number"
            }
          },
          "required": [
            "line",
            "column"
          ],
          "additionalProperties": false,
          "description": "Selection focus (end point)"
        },
        "direction": {
          "description": "Selection direction",
          "type": "string",
          "enum": [
            "forward",
            "backward"
          ]
        }
      },
      "required": [
        "anchor",
        "focus"
      ],
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "properties": {
        "color": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "blue",
                "green",
                "red",
                "yellow",
                "purple",
                "orange",
                "pink",
                "teal",
                "indigo",
                "cyan"
              ]
            },
            {
              "type": "string"
            }
          ],
          "description": "Cursor color (preset or custom hex)"
        },
        "opacity": {
          "default": 1,
          "description": "Cursor opacity (0-1)",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "label": {
          "description": "Label to display with cursor (usually username)",
          "type": "string"
        },
        "showLabel": {
          "default": true,
          "description": "Whether to show label",
          "type": "boolean"
        },
        "pulseOnUpdate": {
          "default": true,
          "description": "Whether to pulse when cursor moves",
          "type": "boolean"
        }
      },
      "required": [
        "color",
        "opacity",
        "showLabel",
        "pulseOnUpdate"
      ],
      "additionalProperties": false,
      "description": "Visual style for this cursor"
    },
    "isTyping": {
      "default": false,
      "description": "Whether user is currently typing",
      "type": "boolean"
    },
    "lastUpdate": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "description": "ISO 8601 datetime of last cursor update"
    },
    "metadata": {
      "description": "Additional cursor metadata",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "userId",
    "sessionId",
    "documentId",
    "userName",
    "position",
    "style",
    "isTyping",
    "lastUpdate"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/system/CollaborativeCursor.json",
  "x-spec-version": "3.0.11"
}