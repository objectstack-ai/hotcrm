{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "filter": {
      "description": "JSON-encoded filter expression (canonical, singular).",
      "type": "string"
    },
    "filters": {
      "description": "JSON-encoded filter expression (deprecated plural alias).",
      "type": "string"
    },
    "select": {
      "description": "Comma-separated list of fields to retrieve.",
      "type": "string"
    },
    "sort": {
      "description": "Sort expression (e.g. \"name asc,created_at desc\" or \"-created_at\").",
      "type": "string"
    },
    "orderBy": {
      "description": "Alias for sort (OData compatibility).",
      "type": "string"
    },
    "top": {
      "description": "Max records to return (limit).",
      "type": "number"
    },
    "skip": {
      "description": "Records to skip (offset).",
      "type": "number"
    },
    "expand": {
      "description": "Comma-separated list of relations to eager-load.",
      "type": "string"
    },
    "search": {
      "description": "Full-text search query.",
      "type": "string"
    },
    "distinct": {
      "description": "SELECT DISTINCT flag.",
      "type": "boolean"
    },
    "count": {
      "description": "Include total count in response.",
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/HttpFindQueryParams.json",
  "x-spec-version": "3.0.11"
}