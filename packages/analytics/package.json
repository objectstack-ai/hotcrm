  "keywords": [
    "analytics",
    "reports",
    "dashboards",
    "kpi",
    "bi"
  ],
  "author": "HotCRM Team",
  "dependencies": {
    "@hotcrm/ai": "workspace:*",
    "@objectstack/spec": "^4.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@objectstack/cli": "^4.0.4",
    "typescript": "^5.9.3"
  }
}
