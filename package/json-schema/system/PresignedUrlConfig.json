{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "operation": {
      "type": "string",
      "enum": [
        "get",
        "put",
        "delete",
        "head"
      ],
      "description": "Allowed operation"
    },
    "expiresIn": {
      "type": "number",
      "minimum": 1,
      "maximum": 604800,
      "description": "Expiration time in seconds (max 7 days)"
    },
    "contentType": {
      "description": "Required content type for PUT operations",
      "type": "string"
    },
    "maxSize": {
      "description": "Maximum file size in bytes for PUT operations",
      "type": "number",
      "minimum": 0
    },
    "responseContentType": {
      "description": "Override content-type for GET operations",
      "type": "string"
    },
    "responseContentDisposition": {
      "description": "Override content-disposition for GET operations",
      "type": "string"
    }
  },
  "required": [
    "operation",
    "expiresIn"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/system/PresignedUrlConfig.json",
  "x-spec-version": "3.0.11"
}