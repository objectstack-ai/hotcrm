{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pluginId": {
      "type": "string"
    },
    "trustLevel": {
      "type": "string",
      "enum": [
        "verified",
        "trusted",
        "community",
        "untrusted",
        "blocked"
      ],
      "description": "Trust level of the plugin"
    },
    "permissions": {
      "type": "object",
      "properties": {
        "permissions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique permission identifier"
              },
              "resource": {
                "type": "string",
                "enum": [
                  "data.object",
                  "data.record",
                  "data.field",
                  "ui.view",
                  "ui.dashboard",
                  "ui.report",
                  "system.config",
                  "system.plugin",
                  "system.api",
                  "system.service",
                  "storage.file",
                  "storage.database",
                  "network.http",
                  "network.websocket",
                  "process.spawn",
                  "process.env"
                ],
                "description": "Type of resource being accessed"
              },
              "actions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "create",
                    "read",
                    "update",
                    "delete",
                    "execute",
                    "manage",
                    "configure",
                    "share",
                    "export",
                    "import",
                    "admin"
                  ],
                  "description": "Type of action being permitted"
                }
              },
              "scope": {
                "default": "plugin",
                "type": "string",
                "enum": [
                  "global",
                  "tenant",
                  "user",
                  "resource",
                  "plugin"
                ],
                "description": "Scope of permission application"
              },
              "filter": {
                "type": "object",
                "properties": {
                  "resourceIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "condition": {
                    "description": "Filter expression (e.g., owner = currentUser)",
                    "type": "string"
                  },
                  "fields": {
                    "description": "Allowed fields for data resources",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              },
              "description": {
                "type": "string"
              },
              "required": {
                "default": true,
                "type": "boolean"
              },
              "justification": {
                "description": "Why this permission is needed",
                "type": "string"
              }
            },
            "required": [
              "id",
              "resource",
              "actions",
              "scope",
              "description",
              "required"
            ],
            "additionalProperties": false
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Group name"
              },
              "description": {
                "type": "string"
              },
              "permissions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Permission IDs in this group"
              }
            },
            "required": [
              "name",
              "description",
              "permissions"
            ],
            "additionalProperties": false
          }
        },
        "defaultGrant": {
          "default": "prompt",
          "type": "string",
          "enum": [
            "prompt",
            "allow",
            "deny",
            "inherit"
          ]
        }
      },
      "required": [
        "permissions",
        "defaultGrant"
      ],
      "additionalProperties": false
    },
    "sandbox": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "level": {
          "default": "standard",
          "type": "string",
          "enum": [
            "none",
            "minimal",
            "standard",
            "strict",
            "paranoid"
          ]
        },
        "runtime": {
          "description": "Execution environment and isolation settings",
          "type": "object",
          "properties": {
            "engine": {
              "default": "v8-isolate",
              "description": "Execution environment engine",
              "type": "string",
              "enum": [
                "v8-isolate",
                "wasm",
                "container",
                "process"
              ]
            },
            "engineConfig": {
              "type": "object",
              "properties": {
                "wasm": {
                  "type": "object",
                  "properties": {
                    "maxMemoryPages": {
                      "description": "Maximum WASM memory pages (64KB each)",
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65536
                    },
                    "instructionLimit": {
                      "description": "Maximum instructions before timeout",
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "enableSimd": {
                      "default": false,
                      "description": "Enable WebAssembly SIMD support",
                      "type": "boolean"
                    },
                    "enableThreads": {
                      "default": false,
                      "description": "Enable WebAssembly threads",
                      "type": "boolean"
                    },
                    "enableBulkMemory": {
                      "default": true,
                      "description": "Enable bulk memory operations",
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "enableSimd",
                    "enableThreads",
                    "enableBulkMemory"
                  ],
                  "additionalProperties": false
                },
                "container": {
                  "type": "object",
                  "properties": {
                    "image": {
                      "description": "Container image to use",
                      "type": "string"
                    },
                    "runtime": {
                      "default": "docker",
                      "type": "string",
                      "enum": [
                        "docker",
                        "podman",
                        "containerd"
                      ]
                    },
                    "resources": {
                      "type": "object",
                      "properties": {
                        "cpuLimit": {
                          "description": "CPU limit (e.g., \"0.5\", \"2\")",
                          "type": "string"
                        },
                        "memoryLimit": {
                          "description": "Memory limit (e.g., \"512m\", \"1g\")",
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    },
                    "networkMode": {
                      "default": "bridge",
                      "type": "string",
                      "enum": [
                        "none",
                        "bridge",
                        "host"
                      ]
                    }
                  },
                  "required": [
                    "runtime",
                    "networkMode"
                  ],
                  "additionalProperties": false
                },
                "v8Isolate": {
                  "type": "object",
                  "properties": {
                    "heapSizeMb": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "enableSnapshot": {
                      "default": true,
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "enableSnapshot"
                  ],
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "resourceLimits": {
              "type": "object",
              "properties": {
                "maxMemory": {
                  "description": "Maximum memory allocation",
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "maxCpu": {
                  "description": "Maximum CPU usage percentage",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "timeout": {
                  "description": "Maximum execution time",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "engine"
          ],
          "additionalProperties": false
        },
        "filesystem": {
          "type": "object",
          "properties": {
            "mode": {
              "default": "restricted",
              "type": "string",
              "enum": [
                "none",
                "readonly",
                "restricted",
                "full"
              ]
            },
            "allowedPaths": {
              "description": "Whitelisted paths",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deniedPaths": {
              "description": "Blacklisted paths",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "maxFileSize": {
              "description": "Maximum file size in bytes",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        "network": {
          "type": "object",
          "properties": {
            "mode": {
              "default": "restricted",
              "type": "string",
              "enum": [
                "none",
                "local",
                "restricted",
                "full"
              ]
            },
            "allowedHosts": {
              "description": "Whitelisted hosts",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deniedHosts": {
              "description": "Blacklisted hosts",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allowedPorts": {
              "description": "Allowed port numbers",
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "maxConnections": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        "process": {
          "type": "object",
          "properties": {
            "allowSpawn": {
              "default": false,
              "description": "Allow spawning child processes",
              "type": "boolean"
            },
            "allowedCommands": {
              "description": "Whitelisted commands",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "timeout": {
              "description": "Process timeout in ms",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "allowSpawn"
          ],
          "additionalProperties": false
        },
        "memory": {
          "type": "object",
          "properties": {
            "maxHeap": {
              "description": "Maximum heap size in bytes",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "maxStack": {
              "description": "Maximum stack size in bytes",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "cpu": {
          "type": "object",
          "properties": {
            "maxCpuPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "maxThreads": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "environment": {
          "type": "object",
          "properties": {
            "mode": {
              "default": "readonly",
              "type": "string",
              "enum": [
                "none",
                "readonly",
                "restricted",
                "full"
              ]
            },
            "allowedVars": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deniedVars": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "enabled",
        "level"
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "csp": {
          "type": "object",
          "properties": {
            "directives": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "reportOnly": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "reportOnly"
          ],
          "additionalProperties": false
        },
        "cors": {
          "type": "object",
          "properties": {
            "allowedOrigins": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allowedMethods": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allowedHeaders": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allowCredentials": {
              "default": false,
              "type": "boolean"
            },
            "maxAge": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "allowedOrigins",
            "allowedMethods",
            "allowedHeaders",
            "allowCredentials"
          ],
          "additionalProperties": false
        },
        "rateLimit": {
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "maxRequests": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "windowMs": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "Time window in milliseconds"
            },
            "strategy": {
              "default": "sliding",
              "type": "string",
              "enum": [
                "fixed",
                "sliding",
                "token-bucket"
              ]
            }
          },
          "required": [
            "enabled",
            "maxRequests",
            "windowMs",
            "strategy"
          ],
          "additionalProperties": false
        },
        "authentication": {
          "type": "object",
          "properties": {
            "required": {
              "default": true,
              "type": "boolean"
            },
            "methods": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "jwt",
                  "oauth2",
                  "api-key",
                  "session",
                  "certificate"
                ]
              }
            },
            "tokenExpiration": {
              "description": "Token expiration in seconds",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "required",
            "methods"
          ],
          "additionalProperties": false
        },
        "encryption": {
          "type": "object",
          "properties": {
            "dataAtRest": {
              "default": false,
              "description": "Encrypt data at rest",
              "type": "boolean"
            },
            "dataInTransit": {
              "default": true,
              "description": "Enforce HTTPS/TLS",
              "type": "boolean"
            },
            "algorithm": {
              "description": "Encryption algorithm",
              "type": "string"
            },
            "minKeyLength": {
              "description": "Minimum key length in bits",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "dataAtRest",
            "dataInTransit"
          ],
          "additionalProperties": false
        },
        "auditLog": {
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "events": {
              "description": "Events to log",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "retention": {
              "description": "Log retention in days",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "enabled"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "scanResults": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          },
          "scanner": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "version"
            ],
            "additionalProperties": false
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "warning"
            ]
          },
          "vulnerabilities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "cve": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "critical",
                    "high",
                    "medium",
                    "low",
                    "info"
                  ]
                },
                "category": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "location": {
                  "type": "string"
                },
                "remediation": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "affectedVersions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "fixedIn": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "cvssScore": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "exploitAvailable": {
                  "default": false,
                  "type": "boolean"
                },
                "patchAvailable": {
                  "default": false,
                  "type": "boolean"
                },
                "workaround": {
                  "type": "string"
                },
                "references": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "discoveredDate": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                },
                "publishedDate": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                }
              },
              "required": [
                "id",
                "severity",
                "title",
                "description",
                "affectedVersions",
                "exploitAvailable",
                "patchAvailable"
              ],
              "additionalProperties": false
            }
          },
          "codeIssues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "severity": {
                  "type": "string",
                  "enum": [
                    "error",
                    "warning",
                    "info"
                  ]
                },
                "type": {
                  "type": "string",
                  "description": "Issue type (e.g., sql-injection, xss)"
                },
                "file": {
                  "type": "string"
                },
                "line": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "message": {
                  "type": "string"
                },
                "suggestion": {
                  "type": "string"
                }
              },
              "required": [
                "severity",
                "type",
                "file",
                "message"
              ],
              "additionalProperties": false
            }
          },
          "dependencyVulnerabilities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "package": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "vulnerability": {
                  "type": "object",
                  "properties": {
                    "cve": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "severity": {
                      "type": "string",
                      "enum": [
                        "critical",
                        "high",
                        "medium",
                        "low",
                        "info"
                      ]
                    },
                    "category": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "location": {
                      "type": "string"
                    },
                    "remediation": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "affectedVersions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "fixedIn": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "cvssScore": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 10
                    },
                    "exploitAvailable": {
                      "default": false,
                      "type": "boolean"
                    },
                    "patchAvailable": {
                      "default": false,
                      "type": "boolean"
                    },
                    "workaround": {
                      "type": "string"
                    },
                    "references": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "discoveredDate": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                    },
                    "publishedDate": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                    }
                  },
                  "required": [
                    "id",
                    "severity",
                    "title",
                    "description",
                    "affectedVersions",
                    "exploitAvailable",
                    "patchAvailable"
                  ],
                  "additionalProperties": false
                }
              },
