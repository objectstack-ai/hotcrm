{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Machine name (lowercase snake_case)"
    },
    "label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Translation key (e.g., \"views.task_list.label\")"
            },
            "defaultValue": {
              "description": "Fallback value when translation key is not found",
              "type": "string"
            },
            "params": {
              "description": "Interpolation parameters (e.g., { count: 5 })",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Display label"
    },
    "icon": {
      "description": "Icon name",
      "type": "string"
    },
    "locations": {
      "description": "Locations where this action is visible",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "list_toolbar",
          "list_item",
          "record_header",
          "record_more",
          "record_related",
          "global_nav"
        ]
      }
    },
    "component": {
      "description": "Visual component override",
      "type": "string",
      "enum": [
        "action:button",
        "action:icon",
        "action:menu",
        "action:group"
      ]
    },
    "type": {
      "default": "script",
      "description": "Action functionality type",
      "type": "string",
      "enum": [
        "script",
        "url",
        "modal",
        "flow",
        "api"
      ]
    },
    "target": {
      "description": "URL, Script Name, Flow ID, or API Endpoint",
      "type": "string"
    },
    "execute": {
      "description": "Legacy execution logic",
      "type": "string"
    },
    "params": {
      "description": "Input parameters required from user",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "description": "Translation key (e.g., \"views.task_list.label\")"
                  },
                  "defaultValue": {
                    "description": "Fallback value when translation key is not found",
                    "type": "string"
                  },
                  "params": {
                    "description": "Interpolation parameters (e.g., { count: 5 })",
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "key"
                ],
                "additionalProperties": false
              }
            ],
            "description": "Display label: plain string or i18n translation object"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "textarea",
              "email",
              "url",
              "phone",
              "password",
              "markdown",
              "html",
              "richtext",
              "number",
              "currency",
              "percent",
              "date",
              "datetime",
              "time",
              "boolean",
              "toggle",
              "select",
              "multiselect",
              "radio",
              "checkboxes",
              "lookup",
              "master_detail",
              "tree",
              "image",
              "file",
              "avatar",
              "video",
              "audio",
              "formula",
              "summary",
              "autonumber",
              "location",
              "address",
              "code",
              "json",
              "color",
              "rating",
              "slider",
              "signature",
              "qrcode",
              "progress",
              "tags",
              "vector"
            ]
          },
          "required": {
            "default": false,
            "type": "boolean"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string",
                          "description": "Translation key (e.g., \"views.task_list.label\")"
                        },
                        "defaultValue": {
                          "description": "Fallback value when translation key is not found",
                          "type": "string"
                        },
                        "params": {
                          "description": "Interpolation parameters (e.g., { count: 5 })",
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "number"
                              },
                              {
                                "type": "boolean"
                              }
                            ]
                          }
                        }
                      },
                      "required": [
                        "key"
                      ],
                      "additionalProperties": false
                    }
                  ],
                  "description": "Display label: plain string or i18n translation object"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "label",
                "value"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "label",
          "type",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "variant": {
      "description": "Button visual variant for styling (primary = highlighted, danger = destructive, ghost = transparent)",
      "type": "string",
      "enum": [
        "primary",
        "secondary",
        "danger",
        "ghost",
        "link"
      ]
    },
    "confirmText": {
      "description": "Confirmation message before execution",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Translation key (e.g., \"views.task_list.label\")"
            },
            "defaultValue": {
              "description": "Fallback value when translation key is not found",
              "type": "string"
            },
            "params": {
              "description": "Interpolation parameters (e.g., { count: 5 })",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        }
      ]
    },
    "successMessage": {
      "description": "Success message to show after execution",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Translation key (e.g., \"views.task_list.label\")"
            },
            "defaultValue": {
              "description": "Fallback value when translation key is not found",
              "type": "string"
            },
            "params": {
              "description": "Interpolation parameters (e.g., { count: 5 })",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        }
      ]
    },
    "refreshAfter": {
      "default": false,
      "description": "Refresh view after execution",
      "type": "boolean"
    },
    "visible": {
      "description": "Formula returning boolean",
      "type": "string"
    },
    "disabled": {
      "description": "Whether the action is disabled, or a condition expression string",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string"
        }
      ]
    },
    "shortcut": {
      "description": "Keyboard shortcut to trigger this action (e.g., \"Ctrl+S\")",
      "type": "string"
    },
    "bulkEnabled": {
      "description": "Whether this action can be applied to multiple selected records",
      "type": "boolean"
    },
    "timeout": {
      "description": "Maximum execution time in milliseconds for the action",
      "type": "number"
    },
    "aria": {
      "description": "ARIA accessibility attributes",
      "type": "object",
      "properties": {
        "ariaLabel": {
          "description": "Accessible label for screen readers (WAI-ARIA aria-label)",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "description": "Translation key (e.g., \"views.task_list.label\")"
                },
                "defaultValue": {
                  "description": "Fallback value when translation key is not found",
                  "type": "string"
                },
                "params": {
                  "description": "Interpolation parameters (e.g., { count: 5 })",
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  }
                }
              },
              "required": [
                "key"
              ],
              "additionalProperties": false
            }
          ]
        },
        "ariaDescribedBy": {
          "description": "ID of element providing additional description (WAI-ARIA aria-describedby)",
          "type": "string"
        },
        "role": {
          "description": "WAI-ARIA role attribute (e.g., \"dialog\", \"navigation\", \"alert\")",
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "label",
    "type",
    "refreshAfter"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ui/Action.json",
  "x-spec-version": "3.0.11"
}