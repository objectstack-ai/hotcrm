{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "field": {
      "type": "string",
      "description": "Field name to monitor"
    },
    "operator": {
      "default": "changed",
      "type": "string",
      "enum": [
        "changed",
        "changed_to",
        "changed_from",
        "is",
        "is_not"
      ]
    },
    "value": {
      "description": "Value to compare against (for changed_to/changed_from/is/is_not)"
    }
  },
  "required": [
    "field",
    "operator"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/WorkflowFieldCondition.json",
  "x-spec-version": "3.0.11"
}