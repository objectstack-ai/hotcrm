{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "field": {
      "type": "string",
      "description": "Field path in the result to check (e.g. \"body.data.0.status\")"
    },
    "operator": {
      "type": "string",
      "enum": [
        "equals",
        "not_equals",
        "contains",
        "not_contains",
        "is_null",
        "not_null",
        "gt",
        "gte",
        "lt",
        "lte",
        "error"
      ],
      "description": "Comparison operator to use"
    },
    "expectedValue": {
      "description": "Expected value to compare against"
    }
  },
  "required": [
    "field",
    "operator",
    "expectedValue"
  ],
  "additionalProperties": false,
  "description": "A test assertion that validates the result of a test action",
  "$id": "https://schema.objectstack.io/v3.0.11/qa/TestAssertion.json",
  "x-spec-version": "3.0.11"
}