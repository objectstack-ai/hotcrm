{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Translation key (e.g., \"views.task_list.label\")"
            },
            "defaultValue": {
              "description": "Fallback value when translation key is not found",
              "type": "string"
            },
            "params": {
              "description": "Interpolation parameters (e.g., { count: 5 })",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Display label: plain string or i18n translation object"
    },
    "type": {
      "type": "string",
      "enum": [
        "text",
        "textarea",
        "email",
        "url",
        "phone",
        "password",
        "markdown",
        "html",
        "richtext",
        "number",
        "currency",
        "percent",
        "date",
        "datetime",
        "time",
        "boolean",
        "toggle",
        "select",
        "multiselect",
        "radio",
        "checkboxes",
        "lookup",
        "master_detail",
        "tree",
        "image",
        "file",
        "avatar",
        "video",
        "audio",
        "formula",
        "summary",
        "autonumber",
        "location",
        "address",
        "code",
        "json",
        "color",
        "rating",
        "slider",
        "signature",
        "qrcode",
        "progress",
        "tags",
        "vector"
      ]
    },
    "required": {
      "default": false,
      "type": "boolean"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "description": "Translation key (e.g., \"views.task_list.label\")"
                  },
                  "defaultValue": {
                    "description": "Fallback value when translation key is not found",
                    "type": "string"
                  },
                  "params": {
                    "description": "Interpolation parameters (e.g., { count: 5 })",
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "key"
                ],
                "additionalProperties": false
              }
            ],
            "description": "Display label: plain string or i18n translation object"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "value"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name",
    "label",
    "type",
    "required"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ui/ActionParam.json",
  "x-spec-version": "3.0.11"
}