{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "defaultTimeoutMs": {
      "default": 86400000,
      "description": "Default timeout in ms (default: 24 hours)",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "defaultTimeoutBehavior": {
      "default": "fail",
      "description": "Default behavior when wait timeout is exceeded",
      "type": "string",
      "enum": [
        "fail",
        "continue",
        "fallback"
      ]
    },
    "conditionPollIntervalMs": {
      "default": 30000,
      "description": "Polling interval for condition waits in ms (default: 30s)",
      "type": "integer",
      "minimum": 1000,
      "maximum": 9007199254740991
    },
    "conditionMaxPolls": {
      "default": 0,
      "description": "Max polling attempts for condition waits (0 = unlimited)",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "webhookUrlPattern": {
      "default": "/api/v1/automation/resume/{executionId}/{nodeId}",
      "description": "URL pattern for webhook resume endpoints",
      "type": "string"
    },
    "persistCheckpoints": {
      "default": true,
      "description": "Persist wait checkpoints to durable storage",
      "type": "boolean"
    },
    "maxPausedExecutions": {
      "default": 0,
      "description": "Max concurrent paused executions (0 = unlimited)",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "defaultTimeoutMs",
    "defaultTimeoutBehavior",
    "conditionPollIntervalMs",
    "conditionMaxPolls",
    "webhookUrlPattern",
    "persistCheckpoints",
    "maxPausedExecutions"
  ],
  "additionalProperties": false,
  "description": "Wait node executor plugin configuration",
  "$id": "https://schema.objectstack.io/v3.0.11/automation/WaitExecutorConfig.json",
  "x-spec-version": "3.0.11"
}