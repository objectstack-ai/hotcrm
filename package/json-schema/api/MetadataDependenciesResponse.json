{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "success": {
      "type": "boolean",
      "description": "Operation success status"
    },
    "error": {
      "description": "Error details if success is false",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Error code (e.g. validation_error)"
        },
        "message": {
          "type": "string",
          "description": "Readable error message"
        },
        "category": {
          "description": "Error category (e.g. validation, authorization)",
          "type": "string"
        },
        "details": {
          "description": "Additional error context (e.g. field validation errors)"
        },
        "requestId": {
          "description": "Request ID for tracking",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "meta": {
      "description": "Response metadata",
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "string"
        },
        "duration": {
          "type": "number"
        },
        "requestId": {
          "type": "string"
        },
        "traceId": {
          "type": "string"
        }
      },
      "required": [
        "timestamp"
      ],
      "additionalProperties": false
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceType": {
            "type": "string",
            "description": "Dependent metadata type"
          },
          "sourceName": {
            "type": "string",
            "description": "Dependent metadata name"
          },
          "targetType": {
            "type": "string",
            "description": "Referenced metadata type"
          },
          "targetName": {
            "type": "string",
            "description": "Referenced metadata name"
          },
          "kind": {
            "type": "string",
            "enum": [
              "reference",
              "extends",
              "includes",
              "triggers"
            ],
            "description": "How the dependency is formed"
          }
        },
        "required": [
          "sourceType",
          "sourceName",
          "targetType",
          "targetName",
          "kind"
        ],
        "additionalProperties": false
      },
      "description": "Items this item depends on"
    }
  },
  "required": [
    "success",
    "data"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/MetadataDependenciesResponse.json",
  "x-spec-version": "3.0.11"
}