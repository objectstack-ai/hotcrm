{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "description": "Unique action ID",
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "trigger_flow",
        "trigger_approval",
        "trigger_webhook",
        "run_report",
        "send_email",
        "send_notification",
        "schedule_task"
      ]
    },
    "params": {
      "type": "object",
      "properties": {
        "flowName": {
          "description": "Flow/workflow name",
          "type": "string"
        },
        "approvalProcessName": {
          "description": "Approval process name",
          "type": "string"
        },
        "webhookUrl": {
          "description": "Webhook URL",
          "type": "string"
        },
        "reportName": {
          "description": "Report name",
          "type": "string"
        },
        "emailTemplate": {
          "description": "Email template",
          "type": "string"
        },
        "recipients": {
          "description": "Email recipients",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subject": {
          "description": "Email subject",
          "type": "string"
        },
        "message": {
          "description": "Notification/email message",
          "type": "string"
        },
        "taskData": {
          "description": "Task creation data",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "scheduleTime": {
          "description": "Schedule time (ISO 8601)",
          "type": "string"
        },
        "contextData": {
          "description": "Additional context data",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "additionalProperties": false
    },
    "requireConfirmation": {
      "default": false,
      "description": "Require user confirmation before executing",
      "type": "boolean"
    },
    "confirmationMessage": {
      "description": "Message to show in confirmation dialog",
      "type": "string"
    },
    "successMessage": {
      "description": "Message to show on success",
      "type": "string"
    },
    "onError": {
      "default": "abort",
      "description": "Error handling strategy",
      "type": "string",
      "enum": [
        "retry",
        "skip",
        "abort"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "intent": {
          "description": "Original user intent/query",
          "type": "string"
        },
        "confidence": {
          "description": "Confidence score (0-1)",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "agentName": {
          "description": "Agent that generated this action",
          "type": "string"
        },
        "timestamp": {
          "description": "Generation timestamp (ISO 8601)",
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "params",
    "requireConfirmation",
    "onError"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/WorkflowAgentAction.json",
  "x-spec-version": "3.0.11"
}