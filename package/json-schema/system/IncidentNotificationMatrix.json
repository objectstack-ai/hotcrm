{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ],
            "description": "Minimum severity to trigger notification"
          },
          "channels": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "email",
                "sms",
                "slack",
                "pagerduty",
                "webhook"
              ]
            },
            "description": "Notification channels"
          },
          "recipients": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Roles or teams to notify"
          },
          "withinMinutes": {
            "type": "number",
            "minimum": 1,
            "description": "Notification deadline in minutes from detection"
          },
          "notifyRegulators": {
            "default": false,
            "description": "Whether to notify regulatory authorities",
            "type": "boolean"
          },
          "regulatorDeadlineHours": {
            "description": "Regulatory notification deadline in hours",
            "type": "number"
          }
        },
        "required": [
          "severity",
          "channels",
          "recipients",
          "withinMinutes",
          "notifyRegulators"
        ],
        "additionalProperties": false,
        "description": "Incident notification rule per severity level"
      },
      "description": "Notification rules by severity level"
    },
    "escalationTimeoutMinutes": {
      "default": 30,
      "description": "Auto-escalation timeout in minutes",
      "type": "number"
    },
    "escalationChain": {
      "default": [],
      "description": "Ordered escalation chain of roles",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "rules",
    "escalationTimeoutMinutes",
    "escalationChain"
  ],
  "additionalProperties": false,
  "description": "Incident notification matrix with escalation policies",
  "$id": "https://schema.objectstack.io/v3.0.11/system/IncidentNotificationMatrix.json",
  "x-spec-version": "3.0.11"
}