{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "emoji": {
      "type": "string",
      "description": "Emoji character or shortcode (e.g., \"👍\", \":thumbsup:\")"
    },
    "userIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Users who reacted"
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Total reaction count"
    }
  },
  "required": [
    "emoji",
    "userIds",
    "count"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/data/Reaction.json",
  "x-spec-version": "3.0.11"
}