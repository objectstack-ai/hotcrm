{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "maxTokens": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "Maximum total tokens"
    },
    "maxPromptTokens": {
      "description": "Max tokens for prompt",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "maxCompletionTokens": {
      "description": "Max tokens for completion",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "reserveTokens": {
      "default": 500,
      "description": "Reserve tokens for system messages",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "bufferPercentage": {
      "default": 0.1,
      "description": "Buffer percentage (0.1 = 10%)",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "strategy": {
      "default": "sliding_window",
      "type": "string",
      "enum": [
        "fifo",
        "importance",
        "semantic",
        "sliding_window",
        "summary"
      ]
    },
    "slidingWindowSize": {
      "description": "Number of recent messages to keep",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "minImportanceScore": {
      "description": "Minimum importance to keep",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "semanticThreshold": {
      "description": "Semantic similarity threshold",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "enableSummarization": {
      "default": false,
      "description": "Enable context summarization",
      "type": "boolean"
    },
    "summarizationThreshold": {
      "description": "Trigger summarization at N tokens",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "summaryModel": {
      "description": "Model ID for summarization",
      "type": "string"
    },
    "warnThreshold": {
      "default": 0.8,
      "description": "Warn at % of budget (0.8 = 80%)",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "maxTokens",
    "reserveTokens",
    "bufferPercentage",
    "strategy",
    "enableSummarization",
    "warnThreshold"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/TokenBudgetConfig.json",
  "x-spec-version": "3.0.11"
}