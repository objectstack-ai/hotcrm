{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "owner": {
      "type": "string",
      "description": "Repository owner (organization or username)"
    },
    "name": {
      "type": "string",
      "description": "Repository name"
    },
    "defaultBranch": {
      "default": "main",
      "description": "Default branch name",
      "type": "string"
    },
    "autoMerge": {
      "default": false,
      "description": "Enable auto-merge for pull requests",
      "type": "boolean"
    },
    "branchProtection": {
      "description": "Branch protection configuration",
      "type": "object",
      "properties": {
        "requiredReviewers": {
          "default": 1,
          "description": "Required number of reviewers",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requireStatusChecks": {
          "default": true,
          "description": "Require status checks to pass",
          "type": "boolean"
        },
        "enforceAdmins": {
          "default": false,
          "description": "Enforce protections for admins",
          "type": "boolean"
        },
        "allowForcePushes": {
          "default": false,
          "description": "Allow force pushes",
          "type": "boolean"
        },
        "allowDeletions": {
          "default": false,
          "description": "Allow branch deletions",
          "type": "boolean"
        }
      },
      "required": [
        "requiredReviewers",
        "requireStatusChecks",
        "enforceAdmins",
        "allowForcePushes",
        "allowDeletions"
      ],
      "additionalProperties": false
    },
    "topics": {
      "description": "Repository topics",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "owner",
    "name",
    "defaultBranch",
    "autoMerge"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/integration/GitHubRepository.json",
  "x-spec-version": "3.0.11"
}