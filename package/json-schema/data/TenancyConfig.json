{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "description": "Enable multi-tenancy for this object"
    },
    "strategy": {
      "type": "string",
      "enum": [
        "shared",
        "isolated",
        "hybrid"
      ],
      "description": "Tenant isolation strategy: shared (single DB, row-level), isolated (separate DB per tenant), hybrid (mix)"
    },
    "tenantField": {
      "default": "tenant_id",
      "description": "Field name for tenant identifier",
      "type": "string"
    },
    "crossTenantAccess": {
      "default": false,
      "description": "Allow cross-tenant data access (with explicit permission)",
      "type": "boolean"
    }
  },
  "required": [
    "enabled",
    "strategy",
    "tenantField",
    "crossTenantAccess"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/data/TenancyConfig.json",
  "x-spec-version": "3.0.11"
}