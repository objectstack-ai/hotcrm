{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Loader identifier"
    },
    "protocol": {
      "type": "string",
      "enum": [
        "file:",
        "http:",
        "s3:",
        "datasource:",
        "memory:"
      ],
      "description": "Protocol identifier"
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "read": {
          "default": true,
          "type": "boolean"
        },
        "write": {
          "default": false,
          "type": "boolean"
        },
        "watch": {
          "default": false,
          "type": "boolean"
        },
        "list": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "read",
        "write",
        "watch",
        "list"
      ],
      "additionalProperties": false,
      "description": "Loader capabilities"
    },
    "supportedFormats": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "json",
          "yaml",
          "typescript",
          "javascript"
        ]
      },
      "description": "Supported formats"
    },
    "supportsWatch": {
      "default": false,
      "description": "Supports file watching",
      "type": "boolean"
    },
    "supportsWrite": {
      "default": true,
      "description": "Supports write operations",
      "type": "boolean"
    },
    "supportsCache": {
      "default": true,
      "description": "Supports caching",
      "type": "boolean"
    }
  },
  "required": [
    "name",
    "protocol",
    "capabilities",
    "supportedFormats",
    "supportsWatch",
    "supportsWrite",
    "supportsCache"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/MetadataLoaderContract.json",
  "x-spec-version": "3.0.11"
}