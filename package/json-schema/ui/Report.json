              },
              "columns": {
                "description": "Grid columns per breakpoint",
                "type": "object",
                "properties": {
                  "xs": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 12
                  },
                  "sm": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 12
                  },
                  "md": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 12
                  },
                  "lg": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 12
                  },
                  "xl": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 12
                  },
                  "2xl": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 12
                  }
