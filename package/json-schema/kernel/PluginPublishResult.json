{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "success": {
      "type": "boolean",
      "description": "Whether the publish succeeded"
    },
    "packageId": {
      "description": "Published package identifier",
      "type": "string"
    },
    "version": {
      "description": "Published version string",
      "type": "string"
    },
    "artifactUrl": {
      "description": "URL of the published artifact in the marketplace",
      "type": "string",
      "format": "uri"
    },
    "sha256": {
      "description": "SHA256 checksum of the uploaded artifact",
      "type": "string"
    },
    "submissionId": {
      "description": "Marketplace submission ID for review tracking",
      "type": "string"
    },
    "errorMessage": {
      "description": "Error message if publish failed",
      "type": "string"
    },
    "message": {
      "description": "Human-readable status message",
      "type": "string"
    }
  },
  "required": [
    "success"
  ],
  "additionalProperties": false,
  "description": "Result of the os plugin publish command",
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/PluginPublishResult.json",
  "x-spec-version": "3.0.11"
}