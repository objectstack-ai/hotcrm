{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Target cube name"
    },
    "relationship": {
      "default": "many_to_one",
      "type": "string",
      "enum": [
        "one_to_one",
        "one_to_many",
        "many_to_one"
      ]
    },
    "sql": {
      "type": "string",
      "description": "Join condition (ON clause)"
    }
  },
  "required": [
    "name",
    "relationship",
    "sql"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/data/CubeJoin.json",
  "x-spec-version": "3.0.11"
}