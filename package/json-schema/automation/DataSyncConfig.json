{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$",
      "description": "Sync configuration name (snake_case)"
    },
    "label": {
      "description": "Sync display name",
      "type": "string"
    },
    "description": {
      "description": "Sync description",
      "type": "string"
    },
    "source": {
      "type": "object",
      "properties": {
        "object": {
          "description": "ObjectStack object name",
          "type": "string"
        },
        "filters": {
          "description": "Filter conditions"
        },
        "fields": {
          "description": "Fields to sync",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "connectorInstanceId": {
          "description": "Connector instance ID",
          "type": "string"
        },
        "externalResource": {
          "description": "External resource ID",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "Data source"
    },
    "destination": {
      "type": "object",
      "properties": {
        "object": {
          "description": "ObjectStack object name",
          "type": "string"
        },
        "connectorInstanceId": {
          "description": "Connector instance ID",
          "type": "string"
        },
        "operation": {
          "type": "string",
          "enum": [
            "insert",
            "update",
            "upsert",
            "delete",
            "sync"
          ],
          "description": "Sync operation"
        },
        "mapping": {
          "description": "Field mappings",
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "description": "Source field name"
                  },
                  "target": {
                    "type": "string",
                    "description": "Target field name"
                  },
                  "transform": {
                    "description": "Transformation to apply",
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "constant"
                          },
                          "value": {
                            "description": "Constant value to use"
                          }
                        },
                        "required": [
                          "type",
                          "value"
                        ],
                        "additionalProperties": false,
                        "description": "Set a constant value"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "cast"
                          },
                          "targetType": {
                            "type": "string",
                            "enum": [
                              "string",
                              "number",
                              "boolean",
                              "date"
                            ],
                            "description": "Target data type"
                          }
                        },
                        "required": [
                          "type",
                          "targetType"
                        ],
                        "additionalProperties": false,
                        "description": "Cast to a specific data type"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "lookup"
                          },
                          "table": {
                            "type": "string",
                            "description": "Lookup table name"
                          },
                          "keyField": {
                            "type": "string",
                            "description": "Field to match on"
                          },
                          "valueField": {
                            "type": "string",
                            "description": "Field to retrieve"
                          }
                        },
                        "required": [
                          "type",
                          "table",
                          "keyField",
                          "valueField"
                        ],
                        "additionalProperties": false,
                        "description": "Lookup value from another table"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "javascript"
                          },
                          "expression": {
                            "type": "string",
                            "description": "JavaScript expression (e.g., \"value.toUpperCase()\")"
                          }
                        },
                        "required": [
                          "type",
                          "expression"
                        ],
                        "additionalProperties": false,
                        "description": "Custom JavaScript transformation"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "map"
                          },
                          "mappings": {
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {},
                            "description": "Value mappings (e.g., {\"Active\": \"active\"})"
                          }
                        },
                        "required": [
                          "type",
                          "mappings"
                        ],
                        "additionalProperties": false,
                        "description": "Map values using a dictionary"
                      }
                    ]
                  },
                  "defaultValue": {
                    "description": "Default if source is null/undefined"
                  }
                },
                "required": [
                  "source",
                  "target"
                ],
                "additionalProperties": false
              }
            }
          ]
        },
        "externalResource": {
          "description": "External resource ID",
          "type": "string"
        },
        "matchKey": {
          "description": "Match key fields",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "operation"
      ],
      "additionalProperties": false,
      "description": "Data destination"
    },
    "direction": {
      "default": "push",
      "description": "Sync direction",
      "type": "string",
      "enum": [
        "push",
        "pull",
        "bidirectional"
      ]
    },
    "syncMode": {
      "default": "incremental",
      "description": "Sync mode",
      "type": "string",
      "enum": [
        "full",
        "incremental",
        "realtime"
      ]
    },
    "conflictResolution": {
      "default": "latest_wins",
      "description": "Conflict resolution",
      "type": "string",
      "enum": [
        "source_wins",
        "destination_wins",
        "latest_wins",
        "manual",
        "merge"
      ]
    },
    "schedule": {
      "description": "Cron schedule",
      "type": "string"
    },
    "enabled": {
      "default": true,
      "description": "Sync enabled",
      "type": "boolean"
    },
    "changeTrackingField": {
      "description": "Field for change tracking",
      "type": "string"
    },
    "batchSize": {
      "default": 100,
      "description": "Batch size for processing",
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "retry": {
      "description": "Retry configuration",
      "type": "object",
      "properties": {
        "maxAttempts": {
          "default": 3,
          "description": "Max retries",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "backoffMs": {
          "default": 30000,
          "description": "Backoff duration",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "maxAttempts",
        "backoffMs"
      ],
      "additionalProperties": false
    },
    "validation": {
      "description": "Validation rules",
      "type": "object",
      "properties": {
        "required": {
          "description": "Required fields",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unique": {
          "description": "Unique constraint fields",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "custom": {
          "description": "Custom validation rules",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "condition": {
                "type": "string",
                "description": "Validation condition"
              },
              "message": {
                "type": "string",
                "description": "Error message"
              }
            },
            "required": [
              "name",
              "condition",
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "errorHandling": {
      "description": "Error handling",
      "type": "object",
      "properties": {
        "onValidationError": {
          "default": "skip",
          "type": "string",
          "enum": [
            "skip",
            "fail",
            "log"
          ]
        },
        "onSyncError": {
          "default": "retry",
          "type": "string",
          "enum": [
            "skip",
            "fail",
            "retry"
          ]
        },
        "notifyOnError": {
          "description": "Email notifications",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "onValidationError",
        "onSyncError"
      ],
      "additionalProperties": false
    },
    "optimization": {
      "description": "Performance optimization",
      "type": "object",
      "properties": {
        "parallelBatches": {
          "default": false,
          "description": "Process batches in parallel",
          "type": "boolean"
        },
        "cacheEnabled": {
          "default": true,
          "description": "Enable caching",
          "type": "boolean"
        },
        "compressionEnabled": {
          "default": false,
          "description": "Enable compression",
          "type": "boolean"
        }
      },
      "required": [
        "parallelBatches",
        "cacheEnabled",
        "compressionEnabled"
      ],
      "additionalProperties": false
    },
    "audit": {
      "description": "Audit configuration",
      "type": "object",
      "properties": {
        "logLevel": {
          "default": "info",
          "type": "string",
          "enum": [
            "none",
            "error",
            "warn",
            "info",
            "debug"
          ]
        },
        "retainLogsForDays": {
          "default": 30,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "trackChanges": {
          "default": true,
          "description": "Track all changes",
          "type": "boolean"
        }
      },
      "required": [
        "logLevel",
        "retainLogsForDays",
        "trackChanges"
      ],
      "additionalProperties": false
    },
    "tags": {
      "description": "Sync tags",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "description": "Custom metadata",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "name",
    "source",
    "destination",
    "direction",
    "syncMode",
    "conflictResolution",
    "enabled",
    "batchSize"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/automation/DataSyncConfig.json",
  "x-spec-version": "3.0.11"
}