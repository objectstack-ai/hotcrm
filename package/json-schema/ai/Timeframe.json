{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "absolute",
        "relative"
      ]
    },
    "start": {
      "description": "Start date (ISO format)",
      "type": "string"
    },
    "end": {
      "description": "End date (ISO format)",
      "type": "string"
    },
    "relative": {
      "type": "object",
      "properties": {
        "unit": {
          "type": "string",
          "enum": [
            "hour",
            "day",
            "week",
            "month",
            "quarter",
            "year"
          ]
        },
        "value": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "direction": {
          "default": "past",
          "type": "string",
          "enum": [
            "past",
            "future",
            "current"
          ]
        }
      },
      "required": [
        "unit",
        "value",
        "direction"
      ],
      "additionalProperties": false
    },
    "text": {
      "type": "string",
      "description": "Original timeframe text"
    }
  },
  "required": [
    "type",
    "text"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/Timeframe.json",
  "x-spec-version": "3.0.11"
}