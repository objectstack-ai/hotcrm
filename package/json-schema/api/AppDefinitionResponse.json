            "height": {
              "default": "600px",
              "description": "Embed height (CSS value)",
              "type": "string"
            },
            "showHeader": {
              "default": true,
              "description": "Show interface header in embed",
              "type": "boolean"
            },
            "showNavigation": {
              "default": false,
              "description": "Show navigation in embed",
              "type": "boolean"
            },
            "responsive": {
              "default": true,
