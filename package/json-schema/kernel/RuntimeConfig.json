{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "engine": {
      "default": "v8-isolate",
      "description": "Execution environment engine",
      "type": "string",
      "enum": [
        "v8-isolate",
        "wasm",
        "container",
        "process"
      ]
    },
    "engineConfig": {
      "type": "object",
      "properties": {
        "wasm": {
          "type": "object",
          "properties": {
            "maxMemoryPages": {
              "description": "Maximum WASM memory pages (64KB each)",
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "instructionLimit": {
              "description": "Maximum instructions before timeout",
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "enableSimd": {
              "default": false,
              "description": "Enable WebAssembly SIMD support",
              "type": "boolean"
            },
            "enableThreads": {
              "default": false,
              "description": "Enable WebAssembly threads",
              "type": "boolean"
            },
            "enableBulkMemory": {
              "default": true,
              "description": "Enable bulk memory operations",
              "type": "boolean"
            }
          },
          "required": [
            "enableSimd",
            "enableThreads",
            "enableBulkMemory"
          ],
          "additionalProperties": false
        },
        "container": {
          "type": "object",
          "properties": {
            "image": {
              "description": "Container image to use",
              "type": "string"
            },
            "runtime": {
              "default": "docker",
              "type": "string",
              "enum": [
                "docker",
                "podman",
                "containerd"
              ]
            },
            "resources": {
              "type": "object",
              "properties": {
                "cpuLimit": {
                  "description": "CPU limit (e.g., \"0.5\", \"2\")",
                  "type": "string"
                },
                "memoryLimit": {
                  "description": "Memory limit (e.g., \"512m\", \"1g\")",
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "networkMode": {
              "default": "bridge",
              "type": "string",
              "enum": [
                "none",
                "bridge",
                "host"
              ]
            }
          },
          "required": [
            "runtime",
            "networkMode"
          ],
          "additionalProperties": false
        },
        "v8Isolate": {
          "type": "object",
          "properties": {
            "heapSizeMb": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "enableSnapshot": {
              "default": true,
              "type": "boolean"
            }
          },
          "required": [
            "enableSnapshot"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "resourceLimits": {
      "type": "object",
      "properties": {
        "maxMemory": {
          "description": "Maximum memory allocation",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "maxCpu": {
          "description": "Maximum CPU usage percentage",
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "timeout": {
          "description": "Maximum execution time",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "engine"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/RuntimeConfig.json",
  "x-spec-version": "3.0.11"
}