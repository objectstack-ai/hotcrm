{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "severity": {
      "type": "string",
      "enum": [
        "error",
        "warning",
        "info"
      ],
      "description": "Issue severity"
    },
    "path": {
      "type": "string",
      "description": "Entity path (e.g., objects.project_task.fields.name)"
    },
    "message": {
      "type": "string",
      "description": "Issue description"
    },
    "code": {
      "description": "Validation error code",
      "type": "string"
    }
  },
  "required": [
    "severity",
    "path",
    "message"
  ],
  "additionalProperties": false,
  "description": "Validation issue",
  "$id": "https://schema.objectstack.io/v3.0.11/system/DeployValidationIssue.json",
  "x-spec-version": "3.0.11"
}