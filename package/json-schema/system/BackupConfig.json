{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "strategy": {
      "default": "incremental",
      "description": "Backup strategy",
      "type": "string",
      "enum": [
        "full",
        "incremental",
        "differential"
      ]
    },
    "schedule": {
      "description": "Cron expression for backup schedule (e.g., \"0 2 * * *\")",
      "type": "string"
    },
    "retention": {
      "type": "object",
      "properties": {
        "days": {
          "type": "number",
          "minimum": 1,
          "description": "Retention period in days"
        },
        "minCopies": {
          "default": 3,
          "description": "Minimum backup copies to retain",
          "type": "number",
          "minimum": 1
        },
        "maxCopies": {
          "description": "Maximum backup copies to store",
          "type": "number"
        }
      },
      "required": [
        "days",
        "minCopies"
      ],
      "additionalProperties": false,
      "description": "Backup retention policy"
    },
    "destination": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "s3",
            "gcs",
            "azure_blob",
            "local"
          ],
          "description": "Storage backend type"
        },
        "bucket": {
          "description": "Cloud storage bucket/container name",
          "type": "string"
        },
        "path": {
          "description": "Storage path prefix",
          "type": "string"
        },
        "region": {
          "description": "Cloud storage region",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "description": "Backup storage destination"
    },
    "encryption": {
      "description": "Backup encryption settings",
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Enable backup encryption",
          "type": "boolean"
        },
        "algorithm": {
          "default": "AES-256-GCM",
          "description": "Encryption algorithm",
          "type": "string",
          "enum": [
            "AES-256-GCM",
            "AES-256-CBC",
            "ChaCha20-Poly1305"
          ]
        },
        "keyId": {
          "description": "KMS key ID for encryption",
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "algorithm"
      ],
      "additionalProperties": false
    },
    "compression": {
      "description": "Backup compression settings",
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Enable backup compression",
          "type": "boolean"
        },
        "algorithm": {
          "default": "zstd",
          "description": "Compression algorithm",
          "type": "string",
          "enum": [
            "gzip",
            "zstd",
            "lz4",
            "snappy"
          ]
        }
      },
      "required": [
        "enabled",
        "algorithm"
      ],
      "additionalProperties": false
    },
    "verifyAfterBackup": {
      "default": true,
      "description": "Verify backup integrity after creation",
      "type": "boolean"
    }
  },
  "required": [
    "strategy",
    "retention",
    "destination",
    "verifyAfterBackup"
  ],
  "additionalProperties": false,
  "description": "Backup configuration",
  "$id": "https://schema.objectstack.io/v3.0.11/system/BackupConfig.json",
  "x-spec-version": "3.0.11"
}