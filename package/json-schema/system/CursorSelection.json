{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "anchor": {
      "type": "object",
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Anchor line number"
        },
        "column": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Anchor column number"
        }
      },
      "required": [
        "line",
        "column"
      ],
      "additionalProperties": false,
      "description": "Selection anchor (start point)"
    },
    "focus": {
      "type": "object",
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Focus line number"
        },
        "column": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Focus column number"
        }
      },
      "required": [
        "line",
        "column"
      ],
      "additionalProperties": false,
      "description": "Selection focus (end point)"
    },
    "direction": {
      "description": "Selection direction",
      "type": "string",
      "enum": [
        "forward",
        "backward"
      ]
    }
  },
  "required": [
    "anchor",
    "focus"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/system/CursorSelection.json",
  "x-spec-version": "3.0.11"
}