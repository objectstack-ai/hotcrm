{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique executor plugin identifier"
    },
    "name": {
      "type": "string",
      "description": "Display name"
    },
    "nodeTypes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "FlowNodeAction types this executor handles"
    },
    "version": {
      "type": "string",
      "description": "Plugin version (semver)"
    },
    "description": {
      "description": "Executor description",
      "type": "string"
    },
    "supportsPause": {
      "default": false,
      "description": "Whether the executor supports async pause/resume",
      "type": "boolean"
    },
    "supportsCancellation": {
      "default": false,
      "description": "Whether the executor supports mid-execution cancellation",
      "type": "boolean"
    },
    "supportsRetry": {
      "default": true,
      "description": "Whether the executor supports retry on failure",
      "type": "boolean"
    },
    "configSchemaRef": {
      "description": "JSON Schema $ref for executor-specific config",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "nodeTypes",
    "version",
    "supportsPause",
    "supportsCancellation",
    "supportsRetry"
  ],
  "additionalProperties": false,
  "description": "Node executor plugin descriptor",
  "$id": "https://schema.objectstack.io/v3.0.11/automation/NodeExecutorDescriptor.json",
  "x-spec-version": "3.0.11"
}