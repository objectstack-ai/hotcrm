{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "create_record",
        "update_record",
        "delete_record",
        "read_record",
        "query_records",
        "api_call",
        "run_script",
        "wait"
      ],
      "description": "The action type to execute"
    },
    "target": {
      "type": "string",
      "description": "Target Object, API Endpoint, or Function Name"
    },
    "payload": {
      "description": "Data to send or use",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "user": {
      "description": "Run as specific user/role for impersonation testing",
      "type": "string"
    }
  },
  "required": [
    "type",
    "target"
  ],
  "additionalProperties": false,
  "description": "A single test action to execute against the system",
  "$id": "https://schema.objectstack.io/v3.0.11/qa/TestAction.json",
  "x-spec-version": "3.0.11"
}