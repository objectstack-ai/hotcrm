{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "description": "Static JSON Schema definition"
    },
    {
      "type": "object",
      "properties": {
        "$ref": {
          "type": "object",
          "properties": {
            "objectId": {
              "type": "string",
              "minLength": 2,
              "pattern": "^[a-z][a-z0-9_]*$",
              "description": "Object name to reference"
            },
            "includeFields": {
              "description": "Include only these fields in the schema",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "excludeFields": {
              "description": "Exclude these fields from the schema",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "includeRelated": {
              "description": "Include related objects via lookup fields",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "objectId"
          ],
          "additionalProperties": false,
          "description": "Dynamic reference to ObjectQL object"
        }
      },
      "required": [
        "$ref"
      ],
      "additionalProperties": false,
      "description": "Dynamic ObjectQL reference"
    }
  ],
  "$id": "https://schema.objectstack.io/v3.0.11/api/SchemaDefinition.json",
  "x-spec-version": "3.0.11"
}