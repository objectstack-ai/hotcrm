{
  "name": "@hotcrm/support",
  "version": "1.0.0",
  "type": "module",
  "description": "Support module - Case and Knowledge management",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "objectstack dev",
    "start": "objectstack serve",
    "build": "tsc && objectstack compile",
    "typecheck": "tsc --noEmit",
    "test": "objectstack test"
  },
  "keywords": [
    "crm",
    "support",
    "cases",
    "knowledge"
  ],
  "author": "HotCRM Team",
  "dependencies": {
    "@objectstack/spec": "^4.0.3"
  },
  "devDependencies": {
    "@objectstack/cli": "^4.0.3",
    "typescript": "^6.0.2"
  }
}
