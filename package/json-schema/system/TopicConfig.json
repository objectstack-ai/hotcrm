{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Topic name identifier"
    },
    "partitions": {
      "default": 1,
      "description": "Number of partitions for parallel consumption",
      "type": "number"
    },
    "replicationFactor": {
      "default": 1,
      "description": "Number of replicas for fault tolerance",
      "type": "number"
    },
    "retentionMs": {
      "description": "Message retention period in milliseconds",
      "type": "number"
    },
    "compressionType": {
      "default": "none",
      "description": "Message compression algorithm",
      "type": "string",
      "enum": [
        "none",
        "gzip",
        "snappy",
        "lz4"
      ]
    }
  },
  "required": [
    "name",
    "partitions",
    "replicationFactor",
    "compressionType"
  ],
  "additionalProperties": false,
  "description": "Configuration for a message queue topic",
  "$id": "https://schema.objectstack.io/v3.0.11/system/TopicConfig.json",
  "x-spec-version": "3.0.11"
}