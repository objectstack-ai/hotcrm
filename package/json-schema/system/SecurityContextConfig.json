{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": true,
      "description": "Enable unified security context governance",
      "type": "boolean"
    },
    "complianceAuditRequirements": {
      "description": "Compliance-driven audit event requirements",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "framework": {
            "type": "string",
            "enum": [
              "gdpr",
              "hipaa",
              "sox",
              "pci_dss",
              "ccpa",
              "iso27001"
            ],
            "description": "Compliance framework identifier"
          },
          "requiredEvents": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Audit event types required by this framework (e.g., \"data.delete\", \"auth.login\")"
          },
          "retentionDays": {
            "type": "number",
            "minimum": 1,
            "description": "Minimum audit log retention period required by this framework (in days)"
          },
          "alertOnMissing": {
            "default": true,
            "description": "Raise alert if a required audit event is not being captured",
            "type": "boolean"
          }
        },
        "required": [
          "framework",
          "requiredEvents",
          "retentionDays",
          "alertOnMissing"
        ],
        "additionalProperties": false,
        "description": "Compliance framework audit event requirements"
      }
    },
    "complianceEncryptionRequirements": {
      "description": "Compliance-driven encryption requirements by data classification",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "framework": {
            "type": "string",
            "enum": [
              "gdpr",
              "hipaa",
              "sox",
              "pci_dss",
              "ccpa",
              "iso27001"
            ],
            "description": "Compliance framework identifier"
          },
          "dataClassifications": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "pii",
                "phi",
                "pci",
                "financial",
                "confidential",
                "internal",
                "public"
              ],
              "description": "Data classification level"
            },
            "description": "Data classifications that must be encrypted under this framework"
          },
          "minimumAlgorithm": {
            "default": "aes-256-gcm",
            "description": "Minimum encryption algorithm strength required",
            "type": "string",
            "enum": [
              "aes-256-gcm",
              "aes-256-cbc",
              "chacha20-poly1305"
            ]
          },
          "keyRotationMaxDays": {
            "default": 90,
            "description": "Maximum key rotation interval required (in days)",
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "framework",
          "dataClassifications",
          "minimumAlgorithm",
          "keyRotationMaxDays"
        ],
        "additionalProperties": false,
        "description": "Compliance framework encryption requirements"
      }
    },
    "maskingVisibility": {
      "description": "Masking visibility rules per data classification",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dataClassification": {
            "type": "string",
            "enum": [
              "pii",
              "phi",
              "pci",
              "financial",
              "confidential",
              "internal",
              "public"
            ],
            "description": "Data classification this rule applies to"
          },
          "defaultMasked": {
            "default": true,
            "description": "Whether data is masked by default",
            "type": "boolean"
          },
          "unmaskRoles": {
            "description": "Roles allowed to view unmasked data",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "auditUnmask": {
            "default": true,
            "description": "Log an audit event when data is unmasked",
            "type": "boolean"
          },
          "requireApproval": {
            "default": false,
            "description": "Require explicit approval before unmasking",
            "type": "boolean"
          },
          "approvalRoles": {
            "description": "Roles that can approve unmasking requests",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "dataClassification",
          "defaultMasked",
          "auditUnmask",
          "requireApproval"
        ],
        "additionalProperties": false,
        "description": "Masking visibility and audit rule per data classification"
      }
    },
    "dataClassifications": {
      "description": "Data classification policies for unified security enforcement",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "classification": {
            "type": "string",
            "enum": [
              "pii",
              "phi",
              "pci",
              "financial",
              "confidential",
              "internal",
              "public"
            ],
            "description": "Data classification level"
          },
          "requireEncryption": {
            "default": false,
            "description": "Encryption required for this classification",
            "type": "boolean"
          },
          "requireMasking": {
            "default": false,
            "description": "Masking required for this classification",
            "type": "boolean"
          },
          "requireAudit": {
            "default": false,
            "description": "Audit trail required for access to this classification",
            "type": "boolean"
          },
          "retentionDays": {
            "description": "Data retention limit in days (for compliance)",
            "type": "number"
          }
        },
        "required": [
          "classification",
          "requireEncryption",
          "requireMasking",
          "requireAudit"
        ],
        "additionalProperties": false,
        "description": "Security policy for a specific data classification level"
      }
    },
    "eventCorrelation": {
      "description": "Cross-subsystem security event correlation settings",
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Enable cross-subsystem security event correlation",
          "type": "boolean"
        },
        "correlationId": {
          "default": true,
          "description": "Inject a shared correlation ID into audit, encryption, and masking events",
          "type": "boolean"
        },
        "linkAuthToAudit": {
          "default": true,
          "description": "Link authentication events to subsequent data operation audit trails",
          "type": "boolean"
        },
        "linkEncryptionToAudit": {
          "default": true,
          "description": "Log encryption/decryption operations in the audit trail",
          "type": "boolean"
        },
        "linkMaskingToAudit": {
          "default": true,
          "description": "Log masking/unmasking operations in the audit trail",
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "correlationId",
        "linkAuthToAudit",
        "linkEncryptionToAudit",
        "linkMaskingToAudit"
      ],
      "additionalProperties": false
    },
    "enforceOnWrite": {
      "default": true,
      "description": "Enforce encryption and masking requirements on data write operations",
      "type": "boolean"
    },
    "enforceOnRead": {
      "default": true,
      "description": "Enforce masking and audit requirements on data read operations",
      "type": "boolean"
    },
    "failOpen": {
      "default": false,
      "description": "When false (default), deny access if security context cannot be evaluated",
      "type": "boolean"
    }
  },
  "required": [
    "enabled",
    "enforceOnWrite",
    "enforceOnRead",
    "failOpen"
  ],
  "additionalProperties": false,
  "description": "Unified security context governance configuration",
  "$id": "https://schema.objectstack.io/v3.0.11/system/SecurityContextConfig.json",
  "x-spec-version": "3.0.11"
}