{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "downloadUrl": {
      "type": "string",
      "format": "uri",
      "description": "Artifact download URL (may be pre-signed)"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA256 checksum for verification"
    },
    "size": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "Artifact size in bytes"
    },
    "format": {
      "type": "string",
      "enum": [
        "tgz",
        "zip"
      ],
      "description": "Artifact format"
    },
    "expiresAt": {
      "description": "URL expiration timestamp for pre-signed URLs",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "downloadUrl",
    "sha256",
    "size",
    "format"
  ],
  "additionalProperties": false,
  "description": "Artifact download response with integrity metadata",
  "$id": "https://schema.objectstack.io/v3.0.11/cloud/ArtifactDownloadResponse.json",
  "x-spec-version": "3.0.11"
}