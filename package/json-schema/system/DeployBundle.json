{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "manifest": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "Deployment version"
        },
        "checksum": {
          "description": "SHA256 checksum",
          "type": "string"
        },
        "objects": {
          "default": [],
          "description": "Object names included",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "views": {
          "default": [],
          "description": "View names included",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "flows": {
          "default": [],
          "description": "Flow names included",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "permissions": {
          "default": [],
          "description": "Permission names included",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "createdAt": {
          "description": "Bundle creation time",
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        }
      },
      "required": [
        "version",
        "objects",
        "views",
        "flows",
        "permissions"
      ],
      "additionalProperties": false,
      "description": "Deployment manifest"
    },
    "objects": {
      "default": [],
      "description": "Object definitions",
      "type": "array",
      "items": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    },
    "views": {
      "default": [],
      "description": "View definitions",
      "type": "array",
      "items": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    },
    "flows": {
      "default": [],
      "description": "Flow definitions",
      "type": "array",
      "items": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    },
    "permissions": {
      "default": [],
      "description": "Permission definitions",
      "type": "array",
      "items": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    },
    "seedData": {
      "default": [],
      "description": "Seed data records",
      "type": "array",
      "items": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "manifest",
    "objects",
    "views",
    "flows",
    "permissions",
    "seedData"
  ],
  "additionalProperties": false,
  "description": "Deploy bundle containing all metadata for deployment",
  "$id": "https://schema.objectstack.io/v3.0.11/system/DeployBundle.json",
  "x-spec-version": "3.0.11"
}