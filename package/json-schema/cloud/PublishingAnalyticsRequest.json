{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "listingId": {
      "type": "string",
      "description": "Listing to get analytics for"
    },
    "timeRange": {
      "default": "last_30d",
      "type": "string",
      "enum": [
        "last_7d",
        "last_30d",
        "last_90d",
        "last_365d",
        "all_time"
      ]
    },
    "metrics": {
      "description": "Metrics to include (default: all)",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "installs",
          "uninstalls",
          "active_installs",
          "ratings",
          "revenue",
          "page_views"
        ]
      }
    }
  },
  "required": [
    "listingId",
    "timeRange"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/cloud/PublishingAnalyticsRequest.json",
  "x-spec-version": "3.0.11"
}