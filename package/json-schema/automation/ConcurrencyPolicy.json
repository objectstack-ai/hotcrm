{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "maxConcurrent": {
      "default": 1,
      "description": "Maximum number of concurrent executions allowed",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "onConflict": {
      "default": "queue",
      "description": "queue = enqueue for later, reject = fail immediately, cancel_existing = stop running instance",
      "type": "string",
      "enum": [
        "queue",
        "reject",
        "cancel_existing"
      ]
    },
    "lockScope": {
      "default": "global",
      "description": "Scope of the concurrency lock",
      "type": "string",
      "enum": [
        "global",
        "per_record",
        "per_user"
      ]
    },
    "queueTimeoutMs": {
      "description": "Maximum time to wait in queue before timing out (ms)",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "maxConcurrent",
    "onConflict",
    "lockScope"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/automation/ConcurrencyPolicy.json",
  "x-spec-version": "3.0.11"
}