{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "maxRetries": {
      "default": 3,
      "description": "Maximum number of retry attempts",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "backoffMs": {
      "default": 1000,
      "description": "Initial backoff delay in milliseconds",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "backoffMultiplier": {
      "default": 2,
      "description": "Multiplier for exponential backoff",
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "required": [
    "maxRetries",
    "backoffMs",
    "backoffMultiplier"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/system/RetryPolicy.json",
  "x-spec-version": "3.0.11"
}