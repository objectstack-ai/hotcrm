{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "protocol": {
      "type": "string",
      "enum": [
        "file:",
        "http:",
        "s3:",
        "datasource:",
        "memory:"
      ],
      "description": "Loader protocol identifier"
    },
    "description": {
      "type": "string"
    },
    "supportedFormats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supportsWatch": {
      "type": "boolean"
    },
    "supportsWrite": {
      "type": "boolean"
    },
    "supportsCache": {
      "type": "boolean"
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "read": {
          "default": true,
          "type": "boolean"
        },
        "write": {
          "default": false,
          "type": "boolean"
        },
        "watch": {
          "default": false,
          "type": "boolean"
        },
        "list": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "read",
        "write",
        "watch",
        "list"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "protocol",
    "capabilities"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/system/MetadataLoaderContract.json",
  "x-spec-version": "3.0.11"
}