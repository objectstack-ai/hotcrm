{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "webhooks": {
      "description": "OpenAPI 3.1 webhooks (top-level webhook definitions)",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_]*$",
            "description": "Webhook event identifier (snake_case)"
          },
          "description": {
            "type": "string",
            "description": "Human-readable event description"
          },
          "method": {
            "default": "POST",
            "description": "HTTP method for webhook delivery",
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "DELETE",
              "PATCH",
              "HEAD",
              "OPTIONS"
            ]
          },
          "payloadSchema": {
            "type": "string",
            "description": "JSON Schema $ref for the webhook payload"
          },
          "headers": {
            "description": "Custom headers to include in webhook delivery",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "security": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "hmac_sha256",
                "basic",
                "bearer",
                "api_key"
              ]
            },
            "description": "Supported authentication methods for webhook verification"
          }
        },
        "required": [
          "name",
          "description",
          "method",
          "payloadSchema",
          "security"
        ],
        "additionalProperties": false
      }
    },
    "callbacks": {
      "description": "OpenAPI 3.1 callbacks (async response definitions)",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]*$",
              "description": "Callback identifier (snake_case)"
            },
            "expression": {
              "type": "string",
              "description": "Runtime expression (e.g., {$request.body#/callbackUrl})"
            },
            "method": {
              "type": "string",
              "enum": [
                "GET",
                "POST",
                "PUT",
                "DELETE",
                "PATCH",
                "HEAD",
                "OPTIONS"
              ],
              "description": "HTTP method for callback request"
            },
            "url": {
              "type": "string",
              "description": "Callback URL template with runtime expressions"
            }
          },
          "required": [
            "name",
            "expression",
            "method",
            "url"
          ],
          "additionalProperties": false
        }
      }
    },
    "jsonSchemaDialect": {
      "default": "https://json-schema.org/draft/2020-12/schema",
      "description": "JSON Schema dialect for schema definitions",
      "type": "string"
    },
    "pathItemReferences": {
      "default": false,
      "description": "Allow $ref in path items (OpenAPI 3.1 feature)",
      "type": "boolean"
    }
  },
  "required": [
    "jsonSchemaDialect",
    "pathItemReferences"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/OpenApi31Extensions.json",
  "x-spec-version": "3.0.11"
}