{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "field": {
      "type": "string",
      "description": "Data field key"
    },
    "title": {
      "description": "Axis display title",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Translation key (e.g., \"views.task_list.label\")"
            },
            "defaultValue": {
              "description": "Fallback value when translation key is not found",
              "type": "string"
            },
            "params": {
              "description": "Interpolation parameters (e.g., { count: 5 })",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        }
      ]
    },
    "format": {
      "description": "Value format string (e.g., \"$0,0.00\")",
      "type": "string"
    },
    "min": {
      "description": "Minimum value",
      "type": "number"
    },
    "max": {
      "description": "Maximum value",
      "type": "number"
    },
    "stepSize": {
      "description": "Step size for ticks",
      "type": "number"
    },
    "showGridLines": {
      "default": true,
      "type": "boolean"
    },
    "position": {
      "description": "Axis position",
      "type": "string",
      "enum": [
        "left",
        "right",
        "top",
        "bottom"
      ]
    },
    "logarithmic": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "field",
    "showGridLines",
    "logarithmic"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ui/ChartAxis.json",
  "x-spec-version": "3.0.11"
}