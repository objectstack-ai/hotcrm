{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Unique theme identifier (snake_case)"
    },
    "label": {
      "type": "string",
      "description": "Human-readable theme name"
    },
    "description": {
      "description": "Theme description",
      "type": "string"
    },
    "mode": {
      "default": "light",
      "description": "Theme mode (light, dark, or auto)",
      "type": "string",
      "enum": [
        "light",
        "dark",
        "auto"
      ]
    },
    "colors": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "string",
          "description": "Primary brand color (hex, rgb, or hsl)"
        },
        "secondary": {
          "description": "Secondary brand color",
          "type": "string"
        },
        "accent": {
          "description": "Accent color for highlights",
          "type": "string"
        },
        "success": {
          "description": "Success state color (default: green)",
          "type": "string"
        },
        "warning": {
          "description": "Warning state color (default: yellow)",
          "type": "string"
        },
        "error": {
          "description": "Error state color (default: red)",
          "type": "string"
        },
        "info": {
          "description": "Info state color (default: blue)",
          "type": "string"
        },
        "background": {
          "description": "Background color",
          "type": "string"
        },
        "surface": {
          "description": "Surface/card background color",
          "type": "string"
        },
        "text": {
          "description": "Primary text color",
          "type": "string"
        },
        "textSecondary": {
          "description": "Secondary text color",
          "type": "string"
        },
        "border": {
          "description": "Border color",
          "type": "string"
        },
        "disabled": {
          "description": "Disabled state color",
          "type": "string"
        },
        "primaryLight": {
          "description": "Lighter shade of primary",
          "type": "string"
        },
        "primaryDark": {
          "description": "Darker shade of primary",
          "type": "string"
        },
        "secondaryLight": {
          "description": "Lighter shade of secondary",
          "type": "string"
        },
        "secondaryDark": {
          "description": "Darker shade of secondary",
          "type": "string"
        }
      },
      "required": [
        "primary"
      ],
      "additionalProperties": false,
      "description": "Color palette configuration"
    },
    "typography": {
      "description": "Typography settings",
      "type": "object",
      "properties": {
        "fontFamily": {
          "type": "object",
          "properties": {
            "base": {
              "description": "Base font family (default: system fonts)",
              "type": "string"
            },
            "heading": {
              "description": "Heading font family",
              "type": "string"
            },
            "mono": {
              "description": "Monospace font family for code",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "fontSize": {
          "type": "object",
          "properties": {
            "xs": {
              "description": "Extra small font size (e.g., 0.75rem)",
              "type": "string"
            },
            "sm": {
              "description": "Small font size (e.g., 0.875rem)",
              "type": "string"
            },
            "base": {
              "description": "Base font size (e.g., 1rem)",
              "type": "string"
            },
            "lg": {
              "description": "Large font size (e.g., 1.125rem)",
              "type": "string"
            },
            "xl": {
              "description": "Extra large font size (e.g., 1.25rem)",
              "type": "string"
            },
            "2xl": {
              "description": "2X large font size (e.g., 1.5rem)",
              "type": "string"
            },
            "3xl": {
              "description": "3X large font size (e.g., 1.875rem)",
              "type": "string"
            },
            "4xl": {
              "description": "4X large font size (e.g., 2.25rem)",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "fontWeight": {
          "type": "object",
          "properties": {
            "light": {
              "description": "Light weight (default: 300)",
              "type": "number"
            },
            "normal": {
              "description": "Normal weight (default: 400)",
              "type": "number"
            },
            "medium": {
              "description": "Medium weight (default: 500)",
              "type": "number"
            },
            "semibold": {
              "description": "Semibold weight (default: 600)",
              "type": "number"
            },
            "bold": {
              "description": "Bold weight (default: 700)",
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "lineHeight": {
          "type": "object",
          "properties": {
            "tight": {
              "description": "Tight line height (e.g., 1.25)",
              "type": "string"
            },
            "normal": {
              "description": "Normal line height (e.g., 1.5)",
              "type": "string"
            },
            "relaxed": {
              "description": "Relaxed line height (e.g., 1.75)",
              "type": "string"
            },
            "loose": {
              "description": "Loose line height (e.g., 2)",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "letterSpacing": {
          "type": "object",
          "properties": {
            "tighter": {
              "description": "Tighter letter spacing (e.g., -0.05em)",
              "type": "string"
            },
            "tight": {
              "description": "Tight letter spacing (e.g., -0.025em)",
              "type": "string"
            },
            "normal": {
              "description": "Normal letter spacing (e.g., 0)",
              "type": "string"
            },
            "wide": {
              "description": "Wide letter spacing (e.g., 0.025em)",
              "type": "string"
            },
            "wider": {
              "description": "Wider letter spacing (e.g., 0.05em)",
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "spacing": {
      "description": "Spacing scale",
      "type": "object",
      "properties": {
        "0": {
          "description": "0 spacing (0)",
          "type": "string"
        },
        "1": {
          "description": "Spacing unit 1 (e.g., 0.25rem)",
          "type": "string"
        },
        "2": {
          "description": "Spacing unit 2 (e.g., 0.5rem)",
          "type": "string"
        },
        "3": {
          "description": "Spacing unit 3 (e.g., 0.75rem)",
          "type": "string"
        },
        "4": {
          "description": "Spacing unit 4 (e.g., 1rem)",
          "type": "string"
        },
        "5": {
          "description": "Spacing unit 5 (e.g., 1.25rem)",
          "type": "string"
        },
        "6": {
          "description": "Spacing unit 6 (e.g., 1.5rem)",
          "type": "string"
        },
        "8": {
          "description": "Spacing unit 8 (e.g., 2rem)",
          "type": "string"
        },
        "10": {
          "description": "Spacing unit 10 (e.g., 2.5rem)",
          "type": "string"
        },
        "12": {
          "description": "Spacing unit 12 (e.g., 3rem)",
          "type": "string"
        },
        "16": {
          "description": "Spacing unit 16 (e.g., 4rem)",
          "type": "string"
        },
        "20": {
          "description": "Spacing unit 20 (e.g., 5rem)",
          "type": "string"
        },
        "24": {
          "description": "Spacing unit 24 (e.g., 6rem)",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "borderRadius": {
      "description": "Border radius scale",
      "type": "object",
      "properties": {
        "none": {
          "description": "No border radius (0)",
          "type": "string"
        },
        "sm": {
          "description": "Small border radius (e.g., 0.125rem)",
          "type": "string"
        },
        "base": {
          "description": "Base border radius (e.g., 0.25rem)",
          "type": "string"
        },
        "md": {
          "description": "Medium border radius (e.g., 0.375rem)",
          "type": "string"
        },
        "lg": {
          "description": "Large border radius (e.g., 0.5rem)",
          "type": "string"
        },
        "xl": {
          "description": "Extra large border radius (e.g., 0.75rem)",
          "type": "string"
        },
        "2xl": {
          "description": "2X large border radius (e.g., 1rem)",
          "type": "string"
        },
        "full": {
          "description": "Full border radius (50%)",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "shadows": {
      "description": "Box shadow effects",
      "type": "object",
      "properties": {
        "none": {
          "description": "No shadow",
          "type": "string"
        },
        "sm": {
          "description": "Small shadow",
          "type": "string"
        },
        "base": {
          "description": "Base shadow",
          "type": "string"
        },
        "md": {
          "description": "Medium shadow",
          "type": "string"
        },
        "lg": {
          "description": "Large shadow",
          "type": "string"
        },
        "xl": {
          "description": "Extra large shadow",
          "type": "string"
        },
        "2xl": {
          "description": "2X large shadow",
          "type": "string"
        },
        "inner": {
          "description": "Inner shadow (inset)",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "breakpoints": {
      "description": "Responsive breakpoints",
      "type": "object",
      "properties": {
        "xs": {
          "description": "Extra small breakpoint (e.g., 480px)",
          "type": "string"
        },
        "sm": {
          "description": "Small breakpoint (e.g., 640px)",
          "type": "string"
        },
        "md": {
          "description": "Medium breakpoint (e.g., 768px)",
          "type": "string"
        },
        "lg": {
          "description": "Large breakpoint (e.g., 1024px)",
          "type": "string"
        },
        "xl": {
          "description": "Extra large breakpoint (e.g., 1280px)",
          "type": "string"
        },
        "2xl": {
          "description": "2X large breakpoint (e.g., 1536px)",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "animation": {
      "description": "Animation settings",
      "type": "object",
      "properties": {
        "duration": {
          "type": "object",
          "properties": {
            "fast": {
              "description": "Fast animation (e.g., 150ms)",
              "type": "string"
            },
            "base": {
              "description": "Base animation (e.g., 300ms)",
              "type": "string"
            },
            "slow": {
              "description": "Slow animation (e.g., 500ms)",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "timing": {
          "type": "object",
          "properties": {
            "linear": {
              "description": "Linear timing function",
              "type": "string"
            },
            "ease": {
              "description": "Ease timing function",
              "type": "string"
            },
            "ease_in": {
              "description": "Ease-in timing function",
              "type": "string"
            },
            "ease_out": {
              "description": "Ease-out timing function",
              "type": "string"
            },
            "ease_in_out": {
              "description": "Ease-in-out timing function",
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "zIndex": {
      "description": "Z-index scale for layering",
      "type": "object",
      "properties": {
        "base": {
          "description": "Base z-index (e.g., 0)",
          "type": "number"
        },
        "dropdown": {
          "description": "Dropdown z-index (e.g., 1000)",
          "type": "number"
        },
        "sticky": {
          "description": "Sticky z-index (e.g., 1020)",
          "type": "number"
        },
        "fixed": {
          "description": "Fixed z-index (e.g., 1030)",
          "type": "number"
        },
        "modalBackdrop": {
          "description": "Modal backdrop z-index (e.g., 1040)",
          "type": "number"
        },
        "modal": {
          "description": "Modal z-index (e.g., 1050)",
          "type": "number"
        },
        "popover": {
          "description": "Popover z-index (e.g., 1060)",
          "type": "number"
        },
        "tooltip": {
          "description": "Tooltip z-index (e.g., 1070)",
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "customVars": {
      "description": "Custom CSS variables (key-value pairs)",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "logo": {
      "description": "Logo assets",
      "type": "object",
      "properties": {
        "light": {
          "description": "Logo URL for light mode",
          "type": "string"
        },
        "dark": {
          "description": "Logo URL for dark mode",
          "type": "string"
        },
        "favicon": {
          "description": "Favicon URL",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "extends": {
      "description": "Base theme to extend from",
      "type": "string"
    },
    "density": {
      "description": "Display density: compact, regular, or spacious",
      "type": "string",
      "enum": [
        "compact",
        "regular",
        "spacious"
      ]
    },
    "wcagContrast": {
      "description": "WCAG color contrast level (AA or AAA)",
      "type": "string",
      "enum": [
        "AA",
        "AAA"
      ]
    },
    "rtl": {
      "description": "Enable right-to-left layout direction",
      "type": "boolean"
    },
    "touchTarget": {
      "description": "Touch target sizing defaults",
      "type": "object",
      "properties": {
        "minWidth": {
          "default": 44,
          "description": "Minimum touch target width in pixels (WCAG 2.5.5: 44px)",
          "type": "number"
        },
        "minHeight": {
          "default": 44,
          "description": "Minimum touch target height in pixels (WCAG 2.5.5: 44px)",
          "type": "number"
        },
        "padding": {
          "description": "Additional padding around touch target in pixels",
          "type": "number"
        },
        "hitSlop": {
          "description": "Invisible hit area extension beyond the visible bounds",
          "type": "object",
          "properties": {
            "top": {
              "description": "Extra hit area above the element",
              "type": "number"
            },
            "right": {
              "description": "Extra hit area to the right of the element",
              "type": "number"
            },
            "bottom": {
              "description": "Extra hit area below the element",
              "type": "number"
            },
            "left": {
              "description": "Extra hit area to the left of the element",
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "minWidth",
        "minHeight"
      ],
      "additionalProperties": false
    },
    "keyboardNavigation": {
      "description": "Keyboard focus management settings",
      "type": "object",
      "properties": {
        "tabOrder": {
          "default": "auto",
          "description": "Tab order strategy: auto (DOM order) or manual (explicit tabIndex)",
          "type": "string",
          "enum": [
            "auto",
            "manual"
          ]
        },
        "skipLinks": {
          "default": false,
          "description": "Provide skip-to-content navigation links",
          "type": "boolean"
        },
        "focusVisible": {
          "default": true,
          "description": "Show visible focus indicators for keyboard users",
          "type": "boolean"
        },
        "focusTrap": {
          "description": "Focus trap settings",
          "type": "object",
          "properties": {
            "enabled": {
              "default": false,
              "description": "Enable focus trapping within this container",
              "type": "boolean"
            },
            "initialFocus": {
              "description": "CSS selector for the element to focus on activation",
              "type": "string"
            },
            "returnFocus": {
              "default": true,
              "description": "Return focus to trigger element on deactivation",
              "type": "boolean"
            },
            "escapeDeactivates": {
              "default": true,
              "description": "Allow Escape key to deactivate the focus trap",
              "type": "boolean"
            }
          },
          "required": [
            "enabled",
            "returnFocus",
            "escapeDeactivates"
          ],
          "additionalProperties": false
        },
        "arrowNavigation": {
          "default": false,
          "description": "Enable arrow key navigation between focusable items",
          "type": "boolean"
        }
      },
      "required": [
        "tabOrder",
        "skipLinks",
        "focusVisible",
        "arrowNavigation"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "label",
    "mode",
    "colors"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ui/Theme.json",
  "x-spec-version": "3.0.11"
}