{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "classification": {
      "type": "string",
      "enum": [
        "pii",
        "phi",
        "pci",
        "financial",
        "confidential",
        "internal",
        "public"
      ],
      "description": "Data classification level"
    },
    "requireEncryption": {
      "default": false,
      "description": "Encryption required for this classification",
      "type": "boolean"
    },
    "requireMasking": {
      "default": false,
      "description": "Masking required for this classification",
      "type": "boolean"
    },
    "requireAudit": {
      "default": false,
      "description": "Audit trail required for access to this classification",
      "type": "boolean"
    },
    "retentionDays": {
      "description": "Data retention limit in days (for compliance)",
      "type": "number"
    }
  },
  "required": [
    "classification",
    "requireEncryption",
    "requireMasking",
    "requireAudit"
  ],
  "additionalProperties": false,
  "description": "Security policy for a specific data classification level",
  "$id": "https://schema.objectstack.io/v3.0.11/system/DataClassificationPolicy.json",
  "x-spec-version": "3.0.11"
}