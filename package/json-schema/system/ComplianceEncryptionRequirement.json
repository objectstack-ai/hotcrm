{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "framework": {
      "type": "string",
      "enum": [
        "gdpr",
        "hipaa",
        "sox",
        "pci_dss",
        "ccpa",
        "iso27001"
      ],
      "description": "Compliance framework identifier"
    },
    "dataClassifications": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "pii",
          "phi",
          "pci",
          "financial",
          "confidential",
          "internal",
          "public"
        ],
        "description": "Data classification level"
      },
      "description": "Data classifications that must be encrypted under this framework"
    },
    "minimumAlgorithm": {
      "default": "aes-256-gcm",
      "description": "Minimum encryption algorithm strength required",
      "type": "string",
      "enum": [
        "aes-256-gcm",
        "aes-256-cbc",
        "chacha20-poly1305"
      ]
    },
    "keyRotationMaxDays": {
      "default": 90,
      "description": "Maximum key rotation interval required (in days)",
      "type": "number",
      "minimum": 1
    }
  },
  "required": [
    "framework",
    "dataClassifications",
    "minimumAlgorithm",
    "keyRotationMaxDays"
  ],
  "additionalProperties": false,
  "description": "Compliance framework encryption requirements",
  "$id": "https://schema.objectstack.io/v3.0.11/system/ComplianceEncryptionRequirement.json",
  "x-spec-version": "3.0.11"
}