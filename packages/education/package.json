{
  "name": "@hotcrm/education",
  "version": "1.0.0",
  "type": "module",
  "description": "Education module - Student Management, Course Enrollment, Scholarships, Admissions, and Alumni Engagement",
  "license": "MIT",
  "main": "./dist/plugin.js",
  "types": "./dist/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "objectstack dev",
    "start": "objectstack serve",
    "build": "tsc && objectstack compile",
    "typecheck": "tsc --noEmit",
    "test": "objectstack test"
  },
  "keywords": [
    "education",
    "student",
    "enrollment",
    "course",
    "scholarship"
  ],
  "author": "HotCRM Team",
  "dependencies": {
    "@objectstack/spec": "^4.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@objectstack/cli": "^4.0.4",
    "typescript": "^5.9.3"
  }
}
