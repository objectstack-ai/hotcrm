{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "instanceId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "Unique UUID for this running kernel process"
    },
    "mode": {
      "default": "production",
      "type": "string",
      "enum": [
        "development",
        "production",
        "test",
        "provisioning",
        "preview"
      ],
      "description": "Kernel operating mode"
    },
    "version": {
      "type": "string",
      "description": "Kernel version"
    },
    "appName": {
      "description": "Host application name",
      "type": "string"
    },
    "cwd": {
      "type": "string",
      "description": "Current working directory"
    },
    "workspaceRoot": {
      "description": "Workspace root if different from cwd",
      "type": "string"
    },
    "startTime": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "description": "Boot timestamp (ms)"
    },
    "features": {
      "default": {},
      "description": "Global feature toggles",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "previewMode": {
      "description": "Preview/demo mode configuration (used when mode is \"preview\")",
      "type": "object",
      "properties": {
        "autoLogin": {
          "default": true,
          "description": "Auto-login as simulated user, skipping login/registration pages",
          "type": "boolean"
        },
        "simulatedRole": {
          "default": "admin",
          "description": "Permission role for the simulated preview user",
          "type": "string",
          "enum": [
            "admin",
            "user",
            "viewer"
          ]
        },
        "simulatedUserName": {
          "default": "Preview User",
          "description": "Display name for the simulated preview user",
          "type": "string"
        },
        "readOnly": {
          "default": false,
          "description": "Restrict the preview session to read-only operations",
          "type": "boolean"
        },
        "expiresInSeconds": {
          "default": 0,
          "description": "Preview session duration in seconds (0 = no expiration)",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "bannerMessage": {
          "description": "Banner message displayed in the UI during preview mode",
          "type": "string"
        }
      },
      "required": [
        "autoLogin",
        "simulatedRole",
        "simulatedUserName",
        "readOnly",
        "expiresInSeconds"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "instanceId",
    "mode",
    "version",
    "cwd",
    "startTime",
    "features"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/KernelContext.json",
  "x-spec-version": "3.0.11"
}