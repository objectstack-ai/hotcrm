{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "packageId": {
      "type": "string",
      "description": "Dependency package identifier"
    },
    "requiredRange": {
      "type": "string",
      "description": "SemVer range required (e.g. \"^2.0.0\")"
    },
    "resolvedVersion": {
      "description": "Actual version resolved from registry",
      "type": "string"
    },
    "installedVersion": {
      "description": "Currently installed version",
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "satisfied",
        "needs_install",
        "needs_upgrade",
        "conflict"
      ],
      "description": "Resolution status"
    },
    "conflictReason": {
      "description": "Explanation of the conflict",
      "type": "string"
    }
  },
  "required": [
    "packageId",
    "requiredRange",
    "status"
  ],
  "additionalProperties": false,
  "description": "Resolution result for a single dependency",
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/ResolvedDependency.json",
  "x-spec-version": "3.0.11"
}