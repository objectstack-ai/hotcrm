{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "domain": {
      "type": "string",
      "description": "Domain name (e.g., app.example.com)"
    },
    "httpsRedirect": {
      "default": true,
      "description": "Redirect HTTP to HTTPS",
      "type": "boolean"
    },
    "customCertificate": {
      "description": "Custom SSL certificate",
      "type": "object",
      "properties": {
        "cert": {
          "type": "string",
          "description": "SSL certificate"
        },
        "key": {
          "type": "string",
          "description": "Private key"
        },
        "ca": {
          "description": "Certificate authority",
          "type": "string"
        }
      },
      "required": [
        "cert",
        "key"
      ],
      "additionalProperties": false
    },
    "gitBranch": {
      "description": "Git branch to deploy to this domain",
      "type": "string"
    }
  },
  "required": [
    "domain",
    "httpsRedirect"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/integration/DomainConfig.json",
  "x-spec-version": "3.0.11"
}