{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "subscribe",
        "unsubscribe",
        "data-change",
        "presence-update",
        "cursor-update",
        "error"
      ],
      "description": "Event type"
    },
    "channel": {
      "type": "string",
      "description": "Channel identifier (e.g., \"record.account.123\", \"user.456\")"
    },
    "payload": {
      "description": "Event payload data"
    },
    "timestamp": {
      "type": "number",
      "description": "Unix timestamp in milliseconds"
    }
  },
  "required": [
    "type",
    "channel",
    "payload",
    "timestamp"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/WebSocketEvent.json",
  "x-spec-version": "3.0.11"
}