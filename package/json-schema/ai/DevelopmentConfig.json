{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "specificationSource": {
      "type": "string",
      "description": "Path to ObjectStack specification"
    },
    "codeGeneration": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Enable code generation",
          "type": "boolean"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "frontend",
              "backend",
              "api",
              "database",
              "tests",
              "documentation",
              "infrastructure"
            ],
            "description": "Code generation target"
          },
          "description": "Code generation targets"
        },
        "templateRepo": {
          "description": "Template repository for scaffolding",
          "type": "string"
        },
        "styleGuide": {
          "description": "Code style guide to follow",
          "type": "string"
        },
        "includeTests": {
          "default": true,
          "description": "Generate tests with code",
          "type": "boolean"
        },
        "includeDocumentation": {
          "default": true,
          "description": "Generate documentation",
          "type": "boolean"
        },
        "validationMode": {
          "default": "strict",
          "description": "Code validation strictness",
          "type": "string",
          "enum": [
            "strict",
            "moderate",
            "permissive"
          ]
        }
      },
      "required": [
        "enabled",
        "targets",
        "includeTests",
        "includeDocumentation",
        "validationMode"
      ],
      "additionalProperties": false,
      "description": "Code generation settings"
    },
    "testing": {
      "description": "Testing configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Enable automated testing",
          "type": "boolean"
        },
        "testTypes": {
          "default": [
            "unit",
            "integration"
          ],
          "description": "Types of tests to run",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "unit",
              "integration",
              "e2e",
              "performance",
              "security",
              "accessibility"
            ]
          }
        },
        "coverageThreshold": {
          "default": 80,
          "description": "Minimum test coverage percentage",
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "framework": {
          "description": "Testing framework (e.g., vitest, jest, playwright)",
          "type": "string"
        },
        "preCommitTests": {
          "default": true,
          "description": "Run tests before committing",
          "type": "boolean"
        },
        "autoFix": {
          "default": false,
          "description": "Attempt to auto-fix failing tests",
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "testTypes",
        "coverageThreshold",
        "preCommitTests",
        "autoFix"
      ],
      "additionalProperties": false
    },
    "linting": {
      "description": "Code linting configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "autoFix": {
          "default": true,
          "type": "boolean"
        },
        "rules": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "enabled",
        "autoFix"
      ],
      "additionalProperties": false
    },
    "formatting": {
      "description": "Code formatting configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "autoFormat": {
          "default": true,
          "type": "boolean"
        },
        "config": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "enabled",
        "autoFormat"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "specificationSource",
    "codeGeneration"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/DevelopmentConfig.json",
  "x-spec-version": "3.0.11"
}