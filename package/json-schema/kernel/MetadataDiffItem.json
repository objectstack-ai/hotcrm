{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "description": "Metadata type"
    },
    "name": {
      "type": "string",
      "description": "Metadata name"
    },
    "changeType": {
      "type": "string",
      "enum": [
        "added",
        "modified",
        "removed",
        "renamed"
      ],
      "description": "Category of metadata modification (added, modified, removed, or renamed)"
    },
    "hasConflict": {
      "default": false,
      "description": "Whether this change may conflict with customizations",
      "type": "boolean"
    },
    "summary": {
      "description": "Human-readable change summary",
      "type": "string"
    },
    "previousName": {
      "description": "Previous name if renamed",
      "type": "string"
    }
  },
  "required": [
    "type",
    "name",
    "changeType",
    "hasConflict"
  ],
  "additionalProperties": false,
  "description": "Single metadata change between package versions",
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/MetadataDiffItem.json",
  "x-spec-version": "3.0.11"
}