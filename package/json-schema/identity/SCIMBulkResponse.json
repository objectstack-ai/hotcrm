          },
          "response": {
            "description": "Response body (typically present for errors)"
          }
        },
        "required": [
          "method",
          "status"
        ],
        "additionalProperties": false
      },
      "description": "Results for each bulk operation"
    }
  },
  "required": [
    "schemas",
    "operations"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/identity/SCIMBulkResponse.json",
