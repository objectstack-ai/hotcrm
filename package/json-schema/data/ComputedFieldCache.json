{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "description": "Enable caching for computed field results"
    },
    "ttl": {
      "type": "number",
      "minimum": 0,
      "description": "Cache TTL in seconds (0 = no expiration)"
    },
    "invalidateOn": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Field paths that invalidate cache (e.g., [\"inventory.quantity\", \"pricing.base_price\"])"
    }
  },
  "required": [
    "enabled",
    "ttl",
    "invalidateOn"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/data/ComputedFieldCache.json",
  "x-spec-version": "3.0.11"
}