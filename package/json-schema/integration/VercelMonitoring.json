{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enableWebAnalytics": {
      "default": false,
      "description": "Enable Vercel Web Analytics",
      "type": "boolean"
    },
    "enableSpeedInsights": {
      "default": false,
      "description": "Enable Vercel Speed Insights",
      "type": "boolean"
    },
    "logDrains": {
      "description": "Log drains configuration",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Log drain name"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Log drain URL"
          },
          "headers": {
            "description": "Custom headers",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "sources": {
            "description": "Log sources",
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "static",
                "lambda",
                "edge"
              ]
            }
          }
        },
        "required": [
          "name",
          "url"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "enableWebAnalytics",
    "enableSpeedInsights"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/integration/VercelMonitoring.json",
  "x-spec-version": "3.0.11"
}