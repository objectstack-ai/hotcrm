{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": true,
      "description": "Enable multipart uploads",
      "type": "boolean"
    },
    "partSize": {
      "default": 10485760,
      "description": "Part size in bytes (min 5MB, max 5GB)",
      "type": "number",
      "minimum": 5242880,
      "maximum": 5368709120
    },
    "maxParts": {
      "default": 10000,
      "description": "Maximum number of parts (max 10,000)",
      "type": "number",
      "minimum": 1,
      "maximum": 10000
    },
    "threshold": {
      "default": 104857600,
      "description": "File size threshold to trigger multipart upload (bytes)",
      "type": "number",
      "minimum": 0
    },
    "maxConcurrent": {
      "default": 4,
      "description": "Maximum concurrent part uploads",
      "type": "number",
      "minimum": 1,
      "maximum": 100
    },
    "abortIncompleteAfterDays": {
      "description": "Auto-abort incomplete uploads after N days",
      "type": "number",
      "minimum": 1
    }
  },
  "required": [
    "enabled",
    "partSize",
    "maxParts",
    "threshold",
    "maxConcurrent"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/system/MultipartUploadConfig.json",
  "x-spec-version": "3.0.11"
}