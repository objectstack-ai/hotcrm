{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "description": "Template ID (generated on save)",
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$",
      "description": "Template machine name (snake_case)"
    },
    "label": {
      "type": "string",
      "description": "Human-readable template label"
    },
    "description": {
      "description": "Template description",
      "type": "string"
    },
    "object": {
      "type": "string",
      "description": "Target object name"
    },
    "direction": {
      "type": "string",
      "enum": [
        "import",
        "export",
        "bidirectional"
      ],
      "description": "Template direction"
    },
    "format": {
      "description": "Default file format for this template",
      "type": "string",
      "enum": [
        "csv",
        "json",
        "jsonl",
        "xlsx",
        "parquet"
      ]
    },
    "mappings": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceField": {
            "type": "string",
            "description": "Field name in the source data (import) or object (export)"
          },
          "targetField": {
            "type": "string",
            "description": "Field name in the target object (import) or file column (export)"
          },
          "targetLabel": {
            "description": "Display label for the target column (export)",
            "type": "string"
          },
          "transform": {
            "default": "none",
            "description": "Transformation to apply during mapping",
            "type": "string",
            "enum": [
              "none",
              "uppercase",
              "lowercase",
              "trim",
              "date_format",
              "lookup"
            ]
          },
          "defaultValue": {
            "description": "Default value if source field is null/empty"
          },
          "required": {
            "default": false,
            "description": "Whether this field is required (import validation)",
            "type": "boolean"
          }
        },
        "required": [
          "sourceField",
          "targetField",
          "transform",
          "required"
        ],
        "additionalProperties": false
      },
      "description": "Field mapping entries"
    },
    "createdAt": {
      "description": "Template creation timestamp",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "updatedAt": {
      "description": "Last update timestamp",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "createdBy": {
      "description": "User who created the template",
      "type": "string"
    }
  },
  "required": [
    "name",
    "label",
    "object",
    "direction",
    "mappings"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/ExportImportTemplate.json",
  "x-spec-version": "3.0.11"
}