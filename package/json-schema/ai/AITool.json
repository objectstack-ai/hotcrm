{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "action",
        "flow",
        "query",
        "vector_search"
      ]
    },
    "name": {
      "type": "string",
      "description": "Reference name (Action Name, Flow Name)"
    },
    "description": {
      "description": "Override description for the LLM",
      "type": "string"
    }
  },
  "required": [
    "type",
    "name"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/AITool.json",
  "x-spec-version": "3.0.11"
}