{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique entry identifier"
    },
    "event": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Unique event identifier",
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9_.]*$",
          "description": "Event name (lowercase with dots, e.g., user.created, order.paid)"
        },
        "payload": {
          "description": "Event payload schema"
        },
        "metadata": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "description": "Event source (e.g., plugin name, system component)"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
              "description": "ISO 8601 datetime when event was created"
            },
            "userId": {
              "description": "User who triggered the event",
              "type": "string"
            },
            "tenantId": {
              "description": "Tenant identifier for multi-tenant systems",
              "type": "string"
            },
            "correlationId": {
              "description": "Correlation ID for event tracing",
              "type": "string"
            },
            "causationId": {
              "description": "ID of the event that caused this event",
              "type": "string"
            },
            "priority": {
              "default": "normal",
              "description": "Event priority",
              "type": "string",
              "enum": [
                "critical",
                "high",
                "normal",
                "low",
                "background"
              ]
            }
          },
          "required": [
            "source",
            "timestamp",
            "priority"
          ],
          "additionalProperties": false,
          "description": "Event metadata"
        }
      },
      "required": [
        "name",
        "payload",
        "metadata"
      ],
      "additionalProperties": false,
      "description": "Original event"
    },
    "error": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "description": "Error message"
        },
        "stack": {
          "description": "Error stack trace",
          "type": "string"
        },
        "code": {
          "description": "Error code",
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "additionalProperties": false,
      "description": "Failure details"
    },
    "retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Number of retry attempts"
    },
    "firstFailedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "description": "When event first failed"
    },
    "lastFailedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "description": "When event last failed"
    },
    "failedHandler": {
      "description": "Handler ID that failed",
      "type": "string"
    }
  },
  "required": [
    "id",
    "event",
    "error",
    "retries",
    "firstFailedAt",
    "lastFailedAt"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/DeadLetterQueueEntry.json",
  "x-spec-version": "3.0.11"
}