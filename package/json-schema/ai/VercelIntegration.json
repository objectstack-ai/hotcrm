{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "connector": {
      "type": "string",
      "description": "Vercel connector name"
    },
    "project": {
      "type": "string",
      "description": "Vercel project name"
    },
    "environments": {
      "description": "Environment mapping",
      "type": "object",
      "properties": {
        "production": {
          "default": "main",
          "description": "Production branch",
          "type": "string"
        },
        "preview": {
          "default": [
            "develop",
            "feature/*"
          ],
          "description": "Preview branches",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "production",
        "preview"
      ],
      "additionalProperties": false
    },
    "deployment": {
      "description": "Deployment settings",
      "type": "object",
      "properties": {
        "autoDeployProduction": {
          "default": false,
          "description": "Auto-deploy to production",
          "type": "boolean"
        },
        "autoDeployPreview": {
          "default": true,
          "description": "Auto-deploy preview environments",
          "type": "boolean"
        },
        "requireApproval": {
          "default": true,
          "description": "Require approval for production deployments",
          "type": "boolean"
        }
      },
      "required": [
        "autoDeployProduction",
        "autoDeployPreview",
        "requireApproval"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "connector",
    "project"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/VercelIntegration.json",
  "x-spec-version": "3.0.11"
}