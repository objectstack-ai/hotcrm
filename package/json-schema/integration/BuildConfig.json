{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "buildCommand": {
      "description": "Build command (e.g., npm run build)",
      "type": "string"
    },
    "outputDirectory": {
      "description": "Output directory (e.g., .next, dist)",
      "type": "string"
    },
    "installCommand": {
      "description": "Install command (e.g., npm install, pnpm install)",
      "type": "string"
    },
    "devCommand": {
      "description": "Development command (e.g., npm run dev)",
      "type": "string"
    },
    "nodeVersion": {
      "description": "Node.js version (e.g., 18.x, 20.x)",
      "type": "string"
    },
    "env": {
      "description": "Build environment variables",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/integration/BuildConfig.json",
  "x-spec-version": "3.0.11"
}