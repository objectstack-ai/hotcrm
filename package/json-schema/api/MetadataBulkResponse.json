{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "success": {
      "type": "boolean",
      "description": "Operation success status"
    },
    "error": {
      "description": "Error details if success is false",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Error code (e.g. validation_error)"
        },
        "message": {
          "type": "string",
          "description": "Readable error message"
        },
        "category": {
          "description": "Error category (e.g. validation, authorization)",
          "type": "string"
        },
        "details": {
          "description": "Additional error context (e.g. field validation errors)"
        },
        "requestId": {
          "description": "Request ID for tracking",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "meta": {
      "description": "Response metadata",
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "string"
        },
        "duration": {
          "type": "number"
        },
        "requestId": {
          "type": "string"
        },
        "traceId": {
          "type": "string"
        }
      },
      "required": [
        "timestamp"
      ],
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Total items processed"
        },
        "succeeded": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Successfully processed"
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Failed items"
        },
        "errors": {
          "description": "Per-item errors",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "Metadata type"
              },
              "name": {
                "type": "string",
                "description": "Item name"
              },
              "error": {
                "type": "string",
                "description": "Error message"
              }
            },
            "required": [
              "type",
              "name",
              "error"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "total",
        "succeeded",
        "failed"
      ],
      "additionalProperties": false,
      "description": "Bulk operation result"
    }
  },
  "required": [
    "success",
    "data"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/MetadataBulkResponse.json",
  "x-spec-version": "3.0.11"
}