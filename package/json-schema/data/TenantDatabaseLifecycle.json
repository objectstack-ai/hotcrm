{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "onTenantCreate": {
      "type": "object",
      "properties": {
        "autoCreate": {
          "default": true,
          "description": "Auto-create database on tenant registration",
          "type": "boolean"
        },
        "group": {
          "description": "Turso group for the new database",
          "type": "string"
        },
        "applyGroupSchema": {
          "default": true,
          "description": "Apply shared schema from group",
          "type": "boolean"
        },
        "seedData": {
          "default": false,
          "description": "Populate seed data on creation",
          "type": "boolean"
        }
      },
      "required": [
        "autoCreate",
        "applyGroupSchema",
        "seedData"
      ],
      "additionalProperties": false,
      "description": "Tenant creation hook"
    },
    "onTenantDelete": {
      "type": "object",
      "properties": {
        "immediate": {
          "default": false,
          "description": "Destroy database immediately",
          "type": "boolean"
        },
        "gracePeriodHours": {
          "default": 72,
          "description": "Grace period before permanent deletion",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "createBackup": {
          "default": true,
          "description": "Create backup before deletion",
          "type": "boolean"
        }
      },
      "required": [
        "immediate",
        "gracePeriodHours",
        "createBackup"
      ],
      "additionalProperties": false,
      "description": "Tenant deletion hook"
    },
    "onTenantSuspend": {
      "type": "object",
      "properties": {
        "revokeTokens": {
          "default": true,
          "description": "Revoke auth tokens on suspension",
          "type": "boolean"
        },
        "readOnly": {
          "default": true,
          "description": "Set database to read-only on suspension",
          "type": "boolean"
        }
      },
      "required": [
        "revokeTokens",
        "readOnly"
      ],
      "additionalProperties": false,
      "description": "Tenant suspension hook"
    }
  },
  "required": [
    "onTenantCreate",
    "onTenantDelete",
    "onTenantSuspend"
  ],
  "additionalProperties": false,
  "description": "Tenant database lifecycle hooks",
  "$id": "https://schema.objectstack.io/v3.0.11/data/TenantDatabaseLifecycle.json",
  "x-spec-version": "3.0.11"
}