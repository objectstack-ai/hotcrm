{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "organizationSlug": {
      "type": "string",
      "minLength": 1,
      "description": "Turso organization slug"
    },
    "urlTemplate": {
      "type": "string",
      "minLength": 1,
      "description": "URL template with {tenant_id} placeholder"
    },
    "groupAuthToken": {
      "type": "string",
      "minLength": 1,
      "description": "Group-level auth token for platform operations"
    },
    "tenantResolverStrategy": {
      "default": "token",
      "type": "string",
      "enum": [
        "header",
        "subdomain",
        "path",
        "token",
        "lookup"
      ],
      "description": "Strategy for resolving tenant identity from request context"
    },
    "group": {
      "description": "Database group configuration",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Turso database group name"
        },
        "primaryLocation": {
          "type": "string",
          "minLength": 2,
          "description": "Primary Turso region code (e.g., iad, lhr, nrt)"
        },
        "replicaLocations": {
          "default": [],
          "description": "Additional replica region codes",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "schemaDatabase": {
          "description": "Schema database name for multi-db schemas",
          "type": "string"
        }
      },
      "required": [
        "name",
        "primaryLocation",
        "replicaLocations"
      ],
      "additionalProperties": false
    },
    "lifecycle": {
      "description": "Lifecycle hooks",
      "type": "object",
      "properties": {
        "onTenantCreate": {
          "type": "object",
          "properties": {
            "autoCreate": {
              "default": true,
              "description": "Auto-create database on tenant registration",
              "type": "boolean"
            },
            "group": {
              "description": "Turso group for the new database",
              "type": "string"
            },
            "applyGroupSchema": {
              "default": true,
              "description": "Apply shared schema from group",
              "type": "boolean"
            },
            "seedData": {
              "default": false,
              "description": "Populate seed data on creation",
              "type": "boolean"
            }
          },
          "required": [
            "autoCreate",
            "applyGroupSchema",
            "seedData"
          ],
          "additionalProperties": false,
          "description": "Tenant creation hook"
        },
        "onTenantDelete": {
          "type": "object",
          "properties": {
            "immediate": {
              "default": false,
              "description": "Destroy database immediately",
              "type": "boolean"
            },
            "gracePeriodHours": {
              "default": 72,
              "description": "Grace period before permanent deletion",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "createBackup": {
              "default": true,
              "description": "Create backup before deletion",
              "type": "boolean"
            }
          },
          "required": [
            "immediate",
            "gracePeriodHours",
            "createBackup"
          ],
          "additionalProperties": false,
          "description": "Tenant deletion hook"
        },
        "onTenantSuspend": {
          "type": "object",
          "properties": {
            "revokeTokens": {
              "default": true,
              "description": "Revoke auth tokens on suspension",
              "type": "boolean"
            },
            "readOnly": {
              "default": true,
              "description": "Set database to read-only on suspension",
              "type": "boolean"
            }
          },
          "required": [
            "revokeTokens",
            "readOnly"
          ],
          "additionalProperties": false,
          "description": "Tenant suspension hook"
        }
      },
      "required": [
        "onTenantCreate",
        "onTenantDelete",
        "onTenantSuspend"
      ],
      "additionalProperties": false
    },
    "maxCachedConnections": {
      "default": 100,
      "description": "Max cached tenant connections (LRU)",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "connectionCacheTTL": {
      "default": 300,
      "description": "Connection cache TTL in seconds",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "organizationSlug",
    "urlTemplate",
    "groupAuthToken",
    "tenantResolverStrategy",
    "maxCachedConnections",
    "connectionCacheTTL"
  ],
  "additionalProperties": false,
  "description": "Turso multi-tenant router configuration",
  "$id": "https://schema.objectstack.io/v3.0.11/data/TursoMultiTenantConfig.json",
  "x-spec-version": "3.0.11"
}