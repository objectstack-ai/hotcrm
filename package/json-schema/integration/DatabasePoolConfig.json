{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "min": {
      "default": 2,
      "description": "Minimum connections in pool",
      "type": "number",
      "minimum": 0
    },
    "max": {
      "default": 10,
      "description": "Maximum connections in pool",
      "type": "number",
      "minimum": 1
    },
    "idleTimeoutMs": {
      "default": 30000,
      "description": "Idle connection timeout in ms",
      "type": "number",
      "minimum": 1000
    },
    "connectionTimeoutMs": {
      "default": 10000,
      "description": "Connection establishment timeout in ms",
      "type": "number",
      "minimum": 1000
    },
    "acquireTimeoutMs": {
      "default": 30000,
      "description": "Connection acquisition timeout in ms",
      "type": "number",
      "minimum": 1000
    },
    "evictionRunIntervalMs": {
      "default": 30000,
      "description": "Connection eviction check interval in ms",
      "type": "number",
      "minimum": 1000
    },
    "testOnBorrow": {
      "default": true,
      "description": "Test connection before use",
      "type": "boolean"
    }
  },
  "required": [
    "min",
    "max",
    "idleTimeoutMs",
    "connectionTimeoutMs",
    "acquireTimeoutMs",
    "evictionRunIntervalMs",
    "testOnBorrow"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/integration/DatabasePoolConfig.json",
  "x-spec-version": "3.0.11"
}