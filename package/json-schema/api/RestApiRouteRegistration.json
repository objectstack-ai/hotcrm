{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "prefix": {
      "type": "string",
      "pattern": "^\\/",
      "description": "URL path prefix for this route group"
    },
    "service": {
      "type": "string",
      "description": "Core service name (metadata, data, auth, etc.)"
    },
    "category": {
      "type": "string",
      "enum": [
        "discovery",
        "metadata",
        "data",
        "batch",
        "permission",
        "analytics",
        "automation",
        "workflow",
        "ui",
        "realtime",
        "notification",
        "ai",
        "i18n"
      ],
      "description": "Primary category for this route group"
    },
    "methods": {
      "description": "Protocol method names implemented",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "endpoints": {
      "description": "Endpoint definitions",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "DELETE",
              "PATCH",
              "HEAD",
              "OPTIONS"
            ],
            "description": "HTTP method for this endpoint"
          },
          "path": {
            "type": "string",
            "description": "URL path pattern (e.g., /api/v1/data/:object/:id)"
          },
          "handler": {
            "type": "string",
            "description": "Protocol method name or handler identifier"
          },
          "category": {
            "type": "string",
            "enum": [
              "discovery",
              "metadata",
              "data",
              "batch",
              "permission",
              "analytics",
              "automation",
              "workflow",
              "ui",
              "realtime",
              "notification",
              "ai",
              "i18n"
            ],
            "description": "Route category"
          },
          "public": {
            "default": false,
            "description": "Is publicly accessible without authentication",
            "type": "boolean"
          },
          "permissions": {
            "description": "Required permissions (e.g., [\"data.read\", \"object.account.read\"])",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "description": "Short description for OpenAPI",
            "type": "string"
          },
          "description": {
            "description": "Detailed description for OpenAPI",
            "type": "string"
          },
          "tags": {
            "description": "OpenAPI tags for grouping",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requestSchema": {
            "description": "Request schema name (for validation)",
            "type": "string"
          },
          "responseSchema": {
            "description": "Response schema name (for documentation)",
            "type": "string"
          },
          "timeout": {
            "description": "Request timeout in milliseconds",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "rateLimit": {
            "description": "Rate limit policy name",
            "type": "string"
          },
          "cacheable": {
            "default": false,
            "description": "Whether response can be cached",
            "type": "boolean"
          },
          "cacheTtl": {
            "description": "Cache TTL in seconds",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "method",
          "path",
          "handler",
          "category",
          "public",
          "cacheable"
        ],
        "additionalProperties": false
      }
    },
    "middleware": {
      "description": "Middleware stack for this route group",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_]*$",
            "description": "Middleware name (snake_case)"
          },
          "type": {
            "type": "string",
            "enum": [
              "authentication",
              "authorization",
              "logging",
              "validation",
              "transformation",
              "error",
              "custom"
            ],
            "description": "Middleware type"
          },
          "enabled": {
            "default": true,
            "description": "Whether middleware is enabled",
            "type": "boolean"
          },
          "order": {
            "default": 100,
            "description": "Execution order priority",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "config": {
            "description": "Middleware configuration object",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "paths": {
            "description": "Path filtering",
            "type": "object",
            "properties": {
              "include": {
                "description": "Include path patterns (glob)",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "exclude": {
                "description": "Exclude path patterns (glob)",
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "type",
          "enabled",
          "order"
        ],
        "additionalProperties": false
      }
    },
    "authRequired": {
      "default": true,
      "description": "Whether authentication is required by default",
      "type": "boolean"
    },
    "documentation": {
      "description": "Documentation metadata for this route group",
      "type": "object",
      "properties": {
        "title": {
          "description": "Route group title",
          "type": "string"
        },
        "description": {
          "description": "Route group description",
          "type": "string"
        },
        "tags": {
          "description": "OpenAPI tags",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "prefix",
    "service",
    "category",
    "authRequired"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/RestApiRouteRegistration.json",
  "x-spec-version": "3.0.11"
}