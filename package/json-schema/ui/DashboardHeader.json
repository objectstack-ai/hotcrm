{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "showTitle": {
      "default": true,
      "description": "Show dashboard title in header",
      "type": "boolean"
    },
    "showDescription": {
      "default": true,
      "description": "Show dashboard description in header",
      "type": "boolean"
    },
    "actions": {
      "description": "Header action buttons",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "description": "Translation key (e.g., \"views.task_list.label\")"
                  },
                  "defaultValue": {
                    "description": "Fallback value when translation key is not found",
                    "type": "string"
                  },
                  "params": {
                    "description": "Interpolation parameters (e.g., { count: 5 })",
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "key"
                ],
                "additionalProperties": false
              }
            ],
            "description": "Action button label"
          },
          "actionUrl": {
            "type": "string",
            "description": "URL or target for the action"
          },
          "actionType": {
            "description": "Type of action",
            "type": "string",
            "enum": [
              "script",
              "url",
              "modal",
              "flow",
              "api"
            ]
          },
          "icon": {
            "description": "Icon identifier for the action button",
            "type": "string"
          }
        },
        "required": [
          "label",
          "actionUrl"
        ],
        "additionalProperties": false,
        "description": "Dashboard header action"
      }
    }
  },
  "required": [
    "showTitle",
    "showDescription"
  ],
  "additionalProperties": false,
  "description": "Dashboard header configuration",
  "$id": "https://schema.objectstack.io/v3.0.11/ui/DashboardHeader.json",
  "x-spec-version": "3.0.11"
}