{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "default": "toast",
      "description": "Notification presentation style",
      "type": "string",
      "enum": [
        "toast",
        "snackbar",
        "banner",
        "alert",
        "inline"
      ]
    },
    "severity": {
      "default": "info",
      "description": "Notification severity level",
      "type": "string",
      "enum": [
        "info",
        "success",
        "warning",
        "error"
      ]
    },
    "title": {
      "description": "Notification title",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Translation key (e.g., \"views.task_list.label\")"
            },
            "defaultValue": {
              "description": "Fallback value when translation key is not found",
              "type": "string"
            },
            "params": {
              "description": "Interpolation parameters (e.g., { count: 5 })",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        }
      ]
    },
    "message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Translation key (e.g., \"views.task_list.label\")"
            },
            "defaultValue": {
              "description": "Fallback value when translation key is not found",
              "type": "string"
            },
            "params": {
              "description": "Interpolation parameters (e.g., { count: 5 })",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Notification message body"
    },
    "icon": {
      "description": "Icon name override",
      "type": "string"
    },
    "duration": {
      "description": "Auto-dismiss duration in ms, omit for persistent",
      "type": "number"
    },
    "dismissible": {
      "default": true,
      "description": "Allow user to dismiss the notification",
      "type": "boolean"
    },
    "actions": {
      "description": "Action buttons",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "description": "Translation key (e.g., \"views.task_list.label\")"
                  },
                  "defaultValue": {
                    "description": "Fallback value when translation key is not found",
                    "type": "string"
                  },
                  "params": {
                    "description": "Interpolation parameters (e.g., { count: 5 })",
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "key"
                ],
                "additionalProperties": false
              }
            ],
            "description": "Action button label"
          },
          "action": {
            "type": "string",
            "description": "Action identifier to execute"
          },
          "variant": {
            "default": "primary",
            "description": "Button variant style",
            "type": "string",
            "enum": [
              "primary",
              "secondary",
              "link"
            ]
          }
        },
        "required": [
          "label",
          "action",
          "variant"
        ],
        "additionalProperties": false,
        "description": "Notification action button"
      }
    },
    "position": {
      "description": "Override default position",
      "type": "string",
      "enum": [
        "top_left",
        "top_center",
        "top_right",
        "bottom_left",
        "bottom_center",
        "bottom_right"
      ]
    },
    "ariaLabel": {
      "description": "Accessible label for screen readers (WAI-ARIA aria-label)",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Translation key (e.g., \"views.task_list.label\")"
            },
            "defaultValue": {
              "description": "Fallback value when translation key is not found",
              "type": "string"
            },
            "params": {
              "description": "Interpolation parameters (e.g., { count: 5 })",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ariaDescribedBy": {
      "description": "ID of element providing additional description (WAI-ARIA aria-describedby)",
      "type": "string"
    },
    "role": {
      "description": "WAI-ARIA role attribute (e.g., \"dialog\", \"navigation\", \"alert\")",
      "type": "string"
    }
  },
  "required": [
    "type",
    "severity",
    "message",
    "dismissible"
  ],
  "additionalProperties": false,
  "description": "Notification instance definition",
  "$id": "https://schema.objectstack.io/v3.0.11/ui/Notification.json",
  "x-spec-version": "3.0.11"
}