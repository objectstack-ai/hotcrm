{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": true,
      "description": "Enable automated testing",
      "type": "boolean"
    },
    "testTypes": {
      "default": [
        "unit",
        "integration"
      ],
      "description": "Types of tests to run",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "unit",
          "integration",
          "e2e",
          "performance",
          "security",
          "accessibility"
        ]
      }
    },
    "coverageThreshold": {
      "default": 80,
      "description": "Minimum test coverage percentage",
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "framework": {
      "description": "Testing framework (e.g., vitest, jest, playwright)",
      "type": "string"
    },
    "preCommitTests": {
      "default": true,
      "description": "Run tests before committing",
      "type": "boolean"
    },
    "autoFix": {
      "default": false,
      "description": "Attempt to auto-fix failing tests",
      "type": "boolean"
    }
  },
  "required": [
    "enabled",
    "testTypes",
    "coverageThreshold",
    "preCommitTests",
    "autoFix"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/TestingConfig.json",
  "x-spec-version": "3.0.11"
}