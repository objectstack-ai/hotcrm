{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "source": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ],
      "description": "Source column header(s)"
    },
    "target": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ],
      "description": "Target object field(s)"
    },
    "transform": {
      "default": "none",
      "type": "string",
      "enum": [
        "none",
        "constant",
        "lookup",
        "split",
        "join",
        "javascript",
        "map"
      ]
    },
    "params": {
      "type": "object",
      "properties": {
        "value": {},
        "object": {
          "type": "string"
        },
        "fromField": {
          "type": "string"
        },
        "toField": {
          "type": "string"
        },
        "autoCreate": {
          "type": "boolean"
        },
        "valueMap": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "separator": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "source",
    "target",
    "transform"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/data/FieldMapping.json",
  "x-spec-version": "3.0.11"
}