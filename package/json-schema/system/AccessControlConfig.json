{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "acl": {
      "default": "private",
      "description": "Default access control level",
      "type": "string",
      "enum": [
        "private",
        "public_read",
        "public_read_write",
        "authenticated_read",
        "bucket_owner_read",
        "bucket_owner_full_control"
      ]
    },
    "allowedOrigins": {
      "description": "CORS allowed origins",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowedMethods": {
      "description": "CORS allowed HTTP methods",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "GET",
          "PUT",
          "POST",
          "DELETE",
          "HEAD"
        ]
      }
    },
    "allowedHeaders": {
      "description": "CORS allowed headers",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exposeHeaders": {
      "description": "CORS exposed headers",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "maxAge": {
      "description": "CORS preflight cache duration in seconds",
      "type": "number",
      "minimum": 0
    },
    "corsEnabled": {
      "default": false,
      "description": "Enable CORS configuration",
      "type": "boolean"
    },
    "publicAccess": {
      "description": "Public access control",
      "type": "object",
      "properties": {
        "allowPublicRead": {
          "default": false,
          "description": "Allow public read access",
          "type": "boolean"
        },
        "allowPublicWrite": {
          "default": false,
          "description": "Allow public write access",
          "type": "boolean"
        },
        "allowPublicList": {
          "default": false,
          "description": "Allow public bucket listing",
          "type": "boolean"
        }
      },
      "required": [
        "allowPublicRead",
        "allowPublicWrite",
        "allowPublicList"
      ],
      "additionalProperties": false
    },
    "allowedIps": {
      "description": "Allowed IP addresses/CIDR blocks",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockedIps": {
      "description": "Blocked IP addresses/CIDR blocks",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "acl",
    "corsEnabled"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/system/AccessControlConfig.json",
  "x-spec-version": "3.0.11"
}