{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "description": "Unique handler identifier",
      "type": "string"
    },
    "eventName": {
      "type": "string",
      "description": "Name of event to handle (supports wildcards like user.*)"
    },
    "handler": {
      "description": "Handler function"
    },
    "priority": {
      "default": 0,
      "description": "Execution priority (lower numbers execute first)",
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "async": {
      "default": true,
      "description": "Execute in background (true) or block (false)",
      "type": "boolean"
    },
    "retry": {
      "description": "Retry policy for failed handlers",
      "type": "object",
      "properties": {
        "maxRetries": {
          "default": 3,
          "description": "Maximum retry attempts",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "backoffMs": {
          "default": 1000,
          "description": "Initial backoff delay",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "backoffMultiplier": {
          "default": 2,
          "description": "Backoff multiplier",
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "maxRetries",
        "backoffMs",
        "backoffMultiplier"
      ],
      "additionalProperties": false
    },
    "timeoutMs": {
      "description": "Handler timeout in milliseconds",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "filter": {
      "description": "Optional filter to determine if handler should execute"
    }
  },
  "required": [
    "eventName",
    "handler",
    "priority",
    "async"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/EventHandler.json",
  "x-spec-version": "3.0.11"
}