{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Unique service name identifier"
    },
    "scope": {
      "default": "singleton",
      "description": "Service scope type",
      "type": "string",
      "enum": [
        "singleton",
        "transient",
        "scoped"
      ]
    },
    "type": {
      "description": "Service type or interface name",
      "type": "string"
    },
    "registeredAt": {
      "description": "Unix timestamp in milliseconds when service was registered",
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "metadata": {
      "description": "Additional service-specific metadata",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "name",
    "scope"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/ServiceMetadata.json",
  "x-spec-version": "3.0.11"
}