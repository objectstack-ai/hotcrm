{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "implements": {
      "description": "List of protocols this plugin conforms to",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "protocol": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^([a-z][a-z0-9]*\\.)+protocol\\.[a-z][a-z0-9._]*\\.v\\d+$",
                "description": "Unique protocol identifier (e.g., com.objectstack.protocol.storage.v1)"
              },
              "label": {
                "type": "string"
              },
              "version": {
                "type": "object",
                "properties": {
                  "major": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "minor": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "patch": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "major",
                  "minor",
                  "patch"
                ],
                "additionalProperties": false,
                "description": "Semantic version of the protocol"
              },
              "specification": {
                "description": "URL or path to protocol specification",
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "label",
              "version"
            ],
            "additionalProperties": false
          },
          "conformance": {
            "default": "full",
            "type": "string",
            "enum": [
              "full",
              "partial",
              "experimental",
              "deprecated"
            ],
            "description": "Level of protocol conformance"
          },
          "implementedFeatures": {
            "description": "List of implemented feature names",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "features": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Feature identifier within the protocol"
                },
                "enabled": {
                  "default": true,
                  "type": "boolean"
                },
                "description": {
                  "type": "string"
                },
                "sinceVersion": {
                  "description": "Version when this feature was added",
                  "type": "string"
                },
                "deprecatedSince": {
                  "description": "Version when deprecated",
                  "type": "string"
                }
              },
              "required": [
                "name",
                "enabled"
              ],
              "additionalProperties": false
            }
          },
          "metadata": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "certified": {
            "default": false,
            "description": "Has passed official conformance tests",
            "type": "boolean"
          },
          "certificationDate": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          }
        },
        "required": [
          "protocol",
          "conformance",
          "certified"
        ],
        "additionalProperties": false
      }
    },
    "provides": {
      "description": "Services/APIs this plugin offers to others",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^([a-z][a-z0-9]*\\.)+interface\\.[a-z][a-z0-9._]+$",
            "description": "Unique interface identifier"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "version": {
            "type": "object",
            "properties": {
              "major": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "minor": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "patch": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "major",
              "minor",
              "patch"
            ],
            "additionalProperties": false,
            "description": "Semantic version of the protocol"
          },
          "methods": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Method name"
                },
                "description": {
                  "type": "string"
                },
                "parameters": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string",
                        "description": "Type notation (e.g., string, number, User)"
                      },
                      "required": {
                        "default": true,
                        "type": "boolean"
                      },
                      "description": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name",
                      "type",
                      "required"
                    ],
                    "additionalProperties": false
                  }
                },
                "returnType": {
                  "description": "Return value type",
                  "type": "string"
                },
                "async": {
                  "default": false,
                  "description": "Whether method returns a Promise",
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "async"
              ],
              "additionalProperties": false
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Event name"
                },
                "description": {
                  "type": "string"
                },
                "payload": {
                  "description": "Event payload type",
                  "type": "string"
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          },
          "stability": {
            "default": "stable",
            "type": "string",
            "enum": [
              "stable",
              "beta",
              "alpha",
              "experimental"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "version",
          "methods",
          "stability"
        ],
        "additionalProperties": false
      }
    },
    "requires": {
      "description": "Required plugins and their capabilities",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pluginId": {
            "type": "string",
            "pattern": "^([a-z][a-z0-9]*\\.)+[a-z][a-z0-9-]+$",
            "description": "Required plugin identifier"
          },
          "version": {
            "type": "string",
            "description": "Semantic version constraint"
          },
          "optional": {
            "default": false,
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "requiredCapabilities": {
            "description": "Protocol IDs the dependency must support",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "pluginId",
          "version",
          "optional"
        ],
        "additionalProperties": false
      }
    },
    "extensionPoints": {
      "description": "Points where other plugins can extend this plugin",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^([a-z][a-z0-9]*\\.)+extension\\.[a-z][a-z0-9._]+$",
            "description": "Unique extension point identifier"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "action",
              "hook",
              "widget",
              "provider",
              "transformer",
              "validator",
              "decorator"
            ]
          },
          "contract": {
            "type": "object",
            "properties": {
              "input": {
                "description": "Input type/schema",
                "type": "string"
              },
              "output": {
                "description": "Output type/schema",
                "type": "string"
              },
              "signature": {
                "description": "Function signature if applicable",
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "cardinality": {
            "default": "multiple",
            "description": "Whether multiple extensions can register to this point",
            "type": "string",
            "enum": [
              "single",
              "multiple"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "cardinality"
        ],
        "additionalProperties": false
      }
    },
    "extensions": {
      "description": "Extensions contributed to other plugins",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "targetPluginId": {
            "type": "string",
            "description": "Plugin ID being extended"
          },
          "extensionPointId": {
            "type": "string",
            "description": "Extension point identifier"
          },
          "implementation": {
            "type": "string",
            "description": "Path to implementation module"
          },
          "priority": {
            "default": 100,
            "description": "Registration priority (lower = higher priority)",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "targetPluginId",
          "extensionPointId",
          "implementation",
          "priority"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/PluginCapabilityManifest.json",
  "x-spec-version": "3.0.11"
}