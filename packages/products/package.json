{
  "name": "@hotcrm/products",
  "version": "1.0.0",
  "type": "module",
  "description": "Products module - Product catalog, pricing, and quotes",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "objectstack dev",
    "start": "objectstack serve",
    "build": "tsc && objectstack compile",
    "typecheck": "tsc --noEmit",
    "test": "objectstack test"
  },
  "keywords": [
    "crm",
    "products",
    "pricing",
    "cpq"
  ],
  "author": "HotCRM Team",
  "dependencies": {
    "@objectstack/spec": "^3.0.11"
  },
  "devDependencies": {
    "@objectstack/cli": "^3.0.11",
    "typescript": "^5.9.3"
  }
}
