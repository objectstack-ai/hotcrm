{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$",
      "description": "Pipeline name (snake_case)"
    },
    "label": {
      "type": "string",
      "description": "Display name"
    },
    "description": {
      "type": "string"
    },
    "embedding": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "openai",
            "cohere",
            "huggingface",
            "azure_openai",
            "local",
            "custom"
          ]
        },
        "model": {
          "type": "string",
          "description": "Model name (e.g., \"text-embedding-3-large\")"
        },
        "dimensions": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Embedding vector dimensions"
        },
        "maxTokens": {
          "description": "Maximum tokens per embedding",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "batchSize": {
          "default": 100,
          "description": "Batch size for embedding",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "endpoint": {
          "description": "Custom endpoint URL",
          "type": "string",
          "format": "uri"
        },
        "apiKey": {
          "description": "API key",
          "type": "string"
        },
        "secretRef": {
          "description": "Reference to stored secret",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "dimensions",
        "batchSize"
      ],
      "additionalProperties": false
    },
    "vectorStore": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "pinecone",
            "weaviate",
            "qdrant",
            "milvus",
            "chroma",
            "pgvector",
            "redis",
            "opensearch",
            "elasticsearch",
            "custom"
          ]
        },
        "indexName": {
          "type": "string",
          "description": "Index/collection name"
        },
        "namespace": {
          "description": "Namespace for multi-tenancy",
          "type": "string"
        },
        "host": {
          "description": "Vector store host",
          "type": "string"
        },
        "port": {
          "description": "Vector store port",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "secretRef": {
          "description": "Reference to stored secret",
          "type": "string"
        },
        "apiKey": {
          "description": "API key or reference to secret",
          "type": "string"
        },
        "dimensions": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Vector dimensions"
        },
        "metric": {
          "default": "cosine",
          "type": "string",
          "enum": [
            "cosine",
            "euclidean",
            "dotproduct"
          ]
        },
        "batchSize": {
          "default": 100,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "connectionPoolSize": {
          "default": 10,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "timeout": {
          "default": 30000,
          "description": "Timeout in milliseconds",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "provider",
        "indexName",
        "dimensions",
        "metric",
        "batchSize",
        "connectionPoolSize",
        "timeout"
      ],
      "additionalProperties": false
    },
    "chunking": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "fixed"
            },
            "chunkSize": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "Fixed chunk size in tokens/chars"
            },
            "chunkOverlap": {
              "default": 0,
              "description": "Overlap between chunks",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "unit": {
              "default": "tokens",
              "type": "string",
              "enum": [
                "tokens",
                "characters"
              ]
            }
          },
          "required": [
            "type",
            "chunkSize",
            "chunkOverlap",
            "unit"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "semantic"
            },
            "model": {
              "description": "Model for semantic chunking",
              "type": "string"
            },
            "minChunkSize": {
              "default": 100,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxChunkSize": {
              "default": 1000,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "type",
            "minChunkSize",
            "maxChunkSize"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "recursive"
            },
            "separators": {
              "default": [
                "\n\n",
                "\n",
                " ",
                ""
              ],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "chunkSize": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "chunkOverlap": {
              "default": 0,
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "type",
            "separators",
            "chunkSize",
            "chunkOverlap"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "markdown"
            },
            "maxChunkSize": {
              "default": 1000,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "respectHeaders": {
              "default": true,
              "description": "Keep headers with content",
              "type": "boolean"
            },
            "respectCodeBlocks": {
              "default": true,
              "description": "Keep code blocks intact",
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "maxChunkSize",
            "respectHeaders",
            "respectCodeBlocks"
          ],
          "additionalProperties": false
        }
      ]
    },
    "retrieval": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "similarity"
            },
            "topK": {
              "default": 5,
              "description": "Number of results to retrieve",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "scoreThreshold": {
              "description": "Minimum similarity score",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "type",
            "topK"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "mmr"
            },
            "topK": {
              "default": 5,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "fetchK": {
              "default": 20,
              "description": "Initial fetch size",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "lambda": {
              "default": 0.5,
              "description": "Diversity vs relevance (0=diverse, 1=relevant)",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "type",
            "topK",
            "fetchK",
            "lambda"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "hybrid"
            },
            "topK": {
              "default": 5,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "vectorWeight": {
              "default": 0.7,
              "description": "Weight for vector search",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "keywordWeight": {
              "default": 0.3,
              "description": "Weight for keyword search",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "type",
            "topK",
            "vectorWeight",
            "keywordWeight"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "parent_document"
            },
            "topK": {
              "default": 5,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "retrieveParent": {
              "default": true,
              "description": "Retrieve full parent document",
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "topK",
            "retrieveParent"
          ],
          "additionalProperties": false
        }
      ]
    },
    "reranking": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "model": {
          "description": "Reranking model name",
          "type": "string"
        },
        "provider": {
          "type": "string",
          "enum": [
            "cohere",
            "huggingface",
            "custom"
          ]
        },
        "topK": {
          "default": 3,
          "description": "Final number of results after reranking",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "enabled",
        "topK"
      ],
      "additionalProperties": false
    },
    "loaders": {
      "description": "Document loaders",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "file",
              "directory",
              "url",
              "api",
              "database",
              "custom"
            ]
          },
          "source": {
            "type": "string",
            "description": "Source path, URL, or identifier"
          },
          "fileTypes": {
            "description": "Accepted file extensions (e.g., [\".pdf\", \".md\"])",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recursive": {
            "default": false,
            "description": "Process directories recursively",
            "type": "boolean"
          },
          "maxFileSize": {
            "description": "Maximum file size in bytes",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "excludePatterns": {
            "description": "Patterns to exclude",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "extractImages": {
            "default": false,
            "description": "Extract text from images (OCR)",
            "type": "boolean"
          },
          "extractTables": {
            "default": false,
            "description": "Extract and format tables",
            "type": "boolean"
          },
          "loaderConfig": {
            "description": "Custom loader-specific config",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "type",
          "source",
          "recursive",
          "extractImages",
          "extractTables"
        ],
        "additionalProperties": false
      }
    },
    "maxContextTokens": {
      "default": 4000,
      "description": "Maximum tokens in context",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "contextWindow": {
      "description": "LLM context window size",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "metadataFilters": {
      "description": "Global filters for retrieval",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "description": "Metadata field to filter"
            },
            "operator": {
              "default": "eq",
              "type": "string",
              "enum": [
                "eq",
                "neq",
                "gt",
                "gte",
                "lt",
                "lte",
                "in",
                "nin",
                "contains"
              ]
            },
            "value": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  }
                }
              ],
              "description": "Filter value"
            }
          },
          "required": [
            "field",
            "operator",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/__schema0"
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    "enableCache": {
      "default": true,
      "type": "boolean"
    },
    "cacheTTL": {
      "default": 3600,
      "description": "Cache TTL in seconds",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "cacheInvalidationStrategy": {
      "default": "time_based",
      "type": "string",
      "enum": [
        "time_based",
        "manual",
        "on_update"
      ]
    }
  },
  "required": [
    "name",
    "label",
    "embedding",
    "vectorStore",
    "chunking",
    "retrieval",
    "maxContextTokens",
    "enableCache",
    "cacheTTL"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "logic": {
          "default": "and",
          "type": "string",
          "enum": [
            "and",
            "or"
          ]
        },
        "filters": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "field": {
                    "type": "string",
                    "description": "Metadata field to filter"
                  },
                  "operator": {
                    "default": "eq",
                    "type": "string",
                    "enum": [
                      "eq",
                      "neq",
                      "gt",
                      "gte",
                      "lt",
                      "lte",
                      "in",
                      "nin",
                      "contains"
                    ]
                  },
                  "value": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "array",
                        "items": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "number"
                            }
                          ]
                        }
                      }
                    ],
                    "description": "Filter value"
                  }
                },
                "required": [
                  "field",
                  "operator",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "$ref": "#/$defs/__schema0"
              }
            ]
          }
        }
      },
      "required": [
        "logic",
        "filters"
      ],
      "additionalProperties": false
    }
  },
  "$id": "https://schema.objectstack.io/v3.0.11/ai/RAGPipelineConfig.json",
  "x-spec-version": "3.0.11"
}