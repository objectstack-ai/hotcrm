{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "output": {
      "type": "string",
      "description": "Output file path"
    },
    "format": {
      "default": "json",
      "description": "Export format",
      "type": "string",
      "enum": [
        "json",
        "yaml",
        "typescript",
        "javascript"
      ]
    },
    "filter": {
      "description": "Filter items to export",
      "type": "string"
    },
    "includeStats": {
      "default": false,
      "description": "Include metadata statistics",
      "type": "boolean"
    },
    "compress": {
      "default": false,
      "description": "Compress output (gzip)",
      "type": "boolean"
    },
    "prettify": {
      "default": true,
      "description": "Pretty print output",
      "type": "boolean"
    }
  },
  "required": [
    "output",
    "format",
    "includeStats",
    "compress",
    "prettify"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/MetadataExportOptions.json",
  "x-spec-version": "3.0.11"
}