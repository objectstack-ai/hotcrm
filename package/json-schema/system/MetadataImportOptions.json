{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "description": "Input directory or file"
    },
    "strategy": {
      "default": "merge",
      "type": "string",
      "enum": [
        "merge",
        "replace",
        "skip"
      ]
    },
    "validate": {
      "default": true,
      "type": "boolean"
    }
  },
  "required": [
    "source",
    "strategy",
    "validate"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/system/MetadataImportOptions.json",
  "x-spec-version": "3.0.11"
}