{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "description": "Filter by package status",
      "type": "string",
      "enum": [
        "installed",
        "disabled",
        "installing",
        "upgrading",
        "uninstalling",
        "error"
      ]
    },
    "enabled": {
      "description": "Filter by enabled state",
      "type": "boolean"
    },
    "limit": {
      "default": 50,
      "description": "Maximum number of packages to return",
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "cursor": {
      "description": "Cursor for pagination",
      "type": "string"
    }
  },
  "required": [
    "limit"
  ],
  "additionalProperties": false,
  "description": "List installed packages request",
  "$id": "https://schema.objectstack.io/v3.0.11/api/ListInstalledPackagesRequest.json",
  "x-spec-version": "3.0.11"
}