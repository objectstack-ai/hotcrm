{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "user",
        "system",
        "service",
        "automation"
      ],
      "description": "Actor type"
    },
    "id": {
      "type": "string",
      "description": "Actor ID"
    },
    "name": {
      "description": "Actor display name",
      "type": "string"
    },
    "avatarUrl": {
      "description": "Actor avatar URL",
      "type": "string",
      "format": "uri"
    },
    "source": {
      "description": "Source application (e.g., \"Omni\", \"API\", \"Studio\")",
      "type": "string"
    }
  },
  "required": [
    "type",
    "id"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/data/FeedActor.json",
  "x-spec-version": "3.0.11"
}