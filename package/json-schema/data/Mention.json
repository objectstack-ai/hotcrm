{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "user",
        "team",
        "record"
      ],
      "description": "Mention target type"
    },
    "id": {
      "type": "string",
      "description": "Target ID"
    },
    "name": {
      "type": "string",
      "description": "Display name for rendering"
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Character offset in body text"
    },
    "length": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Length of mention token in body text"
    }
  },
  "required": [
    "type",
    "id",
    "name",
    "offset",
    "length"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/data/Mention.json",
  "x-spec-version": "3.0.11"
}