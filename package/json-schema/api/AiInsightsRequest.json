{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "object": {
      "type": "string",
      "description": "Object name to analyze"
    },
    "recordId": {
      "description": "Specific record to analyze",
      "type": "string"
    },
    "type": {
      "description": "Type of insight",
      "type": "string",
      "enum": [
        "summary",
        "trends",
        "anomalies",
        "recommendations"
      ]
    }
  },
  "required": [
    "object"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/AiInsightsRequest.json",
  "x-spec-version": "3.0.11"
}