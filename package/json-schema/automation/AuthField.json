{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$",
      "description": "Field name (snake_case)"
    },
    "label": {
      "type": "string",
      "description": "Field label"
    },
    "type": {
      "default": "text",
      "description": "Field type",
      "type": "string",
      "enum": [
        "text",
        "password",
        "url",
        "select"
      ]
    },
    "description": {
      "description": "Field description",
      "type": "string"
    },
    "required": {
      "default": true,
      "description": "Required field",
      "type": "boolean"
    },
    "default": {
      "description": "Default value",
      "type": "string"
    },
    "options": {
      "description": "Select field options",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "placeholder": {
      "description": "Placeholder text",
      "type": "string"
    }
  },
  "required": [
    "name",
    "label",
    "type",
    "required"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/automation/AuthField.json",
  "x-spec-version": "3.0.11"
}