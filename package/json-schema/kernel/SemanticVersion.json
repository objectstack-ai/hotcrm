{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "major": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Major version (breaking changes)"
    },
    "minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Minor version (backward compatible features)"
    },
    "patch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Patch version (backward compatible fixes)"
    },
    "preRelease": {
      "description": "Pre-release identifier (alpha, beta, rc.1)",
      "type": "string"
    },
    "build": {
      "description": "Build metadata",
      "type": "string"
    }
  },
  "required": [
    "major",
    "minor",
    "patch"
  ],
  "additionalProperties": false,
  "description": "Semantic version number",
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/SemanticVersion.json",
  "x-spec-version": "3.0.11"
}