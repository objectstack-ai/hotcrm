{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$",
      "description": "Machine name (snake_case)"
    },
    "label": {
      "description": "Human readable label",
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "text",
        "textarea",
        "email",
        "url",
        "phone",
        "password",
        "markdown",
        "html",
        "richtext",
        "number",
        "currency",
        "percent",
        "date",
        "datetime",
        "time",
        "boolean",
        "toggle",
        "select",
        "multiselect",
        "radio",
        "checkboxes",
        "lookup",
        "master_detail",
        "tree",
        "image",
        "file",
        "avatar",
        "video",
        "audio",
        "formula",
        "summary",
        "autonumber",
        "location",
        "address",
        "code",
        "json",
        "color",
        "rating",
        "slider",
        "signature",
        "qrcode",
        "progress",
        "tags",
        "vector"
      ],
      "description": "Field Data Type"
    },
    "description": {
      "description": "Tooltip/Help text",
      "type": "string"
    },
    "format": {
      "description": "Format string (e.g. email, phone)",
      "type": "string"
    },
    "columnName": {
      "description": "Physical column name in the target datasource. Defaults to the field key when not set.",
      "type": "string"
    },
    "required": {
      "default": false,
      "description": "Is required",
      "type": "boolean"
    },
    "searchable": {
      "default": false,
      "description": "Is searchable",
      "type": "boolean"
    },
    "multiple": {
      "default": false,
      "description": "Allow multiple values (Stores as Array/JSON). Applicable for select, lookup, file, image.",
      "type": "boolean"
    },
    "unique": {
      "default": false,
      "description": "Is unique constraint",
      "type": "boolean"
    },
    "defaultValue": {
      "description": "Default value"
    },
    "maxLength": {
      "description": "Max character length",
      "type": "number"
    },
    "minLength": {
      "description": "Min character length",
      "type": "number"
    },
    "precision": {
      "description": "Total digits",
      "type": "number"
    },
    "scale": {
      "description": "Decimal places",
      "type": "number"
    },
    "min": {
      "description": "Minimum value",
      "type": "number"
    },
    "max": {
      "description": "Maximum value",
      "type": "number"
    },
    "options": {
      "description": "Static options for select/multiselect",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "Display label (human-readable, any case allowed)"
          },
          "value": {
            "type": "string",
            "minLength": 2,
            "pattern": "^[a-z][a-z0-9_.]*$",
            "description": "Stored value (lowercase machine identifier)"
          },
          "color": {
            "description": "Color code for badges/charts",
            "type": "string"
          },
          "default": {
            "description": "Is default option",
            "type": "boolean"
          }
        },
        "required": [
          "label",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "reference": {
      "description": "Target Object Name",
      "type": "string"
    },
    "referenceFilters": {
      "description": "Filters applied to lookup dialogs (e.g. \"active = true\")",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "writeRequiresMasterRead": {
      "description": "If true, user needs read access to master record to edit this field",
      "type": "boolean"
    },
    "deleteBehavior": {
      "default": "set_null",
      "description": "What happens if referenced record is deleted",
      "type": "string",
      "enum": [
        "set_null",
        "cascade",
        "restrict"
      ]
    },
    "expression": {
      "description": "Formula expression",
      "type": "string"
    },
    "summaryOperations": {
      "description": "Roll-up summary definition",
      "type": "object",
      "properties": {
        "object": {
          "type": "string",
          "description": "Source child object name for roll-up"
        },
        "field": {
          "type": "string",
          "description": "Field on child object to aggregate"
        },
        "function": {
          "type": "string",
          "enum": [
            "count",
            "sum",
            "min",
            "max",
            "avg"
          ],
          "description": "Aggregation function to apply"
        }
      },
      "required": [
        "object",
        "field",
        "function"
      ],
      "additionalProperties": false
    },
    "language": {
      "description": "Programming language for syntax highlighting (e.g., javascript, python, sql)",
      "type": "string"
    },
    "theme": {
      "description": "Code editor theme (e.g., dark, light, monokai)",
      "type": "string"
    },
    "lineNumbers": {
      "description": "Show line numbers in code editor",
      "type": "boolean"
    },
    "maxRating": {
      "description": "Maximum rating value (default: 5)",
      "type": "number"
    },
    "allowHalf": {
      "description": "Allow half-star ratings",
      "type": "boolean"
    },
    "displayMap": {
      "description": "Display map widget for location field",
      "type": "boolean"
    },
    "allowGeocoding": {
      "description": "Allow address-to-coordinate conversion",
      "type": "boolean"
    },
    "addressFormat": {
      "description": "Address format template",
      "type": "string",
      "enum": [
        "us",
        "uk",
        "international"
      ]
    },
    "colorFormat": {
      "description": "Color value format",
      "type": "string",
      "enum": [
        "hex",
        "rgb",
        "rgba",
        "hsl"
      ]
    },
    "allowAlpha": {
      "description": "Allow transparency/alpha channel",
      "type": "boolean"
    },
    "presetColors": {
      "description": "Preset color options",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "step": {
      "description": "Step increment for slider (default: 1)",
      "type": "number"
    },
    "showValue": {
      "description": "Display current value on slider",
      "type": "boolean"
    },
    "marks": {
      "description": "Custom marks/labels at specific values (e.g., {0: \"Low\", 50: \"Medium\", 100: \"High\"})",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "barcodeFormat": {
      "description": "Barcode format type",
      "type": "string",
      "enum": [
        "qr",
        "ean13",
        "ean8",
        "code128",
        "code39",
        "upca",
        "upce"
      ]
    },
    "qrErrorCorrection": {
      "description": "QR code error correction level (L=7%, M=15%, Q=25%, H=30%). Only applicable when barcodeFormat is \"qr\"",
      "type": "string",
      "enum": [
        "L",
        "M",
        "Q",
        "H"
      ]
    },
    "displayValue": {
      "description": "Display human-readable value below barcode/QR code",
      "type": "boolean"
    },
    "allowScanning": {
      "description": "Enable camera scanning for barcode/QR code input",
      "type": "boolean"
    },
    "currencyConfig": {
      "description": "Configuration for currency field type",
      "type": "object",
      "properties": {
        "precision": {
          "default": 2,
          "description": "Decimal precision (default: 2)",
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "currencyMode": {
          "default": "dynamic",
          "description": "Currency mode: dynamic (user selectable) or fixed (single currency)",
          "type": "string",
          "enum": [
            "dynamic",
            "fixed"
          ]
        },
        "defaultCurrency": {
          "default": "CNY",
          "description": "Default or fixed currency code (ISO 4217, e.g., USD, CNY, EUR)",
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        }
      },
      "required": [
        "precision",
        "currencyMode",
        "defaultCurrency"
      ],
      "additionalProperties": false
    },
    "vectorConfig": {
      "description": "Configuration for vector field type (AI/ML embeddings)",
      "type": "object",
      "properties": {
        "dimensions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "description": "Vector dimensionality (e.g., 1536 for OpenAI embeddings)"
        },
        "distanceMetric": {
          "default": "cosine",
          "description": "Distance/similarity metric for vector search",
          "type": "string",
          "enum": [
            "cosine",
            "euclidean",
            "dotProduct",
            "manhattan"
          ]
        },
        "normalized": {
          "default": false,
          "description": "Whether vectors are normalized (unit length)",
          "type": "boolean"
        },
        "indexed": {
          "default": true,
          "description": "Whether to create a vector index for fast similarity search",
          "type": "boolean"
        },
        "indexType": {
          "description": "Vector index algorithm (HNSW for high accuracy, IVFFlat for large datasets)",
          "type": "string",
          "enum": [
            "hnsw",
            "ivfflat",
            "flat"
          ]
        }
      },
      "required": [
        "dimensions",
        "distanceMetric",
        "normalized",
        "indexed"
      ],
      "additionalProperties": false
    },
    "fileAttachmentConfig": {
      "description": "Configuration for file and attachment field types",
      "type": "object",
      "properties": {
        "minSize": {
          "description": "Minimum file size in bytes",
          "type": "number",
          "minimum": 0
        },
        "maxSize": {
          "description": "Maximum file size in bytes (e.g., 10485760 = 10MB)",
          "type": "number",
          "minimum": 1
        },
        "allowedTypes": {
          "description": "Allowed file extensions (e.g., [\".pdf\", \".docx\", \".jpg\"])",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blockedTypes": {
          "description": "Blocked file extensions (e.g., [\".exe\", \".bat\", \".sh\"])",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowedMimeTypes": {
          "description": "Allowed MIME types (e.g., [\"image/jpeg\", \"application/pdf\"])",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blockedMimeTypes": {
          "description": "Blocked MIME types",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "virusScan": {
          "default": false,
          "description": "Enable virus scanning for uploaded files",
          "type": "boolean"
        },
        "virusScanProvider": {
          "description": "Virus scanning service provider",
          "type": "string",
          "enum": [
            "clamav",
            "virustotal",
            "metadefender",
            "custom"
          ]
        },
        "virusScanOnUpload": {
          "default": true,
          "description": "Scan files immediately on upload",
          "type": "boolean"
        },
        "quarantineOnThreat": {
          "default": true,
          "description": "Quarantine files if threat detected",
          "type": "boolean"
        },
        "storageProvider": {
          "description": "Object storage provider name (references ObjectStorageConfig)",
          "type": "string"
        },
        "storageBucket": {
          "description": "Target bucket name",
          "type": "string"
        },
        "storagePrefix": {
          "description": "Storage path prefix (e.g., \"uploads/documents/\")",
          "type": "string"
        },
        "imageValidation": {
          "description": "Image-specific validation rules",
          "type": "object",
          "properties": {
            "minWidth": {
              "description": "Minimum image width in pixels",
              "type": "number",
              "minimum": 1
            },
            "maxWidth": {
              "description": "Maximum image width in pixels",
              "type": "number",
              "minimum": 1
            },
            "minHeight": {
              "description": "Minimum image height in pixels",
              "type": "number",
              "minimum": 1
            },
            "maxHeight": {
              "description": "Maximum image height in pixels",
              "type": "number",
              "minimum": 1
            },
            "aspectRatio": {
              "description": "Required aspect ratio (e.g., \"16:9\", \"1:1\")",
              "type": "string"
            },
            "generateThumbnails": {
              "default": false,
              "description": "Auto-generate thumbnails",
              "type": "boolean"
            },
            "thumbnailSizes": {
              "description": "Thumbnail size configurations",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Thumbnail variant name (e.g., \"small\", \"medium\", \"large\")"
                  },
                  "width": {
                    "type": "number",
                    "minimum": 1,
                    "description": "Thumbnail width in pixels"
                  },
                  "height": {
                    "type": "number",
                    "minimum": 1,
                    "description": "Thumbnail height in pixels"
                  },
                  "crop": {
                    "default": false,
                    "description": "Crop to exact dimensions",
                    "type": "boolean"
                  }
                },
                "required": [
                  "name",
                  "width",
                  "height",
                  "crop"
                ],
                "additionalProperties": false
              }
            },
            "preserveMetadata": {
              "default": false,
              "description": "Preserve EXIF metadata",
              "type": "boolean"
            },
            "autoRotate": {
              "default": true,
              "description": "Auto-rotate based on EXIF orientation",
              "type": "boolean"
            }
          },
          "required": [
            "generateThumbnails",
            "preserveMetadata",
            "autoRotate"
          ],
          "additionalProperties": false
        },
        "allowMultiple": {
          "default": false,
          "description": "Allow multiple file uploads (overrides field.multiple)",
          "type": "boolean"
        },
        "allowReplace": {
          "default": true,
          "description": "Allow replacing existing files",
          "type": "boolean"
        },
        "allowDelete": {
          "default": true,
          "description": "Allow deleting uploaded files",
          "type": "boolean"
        },
        "requireUpload": {
          "default": false,
          "description": "Require at least one file when field is required",
          "type": "boolean"
        },
        "extractMetadata": {
          "default": true,
          "description": "Extract file metadata (name, size, type, etc.)",
          "type": "boolean"
        },
        "extractText": {
          "default": false,
          "description": "Extract text content from documents (OCR/parsing)",
          "type": "boolean"
        },
        "versioningEnabled": {
          "default": false,
          "description": "Keep previous versions of replaced files",
          "type": "boolean"
        },
        "maxVersions": {
          "description": "Maximum number of versions to retain",
          "type": "number",
          "minimum": 1
        },
        "publicRead": {
          "default": false,
          "description": "Allow public read access to uploaded files",
          "type": "boolean"
        },
        "presignedUrlExpiry": {
          "default": 3600,
          "description": "Presigned URL expiration in seconds (default: 1 hour)",
          "type": "number",
          "minimum": 60,
          "maximum": 604800
        }
      },
      "required": [
        "virusScan",
        "virusScanOnUpload",
        "quarantineOnThreat",
        "allowMultiple",
        "allowReplace",
        "allowDelete",
        "requireUpload",
        "extractMetadata",
        "extractText",
        "versioningEnabled",
        "publicRead",
        "presignedUrlExpiry"
      ],
      "additionalProperties": false
    },
    "encryptionConfig": {
      "description": "Field-level encryption configuration for sensitive data (GDPR/HIPAA/PCI-DSS)",
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "description": "Enable field-level encryption",
          "type": "boolean"
        },
        "algorithm": {
          "default": "aes-256-gcm",
          "description": "Encryption algorithm",
          "type": "string",
          "enum": [
            "aes-256-gcm",
            "aes-256-cbc",
            "chacha20-poly1305"
          ]
        },
        "keyManagement": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "local",
                "aws-kms",
                "azure-key-vault",
                "gcp-kms",
                "hashicorp-vault"
              ],
              "description": "Key management service provider"
            },
            "keyId": {
              "description": "Key identifier in the provider",
              "type": "string"
            },
            "rotationPolicy": {
              "description": "Key rotation policy",
              "type": "object",
              "properties": {
                "enabled": {
                  "default": false,
                  "description": "Enable automatic key rotation",
                  "type": "boolean"
                },
                "frequencyDays": {
                  "default": 90,
                  "description": "Rotation frequency in days",
                  "type": "number",
                  "minimum": 1
                },
                "retainOldVersions": {
                  "default": 3,
                  "description": "Number of old key versions to retain",
                  "type": "number"
                },
                "autoRotate": {
                  "default": true,
                  "description": "Automatically rotate without manual approval",
                  "type": "boolean"
                }
              },
              "required": [
                "enabled",
                "frequencyDays",
                "retainOldVersions",
                "autoRotate"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "provider"
          ],
          "additionalProperties": false,
          "description": "Key management configuration"
        },
        "scope": {
          "type": "string",
          "enum": [
            "field",
            "record",
            "table",
            "database"
          ],
          "description": "Encryption scope level"
        },
        "deterministicEncryption": {
          "default": false,
          "description": "Allows equality queries on encrypted data",
          "type": "boolean"
        },
        "searchableEncryption": {
          "default": false,
          "description": "Allows search on encrypted data",
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "algorithm",
        "keyManagement",
        "scope",
        "deterministicEncryption",
        "searchableEncryption"
      ],
      "additionalProperties": false
    },
    "maskingRule": {
      "description": "Data masking rules for PII protection",
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "description": "Field name to apply masking to"
        },
        "strategy": {
          "type": "string",
          "enum": [
            "redact",
            "partial",
            "hash",
            "tokenize",
            "randomize",
            "nullify",
            "substitute"
          ],
          "description": "Masking strategy to use"
        },
        "pattern": {
          "description": "Regex pattern for partial masking",
          "type": "string"
        },
        "preserveFormat": {
          "default": true,
          "description": "Keep the original data format after masking",
          "type": "boolean"
        },
        "preserveLength": {
          "default": true,
          "description": "Keep the original data length after masking",
          "type": "boolean"
        },
        "roles": {
          "description": "Roles that see masked data",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exemptRoles": {
          "description": "Roles that see unmasked data",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "field",
        "strategy",
        "preserveFormat",
        "preserveLength"
      ],
      "additionalProperties": false
    },
    "auditTrail": {
      "default": false,
      "description": "Enable detailed audit trail for this field (tracks all changes with user and timestamp)",
      "type": "boolean"
    },
    "dependencies": {
      "description": "Array of field names that this field depends on (for formulas, visibility rules, etc.)",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cached": {
      "description": "Caching configuration for computed/formula fields",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable caching for computed field results"
        },
        "ttl": {
          "type": "number",
          "minimum": 0,
          "description": "Cache TTL in seconds (0 = no expiration)"
        },
        "invalidateOn": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Field paths that invalidate cache (e.g., [\"inventory.quantity\", \"pricing.base_price\"])"
        }
      },
      "required": [
        "enabled",
        "ttl",
        "invalidateOn"
      ],
      "additionalProperties": false
    },
    "dataQuality": {
      "description": "Data quality validation and monitoring rules",
      "type": "object",
      "properties": {
        "uniqueness": {
          "default": false,
          "description": "Enforce unique values across all records",
          "type": "boolean"
        },
        "completeness": {
          "default": 0,
          "description": "Minimum ratio of non-null values (0-1, default: 0 = no requirement)",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "accuracy": {
          "description": "Accuracy validation configuration",
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "description": "Reference data source for validation (e.g., \"api.verify.com\", \"master_data\")"
            },
            "threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Minimum accuracy threshold (0-1, e.g., 0.95 = 95% match required)"
            }
          },
          "required": [
            "source",
            "threshold"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "uniqueness",
        "completeness"
      ],
      "additionalProperties": false
    },
    "group": {
      "description": "Field group name for organizing fields in forms and layouts (e.g., \"contact_info\", \"billing\", \"system\")",
      "type": "string"
    },
    "conditionalRequired": {
      "description": "Formula expression that makes this field required when TRUE (e.g., \"status = 'closed_won'\")",
      "type": "string"
    },
    "hidden": {
      "default": false,
      "description": "Hidden from default UI",
      "type": "boolean"
    },
    "readonly": {
      "default": false,
      "description": "Read-only in UI",
      "type": "boolean"
    },
    "sortable": {
      "default": true,
      "description": "Whether field is sortable in list views",
      "type": "boolean"
    },
    "inlineHelpText": {
      "description": "Help text displayed below the field in forms",
      "type": "string"
    },
    "trackFeedHistory": {
      "description": "Track field changes in Chatter/activity feed (Salesforce pattern)",
      "type": "boolean"
    },
    "caseSensitive": {
      "description": "Whether text comparisons are case-sensitive",
      "type": "boolean"
    },
    "autonumberFormat": {
      "description": "Auto-number display format pattern (e.g., \"CASE-{0000}\")",
      "type": "string"
    },
    "index": {
      "default": false,
      "description": "Create standard database index",
      "type": "boolean"
    },
    "externalId": {
      "default": false,
      "description": "Is external ID for upsert operations",
      "type": "boolean"
    }
  },
  "required": [
    "type",
    "required",
    "searchable",
    "multiple",
    "unique",
    "deleteBehavior",
    "auditTrail",
    "hidden",
    "readonly",
    "sortable",
    "index",
    "externalId"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/data/Field.json",
  "x-spec-version": "3.0.11"
}