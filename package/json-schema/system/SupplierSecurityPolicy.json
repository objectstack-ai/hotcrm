{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": true,
      "description": "Enable supplier security management",
      "type": "boolean"
    },
    "reassessmentIntervalDays": {
      "default": 365,
      "description": "Supplier reassessment interval in days",
      "type": "number"
    },
    "requirePreOnboardingAssessment": {
      "default": true,
      "description": "Require security assessment before supplier onboarding",
      "type": "boolean"
    },
    "formalAssessmentThreshold": {
      "default": "medium",
      "description": "Minimum risk level requiring formal assessment",
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "monitorChanges": {
      "default": true,
      "description": "Monitor supplier security posture changes",
      "type": "boolean"
    },
    "requiredCertifications": {
      "default": [],
      "description": "Required certifications for critical-risk suppliers",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "enabled",
    "reassessmentIntervalDays",
    "requirePreOnboardingAssessment",
    "formalAssessmentThreshold",
    "monitorChanges",
    "requiredCertifications"
  ],
  "additionalProperties": false,
  "description": "Organization-level supplier security management policy per ISO 27001:2022",
  "$id": "https://schema.objectstack.io/v3.0.11/system/SupplierSecurityPolicy.json",
  "x-spec-version": "3.0.11"
}