{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node16",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@hotcrm/ai": ["packages/ai/src"],
      "@hotcrm/core": ["packages/core/src"],
      "@hotcrm/crm": ["packages/crm/src"],
      "@hotcrm/finance": ["packages/finance/src"],
      "@hotcrm/hr": ["packages/hr/src"],
      "@hotcrm/marketing": ["packages/marketing/src"],
      "@hotcrm/products": ["packages/products/src"],
      "@hotcrm/server": ["packages/server/src"],
      "@hotcrm/support": ["packages/support/src"]
    }
  },
  "references": [
    { "path": "./packages/ai" },
    { "path": "./packages/core" },
    { "path": "./packages/crm" },
    { "path": "./packages/finance" },
    { "path": "./packages/hr" },
    { "path": "./packages/marketing" },
    { "path": "./packages/products" },
    { "path": "./packages/server" },
    { "path": "./packages/support" }
  ],
  "files": [],
  "include": [],
  "exclude": ["node_modules", "dist"]
}
