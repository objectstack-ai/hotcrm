{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "defaultView": {
      "default": "field-editor",
      "description": "Default view",
      "type": "string",
      "enum": [
        "field-editor",
        "relationship-mapper",
        "er-diagram",
        "object-manager"
      ]
    },
    "fieldEditor": {
      "default": {
        "inlineEditing": true,
        "dragReorder": true,
        "showFieldGroups": true,
        "showPropertyPanel": true,
        "propertySections": [
          {
            "key": "basics",
            "label": "Basic Properties",
            "defaultExpanded": true,
            "order": 0
          },
          {
            "key": "constraints",
            "label": "Constraints & Validation",
            "defaultExpanded": true,
            "order": 10
          },
          {
            "key": "relationship",
            "label": "Relationship Config",
            "defaultExpanded": true,
            "order": 20
          },
          {
            "key": "display",
            "label": "Display & UI",
            "defaultExpanded": false,
            "order": 30
          },
          {
            "key": "security",
            "label": "Security & Compliance",
            "defaultExpanded": false,
            "order": 40
          },
          {
            "key": "advanced",
            "label": "Advanced",
            "defaultExpanded": false,
            "order": 50
          }
        ],
        "fieldGroups": [],
        "paginationThreshold": 50,
        "batchOperations": true,
        "showUsageStats": false
      },
      "description": "Field editor configuration",
      "type": "object",
      "properties": {
        "inlineEditing": {
          "default": true,
          "description": "Enable inline editing of field properties",
          "type": "boolean"
        },
        "dragReorder": {
          "default": true,
          "description": "Enable drag-and-drop field reordering",
          "type": "boolean"
        },
        "showFieldGroups": {
          "default": true,
          "description": "Show field group headers",
          "type": "boolean"
        },
        "showPropertyPanel": {
          "default": true,
          "description": "Show the right-side property panel",
          "type": "boolean"
        },
        "propertySections": {
          "default": [
            {
              "key": "basics",
              "label": "Basic Properties",
              "defaultExpanded": true,
              "order": 0
            },
            {
              "key": "constraints",
              "label": "Constraints & Validation",
              "defaultExpanded": true,
              "order": 10
            },
            {
              "key": "relationship",
              "label": "Relationship Config",
              "defaultExpanded": true,
              "order": 20
            },
            {
              "key": "display",
              "label": "Display & UI",
              "defaultExpanded": false,
              "order": 30
            },
            {
              "key": "security",
              "label": "Security & Compliance",
              "defaultExpanded": false,
              "order": 40
            },
            {
              "key": "advanced",
              "label": "Advanced",
              "defaultExpanded": false,
              "order": 50
            }
          ],
          "description": "Property panel section definitions",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "description": "Section key (e.g., \"basics\", \"constraints\", \"security\")"
              },
              "label": {
                "type": "string",
                "description": "Section display label"
              },
              "icon": {
                "description": "Lucide icon name",
                "type": "string"
              },
              "defaultExpanded": {
                "default": true,
                "description": "Whether section is expanded by default",
                "type": "boolean"
              },
              "order": {
                "default": 0,
                "description": "Sort order (lower = higher)",
                "type": "number"
              }
            },
            "required": [
              "key",
              "label",
              "defaultExpanded",
              "order"
            ],
            "additionalProperties": false
          }
        },
        "fieldGroups": {
          "default": [],
          "description": "Field group definitions",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "description": "Group key matching field.group values"
              },
              "label": {
                "type": "string",
                "description": "Group display label"
              },
              "icon": {
                "description": "Lucide icon name",
                "type": "string"
              },
              "defaultExpanded": {
                "default": true,
                "description": "Whether group is expanded by default",
                "type": "boolean"
              },
              "order": {
                "default": 0,
                "description": "Sort order (lower = higher)",
                "type": "number"
              }
            },
            "required": [
              "key",
              "label",
              "defaultExpanded",
              "order"
            ],
            "additionalProperties": false
          }
        },
        "paginationThreshold": {
          "default": 50,
          "description": "Number of fields before pagination is enabled",
          "type": "number"
        },
        "batchOperations": {
          "default": true,
          "description": "Enable batch add/remove field operations",
          "type": "boolean"
        },
        "showUsageStats": {
          "default": false,
          "description": "Show field usage statistics",
          "type": "boolean"
        }
      },
      "required": [
        "inlineEditing",
        "dragReorder",
        "showFieldGroups",
        "showPropertyPanel",
        "propertySections",
        "fieldGroups",
        "paginationThreshold",
        "batchOperations",
        "showUsageStats"
      ],
      "additionalProperties": false
    },
    "relationshipMapper": {
      "default": {
        "visualCreation": true,
        "showReverseRelationships": true,
        "showCascadeWarnings": true,
        "displayConfig": [
          {
            "type": "lookup",
            "lineStyle": "dashed",
            "color": "#0891b2",
            "highlightColor": "#06b6d4",
            "cardinalityLabel": "1:N"
          },
          {
            "type": "master_detail",
            "lineStyle": "solid",
            "color": "#ea580c",
            "highlightColor": "#f97316",
            "cardinalityLabel": "1:N"
          },
          {
            "type": "tree",
            "lineStyle": "dotted",
            "color": "#8b5cf6",
            "highlightColor": "#a78bfa",
            "cardinalityLabel": "1:N"
          }
        ]
      },
      "description": "Relationship mapper configuration",
      "type": "object",
      "properties": {
        "visualCreation": {
          "default": true,
          "description": "Enable drag-to-create relationships",
          "type": "boolean"
        },
        "showReverseRelationships": {
          "default": true,
          "description": "Show reverse/child-to-parent relationships",
          "type": "boolean"
        },
        "showCascadeWarnings": {
          "default": true,
          "description": "Show cascade delete behavior warnings",
          "type": "boolean"
        },
        "displayConfig": {
          "default": [
            {
              "type": "lookup",
              "lineStyle": "dashed",
              "color": "#0891b2",
              "highlightColor": "#06b6d4",
              "cardinalityLabel": "1:N"
            },
            {
              "type": "master_detail",
              "lineStyle": "solid",
              "color": "#ea580c",
              "highlightColor": "#f97316",
              "cardinalityLabel": "1:N"
            },
            {
              "type": "tree",
              "lineStyle": "dotted",
              "color": "#8b5cf6",
              "highlightColor": "#a78bfa",
              "cardinalityLabel": "1:N"
            }
          ],
          "description": "Visual config per relationship type",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "lookup",
                  "master_detail",
                  "tree"
                ],
                "description": "Relationship type"
              },
              "lineStyle": {
                "default": "solid",
                "description": "Line style in diagrams",
                "type": "string",
                "enum": [
                  "solid",
                  "dashed",
                  "dotted"
                ]
              },
              "color": {
                "default": "#94a3b8",
                "description": "Line color (CSS value)",
                "type": "string"
              },
              "highlightColor": {
                "default": "#0891b2",
                "description": "Highlighted color on hover/select",
                "type": "string"
              },
              "cardinalityLabel": {
                "default": "1:N",
                "description": "Cardinality label (e.g., \"1:N\", \"1:1\", \"N:M\")",
                "type": "string"
              }
            },
            "required": [
              "type",
              "lineStyle",
              "color",
              "highlightColor",
              "cardinalityLabel"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "visualCreation",
        "showReverseRelationships",
        "showCascadeWarnings",
        "displayConfig"
      ],
      "additionalProperties": false
    },
    "erDiagram": {
      "default": {
        "enabled": true,
        "layout": "force",
        "nodeDisplay": {
          "showFields": true,
          "maxFieldsVisible": 8,
          "showFieldTypes": true,
          "showRequiredIndicator": true,
          "showRecordCount": false,
          "showIcon": true,
          "showDescription": true
        },
        "showMinimap": true,
        "zoomControls": true,
        "minZoom": 0.1,
        "maxZoom": 3,
        "showEdgeLabels": true,
        "highlightOnHover": true,
        "clickToNavigate": true,
        "dragToConnect": true,
        "hideOrphans": false,
        "autoFit": true,
        "exportFormats": [
          "png",
          "svg"
        ]
      },
      "description": "ER diagram configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Enable ER diagram panel",
          "type": "boolean"
        },
        "layout": {
          "default": "force",
          "description": "Default layout algorithm",
          "type": "string",
          "enum": [
            "force",
            "hierarchy",
            "grid",
            "circular"
          ]
        },
        "nodeDisplay": {
          "default": {
            "showFields": true,
            "maxFieldsVisible": 8,
            "showFieldTypes": true,
            "showRequiredIndicator": true,
            "showRecordCount": false,
            "showIcon": true,
            "showDescription": true
          },
          "description": "Node display configuration",
          "type": "object",
          "properties": {
            "showFields": {
              "default": true,
              "description": "Show field list inside entity nodes",
              "type": "boolean"
            },
            "maxFieldsVisible": {
              "default": 8,
              "description": "Max fields visible before \"N more...\" collapse",
              "type": "number"
            },
            "showFieldTypes": {
              "default": true,
              "description": "Show field type badges",
              "type": "boolean"
            },
            "showRequiredIndicator": {
              "default": true,
              "description": "Show required field indicators",
              "type": "boolean"
            },
            "showRecordCount": {
              "default": false,
              "description": "Show live record count on nodes",
              "type": "boolean"
            },
            "showIcon": {
              "default": true,
              "description": "Show object icon on node header",
              "type": "boolean"
            },
            "showDescription": {
              "default": true,
              "description": "Show description tooltip on hover",
              "type": "boolean"
            }
          },
          "required": [
            "showFields",
            "maxFieldsVisible",
            "showFieldTypes",
            "showRequiredIndicator",
            "showRecordCount",
            "showIcon",
            "showDescription"
          ],
          "additionalProperties": false
        },
        "showMinimap": {
          "default": true,
          "description": "Show minimap for large diagrams",
          "type": "boolean"
        },
        "zoomControls": {
          "default": true,
          "description": "Show zoom in/out/fit controls",
          "type": "boolean"
        },
        "minZoom": {
          "default": 0.1,
          "description": "Minimum zoom level",
          "type": "number"
        },
        "maxZoom": {
          "default": 3,
          "description": "Maximum zoom level",
          "type": "number"
        },
        "showEdgeLabels": {
          "default": true,
          "description": "Show cardinality labels on relationship edges",
          "type": "boolean"
        },
        "highlightOnHover": {
          "default": true,
          "description": "Highlight connected entities on node hover",
          "type": "boolean"
        },
        "clickToNavigate": {
          "default": true,
          "description": "Click node to navigate to object detail",
          "type": "boolean"
        },
        "dragToConnect": {
          "default": true,
          "description": "Drag between nodes to create relationships",
          "type": "boolean"
        },
        "hideOrphans": {
          "default": false,
          "description": "Hide objects with no relationships",
          "type": "boolean"
        },
        "autoFit": {
          "default": true,
          "description": "Auto-fit diagram to viewport on load",
          "type": "boolean"
        },
        "exportFormats": {
          "default": [
            "png",
            "svg"
          ],
          "description": "Available export formats for diagram",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "png",
              "svg",
              "json"
            ]
          }
        }
      },
      "required": [
        "enabled",
        "layout",
        "nodeDisplay",
        "showMinimap",
        "zoomControls",
        "minZoom",
        "maxZoom",
        "showEdgeLabels",
        "highlightOnHover",
        "clickToNavigate",
        "dragToConnect",
        "hideOrphans",
        "autoFit",
        "exportFormats"
      ],
      "additionalProperties": false
    },
    "objectManager": {
      "default": {
        "defaultDisplayMode": "table",
        "defaultSortField": "label",
        "defaultSortDirection": "asc",
        "defaultFilter": {
          "includeSystem": false,
          "includeAbstract": false
        },
        "showFieldCount": true,
        "showRelationshipCount": true,
        "showQuickPreview": true,
        "enableComparison": false,
        "showERDiagramToggle": true,
        "showCreateAction": true,
        "showStatsSummary": true
