{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$",
      "description": "Unique datasource identifier"
    },
    "label": {
      "description": "Display label",
      "type": "string"
    },
    "driver": {
      "type": "string",
      "description": "Underlying driver type"
    },
    "config": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {},
      "description": "Driver specific configuration"
    },
    "pool": {
      "description": "Connection pool settings",
      "type": "object",
      "properties": {
        "min": {
          "default": 0,
          "description": "Minimum connections",
          "type": "number"
        },
        "max": {
          "default": 10,
          "description": "Maximum connections",
          "type": "number"
        },
        "idleTimeoutMillis": {
          "default": 30000,
          "description": "Idle timeout",
          "type": "number"
        },
        "connectionTimeoutMillis": {
          "default": 3000,
          "description": "Connection establishment timeout",
          "type": "number"
        }
      },
      "required": [
        "min",
        "max",
        "idleTimeoutMillis",
        "connectionTimeoutMillis"
      ],
      "additionalProperties": false
    },
    "readReplicas": {
      "description": "Read-only replica configurations",
      "type": "array",
      "items": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    },
    "capabilities": {
      "description": "Capability overrides",
      "type": "object",
      "properties": {
        "transactions": {
          "default": false,
          "type": "boolean"
        },
        "queryFilters": {
          "default": false,
          "type": "boolean"
        },
        "queryAggregations": {
          "default": false,
          "type": "boolean"
        },
        "querySorting": {
          "default": false,
          "type": "boolean"
        },
        "queryPagination": {
          "default": false,
          "type": "boolean"
        },
        "queryWindowFunctions": {
          "default": false,
          "type": "boolean"
        },
        "querySubqueries": {
          "default": false,
          "type": "boolean"
        },
        "joins": {
          "default": false,
          "type": "boolean"
        },
        "fullTextSearch": {
          "default": false,
          "type": "boolean"
        },
        "readOnly": {
          "default": false,
          "type": "boolean"
        },
        "dynamicSchema": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "transactions",
        "queryFilters",
        "queryAggregations",
        "querySorting",
        "queryPagination",
        "queryWindowFunctions",
        "querySubqueries",
        "joins",
        "fullTextSearch",
        "readOnly",
        "dynamicSchema"
      ],
      "additionalProperties": false
    },
    "healthCheck": {
      "description": "Datasource health check configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Enable health check endpoint",
          "type": "boolean"
        },
        "intervalMs": {
          "default": 30000,
          "description": "Health check interval in milliseconds",
          "type": "number"
        },
        "timeoutMs": {
          "default": 5000,
          "description": "Health check timeout in milliseconds",
          "type": "number"
        }
      },
      "required": [
        "enabled",
        "intervalMs",
        "timeoutMs"
      ],
      "additionalProperties": false
    },
    "ssl": {
      "description": "SSL/TLS configuration for secure database connections",
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "description": "Enable SSL/TLS for database connection",
          "type": "boolean"
        },
        "rejectUnauthorized": {
          "default": true,
          "description": "Reject connections with invalid/self-signed certificates",
          "type": "boolean"
        },
        "ca": {
          "description": "CA certificate (PEM format or path to file)",
          "type": "string"
        },
        "cert": {
          "description": "Client certificate (PEM format or path to file)",
          "type": "string"
        },
        "key": {
          "description": "Client private key (PEM format or path to file)",
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "rejectUnauthorized"
      ],
      "additionalProperties": false
    },
    "retryPolicy": {
      "description": "Connection retry policy for transient failures",
      "type": "object",
      "properties": {
        "maxRetries": {
          "default": 3,
          "description": "Maximum number of retry attempts",
          "type": "number"
        },
        "baseDelayMs": {
          "default": 1000,
          "description": "Base delay between retries in milliseconds",
          "type": "number"
        },
        "maxDelayMs": {
          "default": 30000,
          "description": "Maximum delay between retries in milliseconds",
          "type": "number"
        },
        "backoffMultiplier": {
          "default": 2,
          "description": "Exponential backoff multiplier",
          "type": "number"
        }
      },
      "required": [
        "maxRetries",
        "baseDelayMs",
        "maxDelayMs",
        "backoffMultiplier"
      ],
      "additionalProperties": false
    },
    "description": {
      "description": "Internal description",
      "type": "string"
    },
    "active": {
      "default": true,
      "description": "Is datasource enabled",
      "type": "boolean"
    }
  },
  "required": [
    "name",
    "driver",
    "config",
    "active"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/data/Datasource.json",
  "x-spec-version": "3.0.11"
}