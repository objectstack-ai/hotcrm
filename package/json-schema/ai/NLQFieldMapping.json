  },
  "required": [
    "naturalLanguage",
    "objectField",
    "object",
    "field",
    "confidence"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/NLQFieldMapping.json",
  "x-spec-version": "3.0.11"
}