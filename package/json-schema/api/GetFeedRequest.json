{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "object": {
      "type": "string",
      "description": "Object name (e.g., \"account\")"
    },
    "recordId": {
      "type": "string",
      "description": "Record ID"
    },
    "type": {
      "default": "all",
      "description": "Filter by feed item category",
      "type": "string",
      "enum": [
        "all",
        "comments_only",
        "changes_only",
        "tasks_only"
      ]
    },
    "limit": {
      "default": 20,
      "description": "Maximum number of items to return",
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "cursor": {
      "description": "Cursor for pagination (opaque string from previous response)",
      "type": "string"
    }
  },
  "required": [
    "object",
    "recordId",
    "type",
    "limit"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/GetFeedRequest.json",
  "x-spec-version": "3.0.11"
}