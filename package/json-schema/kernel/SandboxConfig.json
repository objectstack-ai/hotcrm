{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": true,
      "type": "boolean"
    },
    "level": {
      "default": "standard",
      "type": "string",
      "enum": [
        "none",
        "minimal",
        "standard",
        "strict",
        "paranoid"
      ]
    },
    "runtime": {
      "description": "Execution environment and isolation settings",
      "type": "object",
      "properties": {
        "engine": {
          "default": "v8-isolate",
          "description": "Execution environment engine",
          "type": "string",
          "enum": [
            "v8-isolate",
            "wasm",
            "container",
            "process"
          ]
        },
        "engineConfig": {
          "type": "object",
          "properties": {
            "wasm": {
              "type": "object",
              "properties": {
                "maxMemoryPages": {
                  "description": "Maximum WASM memory pages (64KB each)",
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65536
                },
                "instructionLimit": {
                  "description": "Maximum instructions before timeout",
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "enableSimd": {
                  "default": false,
                  "description": "Enable WebAssembly SIMD support",
                  "type": "boolean"
                },
                "enableThreads": {
                  "default": false,
                  "description": "Enable WebAssembly threads",
                  "type": "boolean"
                },
                "enableBulkMemory": {
                  "default": true,
                  "description": "Enable bulk memory operations",
                  "type": "boolean"
                }
              },
              "required": [
                "enableSimd",
                "enableThreads",
                "enableBulkMemory"
              ],
              "additionalProperties": false
            },
            "container": {
              "type": "object",
              "properties": {
                "image": {
                  "description": "Container image to use",
                  "type": "string"
                },
                "runtime": {
                  "default": "docker",
                  "type": "string",
                  "enum": [
                    "docker",
                    "podman",
                    "containerd"
                  ]
                },
                "resources": {
                  "type": "object",
                  "properties": {
                    "cpuLimit": {
                      "description": "CPU limit (e.g., \"0.5\", \"2\")",
                      "type": "string"
                    },
                    "memoryLimit": {
                      "description": "Memory limit (e.g., \"512m\", \"1g\")",
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "networkMode": {
                  "default": "bridge",
                  "type": "string",
                  "enum": [
                    "none",
                    "bridge",
                    "host"
                  ]
                }
              },
              "required": [
                "runtime",
                "networkMode"
              ],
              "additionalProperties": false
            },
            "v8Isolate": {
              "type": "object",
              "properties": {
                "heapSizeMb": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "enableSnapshot": {
                  "default": true,
                  "type": "boolean"
                }
              },
              "required": [
                "enableSnapshot"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "resourceLimits": {
          "type": "object",
          "properties": {
            "maxMemory": {
              "description": "Maximum memory allocation",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "maxCpu": {
              "description": "Maximum CPU usage percentage",
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "timeout": {
              "description": "Maximum execution time",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "engine"
      ],
      "additionalProperties": false
    },
    "filesystem": {
      "type": "object",
      "properties": {
        "mode": {
          "default": "restricted",
          "type": "string",
          "enum": [
            "none",
            "readonly",
            "restricted",
            "full"
          ]
        },
        "allowedPaths": {
          "description": "Whitelisted paths",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deniedPaths": {
          "description": "Blacklisted paths",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maxFileSize": {
          "description": "Maximum file size in bytes",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "properties": {
        "mode": {
          "default": "restricted",
          "type": "string",
          "enum": [
            "none",
            "local",
            "restricted",
            "full"
          ]
        },
        "allowedHosts": {
          "description": "Whitelisted hosts",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deniedHosts": {
          "description": "Blacklisted hosts",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowedPorts": {
          "description": "Allowed port numbers",
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "maxConnections": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    },
    "process": {
      "type": "object",
      "properties": {
        "allowSpawn": {
          "default": false,
          "description": "Allow spawning child processes",
          "type": "boolean"
        },
        "allowedCommands": {
          "description": "Whitelisted commands",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timeout": {
          "description": "Process timeout in ms",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "allowSpawn"
      ],
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "properties": {
        "maxHeap": {
          "description": "Maximum heap size in bytes",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "maxStack": {
          "description": "Maximum stack size in bytes",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "cpu": {
      "type": "object",
      "properties": {
        "maxCpuPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "maxThreads": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "mode": {
          "default": "readonly",
          "type": "string",
          "enum": [
            "none",
            "readonly",
            "restricted",
            "full"
          ]
        },
        "allowedVars": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deniedVars": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "enabled",
    "level"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/SandboxConfig.json",
  "x-spec-version": "3.0.11"
}