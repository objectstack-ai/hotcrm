{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "partitionBy": {
      "description": "PARTITION BY fields",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "orderBy": {
      "description": "ORDER BY specification",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "order": {
            "default": "asc",
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          }
        },
        "required": [
          "field",
          "order"
        ],
        "additionalProperties": false
      }
    },
    "frame": {
      "description": "Window frame specification",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "rows",
            "range"
          ]
        },
        "start": {
          "description": "Frame start (e.g., \"UNBOUNDED PRECEDING\", \"1 PRECEDING\")",
          "type": "string"
        },
        "end": {
          "description": "Frame end (e.g., \"CURRENT ROW\", \"1 FOLLOWING\")",
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/data/WindowSpec.json",
  "x-spec-version": "3.0.11"
}