{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "description": "Suggested value"
          },
          "label": {
            "type": "string",
            "description": "Display label"
          },
          "confidence": {
            "description": "Confidence score (0-1)",
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reason": {
            "description": "Reason for this suggestion",
            "type": "string"
          }
        },
        "required": [
          "value",
          "label"
        ],
        "additionalProperties": false
      },
      "description": "Suggested values"
    }
  },
  "required": [
    "suggestions"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/AiSuggestResponse.json",
  "x-spec-version": "3.0.11"
}