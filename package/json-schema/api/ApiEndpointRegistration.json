{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique endpoint identifier"
    },
    "method": {
      "description": "HTTP method",
      "type": "string",
      "enum": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "PATCH",
        "HEAD",
        "OPTIONS"
      ]
    },
    "path": {
      "type": "string",
      "description": "URL path pattern"
    },
    "summary": {
      "description": "Short endpoint summary",
      "type": "string"
    },
    "description": {
      "description": "Detailed endpoint description",
      "type": "string"
    },
    "operationId": {
      "description": "Unique operation identifier",
      "type": "string"
    },
    "tags": {
      "default": [],
      "description": "Tags for categorization",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parameters": {
      "default": [],
      "description": "Endpoint parameters",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Parameter name"
          },
          "in": {
            "type": "string",
            "enum": [
              "path",
              "query",
              "header",
              "body",
              "cookie"
            ],
            "description": "Parameter location"
          },
          "description": {
            "description": "Parameter description",
            "type": "string"
          },
          "required": {
            "default": false,
            "description": "Whether parameter is required",
            "type": "boolean"
          },
          "schema": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "string",
                      "number",
                      "integer",
                      "boolean",
                      "array",
                      "object"
                    ],
                    "description": "Parameter type"
                  },
                  "format": {
                    "description": "Format (e.g., date-time, email, uuid)",
                    "type": "string"
                  },
                  "enum": {
                    "description": "Allowed values",
                    "type": "array",
                    "items": {}
                  },
                  "default": {
                    "description": "Default value"
                  },
                  "items": {
                    "description": "Array item schema"
                  },
                  "properties": {
                    "description": "Object properties",
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false,
                "description": "Static JSON Schema"
              },
              {
                "type": "object",
                "properties": {
                  "$ref": {
                    "type": "object",
                    "properties": {
                      "objectId": {
                        "type": "string",
                        "minLength": 2,
                        "pattern": "^[a-z][a-z0-9_]*$",
                        "description": "Object name to reference"
                      },
                      "includeFields": {
                        "description": "Include only these fields in the schema",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "excludeFields": {
                        "description": "Exclude these fields from the schema",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "includeRelated": {
                        "description": "Include related objects via lookup fields",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "objectId"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "$ref"
                ],
                "additionalProperties": false,
                "description": "Dynamic ObjectQL reference"
              }
            ],
            "description": "Parameter schema definition"
          },
          "example": {
            "description": "Example value"
          }
        },
        "required": [
          "name",
          "in",
          "required",
          "schema"
        ],
        "additionalProperties": false
      }
    },
    "requestBody": {
      "description": "Request body specification",
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "required": {
          "default": false,
          "type": "boolean"
        },
        "contentType": {
          "default": "application/json",
          "type": "string"
        },
        "schema": {},
        "example": {}
      },
      "required": [
        "required",
        "contentType"
      ],
      "additionalProperties": false
    },
    "responses": {
      "default": [],
      "description": "Possible responses",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "statusCode": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              },
              {
                "type": "string",
                "enum": [
                  "2xx",
                  "3xx",
                  "4xx",
                  "5xx"
                ]
              }
            ],
            "description": "HTTP status code"
          },
          "description": {
            "type": "string",
            "description": "Response description"
          },
          "contentType": {
            "default": "application/json",
            "description": "Response content type",
            "type": "string"
          },
          "schema": {
            "description": "Response body schema",
            "anyOf": [
              {
                "description": "Static JSON Schema"
              },
              {
                "type": "object",
                "properties": {
                  "$ref": {
                    "type": "object",
                    "properties": {
                      "objectId": {
                        "type": "string",
                        "minLength": 2,
                        "pattern": "^[a-z][a-z0-9_]*$",
                        "description": "Object name to reference"
                      },
                      "includeFields": {
                        "description": "Include only these fields in the schema",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "excludeFields": {
                        "description": "Exclude these fields from the schema",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "includeRelated": {
                        "description": "Include related objects via lookup fields",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "objectId"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "$ref"
                ],
                "additionalProperties": false,
                "description": "Dynamic ObjectQL reference"
              }
            ]
          },
          "headers": {
            "description": "Response headers",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string"
                },
                "schema": {}
              },
              "required": [
                "schema"
              ],
              "additionalProperties": false
            }
          },
          "example": {
            "description": "Example response"
          }
        },
        "required": [
          "statusCode",
          "description",
          "contentType"
        ],
        "additionalProperties": false
      }
    },
    "rateLimit": {
      "description": "Endpoint specific rate limiting",
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "description": "Enable rate limiting",
          "type": "boolean"
        },
        "windowMs": {
          "default": 60000,
          "description": "Time window in milliseconds",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "maxRequests": {
          "default": 100,
          "description": "Max requests per window",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "enabled",
        "windowMs",
        "maxRequests"
      ],
      "additionalProperties": false
    },
    "security": {
      "description": "Security requirements (e.g. [{\"bearerAuth\": []}])",
      "type": "array",
      "items": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "requiredPermissions": {
      "default": [],
      "description": "Required RBAC permissions (e.g., \"customer.read\", \"manage_users\")",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "priority": {
      "default": 100,
      "description": "Route priority for conflict resolution (0-1000, higher = more important)",
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "protocolConfig": {
      "description": "Protocol-specific configuration for custom protocols (gRPC, tRPC, etc.)",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "deprecated": {
      "default": false,
      "description": "Whether endpoint is deprecated",
      "type": "boolean"
    },
    "externalDocs": {
      "description": "External documentation link",
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "path",
    "tags",
    "parameters",
    "responses",
    "requiredPermissions",
    "priority",
    "deprecated"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/ApiEndpointRegistration.json",
  "x-spec-version": "3.0.11"
}