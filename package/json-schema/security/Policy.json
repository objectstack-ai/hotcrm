{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$",
      "description": "Policy Name"
    },
    "password": {
      "type": "object",
      "properties": {
        "minLength": {
          "default": 8,
          "type": "number"
        },
        "requireUppercase": {
          "default": true,
          "type": "boolean"
        },
        "requireLowercase": {
          "default": true,
          "type": "boolean"
        },
        "requireNumbers": {
          "default": true,
          "type": "boolean"
        },
        "requireSymbols": {
          "default": false,
          "type": "boolean"
        },
        "expirationDays": {
          "description": "Force password change every X days",
          "type": "number"
        },
        "historyCount": {
          "default": 3,
          "description": "Prevent reusing last X passwords",
          "type": "number"
        }
      },
      "required": [
        "minLength",
        "requireUppercase",
        "requireLowercase",
        "requireNumbers",
        "requireSymbols",
        "historyCount"
      ],
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "properties": {
        "trustedRanges": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "CIDR ranges allowed to access (e.g. 10.0.0.0/8)"
        },
        "blockUnknown": {
          "default": false,
          "description": "Block all IPs not in trusted ranges",
          "type": "boolean"
        },
        "vpnRequired": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "trustedRanges",
        "blockUnknown",
        "vpnRequired"
      ],
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "properties": {
        "idleTimeout": {
          "default": 30,
          "description": "Minutes before idle session logout",
          "type": "number"
        },
        "absoluteTimeout": {
          "default": 480,
          "description": "Max session duration (minutes)",
          "type": "number"
        },
        "forceMfa": {
          "default": false,
          "description": "Require 2FA for all users",
          "type": "boolean"
        }
      },
      "required": [
        "idleTimeout",
        "absoluteTimeout",
        "forceMfa"
      ],
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "properties": {
        "logRetentionDays": {
          "default": 180,
          "type": "number"
        },
        "sensitiveFields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Fields to redact in logs (e.g. password, ssn)"
        },
        "captureRead": {
          "default": false,
          "description": "Log read access (High volume!)",
          "type": "boolean"
        }
      },
      "required": [
        "logRetentionDays",
        "sensitiveFields",
        "captureRead"
      ],
      "additionalProperties": false
    },
    "isDefault": {
      "default": false,
      "description": "Apply to all users by default",
      "type": "boolean"
    },
    "assignedProfiles": {
      "description": "Apply to specific profiles",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "name",
    "isDefault"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/security/Policy.json",
  "x-spec-version": "3.0.11"
}