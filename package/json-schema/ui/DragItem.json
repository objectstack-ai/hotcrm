{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "description": "Drag item type identifier for matching with drop zones"
    },
    "label": {
      "description": "Accessible label describing the draggable item",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Translation key (e.g., \"views.task_list.label\")"
            },
            "defaultValue": {
              "description": "Fallback value when translation key is not found",
              "type": "string"
            },
            "params": {
              "description": "Interpolation parameters (e.g., { count: 5 })",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        }
      ]
    },
    "handle": {
      "default": "element",
      "description": "How to initiate drag",
      "type": "string",
      "enum": [
        "element",
        "handle",
        "grip_icon"
      ]
    },
    "constraint": {
      "description": "Drag movement constraints",
      "type": "object",
      "properties": {
        "axis": {
          "default": "both",
          "description": "Constrain drag axis",
          "type": "string",
          "enum": [
            "x",
            "y",
            "both"
          ]
        },
        "bounds": {
          "default": "none",
          "description": "Constrain within bounds",
          "type": "string",
          "enum": [
            "parent",
            "viewport",
            "none"
          ]
        },
        "grid": {
          "description": "Snap to grid [x, y] in pixels",
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ]
        }
      },
      "required": [
        "axis",
        "bounds"
      ],
      "additionalProperties": false
    },
    "preview": {
      "default": "element",
      "description": "Drag preview type",
      "type": "string",
      "enum": [
        "element",
        "custom",
        "none"
      ]
    },
    "disabled": {
      "default": false,
      "description": "Disable dragging",
      "type": "boolean"
    },
    "ariaLabel": {
      "description": "Accessible label for screen readers (WAI-ARIA aria-label)",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Translation key (e.g., \"views.task_list.label\")"
            },
            "defaultValue": {
              "description": "Fallback value when translation key is not found",
              "type": "string"
            },
            "params": {
              "description": "Interpolation parameters (e.g., { count: 5 })",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ariaDescribedBy": {
      "description": "ID of element providing additional description (WAI-ARIA aria-describedby)",
      "type": "string"
    },
    "role": {
      "description": "WAI-ARIA role attribute (e.g., \"dialog\", \"navigation\", \"alert\")",
      "type": "string"
    }
  },
  "required": [
    "type",
    "handle",
    "preview",
    "disabled"
  ],
  "additionalProperties": false,
  "description": "Draggable item configuration",
  "$id": "https://schema.objectstack.io/v3.0.11/ui/DragItem.json",
  "x-spec-version": "3.0.11"
}