{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$",
      "description": "SLO name (snake_case)"
    },
    "label": {
      "type": "string",
      "description": "Display label"
    },
    "description": {
      "description": "SLO description",
      "type": "string"
    },
    "sli": {
      "type": "string",
      "description": "SLI name"
    },
    "target": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Target percentage"
    },
    "period": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "rolling",
            "calendar"
          ],
          "description": "Period type"
        },
        "duration": {
          "description": "Duration in seconds",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "calendar": {
          "type": "string",
          "enum": [
            "daily",
            "weekly",
            "monthly",
            "quarterly",
            "yearly"
          ]
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "description": "Time period"
    },
    "errorBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "alertThreshold": {
          "default": 80,
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "burnRateWindows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "window": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "description": "Window size"
              },
              "threshold": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Burn rate threshold"
              }
            },
            "required": [
              "window",
              "threshold"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "enabled",
        "alertThreshold"
      ],
      "additionalProperties": false
    },
    "alerts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Alert name"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "critical"
            ],
            "description": "Alert severity"
          },
          "condition": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "slo_breach",
                  "error_budget",
                  "burn_rate"
                ],
                "description": "Condition type"
              },
              "threshold": {
                "description": "Threshold value",
                "type": "number"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false,
            "description": "Alert condition"
          }
        },
        "required": [
          "name",
          "severity",
          "condition"
        ],
        "additionalProperties": false
      }
    },
    "enabled": {
      "default": true,
      "type": "boolean"
    }
  },
  "required": [
    "name",
    "label",
    "sli",
    "target",
    "period",
    "alerts",
    "enabled"
  ],
  "additionalProperties": false,
  "description": "Service Level Objective",
  "$id": "https://schema.objectstack.io/v3.0.11/system/ServiceLevelObjective.json",
  "x-spec-version": "3.0.11"
}