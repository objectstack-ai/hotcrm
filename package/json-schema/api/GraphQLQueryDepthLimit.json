{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": true,
      "description": "Enable query depth limiting",
      "type": "boolean"
    },
    "maxDepth": {
      "default": 10,
      "description": "Maximum query depth",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "ignoreFields": {
      "description": "Fields excluded from depth calculation",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "onDepthExceeded": {
      "default": "reject",
      "description": "Action when depth exceeded",
      "type": "string",
      "enum": [
        "reject",
        "log",
        "warn"
      ]
    },
    "errorMessage": {
      "description": "Custom error message for depth violations",
      "type": "string"
    }
  },
  "required": [
    "enabled",
    "maxDepth",
    "onDepthExceeded"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/GraphQLQueryDepthLimit.json",
  "x-spec-version": "3.0.11"
}