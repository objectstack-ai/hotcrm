{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Overlay record ID (UUID)"
    },
    "baseType": {
      "type": "string",
      "description": "Metadata type being customized"
    },
    "baseName": {
      "type": "string",
      "description": "Metadata name being customized"
    },
    "packageId": {
      "description": "Package ID that delivered the base metadata",
      "type": "string"
    },
    "packageVersion": {
      "description": "Package version when overlay was created",
      "type": "string"
    },
    "scope": {
      "default": "platform",
      "description": "Customization scope (platform=admin, user=personal)",
      "type": "string",
      "enum": [
        "platform",
        "user"
      ]
    },
    "tenantId": {
      "description": "Tenant identifier",
      "type": "string"
    },
    "owner": {
      "description": "Owner user ID for user-scope overlays",
      "type": "string"
    },
    "patch": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {},
      "description": "JSON Merge Patch payload (changed fields only)"
    },
    "changes": {
      "description": "Field-level change tracking for conflict detection",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "JSON path to the changed field"
          },
          "originalValue": {
            "description": "Original value from the package"
          },
          "currentValue": {
            "description": "Current customized value"
          },
          "changedBy": {
            "description": "User or admin who made this change",
            "type": "string"
          },
          "changedAt": {
            "description": "Timestamp of the change",
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          }
        },
        "required": [
          "path",
          "currentValue"
        ],
        "additionalProperties": false
      }
    },
    "active": {
      "default": true,
      "description": "Whether this overlay is active",
      "type": "boolean"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "createdBy": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "updatedBy": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "baseType",
    "baseName",
    "scope",
    "patch",
    "active"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/MetadataOverlay.json",
  "x-spec-version": "3.0.11"
}