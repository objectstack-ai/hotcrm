{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "healthy": {
      "type": "boolean",
      "description": "Whether the plugin is healthy"
    },
    "timestamp": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "description": "Unix timestamp in milliseconds when health check was performed"
    },
    "details": {
      "description": "Optional plugin-specific health details",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "message": {
      "description": "Error message if plugin is unhealthy",
      "type": "string"
    }
  },
  "required": [
    "healthy",
    "timestamp"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/HealthStatus.json",
  "x-spec-version": "3.0.11"
}