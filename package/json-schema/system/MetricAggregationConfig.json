{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "sum",
        "avg",
        "min",
        "max",
        "count",
        "p50",
        "p75",
        "p90",
        "p95",
        "p99",
        "p999",
        "rate",
        "stddev"
      ],
      "description": "Aggregation type"
    },
    "window": {
      "type": "object",
      "properties": {
        "size": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Window size in seconds"
        },
        "sliding": {
          "default": false,
          "type": "boolean"
        },
        "slideInterval": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "size",
        "sliding"
      ],
      "additionalProperties": false
    },
    "groupBy": {
      "description": "Group by label names",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "filters": {
      "description": "Filter criteria",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "type"
  ],
  "additionalProperties": false,
  "description": "Metric aggregation configuration",
  "$id": "https://schema.objectstack.io/v3.0.11/system/MetricAggregationConfig.json",
  "x-spec-version": "3.0.11"
}