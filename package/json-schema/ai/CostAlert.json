{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "description": "ISO 8601 timestamp"
    },
    "type": {
      "type": "string",
      "enum": [
        "threshold_warning",
        "threshold_critical",
        "limit_exceeded",
        "anomaly_detected",
        "projection_exceeded"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ]
    },
    "budgetId": {
      "type": "string"
    },
    "budgetType": {
      "type": "string",
      "enum": [
        "global",
        "user",
        "agent",
        "object",
        "project",
        "department"
      ]
    },
    "scope": {
      "type": "string"
    },
    "message": {
      "type": "string",
      "description": "Alert message"
    },
    "currentCost": {
      "type": "number",
      "minimum": 0
    },
    "maxCost": {
      "type": "number",
      "minimum": 0
    },
    "threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "currency": {
      "default": "USD",
      "type": "string"
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acknowledged": {
      "default": false,
      "type": "boolean"
    },
    "acknowledgedBy": {
      "type": "string"
    },
    "acknowledgedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "resolved": {
      "default": false,
      "type": "boolean"
    },
    "metadata": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "id",
    "timestamp",
    "type",
    "severity",
    "message",
    "currentCost",
    "currency",
    "acknowledged",
    "resolved"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/CostAlert.json",
  "x-spec-version": "3.0.11"
}