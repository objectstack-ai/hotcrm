{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Field name or series identifier"
    },
    "label": {
      "description": "Series display label",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Translation key (e.g., \"views.task_list.label\")"
            },
            "defaultValue": {
              "description": "Fallback value when translation key is not found",
              "type": "string"
            },
            "params": {
              "description": "Interpolation parameters (e.g., { count: 5 })",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        }
      ]
    },
    "type": {
      "description": "Override chart type for this series",
      "type": "string",
      "enum": [
        "bar",
        "horizontal-bar",
        "column",
        "grouped-bar",
        "stacked-bar",
        "bi-polar-bar",
        "line",
        "area",
        "stacked-area",
        "step-line",
        "spline",
        "pie",
        "donut",
        "funnel",
        "pyramid",
        "scatter",
        "bubble",
        "treemap",
        "sunburst",
        "sankey",
        "word-cloud",
        "gauge",
        "solid-gauge",
        "metric",
        "kpi",
        "bullet",
        "choropleth",
        "bubble-map",
        "gl-map",
        "heatmap",
        "radar",
        "waterfall",
        "box-plot",
        "violin",
        "candlestick",
        "stock",
        "table",
        "pivot"
      ]
    },
    "color": {
      "description": "Series color (hex/rgb/token)",
      "type": "string"
    },
    "stack": {
      "description": "Stack identifier to group series",
      "type": "string"
    },
    "yAxis": {
      "default": "left",
      "description": "Bind to specific Y-Axis",
      "type": "string",
      "enum": [
        "left",
        "right"
      ]
    }
  },
  "required": [
    "name",
    "yAxis"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ui/ChartSeries.json",
  "x-spec-version": "3.0.11"
}