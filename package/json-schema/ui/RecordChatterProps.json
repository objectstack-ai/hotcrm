{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "position": {
      "default": "sidebar",
      "description": "Where to render the chatter panel",
      "type": "string",
      "enum": [
        "sidebar",
        "inline",
        "drawer"
      ]
    },
    "width": {
      "description": "Panel width (e.g., \"350px\", \"30%\")",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        }
      ]
    },
    "collapsible": {
      "default": true,
      "description": "Whether the panel can be collapsed",
      "type": "boolean"
    },
    "defaultCollapsed": {
      "default": false,
      "description": "Whether the panel starts collapsed",
      "type": "boolean"
    },
    "feed": {
      "description": "Embedded activity feed configuration",
      "type": "object",
      "properties": {
        "types": {
          "description": "Feed item types to show (default: all)",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "comment",
              "field_change",
              "task",
              "event",
              "email",
              "call",
              "note",
              "file",
              "record_create",
              "record_delete",
              "approval",
              "sharing",
              "system"
            ]
          }
        },
        "filterMode": {
          "default": "all",
          "description": "Default activity filter",
          "type": "string",
          "enum": [
            "all",
            "comments_only",
            "changes_only",
            "tasks_only"
          ]
        },
        "showFilterToggle": {
          "default": true,
          "description": "Show filter dropdown in panel header",
          "type": "boolean"
        },
        "limit": {
          "default": 20,
          "description": "Number of items to load per page",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "showCompleted": {
          "default": false,
          "description": "Include completed activities",
          "type": "boolean"
        },
        "unifiedTimeline": {
          "default": true,
          "description": "Mix field changes and comments in one timeline (Airtable style)",
          "type": "boolean"
        },
        "showCommentInput": {
          "default": true,
          "description": "Show \"Leave a comment\" input at the bottom",
          "type": "boolean"
        },
        "enableMentions": {
          "default": true,
          "description": "Enable @mentions in comments",
          "type": "boolean"
        },
        "enableReactions": {
          "default": false,
          "description": "Enable emoji reactions on feed items",
          "type": "boolean"
        },
        "enableThreading": {
          "default": false,
          "description": "Enable threaded replies on comments",
          "type": "boolean"
        },
        "showSubscriptionToggle": {
          "default": true,
          "description": "Show bell icon for record-level notification subscription",
          "type": "boolean"
        },
        "aria": {
          "description": "ARIA accessibility attributes",
          "type": "object",
          "properties": {
            "ariaLabel": {
              "description": "Accessible label for screen readers (WAI-ARIA aria-label)",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "description": "Translation key (e.g., \"views.task_list.label\")"
                    },
                    "defaultValue": {
                      "description": "Fallback value when translation key is not found",
                      "type": "string"
                    },
                    "params": {
                      "description": "Interpolation parameters (e.g., { count: 5 })",
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          }
                        ]
                      }
                    }
                  },
                  "required": [
                    "key"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "ariaDescribedBy": {
              "description": "ID of element providing additional description (WAI-ARIA aria-describedby)",
              "type": "string"
            },
            "role": {
              "description": "WAI-ARIA role attribute (e.g., \"dialog\", \"navigation\", \"alert\")",
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "filterMode",
        "showFilterToggle",
        "limit",
        "showCompleted",
        "unifiedTimeline",
        "showCommentInput",
        "enableMentions",
        "enableReactions",
        "enableThreading",
        "showSubscriptionToggle"
      ],
      "additionalProperties": false
    },
    "aria": {
      "description": "ARIA accessibility attributes",
      "type": "object",
      "properties": {
        "ariaLabel": {
          "description": "Accessible label for screen readers (WAI-ARIA aria-label)",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "description": "Translation key (e.g., \"views.task_list.label\")"
                },
                "defaultValue": {
                  "description": "Fallback value when translation key is not found",
                  "type": "string"
                },
                "params": {
                  "description": "Interpolation parameters (e.g., { count: 5 })",
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  }
                }
              },
              "required": [
                "key"
              ],
              "additionalProperties": false
            }
          ]
        },
        "ariaDescribedBy": {
          "description": "ID of element providing additional description (WAI-ARIA aria-describedby)",
          "type": "string"
        },
        "role": {
          "description": "WAI-ARIA role attribute (e.g., \"dialog\", \"navigation\", \"alert\")",
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "position",
    "collapsible",
    "defaultCollapsed"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ui/RecordChatterProps.json",
  "x-spec-version": "3.0.11"
}