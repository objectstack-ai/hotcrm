{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Action ID"
    },
    "listingId": {
      "type": "string",
      "description": "Target listing ID"
    },
    "violationType": {
      "type": "string",
      "enum": [
        "malware",
        "data-harvesting",
        "spam",
        "copyright",
        "inappropriate-content",
        "terms-of-service",
        "security-risk",
        "abandoned"
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "warning",
        "suspend",
        "takedown",
        "restrict"
      ]
    },
    "reason": {
      "type": "string",
      "description": "Explanation of the violation"
    },
    "actionBy": {
      "type": "string",
      "description": "Admin user ID"
    },
    "actionAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "resolution": {
      "type": "string"
    },
    "resolved": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "listingId",
    "violationType",
    "action",
    "reason",
    "actionBy",
    "actionAt",
    "resolved"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/cloud/PolicyAction.json",
  "x-spec-version": "3.0.11"
}