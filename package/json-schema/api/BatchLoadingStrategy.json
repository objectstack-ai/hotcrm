{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "strategy": {
      "type": "string",
      "enum": [
        "dataloader",
        "windowed",
        "prefetch"
      ],
      "description": "Batch loading strategy type"
    },
    "windowMs": {
      "description": "Collection window duration in milliseconds (for windowed strategy)",
      "type": "number"
    },
    "prefetchDepth": {
      "description": "Depth of relation prefetching (for prefetch strategy)",
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "associationLoading": {
      "default": "batch",
      "description": "How to load related associations",
      "type": "string",
      "enum": [
        "lazy",
        "eager",
        "batch"
      ]
    }
  },
  "required": [
    "strategy",
    "associationLoading"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/BatchLoadingStrategy.json",
  "x-spec-version": "3.0.11"
}