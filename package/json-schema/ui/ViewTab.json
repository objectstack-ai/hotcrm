{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Tab identifier (snake_case)"
    },
    "label": {
      "description": "Display label",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Translation key (e.g., \"views.task_list.label\")"
            },
            "defaultValue": {
              "description": "Fallback value when translation key is not found",
              "type": "string"
            },
            "params": {
              "description": "Interpolation parameters (e.g., { count: 5 })",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        }
      ]
    },
    "icon": {
      "description": "Tab icon name",
      "type": "string"
    },
    "view": {
      "description": "Referenced list view name from listViews",
      "type": "string"
    },
    "filter": {
      "description": "Tab-specific filter criteria",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "Field name to filter on"
          },
          "operator": {
            "type": "string",
            "description": "Filter operator (e.g. equals, not_equals, contains, this_quarter)"
          },
          "value": {
            "description": "Filter value",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    }
                  ]
                }
              }
            ]
          }
        },
        "required": [
          "field",
          "operator"
        ],
        "additionalProperties": false,
        "description": "View filter rule"
      }
    },
    "order": {
      "description": "Tab display order",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "pinned": {
      "default": false,
      "description": "Pin tab (cannot be removed by users)",
      "type": "boolean"
    },
    "isDefault": {
      "default": false,
      "description": "Set as the default active tab",
      "type": "boolean"
    },
    "visible": {
      "default": true,
      "description": "Tab visibility",
      "type": "boolean"
    }
  },
  "required": [
    "name",
    "pinned",
    "isDefault",
    "visible"
  ],
  "additionalProperties": false,
  "description": "Tab configuration for multi-tab view interface",
  "$id": "https://schema.objectstack.io/v3.0.11/ui/ViewTab.json",
  "x-spec-version": "3.0.11"
}