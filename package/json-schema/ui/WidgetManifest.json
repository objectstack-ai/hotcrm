{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Widget identifier (snake_case)"
    },
    "label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Translation key (e.g., \"views.task_list.label\")"
            },
            "defaultValue": {
              "description": "Fallback value when translation key is not found",
              "type": "string"
            },
            "params": {
              "description": "Interpolation parameters (e.g., { count: 5 })",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Widget display name"
    },
    "description": {
      "description": "Widget description",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Translation key (e.g., \"views.task_list.label\")"
            },
            "defaultValue": {
              "description": "Fallback value when translation key is not found",
              "type": "string"
            },
            "params": {
              "description": "Interpolation parameters (e.g., { count: 5 })",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        }
      ]
    },
    "version": {
      "description": "Widget version (semver)",
      "type": "string"
    },
    "author": {
      "description": "Widget author",
      "type": "string"
    },
    "icon": {
      "description": "Widget icon",
      "type": "string"
    },
    "fieldTypes": {
      "description": "Supported field types",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "default": "custom",
      "description": "Widget category",
      "type": "string",
      "enum": [
        "input",
        "display",
        "picker",
        "editor",
        "custom"
      ]
    },
    "lifecycle": {
      "description": "Lifecycle hooks",
      "type": "object",
      "properties": {
        "onMount": {
          "description": "Initialization code when widget mounts",
          "type": "string"
        },
        "onUpdate": {
          "description": "Code to run when props change",
          "type": "string"
        },
        "onUnmount": {
          "description": "Cleanup code when widget unmounts",
          "type": "string"
        },
        "onValidate": {
          "description": "Custom validation logic",
          "type": "string"
        },
        "onFocus": {
          "description": "Code to run on focus",
          "type": "string"
        },
        "onBlur": {
          "description": "Code to run on blur",
          "type": "string"
        },
        "onError": {
          "description": "Error handling code",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "events": {
      "description": "Custom events",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Event name"
          },
          "label": {
            "description": "Human-readable event label",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "description": "Translation key (e.g., \"views.task_list.label\")"
                  },
                  "defaultValue": {
                    "description": "Fallback value when translation key is not found",
                    "type": "string"
                  },
                  "params": {
                    "description": "Interpolation parameters (e.g., { count: 5 })",
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "key"
                ],
                "additionalProperties": false
              }
            ]
          },
          "description": {
            "description": "Event description and usage",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "description": "Translation key (e.g., \"views.task_list.label\")"
                  },
                  "defaultValue": {
                    "description": "Fallback value when translation key is not found",
                    "type": "string"
                  },
                  "params": {
                    "description": "Interpolation parameters (e.g., { count: 5 })",
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "key"
                ],
                "additionalProperties": false
              }
            ]
          },
          "bubbles": {
            "default": false,
            "description": "Whether event bubbles",
            "type": "boolean"
          },
          "cancelable": {
            "default": false,
            "description": "Whether event is cancelable",
            "type": "boolean"
          },
          "payload": {
            "description": "Event payload schema",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "name",
          "bubbles",
          "cancelable"
        ],
        "additionalProperties": false
      }
    },
    "properties": {
      "description": "Configuration properties",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Property name (camelCase)"
          },
          "label": {
            "description": "Human-readable label",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "description": "Translation key (e.g., \"views.task_list.label\")"
                  },
                  "defaultValue": {
                    "description": "Fallback value when translation key is not found",
                    "type": "string"
                  },
                  "params": {
                    "description": "Interpolation parameters (e.g., { count: 5 })",
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "key"
                ],
                "additionalProperties": false
              }
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "boolean",
              "array",
              "object",
              "function",
              "any"
            ],
            "description": "TypeScript type"
          },
          "required": {
            "default": false,
            "description": "Whether property is required",
            "type": "boolean"
          },
          "default": {
            "description": "Default value"
          },
          "description": {
            "description": "Property description",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "description": "Translation key (e.g., \"views.task_list.label\")"
                  },
                  "defaultValue": {
                    "description": "Fallback value when translation key is not found",
                    "type": "string"
                  },
                  "params": {
                    "description": "Interpolation parameters (e.g., { count: 5 })",
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "key"
                ],
                "additionalProperties": false
              }
            ]
          },
          "validation": {
            "description": "Validation rules",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "category": {
            "description": "Property category",
            "type": "string"
          }
        },
        "required": [
          "name",
          "type",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "implementation": {
      "description": "Widget implementation source",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "npm"
            },
            "packageName": {
              "type": "string",
              "description": "NPM package name"
            },
            "version": {
              "default": "latest",
              "type": "string"
            },
            "exportName": {
              "description": "Named export (default: default)",
              "type": "string"
            }
          },
          "required": [
            "type",
            "packageName",
            "version"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "remote"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "description": "Remote entry URL (.js)"
            },
            "moduleName": {
              "type": "string",
              "description": "Exposed module name"
            },
            "scope": {
              "type": "string",
              "description": "Remote scope name"
            }
          },
          "required": [
            "type",
            "url",
            "moduleName",
            "scope"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "inline"
            },
            "code": {
              "type": "string",
              "description": "JavaScript code body"
            }
          },
          "required": [
            "type",
            "code"
          ],
          "additionalProperties": false
        }
      ]
    },
    "dependencies": {
      "description": "Widget dependencies",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "screenshots": {
      "description": "Screenshot URLs",
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "documentation": {
      "description": "Documentation URL",
      "type": "string",
      "format": "uri"
    },
    "license": {
      "description": "License (SPDX identifier)",
      "type": "string"
    },
    "tags": {
      "description": "Tags for categorization",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "aria": {
      "description": "ARIA accessibility attributes",
      "type": "object",
      "properties": {
        "ariaLabel": {
          "description": "Accessible label for screen readers (WAI-ARIA aria-label)",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "description": "Translation key (e.g., \"views.task_list.label\")"
                },
                "defaultValue": {
                  "description": "Fallback value when translation key is not found",
                  "type": "string"
                },
                "params": {
                  "description": "Interpolation parameters (e.g., { count: 5 })",
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  }
                }
              },
              "required": [
                "key"
              ],
              "additionalProperties": false
            }
          ]
        },
        "ariaDescribedBy": {
          "description": "ID of element providing additional description (WAI-ARIA aria-describedby)",
          "type": "string"
        },
        "role": {
          "description": "WAI-ARIA role attribute (e.g., \"dialog\", \"navigation\", \"alert\")",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "performance": {
      "description": "Performance optimization settings",
      "type": "object",
      "properties": {
        "lazyLoad": {
          "description": "Enable lazy loading (defer rendering until visible)",
          "type": "boolean"
        },
        "virtualScroll": {
          "description": "Virtual scrolling configuration",
          "type": "object",
          "properties": {
            "enabled": {
              "default": false,
              "description": "Enable virtual scrolling",
              "type": "boolean"
            },
            "itemHeight": {
              "description": "Fixed item height in pixels (for estimation)",
              "type": "number"
            },
            "overscan": {
              "description": "Number of extra items to render outside viewport",
              "type": "number"
            }
          },
          "required": [
            "enabled"
          ],
          "additionalProperties": false
        },
        "cacheStrategy": {
          "description": "Client-side data caching strategy",
          "type": "string",
          "enum": [
            "none",
            "cache-first",
            "network-first",
            "stale-while-revalidate"
          ]
        },
        "prefetch": {
          "description": "Prefetch data before component is visible",
          "type": "boolean"
        },
        "pageSize": {
          "description": "Number of items per page for pagination",
          "type": "number"
        },
        "debounceMs": {
          "description": "Debounce interval for user interactions in milliseconds",
          "type": "number"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "label",
    "category"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ui/WidgetManifest.json",
  "x-spec-version": "3.0.11"
}