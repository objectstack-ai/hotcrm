{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "description": "Component type (e.g. \"element:button\", \"element:text\")"
    },
    "label": {
      "type": "string",
      "description": "Display label in palette"
    },
    "icon": {
      "description": "Icon name for palette display",
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "content",
        "interactive",
        "data",
        "layout"
      ],
      "description": "Palette category grouping"
    },
    "defaultWidth": {
      "default": 4,
      "description": "Default width in grid columns",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "defaultHeight": {
      "default": 2,
      "description": "Default height in grid rows",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "type",
    "label",
    "category",
    "defaultWidth",
    "defaultHeight"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/studio/ElementPaletteItem.json",
  "x-spec-version": "3.0.11"
}