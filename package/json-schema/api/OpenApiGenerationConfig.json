{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": true,
      "description": "Enable automatic OpenAPI documentation generation",
      "type": "boolean"
    },
    "version": {
      "default": "3.0.3",
      "description": "OpenAPI specification version",
      "type": "string",
      "enum": [
        "3.0.0",
        "3.0.1",
        "3.0.2",
        "3.0.3",
        "3.1.0"
      ]
    },
    "title": {
      "default": "ObjectStack API",
      "description": "API title",
      "type": "string"
    },
    "description": {
      "description": "API description",
      "type": "string"
    },
    "apiVersion": {
      "default": "1.0.0",
      "description": "API version",
      "type": "string"
    },
    "outputPath": {
      "default": "/api/docs/openapi.json",
      "description": "URL path to serve OpenAPI JSON",
      "type": "string"
    },
    "uiPath": {
      "default": "/api/docs",
      "description": "URL path to serve documentation UI",
      "type": "string"
    },
    "uiFramework": {
      "default": "swagger-ui",
      "description": "Documentation UI framework",
      "type": "string",
      "enum": [
        "swagger-ui",
        "redoc",
        "rapidoc",
        "elements"
      ]
    },
    "includeInternal": {
      "default": false,
      "description": "Include internal endpoints in documentation",
      "type": "boolean"
    },
    "generateSchemas": {
      "default": true,
      "description": "Auto-generate schemas from Zod definitions",
      "type": "boolean"
    },
    "includeExamples": {
      "default": true,
      "description": "Include request/response examples",
      "type": "boolean"
    },
    "servers": {
      "description": "Server URLs for API",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Server URL"
          },
          "description": {
            "description": "Server description",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      }
    },
    "contact": {
      "description": "API contact information",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        }
      },
      "additionalProperties": false
    },
    "license": {
      "description": "API license information",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "License name"
        },
        "url": {
          "description": "License URL",
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "securitySchemes": {
      "description": "Security scheme definitions",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "apiKey",
              "http",
              "oauth2",
              "openIdConnect"
            ]
          },
          "scheme": {
            "type": "string"
          },
          "bearerFormat": {
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "enabled",
    "version",
    "title",
    "apiVersion",
    "outputPath",
    "uiPath",
    "uiFramework",
    "includeInternal",
    "generateSchemas",
    "includeExamples"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/OpenApiGenerationConfig.json",
  "x-spec-version": "3.0.11"
}