{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "preset": {
      "default": "standard",
      "description": "Base configuration preset",
      "type": "string",
      "enum": [
        "minimal",
        "standard",
        "full"
      ]
    },
    "services": {
      "description": "Per-service dev overrides keyed by service name",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "default": true,
            "description": "Enable or disable this service",
            "type": "boolean"
          },
          "strategy": {
            "default": "memory",
            "description": "Implementation strategy for development",
            "type": "string",
            "enum": [
              "mock",
              "memory",
              "stub",
              "passthrough"
            ]
          },
          "config": {
            "description": "Strategy-specific configuration for this service override",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "enabled",
          "strategy"
        ],
        "additionalProperties": false
      }
    },
    "fixtures": {
      "description": "Fixture data loading configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Load fixture data on startup",
          "type": "boolean"
        },
        "paths": {
          "description": "Glob patterns for fixture files",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resetBeforeLoad": {
          "default": true,
          "description": "Clear existing data before loading fixtures",
          "type": "boolean"
        },
        "envFilter": {
          "description": "Only load fixtures matching these environment tags",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "enabled",
        "resetBeforeLoad"
      ],
      "additionalProperties": false
    },
    "tools": {
      "description": "Developer tooling settings",
      "type": "object",
      "properties": {
        "hotReload": {
          "default": true,
          "description": "Enable HMR / live-reload",
          "type": "boolean"
        },
        "requestInspector": {
          "default": false,
          "description": "Enable request inspector",
          "type": "boolean"
        },
        "dbExplorer": {
          "default": false,
          "description": "Enable database explorer UI",
          "type": "boolean"
        },
        "verboseLogging": {
          "default": true,
          "description": "Enable verbose logging",
          "type": "boolean"
        },
        "apiDocs": {
          "default": true,
          "description": "Serve OpenAPI docs at /_dev/docs",
          "type": "boolean"
        },
        "mailCatcher": {
          "default": false,
          "description": "Capture outbound emails in dev",
          "type": "boolean"
        }
      },
      "required": [
        "hotReload",
        "requestInspector",
        "dbExplorer",
        "verboseLogging",
        "apiDocs",
        "mailCatcher"
      ],
      "additionalProperties": false
    },
    "port": {
      "default": 4400,
      "description": "Port for the dev-tools dashboard",
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "open": {
      "default": false,
      "description": "Auto-open dev dashboard in browser",
      "type": "boolean"
    },
    "seedAdminUser": {
      "default": true,
      "description": "Create a default admin user for development",
      "type": "boolean"
    },
    "simulatedLatency": {
      "default": 0,
      "description": "Artificial latency (ms) added to service calls",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "preset",
    "port",
    "open",
    "seedAdminUser",
    "simulatedLatency"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/DevPluginConfig.json",
  "x-spec-version": "3.0.11"
}