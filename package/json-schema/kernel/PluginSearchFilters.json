{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "query": {
      "type": "string"
    },
    "category": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trustLevel": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "official",
          "verified",
          "community",
          "unverified"
        ]
      }
    },
    "implementsProtocols": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pricingModel": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "free",
          "freemium",
          "paid",
          "enterprise"
        ]
      }
    },
    "minRating": {
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "sortBy": {
      "type": "string",
      "enum": [
        "relevance",
        "downloads",
        "rating",
        "updated",
        "name"
      ]
    },
    "sortOrder": {
      "default": "desc",
      "type": "string",
      "enum": [
        "asc",
        "desc"
      ]
    },
    "page": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "limit": {
      "default": 20,
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/PluginSearchFilters.json",
  "x-spec-version": "3.0.11"
}