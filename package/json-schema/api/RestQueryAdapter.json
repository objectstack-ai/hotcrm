{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "filterStyle": {
      "default": "bracket",
      "description": "REST filter parameter encoding style",
      "type": "string",
      "enum": [
        "bracket",
        "dot",
        "flat",
        "rsql"
      ]
    },
    "pagination": {
      "description": "Pagination parameter name mappings",
      "type": "object",
      "properties": {
        "limitParam": {
          "default": "limit",
          "description": "Page size parameter name",
          "type": "string"
        },
        "offsetParam": {
          "default": "offset",
          "description": "Offset parameter name",
          "type": "string"
        },
        "cursorParam": {
          "default": "cursor",
          "description": "Cursor parameter name",
          "type": "string"
        },
        "pageParam": {
          "default": "page",
          "description": "Page number parameter name",
          "type": "string"
        }
      },
      "required": [
        "limitParam",
        "offsetParam",
        "cursorParam",
        "pageParam"
      ],
      "additionalProperties": false
    },
    "sorting": {
      "description": "Sort parameter mapping",
      "type": "object",
      "properties": {
        "param": {
          "default": "sort",
          "description": "Sort parameter name",
          "type": "string"
        },
        "format": {
          "default": "comma",
          "description": "Sort parameter encoding format",
          "type": "string",
          "enum": [
            "comma",
            "array",
            "pipe"
          ]
        }
      },
      "required": [
        "param",
        "format"
      ],
      "additionalProperties": false
    },
    "fieldsParam": {
      "default": "fields",
      "description": "Field selection parameter name",
      "type": "string"
    }
  },
  "required": [
    "filterStyle",
    "fieldsParam"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/RestQueryAdapter.json",
  "x-spec-version": "3.0.11"
}