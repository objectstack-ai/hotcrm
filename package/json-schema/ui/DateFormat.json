{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "dateStyle": {
      "description": "Date display style",
      "type": "string",
      "enum": [
        "full",
        "long",
        "medium",
        "short"
      ]
    },
    "timeStyle": {
      "description": "Time display style",
      "type": "string",
      "enum": [
        "full",
        "long",
        "medium",
        "short"
      ]
    },
    "timeZone": {
      "description": "IANA time zone (e.g., \"America/New_York\")",
      "type": "string"
    },
    "hour12": {
      "description": "Use 12-hour format",
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "description": "Date/time formatting rules",
  "$id": "https://schema.objectstack.io/v3.0.11/ui/DateFormat.json",
  "x-spec-version": "3.0.11"
}