{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9_.]*$",
      "description": "Event type name (lowercase with dots)"
    },
    "version": {
      "default": "1.0.0",
      "description": "Event schema version",
      "type": "string"
    },
    "schema": {
      "description": "JSON Schema for event payload validation"
    },
    "description": {
      "description": "Event type description",
      "type": "string"
    },
    "deprecated": {
      "default": false,
      "description": "Whether this event type is deprecated",
      "type": "boolean"
    },
    "tags": {
      "description": "Event type tags",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "name",
    "version",
    "deprecated"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/EventTypeDefinition.json",
  "x-spec-version": "3.0.11"
}