{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$",
      "description": "Group unique identifier (snake_case)"
    },
    "label": {
      "type": "string",
      "description": "Group display name"
    },
    "description": {
      "type": "string"
    },
    "strategy": {
      "type": "string",
      "enum": [
        "sequential",
        "parallel",
        "debate",
        "hierarchical",
        "swarm"
      ],
      "description": "Multi-agent orchestration strategy"
    },
    "agents": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "agentId": {
            "type": "string",
            "description": "Agent identifier (reference to AgentSchema.name)"
          },
          "role": {
            "type": "string",
            "enum": [
              "coordinator",
              "specialist",
              "critic",
              "executor"
            ],
            "description": "Agent role within the group"
          },
          "capabilities": {
            "description": "List of capabilities this agent contributes",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "description": "Agent IDs this agent depends on for input",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "priority": {
            "description": "Execution priority (0 = highest)",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "agentId",
          "role"
        ],
        "additionalProperties": false
      },
      "description": "Agent members (minimum 2)"
    },
    "communication": {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "string",
          "enum": [
            "message_passing",
            "shared_memory",
            "blackboard"
          ],
          "description": "Inter-agent communication protocol"
        },
        "messageQueue": {
          "description": "Message queue identifier for async communication",
          "type": "string"
        },
        "maxRounds": {
          "description": "Maximum communication rounds before forced termination",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "protocol"
      ],
      "additionalProperties": false,
      "description": "Communication configuration"
    },
    "conflictResolution": {
      "description": "How conflicts between agents are resolved",
      "type": "string",
      "enum": [
        "voting",
        "priorityBased",
        "consensusBased",
        "coordinatorDecides"
      ]
    },
    "timeout": {
      "description": "Maximum execution time in seconds for the group",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "active": {
      "default": true,
      "description": "Whether this agent group is active",
      "type": "boolean"
    }
  },
  "required": [
    "name",
    "label",
    "strategy",
    "agents",
    "communication",
    "active"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/MultiAgentGroup.json",
  "x-spec-version": "3.0.11"
}