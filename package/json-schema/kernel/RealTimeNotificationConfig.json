{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": true,
      "description": "Enable real-time notifications",
      "type": "boolean"
    },
    "protocol": {
      "default": "websocket",
      "description": "Real-time protocol",
      "type": "string",
      "enum": [
        "websocket",
        "sse",
        "long-polling"
      ]
    },
    "eventPattern": {
      "default": "*",
      "description": "Event pattern to broadcast",
      "type": "string"
    },
    "userFilter": {
      "default": true,
      "description": "Filter events by user",
      "type": "boolean"
    },
    "tenantFilter": {
      "default": true,
      "description": "Filter events by tenant",
      "type": "boolean"
    },
    "channels": {
      "description": "Named channels for event broadcasting",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Channel name"
          },
          "eventPattern": {
            "type": "string",
            "description": "Event pattern for channel"
          },
          "filter": {
            "description": "Additional filter function"
          }
        },
        "required": [
          "name",
          "eventPattern"
        ],
        "additionalProperties": false
      }
    },
    "rateLimit": {
      "description": "Rate limiting configuration",
      "type": "object",
      "properties": {
        "maxEventsPerSecond": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Max events per second per client"
        },
        "windowMs": {
          "default": 1000,
          "description": "Rate limit window",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "maxEventsPerSecond",
        "windowMs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "enabled",
    "protocol",
    "eventPattern",
    "userFilter",
    "tenantFilter"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/RealTimeNotificationConfig.json",
  "x-spec-version": "3.0.11"
}