{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$",
      "description": "Destination name (snake_case)"
    },
    "type": {
      "type": "string",
      "enum": [
        "console",
        "file",
        "syslog",
        "elasticsearch",
        "cloudwatch",
        "stackdriver",
        "azure_monitor",
        "datadog",
        "splunk",
        "loki",
        "http",
        "kafka",
        "redis",
        "custom"
      ],
      "description": "Destination type"
    },
    "level": {
      "default": "info",
      "type": "string",
      "enum": [
        "trace",
        "debug",
        "info",
        "warn",
        "error",
        "fatal"
      ],
      "description": "Extended log severity level"
    },
    "enabled": {
      "default": true,
      "type": "boolean"
    },
    "console": {
      "type": "object",
      "properties": {
        "stream": {
          "default": "stdout",
          "type": "string",
          "enum": [
            "stdout",
            "stderr"
          ]
        },
        "colors": {
          "default": true,
          "type": "boolean"
        },
        "prettyPrint": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "stream",
        "colors",
        "prettyPrint"
      ],
      "additionalProperties": false,
      "description": "Console destination configuration"
    },
    "file": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "Log file path"
        },
        "rotation": {
          "type": "object",
          "properties": {
            "maxSize": {
              "default": "10m",
              "type": "string"
            },
            "maxFiles": {
              "default": 5,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "compress": {
              "default": true,
              "type": "boolean"
            },
            "interval": {
              "type": "string",
              "enum": [
                "hourly",
                "daily",
                "weekly",
                "monthly"
              ]
            }
          },
          "required": [
            "maxSize",
            "maxFiles",
            "compress"
          ],
          "additionalProperties": false
        },
        "encoding": {
          "default": "utf8",
          "type": "string"
        },
        "append": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "encoding",
        "append"
      ],
      "additionalProperties": false,
      "description": "File destination configuration"
    },
    "http": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "description": "HTTP endpoint URL"
        },
        "method": {
          "default": "POST",
          "type": "string",
          "enum": [
            "POST",
            "PUT"
          ]
        },
        "headers": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "auth": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "basic",
                "bearer",
                "api_key"
              ],
              "description": "Auth type"
            },
            "username": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "token": {
              "type": "string"
            },
            "apiKey": {
              "type": "string"
            },
            "apiKeyHeader": {
              "default": "X-API-Key",
              "type": "string"
            }
          },
          "required": [
            "type",
            "apiKeyHeader"
          ],
          "additionalProperties": false
        },
        "batch": {
          "type": "object",
          "properties": {
            "maxSize": {
              "default": 100,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "flushInterval": {
              "default": 5000,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "maxSize",
            "flushInterval"
          ],
          "additionalProperties": false
        },
        "retry": {
          "type": "object",
          "properties": {
            "maxAttempts": {
              "default": 3,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "initialDelay": {
              "default": 1000,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "backoffMultiplier": {
              "default": 2,
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "maxAttempts",
            "initialDelay",
            "backoffMultiplier"
          ],
          "additionalProperties": false
        },
        "timeout": {
          "default": 30000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "url",
        "method",
        "timeout"
      ],
      "additionalProperties": false,
      "description": "HTTP destination configuration"
    },
    "externalService": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string",
          "format": "uri"
        },
        "region": {
          "type": "string"
        },
        "credentials": {
          "type": "object",
          "properties": {
            "accessKeyId": {
              "type": "string"
            },
            "secretAccessKey": {
              "type": "string"
            },
            "apiKey": {
              "type": "string"
            },
            "projectId": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "logGroup": {
          "type": "string"
        },
        "logStream": {
          "type": "string"
        },
        "index": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "additionalProperties": false,
      "description": "External service destination configuration"
    },
    "format": {
      "default": "json",
      "type": "string",
      "enum": [
        "json",
        "text",
        "pretty"
      ]
    },
    "filterId": {
      "description": "Filter function identifier",
      "type": "string"
    }
  },
  "required": [
    "name",
    "type",
    "level",
    "enabled",
    "format"
  ],
  "additionalProperties": false,
  "description": "Log destination configuration",
  "$id": "https://schema.objectstack.io/v3.0.11/system/LogDestination.json",
  "x-spec-version": "3.0.11"
}