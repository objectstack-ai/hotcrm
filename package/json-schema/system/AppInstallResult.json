{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "success": {
      "type": "boolean",
      "description": "Whether installation succeeded"
    },
    "appId": {
      "type": "string",
      "description": "Installed app identifier"
    },
    "version": {
      "type": "string",
      "description": "Installed app version"
    },
    "installedObjects": {
      "default": [],
      "description": "Objects created/updated",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "createdTables": {
      "default": [],
      "description": "Database tables created",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "seededRecords": {
      "default": 0,
      "description": "Seed records inserted",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "durationMs": {
      "description": "Installation duration",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "error": {
      "description": "Error message on failure",
      "type": "string"
    }
  },
  "required": [
    "success",
    "appId",
    "version",
    "installedObjects",
    "createdTables",
    "seededRecords"
  ],
  "additionalProperties": false,
  "description": "App install result",
  "$id": "https://schema.objectstack.io/v3.0.11/system/AppInstallResult.json",
  "x-spec-version": "3.0.11"
}