{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "precision": {
      "default": 2,
      "description": "Decimal precision (default: 2)",
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "currencyMode": {
      "default": "dynamic",
      "description": "Currency mode: dynamic (user selectable) or fixed (single currency)",
      "type": "string",
      "enum": [
        "dynamic",
        "fixed"
      ]
    },
    "defaultCurrency": {
      "default": "CNY",
      "description": "Default or fixed currency code (ISO 4217, e.g., USD, CNY, EUR)",
      "type": "string",
      "minLength": 3,
      "maxLength": 3
    }
  },
  "required": [
    "precision",
    "currencyMode",
    "defaultCurrency"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/data/CurrencyConfig.json",
  "x-spec-version": "3.0.11"
}