{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Server name"
    },
    "version": {
      "type": "string",
      "description": "Server version (semver)"
    },
    "description": {
      "type": "string"
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "resources": {
          "default": false,
          "description": "Supports resource listing and retrieval",
          "type": "boolean"
        },
        "resourceTemplates": {
          "default": false,
          "description": "Supports dynamic resource templates",
          "type": "boolean"
        },
        "tools": {
          "default": false,
          "description": "Supports tool/function calling",
          "type": "boolean"
        },
        "prompts": {
          "default": false,
          "description": "Supports prompt templates",
          "type": "boolean"
        },
        "sampling": {
          "default": false,
          "description": "Supports sampling from LLMs",
          "type": "boolean"
        },
        "logging": {
          "default": false,
          "description": "Supports logging and debugging",
          "type": "boolean"
        }
      },
      "required": [
        "resources",
        "resourceTemplates",
        "tools",
        "prompts",
        "sampling",
        "logging"
      ],
      "additionalProperties": false
    },
    "protocolVersion": {
      "default": "2024-11-05",
      "description": "MCP protocol version",
      "type": "string"
    },
    "vendor": {
      "description": "Server vendor/provider",
      "type": "string"
    },
    "homepage": {
      "description": "Server homepage URL",
      "type": "string",
      "format": "uri"
    },
    "documentation": {
      "description": "Documentation URL",
      "type": "string",
      "format": "uri"
    }
  },
  "required": [
    "name",
    "version",
    "capabilities",
    "protocolVersion"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/MCPServerInfo.json",
  "x-spec-version": "3.0.11"
}