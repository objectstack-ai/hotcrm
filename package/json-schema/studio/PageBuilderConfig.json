{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "snap": {
      "description": "Canvas snap settings",
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Enable snap-to-grid",
          "type": "boolean"
        },
        "gridSize": {
          "default": 8,
          "description": "Snap grid size in pixels",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "showGrid": {
          "default": true,
          "description": "Show grid overlay on canvas",
          "type": "boolean"
        },
        "showGuides": {
          "default": true,
          "description": "Show alignment guides when dragging",
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "gridSize",
        "showGrid",
        "showGuides"
      ],
      "additionalProperties": false
    },
    "zoom": {
      "description": "Canvas zoom settings",
      "type": "object",
      "properties": {
        "min": {
          "default": 0.25,
          "description": "Minimum zoom level",
          "type": "number",
          "minimum": 0.1
        },
        "max": {
          "default": 3,
          "description": "Maximum zoom level",
          "type": "number",
          "maximum": 10
        },
        "default": {
          "default": 1,
          "description": "Default zoom level",
          "type": "number"
        },
        "step": {
          "default": 0.1,
          "description": "Zoom step increment",
          "type": "number"
        }
      },
      "required": [
        "min",
        "max",
        "default",
        "step"
      ],
      "additionalProperties": false
    },
    "palette": {
      "description": "Custom element palette (defaults to all registered elements)",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Component type (e.g. \"element:button\", \"element:text\")"
          },
          "label": {
            "type": "string",
            "description": "Display label in palette"
          },
          "icon": {
            "description": "Icon name for palette display",
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "content",
              "interactive",
              "data",
              "layout"
            ],
            "description": "Palette category grouping"
          },
          "defaultWidth": {
            "default": 4,
            "description": "Default width in grid columns",
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "defaultHeight": {
            "default": 2,
            "description": "Default height in grid rows",
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "type",
          "label",
          "category",
          "defaultWidth",
          "defaultHeight"
        ],
        "additionalProperties": false
      }
    },
    "showLayerPanel": {
      "default": true,
      "description": "Show layer ordering panel",
      "type": "boolean"
    },
    "showPropertyPanel": {
      "default": true,
      "description": "Show property inspector panel",
      "type": "boolean"
    },
    "undoLimit": {
      "default": 50,
      "description": "Maximum undo history steps",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "showLayerPanel",
    "showPropertyPanel",
    "undoLimit"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/studio/PageBuilderConfig.json",
  "x-spec-version": "3.0.11"
}