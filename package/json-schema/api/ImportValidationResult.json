{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "success": {
      "type": "boolean",
      "description": "Operation success status"
    },
    "error": {
      "description": "Error details if success is false",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Error code (e.g. validation_error)"
        },
        "message": {
          "type": "string",
          "description": "Readable error message"
        },
        "category": {
          "description": "Error category (e.g. validation, authorization)",
          "type": "string"
        },
        "details": {
          "description": "Additional error context (e.g. field validation errors)"
        },
        "requestId": {
          "description": "Request ID for tracking",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "meta": {
      "description": "Response metadata",
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "string"
        },
        "duration": {
          "type": "number"
        },
        "requestId": {
          "type": "string"
        },
        "traceId": {
          "type": "string"
        }
      },
      "required": [
        "timestamp"
      ],
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "properties": {
        "totalRecords": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Total records in import file"
        },
        "validRecords": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Records that passed validation"
        },
        "invalidRecords": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Records that failed validation"
        },
        "duplicateRecords": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Duplicate records detected"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "row": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "Row number in the import file"
              },
              "field": {
                "description": "Field that failed validation",
                "type": "string"
              },
              "code": {
                "type": "string",
                "description": "Validation error code"
              },
              "message": {
                "type": "string",
                "description": "Validation error message"
              }
            },
            "required": [
              "row",
              "code",
              "message"
            ],
            "additionalProperties": false
          },
          "description": "List of validation errors"
        },
        "preview": {
          "description": "Preview of first N valid records (for dry_run mode)",
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        }
      },
      "required": [
        "totalRecords",
        "validRecords",
        "invalidRecords",
        "duplicateRecords",
        "errors"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "success",
    "data"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/ImportValidationResult.json",
  "x-spec-version": "3.0.11"
}