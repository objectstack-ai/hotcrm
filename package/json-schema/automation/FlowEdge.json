{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Edge unique ID"
    },
    "source": {
      "type": "string",
      "description": "Source Node ID"
    },
    "target": {
      "type": "string",
      "description": "Target Node ID"
    },
    "condition": {
      "description": "Expression returning boolean used for branching",
      "type": "string"
    },
    "type": {
      "default": "default",
      "description": "Connection type: default (normal flow), fault (error path), or conditional (expression-guarded)",
      "type": "string",
      "enum": [
        "default",
        "fault",
        "conditional"
      ]
    },
    "label": {
      "description": "Label on the connector",
      "type": "string"
    },
    "isDefault": {
      "default": false,
      "description": "Marks this edge as the default path when no other conditions match",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "source",
    "target",
    "type",
    "isDefault"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/automation/FlowEdge.json",
  "x-spec-version": "3.0.11"
}