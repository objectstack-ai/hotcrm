{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "conflictResolution": {
      "default": "merge",
      "description": "How to handle existing items",
      "type": "string",
      "enum": [
        "skip",
        "overwrite",
        "merge",
        "fail"
      ]
    },
    "validate": {
      "default": true,
      "description": "Validate before import",
      "type": "boolean"
    },
    "dryRun": {
      "default": false,
      "description": "Simulate import without saving",
      "type": "boolean"
    },
    "continueOnError": {
      "default": false,
      "description": "Continue if validation fails",
      "type": "boolean"
    },
    "transform": {
      "description": "Transform items before import",
      "type": "string"
    }
  },
  "required": [
    "conflictResolution",
    "validate",
    "dryRun",
    "continueOnError"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/MetadataImportOptions.json",
  "x-spec-version": "3.0.11"
}