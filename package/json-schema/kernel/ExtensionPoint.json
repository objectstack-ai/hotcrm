{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^([a-z][a-z0-9]*\\.)+extension\\.[a-z][a-z0-9._]+$",
      "description": "Unique extension point identifier"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "action",
        "hook",
        "widget",
        "provider",
        "transformer",
        "validator",
        "decorator"
      ]
    },
    "contract": {
      "type": "object",
      "properties": {
        "input": {
          "description": "Input type/schema",
          "type": "string"
        },
        "output": {
          "description": "Output type/schema",
          "type": "string"
        },
        "signature": {
          "description": "Function signature if applicable",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "cardinality": {
      "default": "multiple",
      "description": "Whether multiple extensions can register to this point",
      "type": "string",
      "enum": [
        "single",
        "multiple"
      ]
    }
  },
  "required": [
    "id",
    "name",
    "type",
    "cardinality"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/ExtensionPoint.json",
  "x-spec-version": "3.0.11"
}