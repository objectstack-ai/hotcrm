{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Parameter name"
    },
    "in": {
      "type": "string",
      "enum": [
        "path",
        "query",
        "header",
        "body",
        "cookie"
      ],
      "description": "Parameter location"
    },
    "description": {
      "description": "Parameter description",
      "type": "string"
    },
    "required": {
      "default": false,
      "description": "Whether parameter is required",
      "type": "boolean"
    },
    "schema": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "string",
                "number",
                "integer",
                "boolean",
                "array",
                "object"
              ],
              "description": "Parameter type"
            },
            "format": {
              "description": "Format (e.g., date-time, email, uuid)",
              "type": "string"
            },
            "enum": {
              "description": "Allowed values",
              "type": "array",
              "items": {}
            },
            "default": {
              "description": "Default value"
            },
            "items": {
              "description": "Array item schema"
            },
            "properties": {
              "description": "Object properties",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "description": "Static JSON Schema"
        },
        {
          "type": "object",
          "properties": {
            "$ref": {
              "type": "object",
              "properties": {
                "objectId": {
                  "type": "string",
                  "minLength": 2,
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "description": "Object name to reference"
                },
                "includeFields": {
                  "description": "Include only these fields in the schema",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "excludeFields": {
                  "description": "Exclude these fields from the schema",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "includeRelated": {
                  "description": "Include related objects via lookup fields",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "objectId"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "$ref"
          ],
          "additionalProperties": false,
          "description": "Dynamic ObjectQL reference"
        }
      ],
      "description": "Parameter schema definition"
    },
    "example": {
      "description": "Example value"
    }
  },
  "required": [
    "name",
    "in",
    "required",
    "schema"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/ApiParameter.json",
  "x-spec-version": "3.0.11"
}