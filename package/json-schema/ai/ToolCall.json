{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Tool call ID"
    },
    "type": {
      "default": "function",
      "type": "string",
      "enum": [
        "function"
      ]
    },
    "function": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Function name"
        },
        "arguments": {
          "type": "string",
          "description": "JSON string of function arguments"
        },
        "result": {
          "description": "Function execution result",
          "type": "string"
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "type",
    "function"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/ToolCall.json",
  "x-spec-version": "3.0.11"
}