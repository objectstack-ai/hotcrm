{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "fixed"
        },
        "chunkSize": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Fixed chunk size in tokens/chars"
        },
        "chunkOverlap": {
          "default": 0,
          "description": "Overlap between chunks",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unit": {
          "default": "tokens",
          "type": "string",
          "enum": [
            "tokens",
            "characters"
          ]
        }
      },
      "required": [
        "type",
        "chunkSize",
        "chunkOverlap",
        "unit"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "semantic"
        },
        "model": {
          "description": "Model for semantic chunking",
          "type": "string"
        },
        "minChunkSize": {
          "default": 100,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxChunkSize": {
          "default": 1000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "minChunkSize",
        "maxChunkSize"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "recursive"
        },
        "separators": {
          "default": [
            "\n\n",
            "\n",
            " ",
            ""
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "chunkSize": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "chunkOverlap": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "separators",
        "chunkSize",
        "chunkOverlap"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "markdown"
        },
        "maxChunkSize": {
          "default": 1000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "respectHeaders": {
          "default": true,
          "description": "Keep headers with content",
          "type": "boolean"
        },
        "respectCodeBlocks": {
          "default": true,
          "description": "Keep code blocks intact",
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "maxChunkSize",
        "respectHeaders",
        "respectCodeBlocks"
      ],
      "additionalProperties": false
    }
  ],
  "$id": "https://schema.objectstack.io/v3.0.11/ai/ChunkingStrategy.json",
  "x-spec-version": "3.0.11"
}