{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "color": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "blue",
            "green",
            "red",
            "yellow",
            "purple",
            "orange",
            "pink",
            "teal",
            "indigo",
            "cyan"
          ]
        },
        {
          "type": "string"
        }
      ],
      "description": "Cursor color (preset or custom hex)"
    },
    "opacity": {
      "default": 1,
      "description": "Cursor opacity (0-1)",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "label": {
      "description": "Label to display with cursor (usually username)",
      "type": "string"
    },
    "showLabel": {
      "default": true,
      "description": "Whether to show label",
      "type": "boolean"
    },
    "pulseOnUpdate": {
      "default": true,
      "description": "Whether to pulse when cursor moves",
      "type": "boolean"
    }
  },
  "required": [
    "color",
    "opacity",
    "showLabel",
    "pulseOnUpdate"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/system/CursorStyle.json",
  "x-spec-version": "3.0.11"
}