{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "csp": {
      "type": "object",
      "properties": {
        "directives": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "reportOnly": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "reportOnly"
      ],
      "additionalProperties": false
    },
    "cors": {
      "type": "object",
      "properties": {
        "allowedOrigins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowedMethods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowedHeaders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowCredentials": {
          "default": false,
          "type": "boolean"
        },
        "maxAge": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "allowedOrigins",
        "allowedMethods",
        "allowedHeaders",
        "allowCredentials"
      ],
      "additionalProperties": false
    },
    "rateLimit": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "maxRequests": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "windowMs": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Time window in milliseconds"
        },
        "strategy": {
          "default": "sliding",
          "type": "string",
          "enum": [
            "fixed",
            "sliding",
            "token-bucket"
          ]
        }
      },
      "required": [
        "enabled",
        "maxRequests",
        "windowMs",
        "strategy"
      ],
      "additionalProperties": false
    },
    "authentication": {
      "type": "object",
      "properties": {
        "required": {
          "default": true,
          "type": "boolean"
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "jwt",
              "oauth2",
              "api-key",
              "session",
              "certificate"
            ]
          }
        },
        "tokenExpiration": {
          "description": "Token expiration in seconds",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "required",
        "methods"
      ],
      "additionalProperties": false
    },
    "encryption": {
      "type": "object",
      "properties": {
        "dataAtRest": {
          "default": false,
          "description": "Encrypt data at rest",
          "type": "boolean"
        },
        "dataInTransit": {
          "default": true,
          "description": "Enforce HTTPS/TLS",
          "type": "boolean"
        },
        "algorithm": {
          "description": "Encryption algorithm",
          "type": "string"
        },
        "minKeyLength": {
          "description": "Minimum key length in bits",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "dataAtRest",
        "dataInTransit"
      ],
      "additionalProperties": false
    },
    "auditLog": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "events": {
          "description": "Events to log",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "retention": {
          "description": "Log retention in days",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/KernelSecurityPolicy.json",
  "x-spec-version": "3.0.11"
}