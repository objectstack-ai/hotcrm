{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": false,
      "type": "boolean"
    },
    "priority": {
      "default": 100,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "metadata",
          "dependencies",
          "assets",
          "code",
          "services"
        ]
      }
    },
    "conditions": {
      "type": "object",
      "properties": {
        "routes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deviceType": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "desktop",
              "mobile",
              "tablet"
            ]
          }
        },
        "minNetworkSpeed": {
          "type": "string",
          "enum": [
            "slow-2g",
            "2g",
            "3g",
            "4g"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "enabled",
    "priority"
  ],
  "additionalProperties": false,
  "description": "Plugin preloading configuration",
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/PluginPreloadConfig.json",
  "x-spec-version": "3.0.11"
}