{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "url": {
      "type": "string",
      "minLength": 1,
      "description": "Database connection URL"
    },
    "authToken": {
      "description": "Database auth token (encrypted at rest)",
      "type": "string"
    },
    "group": {
      "description": "Turso database group name",
      "type": "string"
    }
  },
  "required": [
    "url"
  ],
  "additionalProperties": false,
  "description": "Tenant database connection configuration",
  "$id": "https://schema.objectstack.io/v3.0.11/system/TenantConnectionConfig.json",
  "x-spec-version": "3.0.11"
}