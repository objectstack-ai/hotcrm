{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "description": "Impact level"
    },
    "affectedSystems": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Affected systems"
    },
    "affectedUsers": {
      "description": "Affected user count",
      "type": "number"
    },
    "downtime": {
      "description": "Downtime information",
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean",
          "description": "Downtime required"
        },
        "durationMinutes": {
          "description": "Downtime duration",
          "type": "number"
        }
      },
      "required": [
        "required"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "level",
    "affectedSystems"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/system/ChangeImpact.json",
  "x-spec-version": "3.0.11"
}