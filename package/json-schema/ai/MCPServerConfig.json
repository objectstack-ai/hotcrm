{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$",
      "description": "Server unique identifier (snake_case)"
    },
    "label": {
      "type": "string",
      "description": "Display name"
    },
    "description": {
      "type": "string"
    },
    "serverInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Server name"
        },
        "version": {
          "type": "string",
          "description": "Server version (semver)"
        },
        "description": {
          "type": "string"
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "resources": {
              "default": false,
              "description": "Supports resource listing and retrieval",
              "type": "boolean"
            },
            "resourceTemplates": {
              "default": false,
              "description": "Supports dynamic resource templates",
              "type": "boolean"
            },
            "tools": {
              "default": false,
              "description": "Supports tool/function calling",
              "type": "boolean"
            },
            "prompts": {
              "default": false,
              "description": "Supports prompt templates",
              "type": "boolean"
            },
            "sampling": {
              "default": false,
              "description": "Supports sampling from LLMs",
              "type": "boolean"
            },
            "logging": {
              "default": false,
              "description": "Supports logging and debugging",
              "type": "boolean"
            }
          },
          "required": [
            "resources",
            "resourceTemplates",
            "tools",
            "prompts",
            "sampling",
            "logging"
          ],
          "additionalProperties": false
        },
        "protocolVersion": {
          "default": "2024-11-05",
          "description": "MCP protocol version",
          "type": "string"
        },
        "vendor": {
          "description": "Server vendor/provider",
          "type": "string"
        },
        "homepage": {
          "description": "Server homepage URL",
          "type": "string",
          "format": "uri"
        },
        "documentation": {
          "description": "Documentation URL",
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "name",
        "version",
        "capabilities",
        "protocolVersion"
      ],
      "additionalProperties": false
    },
    "transport": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "stdio",
            "http",
            "websocket",
            "grpc"
          ]
        },
        "url": {
          "description": "Server URL (for HTTP/WebSocket/gRPC)",
          "type": "string",
          "format": "uri"
        },
        "headers": {
          "description": "Custom headers for requests",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "auth": {
          "type": "object",
          "properties": {
            "type": {
              "default": "none",
              "type": "string",
              "enum": [
                "none",
                "bearer",
                "api_key",
                "oauth2",
                "custom"
              ]
            },
            "token": {
              "description": "Bearer token or API key",
              "type": "string"
            },
            "secretRef": {
              "description": "Reference to stored secret",
              "type": "string"
            },
            "headerName": {
              "description": "Custom auth header name",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        "timeout": {
          "default": 30000,
          "description": "Request timeout in milliseconds",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "retryAttempts": {
          "default": 3,
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "retryDelay": {
          "default": 1000,
          "description": "Delay between retries in milliseconds",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "command": {
          "description": "Command to execute (for stdio transport)",
          "type": "string"
        },
        "args": {
          "description": "Command arguments",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "description": "Environment variables",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "workingDirectory": {
          "description": "Working directory for the process",
          "type": "string"
        }
      },
      "required": [
        "type",
        "timeout",
        "retryAttempts",
        "retryDelay"
      ],
      "additionalProperties": false
    },
    "resources": {
      "description": "Static resources",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "uri": {
            "type": "string",
            "description": "Unique resource identifier (e.g., \"objectstack://objects/account/ABC123\")"
          },
          "name": {
            "type": "string",
            "description": "Human-readable resource name"
          },
          "description": {
            "description": "Resource description for AI consumption",
            "type": "string"
          },
          "mimeType": {
            "description": "MIME type (e.g., \"application/json\", \"text/plain\")",
            "type": "string"
          },
          "resourceType": {
            "default": "json",
            "type": "string",
            "enum": [
              "text",
              "json",
              "binary",
              "stream"
            ]
          },
          "content": {
            "description": "Resource content (for static resources)"
          },
          "contentUrl": {
            "description": "URL to fetch content dynamically",
            "type": "string",
            "format": "uri"
          },
          "size": {
            "description": "Resource size in bytes",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "lastModified": {
            "description": "Last modification timestamp (ISO 8601)",
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          },
          "tags": {
            "description": "Tags for resource categorization",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissions": {
            "type": "object",
            "properties": {
              "read": {
                "default": true,
                "type": "boolean"
              },
              "write": {
                "default": false,
                "type": "boolean"
              },
              "delete": {
                "default": false,
                "type": "boolean"
              }
            },
            "required": [
              "read",
              "write",
              "delete"
            ],
            "additionalProperties": false
          },
          "cacheable": {
            "default": true,
            "description": "Whether this resource can be cached",
            "type": "boolean"
          },
          "cacheMaxAge": {
            "description": "Cache max age in seconds",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "uri",
          "name",
          "resourceType",
          "cacheable"
        ],
        "additionalProperties": false
      }
    },
    "resourceTemplates": {
      "description": "Dynamic resource templates",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "uriPattern": {
            "type": "string",
            "description": "URI pattern with variables (e.g., \"objectstack://objects/{objectName}/{recordId}\")"
          },
          "name": {
            "type": "string",
            "description": "Template name"
          },
          "description": {
            "type": "string"
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Parameter name"
                },
                "type": {
                  "default": "string",
                  "type": "string",
                  "enum": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "required": {
                  "default": true,
                  "type": "boolean"
                },
                "description": {
                  "type": "string"
                },
                "pattern": {
                  "description": "Regex validation pattern",
                  "type": "string"
                },
                "default": {}
              },
              "required": [
                "name",
                "type",
                "required"
              ],
              "additionalProperties": false
            },
            "description": "URI parameters"
          },
          "handler": {
            "description": "Handler function name for dynamic generation",
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          },
          "resourceType": {
            "default": "json",
            "type": "string",
            "enum": [
              "text",
              "json",
              "binary",
              "stream"
            ]
          }
        },
        "required": [
          "uriPattern",
          "name",
          "parameters",
          "resourceType"
        ],
        "additionalProperties": false
      }
    },
    "tools": {
      "description": "Available tools",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_]*$",
            "description": "Tool function name (snake_case)"
          },
          "description": {
            "type": "string",
            "description": "Tool description for AI consumption (be detailed and specific)"
          },
          "parameters": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema0"
            },
            "description": "Tool parameters"
          },
          "returns": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "string",
                  "number",
                  "boolean",
                  "object",
                  "array",
                  "void"
                ]
              },
              "description": {
                "type": "string"
              },
              "schema": {
                "description": "Return value schema",
                "$ref": "#/$defs/__schema0"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          "handler": {
            "type": "string",
            "description": "Handler function or endpoint reference"
          },
          "async": {
            "default": true,
            "description": "Whether the tool executes asynchronously",
            "type": "boolean"
          },
          "timeout": {
            "description": "Execution timeout in milliseconds",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "sideEffects": {
            "default": "read",
            "description": "Tool side effects",
            "type": "string",
            "enum": [
              "none",
              "read",
              "write",
              "delete"
            ]
          },
          "requiresConfirmation": {
            "default": false,
            "description": "Require user confirmation before execution",
            "type": "boolean"
          },
          "confirmationMessage": {
            "type": "string"
          },
          "examples": {
            "description": "Usage examples for AI learning",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string"
                },
                "parameters": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "result": {}
              },
              "required": [
                "description",
                "parameters"
              ],
              "additionalProperties": false
            }
          },
          "category": {
            "description": "Tool category (e.g., \"data\", \"workflow\", \"analytics\")",
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deprecated": {
            "default": false,
            "type": "boolean"
          },
          "version": {
            "default": "1.0.0",
            "type": "string"
          }
        },
        "required": [
          "name",
          "description",
          "parameters",
          "handler",
          "async",
          "sideEffects",
          "requiresConfirmation",
          "deprecated",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "prompts": {
      "description": "Prompt templates",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_]*$",
            "description": "Prompt template name (snake_case)"
          },
          "description": {
            "description": "Prompt description",
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "system",
                    "user",
                    "assistant"
                  ],
                  "description": "Message role"
                },
                "content": {
                  "type": "string",
                  "description": "Message content (can include {{variable}} placeholders)"
                }
              },
              "required": [
                "role",
                "content"
              ],
              "additionalProperties": false
            },
            "description": "Prompt message sequence"
          },
          "arguments": {
            "description": "Dynamic arguments for the prompt",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Argument name"
                },
                "description": {
                  "type": "string"
                },
                "type": {
                  "default": "string",
                  "type": "string",
                  "enum": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "required": {
                  "default": false,
                  "type": "boolean"
                },
                "default": {}
              },
              "required": [
                "name",
                "type",
                "required"
              ],
              "additionalProperties": false
            }
          },
          "category": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "version": {
            "default": "1.0.0",
            "type": "string"
          }
        },
        "required": [
          "name",
          "messages",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "autoStart": {
      "default": false,
      "description": "Auto-start server on system boot",
      "type": "boolean"
    },
    "restartOnFailure": {
      "default": true,
      "description": "Auto-restart on failure",
      "type": "boolean"
    },
    "healthCheck": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "interval": {
          "default": 60000,
          "description": "Health check interval in milliseconds",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "timeout": {
          "default": 5000,
          "description": "Health check timeout in milliseconds",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "endpoint": {
          "description": "Health check endpoint (for HTTP servers)",
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "interval",
        "timeout"
      ],
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "properties": {
        "allowedAgents": {
          "description": "Agent names allowed to use this server",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowedUsers": {
          "description": "User IDs allowed to use this server",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requireAuth": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "requireAuth"
      ],
      "additionalProperties": false
    },
    "rateLimit": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "requestsPerMinute": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "requestsPerHour": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "burstSize": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "default": "active",
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "maintenance",
        "deprecated"
      ]
    },
    "version": {
      "default": "1.0.0",
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "streaming": {
      "description": "Streaming configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable streaming for MCP communication"
        },
        "chunkSize": {
          "description": "Size of each streamed chunk in bytes",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "heartbeatIntervalMs": {
          "default": 30000,
          "description": "Heartbeat interval in milliseconds",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "backpressure": {
          "description": "Backpressure handling strategy",
          "type": "string",
          "enum": [
            "drop",
            "buffer",
            "block"
          ]
        }
      },
      "required": [
        "enabled",
        "heartbeatIntervalMs"
      ],
      "additionalProperties": false
    },
    "toolApproval": {
      "description": "Tool approval configuration",
      "type": "object",
      "properties": {
        "requireApproval": {
          "default": false,
          "description": "Require approval before tool execution",
          "type": "boolean"
        },
        "approvalStrategy": {
          "type": "string",
          "enum": [
            "human_in_loop",
            "auto_approve",
            "policy_based"
          ],
          "description": "Approval strategy for tool execution"
        },
        "dangerousToolPatterns": {
          "description": "Regex patterns for tools needing approval",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "autoApproveTimeout": {
          "description": "Auto-approve timeout in seconds",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "requireApproval",
        "approvalStrategy"
      ],
      "additionalProperties": false
    },
    "sampling": {
      "description": "LLM sampling configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable LLM sampling"
        },
        "maxTokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Maximum tokens to generate"
        },
        "temperature": {
          "description": "Sampling temperature",
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "stopSequences": {
          "description": "Stop sequences to end generation",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modelPreferences": {
          "description": "Preferred model IDs in priority order",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "systemPrompt": {
          "description": "System prompt for sampling context",
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "maxTokens"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "label",
    "serverInfo",
    "transport",
    "autoStart",
    "restartOnFailure",
    "status",
    "version"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Parameter name"
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "boolean",
            "object",
            "array"
          ]
        },
        "description": {
          "type": "string",
          "description": "Parameter description for AI consumption"
        },
        "required": {
          "default": false,
          "type": "boolean"
        },
        "default": {},
        "enum": {
          "description": "Allowed values",
          "type": "array",
          "items": {}
        },
        "pattern": {
          "description": "Regex validation pattern (for strings)",
          "type": "string"
        },
        "minimum": {
          "description": "Minimum value (for numbers)",
          "type": "number"
        },
        "maximum": {
          "description": "Maximum value (for numbers)",
          "type": "number"
        },
        "minLength": {
          "description": "Minimum length (for strings/arrays)",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxLength": {
          "description": "Maximum length (for strings/arrays)",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "properties": {
          "description": "Properties for object types",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "items": {
          "description": "Item schema for array types",
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "name",
        "type",
        "description",
        "required"
      ],
      "additionalProperties": false
    }
  },
  "$id": "https://schema.objectstack.io/v3.0.11/ai/MCPServerConfig.json",
  "x-spec-version": "3.0.11"
}