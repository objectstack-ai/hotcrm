{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "API version (e.g., \"v1\", \"2024-01\")"
    },
    "apiName": {
      "type": "string",
      "description": "API name"
    },
    "routes": {
      "description": "Available endpoint paths",
      "type": "object",
      "properties": {
        "data": {
          "type": "string",
          "description": "e.g. /api/v1/data"
        },
        "metadata": {
          "type": "string",
          "description": "e.g. /api/v1/meta"
        },
        "ui": {
          "description": "e.g. /api/v1/ui",
          "type": "string"
        },
        "auth": {
          "description": "e.g. /api/v1/auth",
          "type": "string"
        },
        "automation": {
          "description": "e.g. /api/v1/automation",
          "type": "string"
        },
        "storage": {
          "description": "e.g. /api/v1/storage",
          "type": "string"
        },
        "analytics": {
          "description": "e.g. /api/v1/analytics",
          "type": "string"
        },
        "graphql": {
          "description": "e.g. /graphql",
          "type": "string"
        },
        "packages": {
          "description": "e.g. /api/v1/packages",
          "type": "string"
        },
        "workflow": {
          "description": "e.g. /api/v1/workflow",
          "type": "string"
        },
        "realtime": {
          "description": "e.g. /api/v1/realtime",
          "type": "string"
        },
        "notifications": {
          "description": "e.g. /api/v1/notifications",
          "type": "string"
        },
        "ai": {
          "description": "e.g. /api/v1/ai",
          "type": "string"
        },
        "i18n": {
          "description": "e.g. /api/v1/i18n",
          "type": "string"
        }
      },
      "required": [
        "data",
        "metadata"
      ],
      "additionalProperties": false
    },
    "services": {
      "description": "Per-service availability map",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "unavailable",
              "degraded",
              "stub"
            ],
            "description": "available = fully operational, unavailable = not installed, degraded = partial, stub = placeholder that throws"
          },
          "route": {
            "description": "e.g. /api/v1/analytics",
            "type": "string"
          },
          "provider": {
            "description": "e.g. \"objectql\", \"plugin-redis\", \"driver-memory\"",
            "type": "string"
          },
          "version": {
            "description": "Semantic version of the service implementation (e.g. \"3.0.6\")",
            "type": "string"
          },
          "message": {
            "description": "e.g. \"Install plugin-workflow to enable\"",
            "type": "string"
          },
          "rateLimit": {
            "description": "Rate limit and quota info for this service",
            "type": "object",
            "properties": {
              "requestsPerMinute": {
                "description": "Maximum requests per minute",
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "requestsPerHour": {
                "description": "Maximum requests per hour",
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "burstLimit": {
                "description": "Maximum burst request count",
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "retryAfterMs": {
                "description": "Suggested retry-after delay in milliseconds when rate-limited",
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "enabled",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "capabilities": {
      "description": "Well-known capability flags for frontend adaptation",
      "type": "object",
      "properties": {
        "feed": {
          "type": "boolean",
          "description": "Whether the backend supports Feed / Chatter API"
        },
        "comments": {
          "type": "boolean",
          "description": "Whether the backend supports comments (a subset of Feed)"
        },
        "automation": {
          "type": "boolean",
          "description": "Whether the backend supports Automation CRUD (flows, triggers)"
        },
        "cron": {
          "type": "boolean",
          "description": "Whether the backend supports cron scheduling"
        },
        "search": {
          "type": "boolean",
          "description": "Whether the backend supports full-text search"
        },
        "export": {
          "type": "boolean",
          "description": "Whether the backend supports async export"
        },
        "chunkedUpload": {
          "type": "boolean",
          "description": "Whether the backend supports chunked (multipart) uploads"
        }
      },
      "required": [
        "feed",
        "comments",
        "automation",
        "cron",
        "search",
        "export",
        "chunkedUpload"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "apiName"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/GetDiscoveryResponse.json",
  "x-spec-version": "3.0.11"
}