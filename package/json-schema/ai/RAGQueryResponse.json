{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "query": {
      "type": "string"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "metadata": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "description": "Document source (file path, URL, etc.)"
              },
              "sourceType": {
                "type": "string",
                "enum": [
                  "file",
                  "url",
                  "api",
                  "database",
                  "custom"
                ]
              },
              "title": {
                "type": "string"
              },
              "author": {
                "description": "Document author",
                "type": "string"
              },
              "createdAt": {
                "description": "ISO timestamp",
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              },
              "updatedAt": {
                "description": "ISO timestamp",
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "category": {
                "type": "string"
              },
              "language": {
                "description": "Document language (ISO 639-1 code)",
                "type": "string"
              },
              "custom": {
                "description": "Custom metadata fields",
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "source"
            ],
            "additionalProperties": false
          },
          "chunkId": {
            "type": "string"
          }
        },
        "required": [
          "content",
          "score"
        ],
        "additionalProperties": false
      }
    },
    "context": {
      "type": "string",
      "description": "Assembled context for LLM"
    },
    "tokens": {
      "description": "Token usage for this query",
      "type": "object",
      "properties": {
        "prompt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Input tokens"
        },
        "completion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Output tokens"
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Total tokens"
        }
      },
      "required": [
        "prompt",
        "completion",
        "total"
      ],
      "additionalProperties": false
    },
    "cost": {
      "description": "Cost for this query in USD",
      "type": "number",
      "minimum": 0
    },
    "retrievalTime": {
      "description": "Retrieval time in milliseconds",
      "type": "number"
    }
  },
  "required": [
    "query",
    "results",
    "context"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/RAGQueryResponse.json",
  "x-spec-version": "3.0.11"
}