{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "filename": {
      "type": "string",
      "description": "Original filename"
    },
    "mimeType": {
      "type": "string",
      "description": "File MIME type"
    },
    "totalSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Total file size in bytes"
    },
    "chunkSize": {
      "default": 5242880,
      "description": "Size of each chunk in bytes (minimum 5MB per S3 spec)",
      "type": "integer",
      "minimum": 5242880,
      "maximum": 9007199254740991
    },
    "scope": {
      "default": "user",
      "description": "Target storage scope",
      "type": "string"
    },
    "bucket": {
      "description": "Specific bucket override (admin only)",
      "type": "string"
    },
    "metadata": {
      "description": "Custom metadata key-value pairs",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "filename",
    "mimeType",
    "totalSize",
    "chunkSize",
    "scope"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/InitiateChunkedUploadRequest.json",
  "x-spec-version": "3.0.11"
}