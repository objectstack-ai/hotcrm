{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "enum": [
        "json_object",
        "json_schema",
        "regex",
        "grammar",
        "xml"
      ],
      "description": "Expected output format"
    },
    "schema": {
      "description": "JSON Schema definition for output",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "strict": {
      "default": false,
      "description": "Enforce exact schema compliance",
      "type": "boolean"
    },
    "retryOnValidationFailure": {
      "default": true,
      "description": "Retry generation when output fails validation",
      "type": "boolean"
    },
    "maxRetries": {
      "default": 3,
      "description": "Maximum retries on validation failure",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "fallbackFormat": {
      "description": "Fallback format if primary format fails",
      "type": "string",
      "enum": [
        "json_object",
        "json_schema",
        "regex",
        "grammar",
        "xml"
      ]
    },
    "transformPipeline": {
      "description": "Post-processing steps applied to output",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "trim",
          "parse_json",
          "validate",
          "coerce_types"
        ],
        "description": "Post-processing step for structured output"
      }
    }
  },
  "required": [
    "format",
    "strict",
    "retryOnValidationFailure",
    "maxRetries"
  ],
  "additionalProperties": false,
  "description": "Structured output configuration for agent responses",
  "$id": "https://schema.objectstack.io/v3.0.11/ai/StructuredOutputConfig.json",
  "x-spec-version": "3.0.11"
}