{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "query": {
      "type": "string",
      "description": "User query"
    },
    "pipelineName": {
      "type": "string",
      "description": "Pipeline to use"
    },
    "topK": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "metadataFilters": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "conversationHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant",
              "system"
            ]
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "additionalProperties": false
      }
    },
    "includeMetadata": {
      "default": true,
      "type": "boolean"
    },
    "includeSources": {
      "default": true,
      "type": "boolean"
    }
  },
  "required": [
    "query",
    "pipelineName",
    "includeMetadata",
    "includeSources"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/RAGQueryRequest.json",
  "x-spec-version": "3.0.11"
}