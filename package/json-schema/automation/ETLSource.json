{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "database",
        "api",
        "file",
        "stream",
        "object",
        "warehouse",
        "storage",
        "spreadsheet"
      ],
      "description": "Source type"
    },
    "connector": {
      "description": "Connector ID",
      "type": "string"
    },
    "config": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {},
      "description": "Source configuration"
    },
    "incremental": {
      "description": "Incremental extraction config",
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "cursorField": {
          "type": "string",
          "description": "Field to track progress (e.g., updated_at)"
        },
        "cursorValue": {
          "description": "Last processed value"
        }
      },
      "required": [
        "enabled",
        "cursorField"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "config"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/automation/ETLSource.json",
  "x-spec-version": "3.0.11"
}