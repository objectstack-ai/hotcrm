{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": false,
      "description": "Enable event persistence",
      "type": "boolean"
    },
    "retention": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "Days to retain persisted events"
    },
    "filter": {
      "description": "Optional filter function to select which events to persist"
    },
    "storage": {
      "default": "database",
      "description": "Storage backend for persisted events",
      "type": "string",
      "enum": [
        "database",
        "file",
        "s3",
        "custom"
      ]
    }
  },
  "required": [
    "enabled",
    "retention",
    "storage"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/EventPersistence.json",
  "x-spec-version": "3.0.11"
}