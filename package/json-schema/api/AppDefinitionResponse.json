{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "success": {
      "type": "boolean",
      "description": "Operation success status"
    },
    "error": {
      "description": "Error details if success is false",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Error code (e.g. validation_error)"
        },
        "message": {
          "type": "string",
          "description": "Readable error message"
        },
        "category": {
          "description": "Error category (e.g. validation, authorization)",
          "type": "string"
        },
        "details": {
          "description": "Additional error context (e.g. field validation errors)"
        },
        "requestId": {
          "description": "Request ID for tracking",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "meta": {
      "description": "Response metadata",
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "string"
        },
        "duration": {
          "type": "number"
        },
        "requestId": {
          "type": "string"
        },
        "traceId": {
          "type": "string"
        }
      },
      "required": [
        "timestamp"
      ],
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "App unique machine name (lowercase snake_case)"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "description": "Translation key (e.g., \"views.task_list.label\")"
                },
                "defaultValue": {
                  "description": "Fallback value when translation key is not found",
                  "type": "string"
                },
                "params": {
                  "description": "Interpolation parameters (e.g., { count: 5 })",
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  }
                }
              },
              "required": [
                "key"
              ],
              "additionalProperties": false
            }
          ],
          "description": "App display label"
        },
        "version": {
          "description": "App version",
          "type": "string"
        },
        "description": {
          "description": "App description",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "description": "Translation key (e.g., \"views.task_list.label\")"
                },
                "defaultValue": {
                  "description": "Fallback value when translation key is not found",
                  "type": "string"
                },
                "params": {
                  "description": "Interpolation parameters (e.g., { count: 5 })",
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  }
                }
              },
              "required": [
                "key"
              ],
              "additionalProperties": false
            }
          ]
        },
        "icon": {
          "description": "App icon used in the App Launcher",
          "type": "string"
        },
        "branding": {
          "description": "App-specific branding",
          "type": "object",
          "properties": {
            "primaryColor": {
              "description": "Primary theme color hex code",
              "type": "string"
            },
            "logo": {
              "description": "Custom logo URL for this app",
              "type": "string"
            },
            "favicon": {
              "description": "Custom favicon URL for this app",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "active": {
          "default": true,
          "description": "Whether the app is enabled",
          "type": "boolean"
        },
        "isDefault": {
          "default": false,
          "description": "Is default app",
          "type": "boolean"
        },
        "navigation": {
          "description": "Full navigation tree for the app sidebar",
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "areas": {
          "description": "Navigation areas for partitioning navigation by business domain",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 2,
                "pattern": "^[a-z][a-z0-9_]*$",
                "description": "Unique area identifier (lowercase snake_case)"
              },
              "label": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "description": "Translation key (e.g., \"views.task_list.label\")"
                      },
                      "defaultValue": {
                        "description": "Fallback value when translation key is not found",
                        "type": "string"
                      },
                      "params": {
                        "description": "Interpolation parameters (e.g., { count: 5 })",
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "number"
                            },
                            {
                              "type": "boolean"
                            }
                          ]
                        }
                      }
                    },
                    "required": [
                      "key"
                    ],
                    "additionalProperties": false
                  }
                ],
                "description": "Area display label"
              },
              "icon": {
                "description": "Area icon name",
                "type": "string"
              },
              "order": {
                "description": "Sort order among areas (lower = first)",
                "type": "number"
              },
              "description": {
                "description": "Area description",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "description": "Translation key (e.g., \"views.task_list.label\")"
                      },
                      "defaultValue": {
                        "description": "Fallback value when translation key is not found",
                        "type": "string"
                      },
                      "params": {
                        "description": "Interpolation parameters (e.g., { count: 5 })",
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "number"
                            },
                            {
                              "type": "boolean"
                            }
                          ]
                        }
                      }
                    },
                    "required": [
                      "key"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
