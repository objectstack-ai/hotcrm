{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$",
      "description": "Webhook event identifier (snake_case)"
    },
    "description": {
      "type": "string",
      "description": "Human-readable event description"
    },
    "method": {
      "default": "POST",
      "description": "HTTP method for webhook delivery",
      "type": "string",
      "enum": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "PATCH",
        "HEAD",
        "OPTIONS"
      ]
    },
    "payloadSchema": {
      "type": "string",
      "description": "JSON Schema $ref for the webhook payload"
    },
    "headers": {
      "description": "Custom headers to include in webhook delivery",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "security": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "hmac_sha256",
          "basic",
          "bearer",
          "api_key"
        ]
      },
      "description": "Supported authentication methods for webhook verification"
    }
  },
  "required": [
    "name",
    "description",
    "method",
    "payloadSchema",
    "security"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/WebhookEvent.json",
  "x-spec-version": "3.0.11"
}