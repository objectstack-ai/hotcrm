{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": true,
      "description": "Enable batch operations",
      "type": "boolean"
    },
    "maxRecordsPerBatch": {
      "default": 200,
      "description": "Maximum records per batch",
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "defaultOptions": {
      "description": "Default batch options",
      "type": "object",
      "properties": {
        "atomic": {
          "default": true,
          "description": "If true, rollback entire batch on any failure (transaction mode)",
          "type": "boolean"
        },
        "returnRecords": {
          "default": false,
          "description": "If true, return full record data in response",
          "type": "boolean"
        },
        "continueOnError": {
          "default": false,
          "description": "If true (and atomic=false), continue processing remaining records after errors",
          "type": "boolean"
        },
        "validateOnly": {
          "default": false,
          "description": "If true, validate records without persisting changes (dry-run mode)",
          "type": "boolean"
        }
      },
      "required": [
        "atomic",
        "returnRecords",
        "continueOnError",
        "validateOnly"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "enabled",
    "maxRecordsPerBatch"
  ],
  "additionalProperties": {},
  "$id": "https://schema.objectstack.io/v3.0.11/api/BatchConfig.json",
  "x-spec-version": "3.0.11"
}