{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": true,
      "description": "Enable monitoring",
      "type": "boolean"
    },
    "metrics": {
      "default": [
        "performance",
        "errors",
        "availability"
      ],
      "description": "Metrics to monitor",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "performance",
          "errors",
          "usage",
          "availability",
          "latency"
        ]
      }
    },
    "alerts": {
      "description": "Alert configurations",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Alert name"
          },
          "metric": {
            "type": "string",
            "description": "Metric to monitor"
          },
          "threshold": {
            "type": "number",
            "description": "Alert threshold"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "critical"
            ],
            "description": "Alert severity"
          }
        },
        "required": [
          "name",
          "metric",
          "threshold",
          "severity"
        ],
        "additionalProperties": false
      }
    },
    "integrations": {
      "description": "Monitoring service integrations",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "enabled",
    "metrics"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/MonitoringConfig.json",
  "x-spec-version": "3.0.11"
}