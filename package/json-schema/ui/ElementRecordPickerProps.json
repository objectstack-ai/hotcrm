{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "object": {
      "type": "string",
      "description": "Object to pick records from"
    },
    "displayField": {
      "type": "string",
      "description": "Field to display as the record label"
    },
    "searchFields": {
      "description": "Fields to search against",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "filter": {
      "description": "Filter criteria for available records",
      "$ref": "#/$defs/__schema0"
    },
    "multiple": {
      "default": false,
      "description": "Allow multiple record selection",
      "type": "boolean"
    },
    "targetVariable": {
      "description": "Page variable to bind selected record ID(s)",
      "type": "string"
    },
    "placeholder": {
      "description": "Placeholder text",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Translation key (e.g., \"views.task_list.label\")"
            },
            "defaultValue": {
              "description": "Fallback value when translation key is not found",
              "type": "string"
            },
            "params": {
              "description": "Interpolation parameters (e.g., { count: 5 })",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        }
      ]
    },
    "aria": {
      "description": "ARIA accessibility attributes",
      "type": "object",
      "properties": {
        "ariaLabel": {
          "description": "Accessible label for screen readers (WAI-ARIA aria-label)",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "description": "Translation key (e.g., \"views.task_list.label\")"
                },
                "defaultValue": {
                  "description": "Fallback value when translation key is not found",
                  "type": "string"
                },
                "params": {
                  "description": "Interpolation parameters (e.g., { count: 5 })",
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  }
                }
              },
              "required": [
                "key"
              ],
              "additionalProperties": false
            }
          ]
        },
        "ariaDescribedBy": {
          "description": "ID of element providing additional description (WAI-ARIA aria-describedby)",
          "type": "string"
        },
        "role": {
          "description": "WAI-ARIA role attribute (e.g., \"dialog\", \"navigation\", \"alert\")",
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "object",
    "displayField",
    "multiple"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "allOf": [
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "$and": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            },
            "$or": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            },
            "$not": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "$id": "https://schema.objectstack.io/v3.0.11/ui/ElementRecordPickerProps.json",
  "x-spec-version": "3.0.11"
}