{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "system",
        "user",
        "assistant"
      ],
      "description": "Message role"
    },
    "content": {
      "type": "string",
      "description": "Message content (can include {{variable}} placeholders)"
    }
  },
  "required": [
    "role",
    "content"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/MCPPromptMessage.json",
  "x-spec-version": "3.0.11"
}