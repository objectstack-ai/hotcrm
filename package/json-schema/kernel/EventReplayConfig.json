{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "fromTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "description": "Start timestamp for replay (ISO 8601)"
    },
    "toTimestamp": {
      "description": "End timestamp for replay (ISO 8601)",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "eventTypes": {
      "description": "Event types to replay (empty = all)",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "filters": {
      "description": "Additional filters for event selection",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "speed": {
      "default": 1,
      "description": "Replay speed multiplier (1 = real-time)",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "targetHandlers": {
      "description": "Handler IDs to execute (empty = all)",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "fromTimestamp",
    "speed"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/EventReplayConfig.json",
  "x-spec-version": "3.0.11"
}