{
  "name": "@hotcrm/analytics",
  "version": "1.0.0",
  "type": "module",
  "description": "Analytics module - Reports, Dashboards, KPIs, Metrics, and Business Intelligence",
  "license": "MIT",
  "main": "./dist/plugin.js",
  "types": "./dist/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
