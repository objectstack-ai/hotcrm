{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "operationId": {
      "type": "string"
    },
    "operationType": {
      "type": "string",
      "enum": [
        "conversation",
        "orchestration",
        "prediction",
        "rag",
        "nlq"
      ]
    },
    "agentName": {
      "description": "Agent that performed the operation",
      "type": "string"
    },
    "modelId": {
      "type": "string"
    },
    "tokens": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Input tokens"
        },
        "completion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Output tokens"
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Total tokens"
        }
      },
      "required": [
        "prompt",
        "completion",
        "total"
      ],
      "additionalProperties": false
    },
    "cost": {
      "type": "number",
      "minimum": 0,
      "description": "Cost in USD"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "metadata": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "operationId",
    "operationType",
    "modelId",
    "tokens",
    "cost",
    "timestamp"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/AIOperationCost.json",
  "x-spec-version": "3.0.11"
}