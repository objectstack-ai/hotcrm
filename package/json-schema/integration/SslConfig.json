{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": false,
      "description": "Enable SSL/TLS",
      "type": "boolean"
    },
    "rejectUnauthorized": {
      "default": true,
      "description": "Reject unauthorized certificates",
      "type": "boolean"
    },
    "ca": {
      "description": "Certificate Authority certificate",
      "type": "string"
    },
    "cert": {
      "description": "Client certificate",
      "type": "string"
    },
    "key": {
      "description": "Client private key",
      "type": "string"
    }
  },
  "required": [
    "enabled",
    "rejectUnauthorized"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/integration/SslConfig.json",
  "x-spec-version": "3.0.11"
}