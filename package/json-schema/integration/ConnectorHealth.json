{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "healthCheck": {
      "description": "Health check configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable health checks"
        },
        "intervalMs": {
          "default": 60000,
          "description": "Health check interval in milliseconds",
          "type": "number"
        },
        "timeoutMs": {
          "default": 5000,
          "description": "Health check timeout in milliseconds",
          "type": "number"
        },
        "endpoint": {
          "description": "Health check endpoint path",
          "type": "string"
        },
        "method": {
          "description": "HTTP method for health check",
          "type": "string",
          "enum": [
            "GET",
            "HEAD",
            "OPTIONS"
          ]
        },
        "expectedStatus": {
          "default": 200,
          "description": "Expected HTTP status code",
          "type": "number"
        },
        "unhealthyThreshold": {
          "default": 3,
          "description": "Consecutive failures before marking unhealthy",
          "type": "number"
        },
        "healthyThreshold": {
          "default": 1,
          "description": "Consecutive successes before marking healthy",
          "type": "number"
        }
      },
      "required": [
        "enabled",
        "intervalMs",
        "timeoutMs",
        "expectedStatus",
        "unhealthyThreshold",
        "healthyThreshold"
      ],
      "additionalProperties": false
    },
    "circuitBreaker": {
      "description": "Circuit breaker configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable circuit breaker"
        },
        "failureThreshold": {
          "default": 5,
          "description": "Failures before opening circuit",
          "type": "number"
        },
        "resetTimeoutMs": {
          "default": 30000,
          "description": "Time in open state before half-open",
          "type": "number"
        },
        "halfOpenMaxRequests": {
          "default": 1,
          "description": "Requests allowed in half-open state",
          "type": "number"
        },
        "monitoringWindow": {
          "default": 60000,
          "description": "Rolling window for failure count in ms",
          "type": "number"
        },
        "fallbackStrategy": {
          "description": "Fallback strategy when circuit is open",
          "type": "string",
          "enum": [
            "cache",
            "default_value",
            "error",
            "queue"
          ]
        }
      },
      "required": [
        "enabled",
        "failureThreshold",
        "resetTimeoutMs",
        "halfOpenMaxRequests",
        "monitoringWindow"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "Connector health configuration",
  "$id": "https://schema.objectstack.io/v3.0.11/integration/ConnectorHealth.json",
  "x-spec-version": "3.0.11"
}