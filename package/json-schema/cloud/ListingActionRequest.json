{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "listingId": {
      "type": "string",
      "description": "Listing ID"
    },
    "action": {
      "type": "string",
      "enum": [
        "submit",
        "unlist",
        "deprecate",
        "reactivate"
      ],
      "description": "Action to perform on listing"
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "listingId",
    "action"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/cloud/ListingActionRequest.json",
  "x-spec-version": "3.0.11"
}