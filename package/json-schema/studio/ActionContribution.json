{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique action identifier"
    },
    "label": {
      "type": "string",
      "description": "Action display label"
    },
    "icon": {
      "description": "Lucide icon name",
      "type": "string"
    },
    "location": {
      "type": "string",
      "enum": [
        "toolbar",
        "contextMenu",
        "commandPalette"
      ],
      "description": "UI location"
    },
    "metadataTypes": {
      "default": [],
      "description": "Applicable metadata types",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "label",
    "location",
    "metadataTypes"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/studio/ActionContribution.json",
  "x-spec-version": "3.0.11"
}