{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "ot",
        "crdt",
        "lock",
        "hybrid"
      ],
      "description": "Collaboration mode to use"
    },
    "enableCursorSharing": {
      "default": true,
      "description": "Enable cursor sharing",
      "type": "boolean"
    },
    "enablePresence": {
      "default": true,
      "description": "Enable presence tracking",
      "type": "boolean"
    },
    "enableAwareness": {
      "default": true,
      "description": "Enable awareness state",
      "type": "boolean"
    },
    "maxUsers": {
      "description": "Maximum concurrent users",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "idleTimeout": {
      "default": 300000,
      "description": "Idle timeout in milliseconds",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "conflictResolution": {
      "default": "ot",
      "description": "Conflict resolution strategy",
      "type": "string",
      "enum": [
        "ot",
        "crdt",
        "manual"
      ]
    },
    "persistence": {
      "default": true,
      "description": "Enable operation persistence",
      "type": "boolean"
    },
    "snapshot": {
      "description": "Snapshot configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable periodic snapshots"
        },
        "interval": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Snapshot interval in milliseconds"
        }
      },
      "required": [
        "enabled",
        "interval"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "mode",
    "enableCursorSharing",
    "enablePresence",
    "enableAwareness",
    "idleTimeout",
    "conflictResolution",
    "persistence"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/system/CollaborationSessionConfig.json",
  "x-spec-version": "3.0.11"
}