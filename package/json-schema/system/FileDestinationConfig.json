{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "description": "Log file path"
    },
    "rotation": {
      "type": "object",
      "properties": {
        "maxSize": {
          "default": "10m",
          "type": "string"
        },
        "maxFiles": {
          "default": 5,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "compress": {
          "default": true,
          "type": "boolean"
        },
        "interval": {
          "type": "string",
          "enum": [
            "hourly",
            "daily",
            "weekly",
            "monthly"
          ]
        }
      },
      "required": [
        "maxSize",
        "maxFiles",
        "compress"
      ],
      "additionalProperties": false
    },
    "encoding": {
      "default": "utf8",
      "type": "string"
    },
    "append": {
      "default": true,
      "type": "boolean"
    }
  },
  "required": [
    "path",
    "encoding",
    "append"
  ],
  "additionalProperties": false,
  "description": "File destination configuration",
  "$id": "https://schema.objectstack.io/v3.0.11/system/FileDestinationConfig.json",
  "x-spec-version": "3.0.11"
}