{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "description": "Conversation summary"
    },
    "keyPoints": {
      "description": "Key discussion points",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "originalTokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Original token count"
    },
    "summaryTokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Summary token count"
    },
    "tokensSaved": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Tokens saved"
    },
    "messageRange": {
      "type": "object",
      "properties": {
        "startIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "startIndex",
        "endIndex"
      ],
      "additionalProperties": false,
      "description": "Range of messages summarized"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "description": "ISO 8601 timestamp"
    },
    "modelId": {
      "description": "Model used for summarization",
      "type": "string"
    }
  },
  "required": [
    "summary",
    "originalTokens",
    "summaryTokens",
    "tokensSaved",
    "messageRange",
    "generatedAt"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/ConversationSummary.json",
  "x-spec-version": "3.0.11"
}