{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$",
      "description": "Callback identifier (snake_case)"
    },
    "expression": {
      "type": "string",
      "description": "Runtime expression (e.g., {$request.body#/callbackUrl})"
    },
    "method": {
      "type": "string",
      "enum": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "PATCH",
        "HEAD",
        "OPTIONS"
      ],
      "description": "HTTP method for callback request"
    },
    "url": {
      "type": "string",
      "description": "Callback URL template with runtime expressions"
    }
  },
  "required": [
    "name",
    "expression",
    "method",
    "url"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/Callback.json",
  "x-spec-version": "3.0.11"
}