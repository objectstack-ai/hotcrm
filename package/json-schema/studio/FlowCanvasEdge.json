{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "edgeId": {
      "type": "string",
      "description": "Corresponding FlowEdge.id"
    },
    "style": {
      "default": "solid",
      "description": "Line style",
      "type": "string",
      "enum": [
        "solid",
        "dashed",
        "dotted",
        "bold"
      ]
    },
    "color": {
      "default": "#94a3b8",
      "description": "Edge line color",
      "type": "string"
    },
    "labelPosition": {
      "default": 0.5,
      "description": "Position of the condition label along the edge",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "waypoints": {
      "description": "Manual waypoints for edge routing",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "description": "Waypoint X"
          },
          "y": {
            "type": "number",
            "description": "Waypoint Y"
          }
        },
        "required": [
          "x",
          "y"
        ],
        "additionalProperties": false
      }
    },
    "animated": {
      "default": false,
      "description": "Show animated flow indicator",
      "type": "boolean"
    }
  },
  "required": [
    "edgeId",
    "style",
    "color",
    "labelPosition",
    "animated"
  ],
  "additionalProperties": false,
  "description": "Canvas layout and visual data for a flow edge",
  "$id": "https://schema.objectstack.io/v3.0.11/studio/FlowCanvasEdge.json",
  "x-spec-version": "3.0.11"
}