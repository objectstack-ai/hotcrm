{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$",
      "description": "Unique connector identifier"
    },
    "label": {
      "type": "string",
      "description": "Display label"
    },
    "type": {
      "type": "string",
      "const": "database"
    },
    "description": {
      "description": "Connector description",
      "type": "string"
    },
    "icon": {
      "description": "Icon identifier",
      "type": "string"
    },
    "authentication": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "oauth2"
            },
            "authorizationUrl": {
              "type": "string",
              "format": "uri",
              "description": "OAuth2 authorization endpoint"
            },
            "tokenUrl": {
              "type": "string",
              "format": "uri",
              "description": "OAuth2 token endpoint"
            },
            "clientId": {
              "type": "string",
              "description": "OAuth2 client ID"
            },
            "clientSecret": {
              "type": "string",
              "description": "OAuth2 client secret (typically from ENV)"
            },
            "scopes": {
              "description": "Requested OAuth2 scopes",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "redirectUri": {
              "description": "OAuth2 redirect URI",
              "type": "string",
              "format": "uri"
            },
            "refreshToken": {
              "description": "Refresh token for token renewal",
              "type": "string"
            },
            "tokenExpiry": {
              "description": "Token expiry timestamp",
              "type": "number"
            }
          },
          "required": [
            "type",
            "authorizationUrl",
            "tokenUrl",
            "clientId",
            "clientSecret"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "api-key"
            },
            "key": {
              "type": "string",
              "description": "API key value"
            },
            "headerName": {
              "default": "X-API-Key",
              "description": "HTTP header name for API key",
              "type": "string"
            },
            "paramName": {
              "description": "Query parameter name (alternative to header)",
              "type": "string"
            }
          },
          "required": [
            "type",
            "key",
            "headerName"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "basic"
            },
            "username": {
              "type": "string",
              "description": "Username"
            },
            "password": {
              "type": "string",
              "description": "Password"
            }
          },
          "required": [
            "type",
            "username",
            "password"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "bearer"
            },
            "token": {
              "type": "string",
              "description": "Bearer token"
            }
          },
          "required": [
            "type",
            "token"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Authentication configuration"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Action key (machine name)"
          },
          "label": {
            "type": "string",
            "description": "Human readable label"
          },
          "description": {
            "type": "string"
          },
          "inputSchema": {
            "description": "Input parameters schema (JSON Schema)",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "outputSchema": {
            "description": "Output schema (JSON Schema)",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "key",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Trigger key"
          },
          "label": {
            "type": "string",
            "description": "Trigger label"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "polling",
              "webhook"
            ],
            "description": "Trigger type"
          },
          "interval": {
            "description": "Polling interval in seconds",
            "type": "number"
          }
        },
        "required": [
          "key",
          "label",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "syncConfig": {
      "description": "Data sync configuration",
      "type": "object",
      "properties": {
        "strategy": {
          "default": "incremental",
          "type": "string",
          "enum": [
            "full",
            "incremental",
            "upsert",
            "append_only"
          ],
          "description": "Synchronization strategy"
        },
        "direction": {
          "default": "import",
          "description": "Sync direction",
          "type": "string",
          "enum": [
            "import",
            "export",
            "bidirectional"
          ]
        },
        "schedule": {
          "description": "Cron expression for scheduled sync",
          "type": "string"
        },
        "realtimeSync": {
          "default": false,
          "description": "Enable real-time sync",
          "type": "boolean"
        },
        "timestampField": {
          "description": "Field to track last modification time",
          "type": "string"
        },
        "conflictResolution": {
          "default": "latest_wins",
          "type": "string",
          "enum": [
            "source_wins",
            "target_wins",
            "latest_wins",
            "manual"
          ],
          "description": "Conflict resolution strategy"
        },
        "batchSize": {
          "default": 1000,
          "description": "Records per batch",
          "type": "number",
          "minimum": 1,
          "maximum": 10000
        },
        "deleteMode": {
          "default": "soft_delete",
          "description": "Delete handling mode",
          "type": "string",
          "enum": [
            "hard_delete",
            "soft_delete",
            "ignore"
          ]
        },
        "filters": {
          "description": "Filter criteria for selective sync",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "strategy",
        "direction",
        "realtimeSync",
        "conflictResolution",
        "batchSize",
        "deleteMode"
      ],
      "additionalProperties": false
    },
    "fieldMappings": {
      "description": "Field mapping rules",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "description": "Source field name"
          },
          "target": {
            "type": "string",
            "description": "Target field name"
          },
          "transform": {
            "description": "Transformation to apply",
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "constant"
                  },
                  "value": {
                    "description": "Constant value to use"
                  }
                },
                "required": [
                  "type",
                  "value"
                ],
                "additionalProperties": false,
                "description": "Set a constant value"
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "cast"
                  },
                  "targetType": {
                    "type": "string",
                    "enum": [
                      "string",
                      "number",
                      "boolean",
                      "date"
                    ],
                    "description": "Target data type"
                  }
                },
                "required": [
                  "type",
                  "targetType"
                ],
                "additionalProperties": false,
                "description": "Cast to a specific data type"
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "lookup"
                  },
                  "table": {
                    "type": "string",
                    "description": "Lookup table name"
                  },
                  "keyField": {
                    "type": "string",
                    "description": "Field to match on"
                  },
                  "valueField": {
                    "type": "string",
                    "description": "Field to retrieve"
                  }
                },
                "required": [
                  "type",
                  "table",
                  "keyField",
                  "valueField"
                ],
                "additionalProperties": false,
                "description": "Lookup value from another table"
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "javascript"
                  },
                  "expression": {
                    "type": "string",
                    "description": "JavaScript expression (e.g., \"value.toUpperCase()\")"
                  }
                },
                "required": [
                  "type",
                  "expression"
                ],
                "additionalProperties": false,
                "description": "Custom JavaScript transformation"
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "map"
                  },
                  "mappings": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {},
                    "description": "Value mappings (e.g., {\"Active\": \"active\"})"
                  }
                },
                "required": [
                  "type",
                  "mappings"
                ],
                "additionalProperties": false,
                "description": "Map values using a dictionary"
              }
            ]
          },
          "defaultValue": {
            "description": "Default if source is null/undefined"
          },
          "dataType": {
            "description": "Target data type",
            "type": "string",
            "enum": [
              "string",
              "number",
              "boolean",
              "date",
              "datetime",
              "json",
              "array"
            ]
          },
          "required": {
            "default": false,
            "description": "Field is required",
            "type": "boolean"
          },
          "syncMode": {
            "default": "bidirectional",
            "description": "Sync mode",
            "type": "string",
            "enum": [
              "read_only",
              "write_only",
              "bidirectional"
            ]
          }
        },
        "required": [
          "source",
          "target",
          "required",
          "syncMode"
        ],
        "additionalProperties": false
      }
    },
    "webhooks": {
      "description": "Webhook configurations",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "Webhook unique name (lowercase snake_case)"
          },
          "label": {
            "description": "Human-readable webhook label",
            "type": "string"
          },
          "object": {
            "description": "Object to listen to (optional for manual webhooks)",
            "type": "string"
          },
          "triggers": {
            "description": "Events that trigger execution",
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "create",
                "update",
                "delete",
                "undelete",
                "api"
              ]
            }
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "External webhook endpoint URL"
          },
          "method": {
            "default": "POST",
            "description": "HTTP method",
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          },
          "headers": {
            "description": "Custom HTTP headers",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "body": {
            "description": "Request body payload (if not using default record data)"
          },
          "payloadFields": {
            "description": "Fields to include. Empty = All",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "includeSession": {
            "default": false,
            "description": "Include user session info",
            "type": "boolean"
          },
          "authentication": {
            "description": "Authentication configuration",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "none",
                  "bearer",
                  "basic",
                  "api-key"
                ],
                "description": "Authentication type"
              },
              "credentials": {
                "description": "Authentication credentials",
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          "retryPolicy": {
            "description": "Retry policy configuration",
            "type": "object",
            "properties": {
              "maxRetries": {
                "default": 3,
                "description": "Maximum retry attempts",
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "backoffStrategy": {
                "default": "exponential",
                "description": "Backoff strategy",
                "type": "string",
                "enum": [
                  "exponential",
                  "linear",
                  "fixed"
                ]
              },
              "initialDelayMs": {
                "default": 1000,
                "description": "Initial retry delay in milliseconds",
                "type": "integer",
                "minimum": 100,
                "maximum": 9007199254740991
              },
              "maxDelayMs": {
                "default": 60000,
                "description": "Maximum retry delay in milliseconds",
                "type": "integer",
                "minimum": 1000,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "maxRetries",
              "backoffStrategy",
              "initialDelayMs",
              "maxDelayMs"
            ],
            "additionalProperties": false
          },
          "timeoutMs": {
            "default": 30000,
            "description": "Request timeout in milliseconds",
            "type": "integer",
            "minimum": 1000,
            "maximum": 300000
          },
          "secret": {
            "description": "Signing secret for HMAC signature verification",
            "type": "string"
          },
          "isActive": {
            "default": true,
            "description": "Whether webhook is active",
            "type": "boolean"
          },
          "description": {
            "description": "Webhook description",
            "type": "string"
          },
          "tags": {
            "description": "Tags for organization",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "events": {
            "description": "Connector events to subscribe to",
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "record.created",
                "record.updated",
                "record.deleted",
                "sync.started",
                "sync.completed",
                "sync.failed",
                "auth.expired",
                "rate_limit.exceeded"
              ],
              "description": "Webhook event type"
            }
          },
          "signatureAlgorithm": {
            "default": "hmac_sha256",
            "type": "string",
            "enum": [
              "hmac_sha256",
              "hmac_sha512",
              "none"
            ],
            "description": "Webhook signature algorithm"
          }
        },
        "required": [
          "name",
          "url",
          "method",
          "includeSession",
          "timeoutMs",
          "isActive",
          "signatureAlgorithm"
        ],
        "additionalProperties": false
      }
    },
    "rateLimitConfig": {
      "description": "Rate limiting configuration",
      "type": "object",
      "properties": {
        "strategy": {
          "default": "token_bucket",
          "type": "string",
          "enum": [
            "fixed_window",
            "sliding_window",
            "token_bucket",
            "leaky_bucket"
          ],
          "description": "Rate limiting strategy"
        },
        "maxRequests": {
          "type": "number",
          "minimum": 1,
          "description": "Maximum requests per window"
        },
        "windowSeconds": {
          "type": "number",
          "minimum": 1,
          "description": "Time window in seconds"
        },
        "burstCapacity": {
          "description": "Burst capacity",
          "type": "number",
          "minimum": 1
        },
        "respectUpstreamLimits": {
          "default": true,
          "description": "Respect external rate limit headers",
          "type": "boolean"
        },
        "rateLimitHeaders": {
          "description": "Custom rate limit headers",
          "type": "object",
          "properties": {
            "remaining": {
              "default": "X-RateLimit-Remaining",
              "description": "Header for remaining requests",
              "type": "string"
            },
            "limit": {
              "default": "X-RateLimit-Limit",
              "description": "Header for rate limit",
              "type": "string"
            },
            "reset": {
              "default": "X-RateLimit-Reset",
              "description": "Header for reset time",
              "type": "string"
            }
          },
          "required": [
            "remaining",
            "limit",
            "reset"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "strategy",
        "maxRequests",
        "windowSeconds",
        "respectUpstreamLimits"
      ],
      "additionalProperties": false
    },
    "retryConfig": {
      "description": "Retry configuration",
      "type": "object",
      "properties": {
        "strategy": {
          "default": "exponential_backoff",
          "type": "string",
          "enum": [
            "exponential_backoff",
            "linear_backoff",
            "fixed_delay",
            "no_retry"
          ],
          "description": "Retry strategy"
        },
        "maxAttempts": {
          "default": 3,
          "description": "Maximum retry attempts",
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "initialDelayMs": {
          "default": 1000,
          "description": "Initial retry delay in ms",
          "type": "number",
          "minimum": 100
        },
        "maxDelayMs": {
          "default": 60000,
          "description": "Maximum retry delay in ms",
          "type": "number",
          "minimum": 1000
        },
        "backoffMultiplier": {
          "default": 2,
          "description": "Exponential backoff multiplier",
          "type": "number",
          "minimum": 1
        },
        "retryableStatusCodes": {
          "default": [
            408,
            429,
            500,
            502,
            503,
            504
          ],
          "description": "HTTP status codes to retry",
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "retryOnNetworkError": {
          "default": true,
          "description": "Retry on network errors",
          "type": "boolean"
        },
        "jitter": {
          "default": true,
          "description": "Add jitter to retry delays",
          "type": "boolean"
        }
      },
      "required": [
        "strategy",
        "maxAttempts",
        "initialDelayMs",
        "maxDelayMs",
        "backoffMultiplier",
        "retryableStatusCodes",
        "retryOnNetworkError",
        "jitter"
      ],
      "additionalProperties": false
    },
    "connectionTimeoutMs": {
      "default": 30000,
      "description": "Connection timeout in ms",
      "type": "number",
      "minimum": 1000,
      "maximum": 300000
    },
    "requestTimeoutMs": {
      "default": 30000,
      "description": "Request timeout in ms",
      "type": "number",
      "minimum": 1000,
      "maximum": 300000
    },
    "status": {
      "default": "inactive",
      "description": "Connector status",
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "error",
        "configuring"
      ]
    },
    "enabled": {
      "default": true,
      "description": "Enable connector",
      "type": "boolean"
    },
    "errorMapping": {
      "description": "Error mapping configuration",
      "type": "object",
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sourceCode": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  }
                ],
                "description": "External system error code"
              },
              "sourceMessage": {
                "description": "Pattern to match against error message",
                "type": "string"
              },
              "targetCode": {
                "type": "string",
                "description": "ObjectStack standard error code"
              },
              "targetCategory": {
                "type": "string",
                "enum": [
                  "validation",
                  "authorization",
                  "not_found",
                  "conflict",
                  "rate_limit",
                  "timeout",
                  "server_error",
                  "integration_error"
                ],
                "description": "Error category"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "critical"
                ],
                "description": "Error severity level"
              },
              "retryable": {
                "type": "boolean",
                "description": "Whether the error is retryable"
              },
              "userMessage": {
                "description": "Human-readable message to show users",
                "type": "string"
              }
            },
            "required": [
              "sourceCode",
              "targetCode",
              "targetCategory",
              "severity",
              "retryable"
            ],
            "additionalProperties": false,
            "description": "Error mapping rule"
          },
          "description": "Error mapping rules"
        },
        "defaultCategory": {
          "default": "integration_error",
          "description": "Default category for unmapped errors",
          "type": "string",
          "enum": [
            "validation",
            "authorization",
            "not_found",
            "conflict",
            "rate_limit",
            "timeout",
            "server_error",
            "integration_error"
          ]
        },
        "unmappedBehavior": {
          "type": "string",
          "enum": [
            "passthrough",
            "generic_error",
            "throw"
          ],
          "description": "What to do with unmapped errors"
        },
        "logUnmapped": {
          "default": true,
          "description": "Log unmapped errors",
          "type": "boolean"
        }
      },
      "required": [
        "rules",
        "defaultCategory",
        "unmappedBehavior",
        "logUnmapped"
      ],
      "additionalProperties": false
    },
    "health": {
      "description": "Health and resilience configuration",
      "type": "object",
      "properties": {
        "healthCheck": {
          "description": "Health check configuration",
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable health checks"
            },
            "intervalMs": {
              "default": 60000,
              "description": "Health check interval in milliseconds",
              "type": "number"
            },
            "timeoutMs": {
              "default": 5000,
              "description": "Health check timeout in milliseconds",
              "type": "number"
            },
            "endpoint": {
              "description": "Health check endpoint path",
              "type": "string"
            },
            "method": {
              "description": "HTTP method for health check",
              "type": "string",
              "enum": [
                "GET",
                "HEAD",
                "OPTIONS"
              ]
            },
            "expectedStatus": {
              "default": 200,
              "description": "Expected HTTP status code",
              "type": "number"
            },
            "unhealthyThreshold": {
              "default": 3,
              "description": "Consecutive failures before marking unhealthy",
              "type": "number"
            },
            "healthyThreshold": {
              "default": 1,
              "description": "Consecutive successes before marking healthy",
              "type": "number"
            }
          },
          "required": [
            "enabled",
            "intervalMs",
            "timeoutMs",
            "expectedStatus",
            "unhealthyThreshold",
            "healthyThreshold"
          ],
          "additionalProperties": false
        },
        "circuitBreaker": {
          "description": "Circuit breaker configuration",
          "type": "object",
