{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "preferences": {
      "type": "object",
      "properties": {
        "email": {
          "default": true,
          "description": "Receive email notifications",
          "type": "boolean"
        },
        "push": {
          "default": true,
          "description": "Receive push notifications",
          "type": "boolean"
        },
        "inApp": {
          "default": true,
          "description": "Receive in-app notifications",
          "type": "boolean"
        },
        "digest": {
          "default": "none",
          "description": "Email digest frequency",
          "type": "string",
          "enum": [
            "none",
            "daily",
            "weekly"
          ]
        },
        "channels": {
          "description": "Per-channel notification preferences",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "enabled": {
                "default": true,
                "description": "Whether this channel is enabled",
                "type": "boolean"
              },
              "email": {
                "description": "Override email setting",
                "type": "boolean"
              },
              "push": {
                "description": "Override push setting",
                "type": "boolean"
              }
            },
            "required": [
              "enabled"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "email",
        "push",
        "inApp",
        "digest"
      ],
      "additionalProperties": false,
      "description": "Current notification preferences"
    }
  },
  "required": [
    "preferences"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/GetNotificationPreferencesResponse.json",
  "x-spec-version": "3.0.11"
}