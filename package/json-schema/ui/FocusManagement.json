{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tabOrder": {
      "default": "auto",
      "description": "Tab order strategy: auto (DOM order) or manual (explicit tabIndex)",
      "type": "string",
      "enum": [
        "auto",
        "manual"
      ]
    },
    "skipLinks": {
      "default": false,
      "description": "Provide skip-to-content navigation links",
      "type": "boolean"
    },
    "focusVisible": {
      "default": true,
      "description": "Show visible focus indicators for keyboard users",
      "type": "boolean"
    },
    "focusTrap": {
      "description": "Focus trap settings",
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "description": "Enable focus trapping within this container",
          "type": "boolean"
        },
        "initialFocus": {
          "description": "CSS selector for the element to focus on activation",
          "type": "string"
        },
        "returnFocus": {
          "default": true,
          "description": "Return focus to trigger element on deactivation",
          "type": "boolean"
        },
        "escapeDeactivates": {
          "default": true,
          "description": "Allow Escape key to deactivate the focus trap",
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "returnFocus",
        "escapeDeactivates"
      ],
      "additionalProperties": false
    },
    "arrowNavigation": {
      "default": false,
      "description": "Enable arrow key navigation between focusable items",
      "type": "boolean"
    }
  },
  "required": [
    "tabOrder",
    "skipLinks",
    "focusVisible",
    "arrowNavigation"
  ],
  "additionalProperties": false,
  "description": "Focus and tab navigation management",
  "$id": "https://schema.objectstack.io/v3.0.11/ui/FocusManagement.json",
  "x-spec-version": "3.0.11"
}