{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "function": {
      "type": "string",
      "enum": [
        "count",
        "sum",
        "avg",
        "min",
        "max",
        "count_distinct",
        "array_agg",
        "string_agg"
      ],
      "description": "Aggregation function"
    },
    "field": {
      "description": "Field to aggregate (optional for COUNT(*))",
      "type": "string"
    },
    "alias": {
      "type": "string",
      "description": "Result column alias"
    },
    "distinct": {
      "description": "Apply DISTINCT before aggregation",
      "type": "boolean"
    },
    "filter": {
      "description": "Filter/Condition to apply to the aggregation (FILTER WHERE clause)",
      "$ref": "#/$defs/__schema0"
    }
  },
  "required": [
    "function",
    "alias"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "allOf": [
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "$and": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            },
            "$or": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            },
            "$not": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "$id": "https://schema.objectstack.io/v3.0.11/data/AggregationNode.json",
  "x-spec-version": "3.0.11"
}