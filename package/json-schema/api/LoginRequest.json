{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "default": "email",
      "description": "Login method",
      "type": "string",
      "enum": [
        "email",
        "username",
        "phone",
        "magic-link",
        "social"
      ]
    },
    "email": {
      "description": "Required for email/magic-link",
      "type": "string",
      "format": "email",
      "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
    },
    "username": {
      "description": "Required for username login",
      "type": "string"
    },
    "password": {
      "description": "Required for password login",
      "type": "string"
    },
    "provider": {
      "description": "Required for social (google, github)",
      "type": "string"
    },
    "redirectTo": {
      "description": "Redirect URL after successful login",
      "type": "string"
    }
  },
  "required": [
    "type"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/LoginRequest.json",
  "x-spec-version": "3.0.11"
}