{
  "name": "hotcrm",
  "version": "5.0.0",
  "description": "HotCRM - Production CRM built on ObjectStack",
  "license": "Apache-2.0",
  "private": true,
  "main": "./objectstack.config.ts",
  "types": "./objectstack.config.ts",
  "exports": {
    ".": "./objectstack.config.ts",
    "./objectstack.config": "./objectstack.config.ts"
  },
  "scripts": {
    "dev": "objectstack dev -p 4001",
    "start": "objectstack start -p 4001",
    "build": "objectstack build",
    "typecheck": "tsc --noEmit",
    "validate": "objectstack validate",
    "lint": "objectstack lint --strict",
    "lint:i18n-gate": "node scripts/check-lint-i18n-gate.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "hygiene": "node scripts/check-source-hygiene.mjs",
    "hygiene:tokens": "node scripts/check-source-token-ratchet.mjs",
    "reconcile:analytics": "tsx scripts/analytics-reconcile/run.ts",
    "verify": "pnpm validate && pnpm typecheck && pnpm lint && pnpm lint:i18n-gate && pnpm hygiene && pnpm hygiene:tokens && pnpm build && pnpm test",
    "changeset": "changeset",
    "changeset:version": "node scripts/changeset-version.mjs",
    "changeset:status": "changeset status --since=origin/main",
    "publish:marketplace": "node scripts/publish-marketplace.mjs",
    "publish:marketplace:dry-run": "DRY_RUN=1 node scripts/publish-marketplace.mjs",
    "demo:reset": "rm -rf .objectstack/data && pnpm build && echo '✅ DB reset — start the server with: pnpm dev (or pnpm start). Seed data loads on first boot, then run: pnpm demo:staff'",
    "demo:staff": "tsx scripts/demo-staff.ts",
    "backfill:owner": "tsx scripts/backfill-owner-id.ts"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@objectstack/account": "18.0.0-next.3",
    "@objectstack/cli": "18.0.0-next.3",
    "@objectstack/core": "18.0.0-next.3",
    "@objectstack/driver-sql": "18.0.0-next.3",
    "@objectstack/driver-sqlite-wasm": "18.0.0-next.3",
    "@objectstack/metadata": "18.0.0-next.3",
    "@objectstack/objectql": "18.0.0-next.3",
    "@objectstack/platform-objects": "18.0.0-next.3",
    "@objectstack/plugin-approvals": "18.0.0-next.3",
    "@objectstack/plugin-auth": "18.0.0-next.3",
    "@objectstack/plugin-security": "18.0.0-next.3",
    "@objectstack/plugin-sharing": "18.0.0-next.3",
    "@objectstack/runtime": "18.0.0-next.3",
    "@objectstack/service-analytics": "18.0.0-next.3",
    "@objectstack/service-automation": "18.0.0-next.3",
    "@objectstack/service-messaging": "18.0.0-next.3",
    "@objectstack/service-storage": "18.0.0-next.3",
    "@objectstack/spec": "18.0.0-next.3",
    "@objectstack/trigger-record-change": "18.0.0-next.3"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@objectstack/formula": "18.0.0-next.3",
    "@objectstack/plugin-audit": "18.0.0-next.3",
    "@objectstack/plugin-email": "18.0.0-next.3",
    "@objectstack/verify": "18.0.0-next.3",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^4.1.10",
    "fumadocs-core": "16.15.14",
    "remark": "^15.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx": "^3.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": "^22.11 || ^24 || >=26",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "msw"
    ]
  }
}
