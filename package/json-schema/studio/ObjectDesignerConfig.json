      "description": "Object manager configuration",
      "type": "object",
      "properties": {
        "defaultDisplayMode": {
          "default": "table",
          "description": "Default list display mode",
          "type": "string",
          "enum": [
            "table",
            "cards",
            "tree"
          ]
        },
        "defaultSortField": {
          "default": "label",
          "description": "Default sort field",
          "type": "string",
          "enum": [
            "name",
            "label",
            "fieldCount",
            "updatedAt"
          ]
        },
        "defaultSortDirection": {
          "default": "asc",
          "description": "Default sort direction",
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ]
        },
        "defaultFilter": {
          "default": {
            "includeSystem": false,
            "includeAbstract": false
          },
          "description": "Default filter configuration",
          "type": "object",
          "properties": {
            "package": {
              "description": "Filter by owning package",
              "type": "string"
            },
            "tags": {
              "description": "Filter by object tags",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "includeSystem": {
              "default": false,
              "description": "Include system-level objects",
              "type": "boolean"
            },
            "includeAbstract": {
              "default": false,
              "description": "Include abstract base objects",
              "type": "boolean"
            },
            "hasFieldType": {
              "description": "Filter to objects containing a specific field type",
              "type": "string"
            },
            "hasRelationships": {
              "description": "Filter to objects with lookup/master_detail fields",
              "type": "boolean"
            },
            "searchQuery": {
              "description": "Free-text search across name, label, and description",
              "type": "string"
            }
          },
          "required": [
            "includeSystem",
            "includeAbstract"
          ],
          "additionalProperties": false
        },
        "showFieldCount": {
          "default": true,
          "description": "Show field count badge",
          "type": "boolean"
        },
        "showRelationshipCount": {
          "default": true,
          "description": "Show relationship count badge",
          "type": "boolean"
        },
        "showQuickPreview": {
          "default": true,
          "description": "Show quick field preview tooltip on hover",
          "type": "boolean"
        },
        "enableComparison": {
          "default": false,
          "description": "Enable side-by-side object comparison",
          "type": "boolean"
        },
        "showERDiagramToggle": {
          "default": true,
          "description": "Show ER diagram toggle in toolbar",
          "type": "boolean"
        },
        "showCreateAction": {
          "default": true,
          "description": "Show create object action",
          "type": "boolean"
        },
        "showStatsSummary": {
          "default": true,
          "description": "Show statistics summary bar",
          "type": "boolean"
        }
      },
      "required": [
        "defaultDisplayMode",
        "defaultSortField",
        "defaultSortDirection",
        "defaultFilter",
        "showFieldCount",
        "showRelationshipCount",
        "showQuickPreview",
        "enableComparison",
        "showERDiagramToggle",
        "showCreateAction",
        "showStatsSummary"
      ],
      "additionalProperties": false
    },
