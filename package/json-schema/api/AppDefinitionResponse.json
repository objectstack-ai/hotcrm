                "type": "string"
              },
              "requiredPermissions": {
                "description": "Permissions required to access this area",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "navigation": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema0"
