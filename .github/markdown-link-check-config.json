{
  "retryOn429": true,
  "retryCount": 3,
  "fallbackRetryDelay": "10s",
  "aliveStatusCodes": [200, 206, 301, 302, 307, 308],
  "ignorePatterns": [
    {
      "pattern": "^https://github.com/objectstack-ai/hotcrm/(actions|workflows|releases)"
    },
    {
      "pattern": "^https://img.shields.io/"
    },
    {
      "pattern": "^https?://localhost"
    }
  ],
  "replacementPatterns": [
    {
      "pattern": "^\\./(crm_service_[a-z_]+\\.md)$",
      "replacement": "{{BASEURL}}/src/service/docs/$1"
    },
    {
      "pattern": "^\\./(crm_revenue_[a-z_]+\\.md)$",
      "replacement": "{{BASEURL}}/src/revenue/docs/$1"
    },
    {
      "pattern": "^\\./(crm_overview\\.md)$",
      "replacement": "{{BASEURL}}/src/docs/$1"
    },
    {
      "pattern": "^\\./(crm_sales_[a-z_]+\\.md)$",
      "replacement": "{{BASEURL}}/src/docs/$1"
    },
    {
      "pattern": "^\\./(crm_admin_[a-z_]+\\.md)$",
      "replacement": "{{BASEURL}}/src/docs/$1"
    },
    {
      "pattern": "^\\./(crm_getting_[a-z_]+\\.md)$",
      "replacement": "{{BASEURL}}/src/docs/$1"
    },
    {
      "pattern": "^\\./(crm_analytics_[a-z_]+\\.md)$",
      "replacement": "{{BASEURL}}/src/docs/$1"
    },
    {
      "pattern": "^\\./(crm_ai_[a-z_]+\\.md)$",
      "replacement": "{{BASEURL}}/src/docs/$1"
    }
  ]
}
