        },
        "required": [
          "timeLength",
          "timeUnit",
          "offsetDirection",
          "offsetFrom",
          "actions"
        ],
        "additionalProperties": false
      }
    },
    "active": {
      "default": true,
      "description": "Whether this workflow is active",
      "type": "boolean"
    },
    "executionOrder": {
      "default": 100,
      "description": "Deterministic execution order when multiple workflows match (lower runs first)",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reevaluateOnChange": {
      "default": false,
      "description": "Re-evaluate rule if field updates change the record validity",
      "type": "boolean"
    }
  },
  "required": [
    "name",
    "objectName",
    "triggerType",
    "active",
    "executionOrder",
    "reevaluateOnChange"
