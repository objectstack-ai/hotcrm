{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": true,
      "description": "Enable CORS",
      "type": "boolean"
    },
    "origins": {
      "default": "*",
      "description": "Allowed origins (* for all)",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "methods": {
      "description": "Allowed HTTP methods",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "GET",
          "POST",
          "PUT",
          "DELETE",
          "PATCH",
          "HEAD",
          "OPTIONS"
        ]
      }
    },
    "credentials": {
      "default": false,
      "description": "Allow credentials (cookies, authorization headers)",
      "type": "boolean"
    },
    "maxAge": {
      "description": "Preflight cache duration in seconds",
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "enabled",
    "origins",
    "credentials"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/shared/CorsConfig.json",
  "x-spec-version": "3.0.11"
}