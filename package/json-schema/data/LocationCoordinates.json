{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90,
      "description": "Latitude coordinate"
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180,
      "description": "Longitude coordinate"
    },
    "altitude": {
      "description": "Altitude in meters",
      "type": "number"
    },
    "accuracy": {
      "description": "Accuracy in meters",
      "type": "number"
    }
  },
  "required": [
    "latitude",
    "longitude"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/data/LocationCoordinates.json",
  "x-spec-version": "3.0.11"
}