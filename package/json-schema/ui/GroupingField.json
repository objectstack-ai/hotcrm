{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "field": {
      "type": "string",
      "description": "Field name to group by"
    },
    "order": {
      "default": "asc",
      "description": "Group sort order",
      "type": "string",
      "enum": [
        "asc",
        "desc"
      ]
    },
    "collapsed": {
      "default": false,
      "description": "Collapse groups by default",
      "type": "boolean"
    }
  },
  "required": [
    "field",
    "order",
    "collapsed"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ui/GroupingField.json",
  "x-spec-version": "3.0.11"
}