{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "trustedRanges": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "CIDR ranges allowed to access (e.g. 10.0.0.0/8)"
    },
    "blockUnknown": {
      "default": false,
      "description": "Block all IPs not in trusted ranges",
      "type": "boolean"
    },
    "vpnRequired": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "trustedRanges",
    "blockUnknown",
    "vpnRequired"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/security/NetworkPolicy.json",
  "x-spec-version": "3.0.11"
}