{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sdkVersion": {
      "description": "OTel SDK version",
      "type": "string"
    },
    "exporter": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "otlp_http",
            "otlp_grpc",
            "jaeger",
            "zipkin",
            "console",
            "datadog",
            "honeycomb",
            "lightstep",
            "newrelic",
            "custom"
          ],
          "description": "Exporter type"
        },
        "endpoint": {
          "description": "Exporter endpoint",
          "type": "string",
          "format": "uri"
        },
        "protocol": {
          "description": "Protocol version",
          "type": "string"
        },
        "headers": {
          "description": "HTTP headers",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "timeout": {
          "default": 10000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "compression": {
          "default": "none",
          "type": "string",
          "enum": [
            "none",
            "gzip"
          ]
        },
        "batch": {
          "type": "object",
          "properties": {
            "maxBatchSize": {
              "default": 512,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxQueueSize": {
              "default": 2048,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "exportTimeout": {
              "default": 30000,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "scheduledDelay": {
              "default": 5000,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "maxBatchSize",
            "maxQueueSize",
            "exportTimeout",
            "scheduledDelay"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "timeout",
        "compression"
      ],
      "additionalProperties": false,
      "description": "Exporter configuration"
    },
    "resource": {
      "type": "object",
      "properties": {
        "serviceName": {
          "type": "string",
          "description": "Service name"
        },
        "serviceVersion": {
          "description": "Service version",
          "type": "string"
        },
        "serviceInstanceId": {
          "description": "Service instance ID",
          "type": "string"
        },
        "serviceNamespace": {
          "description": "Service namespace",
          "type": "string"
        },
        "deploymentEnvironment": {
          "description": "Deployment environment",
          "type": "string"
        },
        "attributes": {
          "description": "Additional resource attributes",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              {
                "type": "array",
                "items": {
                  "type": "boolean"
                }
              }
            ],
            "description": "Span attribute value"
          }
        }
      },
      "required": [
        "serviceName"
      ],
      "additionalProperties": false,
      "description": "Resource attributes"
    },
    "instrumentation": {
      "type": "object",
      "properties": {
        "autoInstrumentation": {
          "default": true,
          "type": "boolean"
        },
        "libraries": {
          "description": "Enabled libraries",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disabledLibraries": {
          "description": "Disabled libraries",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "autoInstrumentation"
      ],
      "additionalProperties": false
    },
    "semanticConventionsVersion": {
      "description": "Semantic conventions version",
      "type": "string"
    }
  },
  "required": [
    "exporter",
    "resource"
  ],
  "additionalProperties": false,
  "description": "OpenTelemetry compatibility configuration",
  "$id": "https://schema.objectstack.io/v3.0.11/system/OpenTelemetryCompatibility.json",
  "x-spec-version": "3.0.11"
}