{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Webhook unique name (lowercase snake_case)"
    },
    "label": {
      "description": "Human-readable webhook label",
      "type": "string"
    },
    "object": {
      "description": "Object to listen to (optional for manual webhooks)",
      "type": "string"
    },
    "triggers": {
      "description": "Events that trigger execution",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "create",
          "update",
          "delete",
          "undelete",
          "api"
        ]
      }
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "External webhook endpoint URL"
    },
    "method": {
      "default": "POST",
      "description": "HTTP method",
      "type": "string",
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ]
    },
    "headers": {
      "description": "Custom HTTP headers",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "body": {
      "description": "Request body payload (if not using default record data)"
    },
    "payloadFields": {
      "description": "Fields to include. Empty = All",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "includeSession": {
      "default": false,
      "description": "Include user session info",
      "type": "boolean"
    },
    "authentication": {
      "description": "Authentication configuration",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "none",
            "bearer",
            "basic",
            "api-key"
          ],
          "description": "Authentication type"
        },
        "credentials": {
          "description": "Authentication credentials",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "retryPolicy": {
      "description": "Retry policy configuration",
      "type": "object",
      "properties": {
        "maxRetries": {
          "default": 3,
          "description": "Maximum retry attempts",
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "backoffStrategy": {
          "default": "exponential",
          "description": "Backoff strategy",
          "type": "string",
          "enum": [
            "exponential",
            "linear",
            "fixed"
          ]
        },
        "initialDelayMs": {
          "default": 1000,
          "description": "Initial retry delay in milliseconds",
          "type": "integer",
          "minimum": 100,
          "maximum": 9007199254740991
        },
        "maxDelayMs": {
          "default": 60000,
          "description": "Maximum retry delay in milliseconds",
          "type": "integer",
          "minimum": 1000,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "maxRetries",
        "backoffStrategy",
        "initialDelayMs",
        "maxDelayMs"
      ],
      "additionalProperties": false
    },
    "timeoutMs": {
      "default": 30000,
      "description": "Request timeout in milliseconds",
      "type": "integer",
      "minimum": 1000,
      "maximum": 300000
    },
    "secret": {
      "description": "Signing secret for HMAC signature verification",
      "type": "string"
    },
    "isActive": {
      "default": true,
      "description": "Whether webhook is active",
      "type": "boolean"
    },
    "description": {
      "description": "Webhook description",
      "type": "string"
    },
    "tags": {
      "description": "Tags for organization",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "events": {
      "description": "Connector events to subscribe to",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "record.created",
          "record.updated",
          "record.deleted",
          "sync.started",
          "sync.completed",
          "sync.failed",
          "auth.expired",
          "rate_limit.exceeded"
        ],
        "description": "Webhook event type"
      }
    },
    "signatureAlgorithm": {
      "default": "hmac_sha256",
      "type": "string",
      "enum": [
        "hmac_sha256",
        "hmac_sha512",
        "none"
      ],
      "description": "Webhook signature algorithm"
    }
  },
  "required": [
    "name",
    "url",
    "method",
    "includeSession",
    "timeoutMs",
    "isActive",
    "signatureAlgorithm"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/integration/WebhookConfig.json",
  "x-spec-version": "3.0.11"
}