{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": false,
      "type": "boolean"
    },
    "model": {
      "description": "Reranking model name",
      "type": "string"
    },
    "provider": {
      "type": "string",
      "enum": [
        "cohere",
        "huggingface",
        "custom"
      ]
    },
    "topK": {
      "default": 3,
      "description": "Final number of results after reranking",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "enabled",
    "topK"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/RerankingConfig.json",
  "x-spec-version": "3.0.11"
}