{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "transport": {
      "description": "Preferred transport protocol",
      "type": "string",
      "enum": [
        "websocket",
        "sse",
        "polling"
      ]
    },
    "channels": {
      "description": "Channels to subscribe to on connect",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "token": {
      "description": "Authentication token",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/RealtimeConnectRequest.json",
  "x-spec-version": "3.0.11"
}