{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "description": "Logger name identifier",
      "type": "string"
    },
    "level": {
      "default": "info",
      "type": "string",
      "enum": [
        "debug",
        "info",
        "warn",
        "error",
        "fatal",
        "silent"
      ],
      "description": "Log severity level"
    },
    "format": {
      "default": "json",
      "type": "string",
      "enum": [
        "json",
        "text",
        "pretty"
      ],
      "description": "Log output format"
    },
    "redact": {
      "default": [
        "password",
        "token",
        "secret",
        "key"
      ],
      "description": "Keys to redact from log context",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourceLocation": {
      "default": false,
      "description": "Include file and line number",
      "type": "boolean"
    },
    "file": {
      "description": "Path to log file",
      "type": "string"
    },
    "rotation": {
      "type": "object",
      "properties": {
        "maxSize": {
          "default": "10m",
          "type": "string"
        },
        "maxFiles": {
          "default": 5,
          "type": "number"
        }
      },
      "required": [
        "maxSize",
        "maxFiles"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "level",
    "format",
    "redact",
    "sourceLocation"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/system/LoggerConfig.json",
  "x-spec-version": "3.0.11"
}