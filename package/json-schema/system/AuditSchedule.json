{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique audit schedule identifier"
    },
    "title": {
      "type": "string",
      "description": "Audit title"
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Audit scope areas"
    },
    "framework": {
      "type": "string",
      "enum": [
        "gdpr",
        "hipaa",
        "sox",
        "pci_dss",
        "ccpa",
        "iso27001"
      ],
      "description": "Target compliance framework"
    },
    "scheduledAt": {
      "type": "number",
      "description": "Scheduled audit timestamp"
    },
    "completedAt": {
      "description": "Completion timestamp",
      "type": "number"
    },
    "assessor": {
      "type": "string",
      "description": "Assessor or audit team"
    },
    "isExternal": {
      "default": false,
      "description": "Whether this is an external audit",
      "type": "boolean"
    },
    "recurrenceMonths": {
      "default": 0,
      "description": "Recurrence interval in months (0 = one-time)",
      "type": "number"
    },
    "findings": {
      "description": "Audit findings",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique finding identifier"
          },
          "title": {
            "type": "string",
            "description": "Finding title"
          },
          "description": {
            "type": "string",
            "description": "Finding description"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "major",
              "minor",
              "observation"
            ],
            "description": "Finding severity"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "in_remediation",
              "remediated",
              "verified",
              "accepted_risk",
              "closed"
            ],
            "description": "Finding status"
          },
          "controlReference": {
            "description": "ISO 27001 control reference",
            "type": "string"
          },
          "framework": {
            "description": "Related compliance framework",
            "type": "string",
            "enum": [
              "gdpr",
              "hipaa",
              "sox",
              "pci_dss",
              "ccpa",
              "iso27001"
            ]
          },
          "identifiedAt": {
            "type": "number",
            "description": "Identification timestamp"
          },
          "identifiedBy": {
            "type": "string",
            "description": "Identifier (auditor name or system)"
          },
          "remediationPlan": {
            "description": "Remediation plan",
            "type": "string"
          },
          "remediationDeadline": {
            "description": "Remediation deadline timestamp",
            "type": "number"
          },
          "verifiedAt": {
            "description": "Verification timestamp",
            "type": "number"
          },
          "verifiedBy": {
            "description": "Verifier name or role",
            "type": "string"
          },
          "notes": {
            "description": "Additional notes",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "severity",
          "status",
          "identifiedAt",
          "identifiedBy"
        ],
        "additionalProperties": false,
        "description": "Audit finding with remediation tracking per ISO 27001:2022 A.5.35"
      }
    }
  },
  "required": [
    "id",
    "title",
    "scope",
    "framework",
    "scheduledAt",
    "assessor",
    "isExternal",
    "recurrenceMonths"
  ],
  "additionalProperties": false,
  "description": "Audit schedule for independent security reviews per ISO 27001:2022 A.5.35",
  "$id": "https://schema.objectstack.io/v3.0.11/system/AuditSchedule.json",
  "x-spec-version": "3.0.11"
}