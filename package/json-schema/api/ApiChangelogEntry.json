{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "API version"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
      "description": "Release date"
    },
    "changes": {
      "type": "object",
      "properties": {
        "added": {
          "default": [],
          "description": "New features",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changed": {
          "default": [],
          "description": "Changes",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deprecated": {
          "default": [],
          "description": "Deprecations",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "default": [],
          "description": "Removed features",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fixed": {
          "default": [],
          "description": "Bug fixes",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "security": {
          "default": [],
          "description": "Security fixes",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "added",
        "changed",
        "deprecated",
        "removed",
        "fixed",
        "security"
      ],
      "additionalProperties": false,
      "description": "Version changes"
    },
    "migrationGuide": {
      "description": "Migration guide URL or text",
      "type": "string"
    }
  },
  "required": [
    "version",
    "date",
    "changes"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/ApiChangelogEntry.json",
  "x-spec-version": "3.0.11"
}