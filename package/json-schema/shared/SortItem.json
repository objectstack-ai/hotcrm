{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "field": {
      "type": "string",
      "description": "Field name to sort by"
    },
    "order": {
      "type": "string",
      "enum": [
        "asc",
        "desc"
      ],
      "description": "Sort direction"
    }
  },
  "required": [
    "field",
    "order"
  ],
  "additionalProperties": false,
  "description": "Sort field and direction pair",
  "$id": "https://schema.objectstack.io/v3.0.11/shared/SortItem.json",
  "x-spec-version": "3.0.11"
}