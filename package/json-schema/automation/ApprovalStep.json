{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Step machine name"
    },
    "label": {
      "type": "string",
      "description": "Step display label"
    },
    "description": {
      "type": "string"
    },
    "entryCriteria": {
      "description": "Formula expression to enter this step",
      "type": "string"
    },
    "approvers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "user",
              "role",
              "manager",
              "field",
              "queue"
            ]
          },
          "value": {
            "type": "string",
            "description": "User ID, Role Name, or Field Name"
          }
        },
        "required": [
          "type",
          "value"
        ],
        "additionalProperties": false
      },
      "description": "List of allowed approvers"
    },
    "behavior": {
      "default": "first_response",
      "description": "How to handle multiple approvers",
      "type": "string",
      "enum": [
        "first_response",
        "unanimous"
      ]
    },
    "rejectionBehavior": {
      "default": "reject_process",
      "description": "What happens if rejected",
      "type": "string",
      "enum": [
        "reject_process",
        "back_to_previous"
      ]
    },
    "onApprove": {
      "description": "Actions on step approval",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "field_update",
              "email_alert",
              "webhook",
              "script",
              "connector_action"
            ]
          },
          "name": {
            "type": "string",
            "description": "Action name"
          },
          "config": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {},
            "description": "Action configuration"
          },
          "connectorId": {
            "type": "string"
          },
          "actionId": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "name",
          "config"
        ],
        "additionalProperties": false
      }
    },
    "onReject": {
      "description": "Actions on step rejection",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "field_update",
              "email_alert",
              "webhook",
              "script",
              "connector_action"
            ]
          },
          "name": {
            "type": "string",
            "description": "Action name"
          },
          "config": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {},
            "description": "Action configuration"
          },
          "connectorId": {
            "type": "string"
          },
          "actionId": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "name",
          "config"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name",
    "label",
    "approvers",
    "behavior",
    "rejectionBehavior"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/automation/ApprovalStep.json",
  "x-spec-version": "3.0.11"
}