{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_.]*$",
      "description": "Feature code (e.g. core.api_access)"
    },
    "label": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "default": "boolean",
      "type": "string",
      "enum": [
        "boolean",
        "counter",
        "gauge"
      ],
      "description": "License metric type"
    },
    "unit": {
      "type": "string",
      "enum": [
        "count",
        "bytes",
        "seconds",
        "percent"
      ]
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "code",
    "label",
    "type"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/system/Feature.json",
  "x-spec-version": "3.0.11"
}