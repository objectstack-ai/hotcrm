{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "patterns": {
      "description": "File glob patterns",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ifNoneMatch": {
      "description": "ETag for conditional request",
      "type": "string"
    },
    "ifModifiedSince": {
      "description": "Only load if modified after this date",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "validate": {
      "default": true,
      "description": "Validate against schema",
      "type": "boolean"
    },
    "useCache": {
      "default": true,
      "description": "Enable caching",
      "type": "boolean"
    },
    "filter": {
      "description": "Filter predicate as string",
      "type": "string"
    },
    "limit": {
      "description": "Maximum items to load",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "recursive": {
      "default": true,
      "description": "Search subdirectories",
      "type": "boolean"
    }
  },
  "required": [
    "validate",
    "useCache",
    "recursive"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/MetadataLoadOptions.json",
  "x-spec-version": "3.0.11"
}