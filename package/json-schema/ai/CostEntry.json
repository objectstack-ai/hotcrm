{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique cost entry ID"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "description": "ISO 8601 timestamp"
    },
    "modelId": {
      "type": "string",
      "description": "AI model used"
    },
    "provider": {
      "type": "string",
      "description": "AI provider (e.g., \"openai\", \"anthropic\")"
    },
    "operation": {
      "type": "string",
      "description": "Operation type (e.g., \"chat_completion\", \"embedding\")"
    },
    "tokens": {
      "description": "Standardized token usage",
      "type": "object",
      "properties": {
        "prompt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Input tokens"
        },
        "completion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Output tokens"
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Total tokens"
        }
      },
      "required": [
        "prompt",
        "completion",
        "total"
      ],
      "additionalProperties": false
    },
    "requestCount": {
      "default": 1,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "promptCost": {
      "description": "Cost of prompt tokens",
      "type": "number",
      "minimum": 0
    },
    "completionCost": {
      "description": "Cost of completion tokens",
      "type": "number",
      "minimum": 0
    },
    "totalCost": {
      "type": "number",
      "minimum": 0,
      "description": "Total cost in base currency"
    },
    "currency": {
      "default": "USD",
      "type": "string"
    },
    "sessionId": {
      "description": "Conversation session ID",
      "type": "string"
    },
    "userId": {
      "description": "User who triggered the request",
      "type": "string"
    },
    "agentId": {
      "description": "AI agent ID",
      "type": "string"
    },
    "object": {
      "description": "Related object (e.g., \"case\", \"project\")",
      "type": "string"
    },
    "recordId": {
      "description": "Related record ID",
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "id",
    "timestamp",
    "modelId",
    "provider",
    "operation",
    "requestCount",
    "totalCost",
    "currency"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/CostEntry.json",
  "x-spec-version": "3.0.11"
}