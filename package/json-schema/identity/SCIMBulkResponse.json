              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ],
            "description": "HTTP method that was executed"
          },
          "bulkId": {
            "description": "Client-assigned bulk operation ID",
            "type": "string"
          },
          "location": {
            "description": "URL of the created or modified resource",
            "type": "string"
          },
          "status": {
            "type": "string",
