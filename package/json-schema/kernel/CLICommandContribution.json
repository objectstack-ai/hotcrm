{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "CLI command name"
    },
    "description": {
      "description": "Command description for help text",
      "type": "string"
    },
    "module": {
      "description": "Module path exporting oclif Command classes",
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/CLICommandContribution.json",
  "x-spec-version": "3.0.11"
}