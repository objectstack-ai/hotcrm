{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Model Name (e.g. FY24 Planning)"
    },
    "state": {
      "default": "planning",
      "type": "string",
      "enum": [
        "planning",
        "active",
        "archived"
      ]
    },
    "startDate": {
      "type": "string"
    },
    "endDate": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "state"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/security/TerritoryModel.json",
  "x-spec-version": "3.0.11"
}