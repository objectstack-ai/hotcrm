{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": false,
      "type": "boolean"
    },
    "scope": {
      "default": "automation-only",
      "description": "Which plugins are subject to isolation",
      "type": "string",
      "enum": [
        "automation-only",
        "untrusted-only",
        "all-plugins"
      ]
    },
    "isolationLevel": {
      "default": "none",
      "type": "string",
      "enum": [
        "none",
        "process",
        "vm",
        "iframe",
        "web-worker"
      ]
    },
    "allowedCapabilities": {
      "description": "List of allowed capability IDs",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resourceQuotas": {
      "type": "object",
      "properties": {
        "maxMemoryMB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxCpuTimeMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 9007199254740991
        },
        "maxFileDescriptors": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxNetworkKBps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "properties": {
        "allowedAPIs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowedEndpoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowedEnvVars": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "ipc": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Allow sandboxed plugins to communicate via IPC",
          "type": "boolean"
        },
        "transport": {
          "default": "message-port",
          "description": "IPC transport for cross-boundary communication",
          "type": "string",
          "enum": [
            "message-port",
            "unix-socket",
            "tcp",
            "memory"
          ]
        },
        "maxMessageSize": {
          "default": 1048576,
          "description": "Maximum IPC message size in bytes (default 1MB)",
          "type": "integer",
          "minimum": 1024,
          "maximum": 9007199254740991
        },
        "timeout": {
          "default": 30000,
          "description": "IPC message response timeout in ms",
          "type": "integer",
          "minimum": 100,
          "maximum": 9007199254740991
        },
        "allowedServices": {
          "description": "Service names the sandboxed plugin may invoke via IPC",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "enabled",
        "transport",
        "maxMessageSize",
        "timeout"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "enabled",
    "scope",
    "isolationLevel"
  ],
  "additionalProperties": false,
  "description": "Plugin sandboxing configuration",
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/PluginSandboxing.json",
  "x-spec-version": "3.0.11"
}