{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "agentId": {
      "type": "string"
    },
    "pluginId": {
      "type": "string"
    },
    "selfHealing": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "strategy": {
          "default": "moderate",
          "type": "string",
          "enum": [
            "conservative",
            "moderate",
            "aggressive"
          ]
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "restart",
                  "scale",
                  "rollback",
                  "clear-cache",
                  "adjust-config",
                  "execute-script",
                  "notify"
                ]
              },
              "trigger": {
                "type": "object",
                "properties": {
                  "healthStatus": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "healthy",
                        "degraded",
                        "unhealthy",
                        "failed",
                        "recovering",
                        "unknown"
                      ],
                      "description": "Current health status of the plugin"
                    }
                  },
                  "anomalyTypes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "errorPatterns": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "customCondition": {
                    "description": "Custom trigger condition (e.g., \"errorRate > 0.1\")",
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "parameters": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "maxAttempts": {
                "default": 3,
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "cooldown": {
                "default": 60,
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "timeout": {
                "default": 300,
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "requireApproval": {
                "default": false,
                "type": "boolean"
              },
              "priority": {
                "default": 5,
                "description": "Action priority (lower number = higher priority)",
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "type",
              "trigger",
              "maxAttempts",
              "cooldown",
              "timeout",
              "requireApproval",
              "priority"
            ],
            "additionalProperties": false
          }
        },
        "anomalyDetection": {
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "metrics": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "cpu-usage",
                  "memory-usage",
                  "response-time",
                  "error-rate",
                  "throughput",
                  "latency",
                  "connection-count",
                  "queue-depth"
                ]
              }
            },
            "algorithm": {
              "default": "hybrid",
              "type": "string",
              "enum": [
                "statistical",
                "machine-learning",
                "heuristic",
                "hybrid"
              ]
            },
            "sensitivity": {
              "default": "medium",
              "description": "How aggressively to detect anomalies",
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "timeWindow": {
              "default": 300,
              "description": "Historical data window for anomaly detection",
              "type": "integer",
              "minimum": 60,
              "maximum": 9007199254740991
            },
            "confidenceThreshold": {
              "default": 80,
              "description": "Minimum confidence to flag as anomaly",
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "alertOnDetection": {
              "default": true,
              "type": "boolean"
            }
          },
          "required": [
            "enabled",
            "metrics",
            "algorithm",
            "sensitivity",
            "timeWindow",
            "confidenceThreshold",
            "alertOnDetection"
          ],
          "additionalProperties": false
        },
        "maxConcurrentHealing": {
          "default": 1,
          "description": "Maximum number of simultaneous healing attempts",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "learning": {
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "description": "Learn from successful/failed healing attempts",
              "type": "boolean"
            },
            "feedbackLoop": {
              "default": true,
              "description": "Adjust strategy based on outcomes",
              "type": "boolean"
            }
          },
          "required": [
            "enabled",
            "feedbackLoop"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "enabled",
        "strategy",
        "actions",
        "maxConcurrentHealing"
      ],
      "additionalProperties": false
    },
    "autoScaling": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "enabled": {
            "default": false,
            "type": "boolean"
          },
          "metric": {
            "type": "string",
            "enum": [
              "cpu-usage",
              "memory-usage",
              "request-rate",
              "response-time",
              "queue-depth",
              "custom"
            ]
          },
          "customMetric": {
            "type": "string"
          },
          "targetValue": {
            "type": "number",
            "description": "Desired metric value (e.g., 70 for 70% CPU)"
          },
          "bounds": {
            "type": "object",
            "properties": {
              "minInstances": {
                "default": 1,
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "maxInstances": {
                "default": 10,
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "minResources": {
                "type": "object",
                "properties": {
                  "cpu": {
                    "description": "CPU limit (e.g., \"0.5\", \"1\")",
                    "type": "string"
                  },
                  "memory": {
                    "description": "Memory limit (e.g., \"512Mi\", \"1Gi\")",
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "maxResources": {
                "type": "object",
                "properties": {
                  "cpu": {
                    "type": "string"
                  },
                  "memory": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "minInstances",
              "maxInstances"
            ],
            "additionalProperties": false
          },
          "scaleUp": {
            "type": "object",
            "properties": {
              "threshold": {
                "type": "number",
                "description": "Metric value that triggers scale up"
              },
              "stabilizationWindow": {
                "default": 60,
                "description": "How long metric must exceed threshold",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "cooldown": {
                "default": 300,
                "description": "Minimum time between scale-up operations",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "stepSize": {
                "default": 1,
                "description": "Number of instances to add",
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "threshold",
              "stabilizationWindow",
              "cooldown",
              "stepSize"
            ],
            "additionalProperties": false
          },
          "scaleDown": {
            "type": "object",
            "properties": {
              "threshold": {
                "type": "number",
                "description": "Metric value that triggers scale down"
              },
              "stabilizationWindow": {
                "default": 300,
                "description": "How long metric must be below threshold",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "cooldown": {
                "default": 600,
                "description": "Minimum time between scale-down operations",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "stepSize": {
                "default": 1,
                "description": "Number of instances to remove",
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "threshold",
              "stabilizationWindow",
              "cooldown",
              "stepSize"
            ],
            "additionalProperties": false
          },
          "predictive": {
            "type": "object",
            "properties": {
              "enabled": {
                "default": false,
                "description": "Use ML to predict future load",
                "type": "boolean"
              },
              "lookAhead": {
                "default": 300,
                "description": "How far ahead to predict (seconds)",
                "type": "integer",
                "minimum": 60,
                "maximum": 9007199254740991
              },
              "confidence": {
                "default": 80,
                "description": "Minimum confidence for prediction-based scaling",
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": [
              "enabled",
              "lookAhead",
              "confidence"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "enabled",
          "metric",
          "targetValue",
          "bounds",
          "scaleUp",
          "scaleDown"
        ],
        "additionalProperties": false
      }
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "interval": {
          "default": 60000,
          "description": "Monitoring interval in milliseconds",
          "type": "integer",
          "minimum": 1000,
          "maximum": 9007199254740991
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "enabled",
        "interval"
      ],
      "additionalProperties": false
    },
    "optimization": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "scanInterval": {
          "default": 86400,
          "description": "How often to scan for optimization opportunities",
          "type": "integer",
          "minimum": 3600,
          "maximum": 9007199254740991
        },
        "autoApply": {
          "default": false,
          "description": "Automatically apply low-risk optimizations",
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "scanInterval",
        "autoApply"
      ],
      "additionalProperties": false
    },
    "incidentResponse": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "autoRCA": {
          "default": true,
          "type": "boolean"
        },
        "notifications": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "channel": {
                "type": "string",
                "enum": [
                  "email",
                  "slack",
                  "webhook",
                  "sms"
                ]
              },
              "config": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "channel",
              "config"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "enabled",
        "autoRCA"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "agentId",
    "pluginId"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/AIOpsAgentConfig.json",
  "x-spec-version": "3.0.11"
}