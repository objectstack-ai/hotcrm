{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Turso database group name"
    },
    "primaryLocation": {
      "type": "string",
      "minLength": 2,
      "description": "Primary Turso region code (e.g., iad, lhr, nrt)"
    },
    "replicaLocations": {
      "default": [],
      "description": "Additional replica region codes",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "schemaDatabase": {
      "description": "Schema database name for multi-db schemas",
      "type": "string"
    }
  },
  "required": [
    "name",
    "primaryLocation",
    "replicaLocations"
  ],
  "additionalProperties": false,
  "description": "Turso database group configuration",
  "$id": "https://schema.objectstack.io/v3.0.11/data/TursoGroup.json",
  "x-spec-version": "3.0.11"
}