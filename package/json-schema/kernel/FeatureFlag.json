{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Feature key (snake_case)"
    },
    "label": {
      "description": "Display label",
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "enabled": {
      "default": false,
      "description": "Is globally enabled",
      "type": "boolean"
    },
    "strategy": {
      "default": "boolean",
      "type": "string",
      "enum": [
        "boolean",
        "percentage",
        "user_list",
        "group",
        "custom"
      ]
    },
    "conditions": {
      "type": "object",
      "properties": {
        "percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "users": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expression": {
          "description": "Custom formula expression",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "default": "all",
      "description": "Environment validity",
      "type": "string",
      "enum": [
        "dev",
        "staging",
        "prod",
        "all"
      ]
    },
    "expiresAt": {
      "description": "Feature flag expiration date",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "name",
    "enabled",
    "strategy",
    "environment"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/FeatureFlag.json",
  "x-spec-version": "3.0.11"
}