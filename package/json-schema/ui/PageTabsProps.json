{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "default": "line",
      "type": "string",
      "enum": [
        "line",
        "card",
        "pill"
      ]
    },
    "position": {
      "default": "top",
      "type": "string",
      "enum": [
        "top",
        "left"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "description": "Translation key (e.g., \"views.task_list.label\")"
                  },
                  "defaultValue": {
                    "description": "Fallback value when translation key is not found",
                    "type": "string"
                  },
                  "params": {
                    "description": "Interpolation parameters (e.g., { count: 5 })",
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "key"
                ],
                "additionalProperties": false
              }
            ],
            "description": "Display label: plain string or i18n translation object"
          },
          "icon": {
            "type": "string"
          },
          "children": {
            "type": "array",
            "items": {},
            "description": "Child components"
          }
        },
        "required": [
          "label",
          "children"
        ],
        "additionalProperties": false
      }
    },
    "aria": {
      "description": "ARIA accessibility attributes",
      "type": "object",
      "properties": {
        "ariaLabel": {
          "description": "Accessible label for screen readers (WAI-ARIA aria-label)",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "description": "Translation key (e.g., \"views.task_list.label\")"
                },
                "defaultValue": {
                  "description": "Fallback value when translation key is not found",
                  "type": "string"
                },
                "params": {
                  "description": "Interpolation parameters (e.g., { count: 5 })",
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  }
                }
              },
              "required": [
                "key"
              ],
              "additionalProperties": false
            }
          ]
        },
        "ariaDescribedBy": {
          "description": "ID of element providing additional description (WAI-ARIA aria-describedby)",
          "type": "string"
        },
        "role": {
          "description": "WAI-ARIA role attribute (e.g., \"dialog\", \"navigation\", \"alert\")",
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "position",
    "items"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ui/PageTabsProps.json",
  "x-spec-version": "3.0.11"
}