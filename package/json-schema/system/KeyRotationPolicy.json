{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": false,
      "description": "Enable automatic key rotation",
      "type": "boolean"
    },
    "frequencyDays": {
      "default": 90,
      "description": "Rotation frequency in days",
      "type": "number",
      "minimum": 1
    },
    "retainOldVersions": {
      "default": 3,
      "description": "Number of old key versions to retain",
      "type": "number"
    },
    "autoRotate": {
      "default": true,
      "description": "Automatically rotate without manual approval",
      "type": "boolean"
    }
  },
  "required": [
    "enabled",
    "frequencyDays",
    "retainOldVersions",
    "autoRotate"
  ],
  "additionalProperties": false,
  "description": "Policy for automatic encryption key rotation",
  "$id": "https://schema.objectstack.io/v3.0.11/system/KeyRotationPolicy.json",
  "x-spec-version": "3.0.11"
}