{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "success": {
      "type": "boolean",
      "description": "Operation success status"
    },
    "error": {
      "description": "Error details if success is false",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Error code (e.g. validation_error)"
        },
        "message": {
          "type": "string",
          "description": "Readable error message"
        },
        "category": {
          "description": "Error category (e.g. validation, authorization)",
          "type": "string"
        },
        "details": {
          "description": "Additional error context (e.g. field validation errors)"
        },
        "requestId": {
          "description": "Request ID for tracking",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "meta": {
      "description": "Response metadata",
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "string"
        },
        "duration": {
          "type": "number"
        },
        "requestId": {
          "type": "string"
        },
        "traceId": {
          "type": "string"
        }
      },
      "required": [
        "timestamp"
      ],
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "properties": {
        "feedId": {
          "type": "string",
          "description": "ID of the starred feed item"
        },
        "starred": {
          "type": "boolean",
          "description": "Whether the item is now starred"
        },
        "starredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
          "description": "Timestamp when starred"
        }
      },
      "required": [
        "feedId",
        "starred",
        "starredAt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "success",
    "data"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/StarFeedItemResponse.json",
  "x-spec-version": "3.0.11"
}