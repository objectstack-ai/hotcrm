{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "capabilities": {
      "description": "Required capabilities",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "maxCostPer1kTokens": {
      "description": "Maximum acceptable cost",
      "type": "number"
    },
    "minContextWindow": {
      "description": "Minimum context window size",
      "type": "number"
    },
    "provider": {
      "type": "string",
      "enum": [
        "openai",
        "azure_openai",
        "anthropic",
        "google",
        "cohere",
        "huggingface",
        "local",
        "custom"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excludeDeprecated": {
      "default": true,
      "type": "boolean"
    }
  },
  "required": [
    "excludeDeprecated"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/ModelSelectionCriteria.json",
  "x-spec-version": "3.0.11"
}