{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Translation key (e.g., \"views.task_list.label\")"
            },
            "defaultValue": {
              "description": "Fallback value when translation key is not found",
              "type": "string"
            },
            "params": {
              "description": "Interpolation parameters (e.g., { count: 5 })",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Action button label"
    },
    "action": {
      "type": "string",
      "description": "Action identifier to execute"
    },
    "variant": {
      "default": "primary",
      "description": "Button variant style",
      "type": "string",
      "enum": [
        "primary",
        "secondary",
        "link"
      ]
    }
  },
  "required": [
    "label",
    "action",
    "variant"
  ],
  "additionalProperties": false,
  "description": "Notification action button",
  "$id": "https://schema.objectstack.io/v3.0.11/ui/NotificationAction.json",
  "x-spec-version": "3.0.11"
}