{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$",
      "description": "Topic/queue identifier in ObjectStack (snake_case)"
    },
    "label": {
      "type": "string",
      "description": "Display label"
    },
    "topicName": {
      "type": "string",
      "description": "Actual topic/queue name in message queue system"
    },
    "enabled": {
      "default": true,
      "description": "Enable sync for this topic/queue",
      "type": "boolean"
    },
    "mode": {
      "default": "both",
      "description": "Consumer, producer, or both",
      "type": "string",
      "enum": [
        "consumer",
        "producer",
        "both"
      ]
    },
    "messageFormat": {
      "default": "json",
      "type": "string",
      "enum": [
        "json",
        "xml",
        "protobuf",
        "avro",
        "text",
        "binary"
      ],
      "description": "Message format/serialization"
    },
    "partitions": {
      "description": "Number of partitions (for Kafka)",
      "type": "number",
      "minimum": 1
    },
    "replicationFactor": {
      "description": "Replication factor (for Kafka)",
      "type": "number",
      "minimum": 1
    },
    "consumerConfig": {
      "description": "Consumer-specific configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Enable consumer",
          "type": "boolean"
        },
        "consumerGroup": {
          "description": "Consumer group ID",
          "type": "string"
        },
        "concurrency": {
          "default": 1,
          "description": "Number of concurrent consumers",
          "type": "number",
          "minimum": 1,
          "maximum": 100
        },
        "prefetchCount": {
          "default": 10,
          "description": "Prefetch count",
          "type": "number",
          "minimum": 1,
          "maximum": 1000
        },
        "ackMode": {
          "default": "manual",
          "type": "string",
          "enum": [
            "auto",
            "manual",
            "client"
          ],
          "description": "Message acknowledgment mode"
        },
        "autoCommit": {
          "default": false,
          "description": "Auto-commit offsets",
          "type": "boolean"
        },
        "autoCommitIntervalMs": {
          "default": 5000,
          "description": "Auto-commit interval in ms",
          "type": "number",
          "minimum": 100
        },
        "sessionTimeoutMs": {
          "default": 30000,
          "description": "Session timeout in ms",
          "type": "number",
          "minimum": 1000
        },
        "rebalanceTimeoutMs": {
          "description": "Rebalance timeout in ms",
          "type": "number",
          "minimum": 1000
        }
      },
      "required": [
        "enabled",
        "concurrency",
        "prefetchCount",
        "ackMode",
        "autoCommit",
        "autoCommitIntervalMs",
        "sessionTimeoutMs"
      ],
      "additionalProperties": false
    },
    "producerConfig": {
      "description": "Producer-specific configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Enable producer",
          "type": "boolean"
        },
        "acks": {
          "default": "all",
          "description": "Acknowledgment level",
          "type": "string",
          "enum": [
            "0",
            "1",
            "all"
          ]
        },
        "compressionType": {
          "default": "none",
          "description": "Compression type",
          "type": "string",
          "enum": [
            "none",
            "gzip",
            "snappy",
            "lz4",
            "zstd"
          ]
        },
        "batchSize": {
          "default": 16384,
          "description": "Batch size in bytes",
          "type": "number",
          "minimum": 1
        },
        "lingerMs": {
          "default": 0,
          "description": "Linger time in ms",
          "type": "number",
          "minimum": 0
        },
        "maxInFlightRequests": {
          "default": 5,
          "description": "Max in-flight requests",
          "type": "number",
          "minimum": 1
        },
        "idempotence": {
          "default": true,
          "description": "Enable idempotent producer",
          "type": "boolean"
        },
        "transactional": {
          "default": false,
          "description": "Enable transactional producer",
          "type": "boolean"
        },
        "transactionTimeoutMs": {
          "description": "Transaction timeout in ms",
          "type": "number",
          "minimum": 1000
        }
      },
      "required": [
        "enabled",
        "acks",
        "compressionType",
        "batchSize",
        "lingerMs",
        "maxInFlightRequests",
        "idempotence",
        "transactional"
      ],
      "additionalProperties": false
    },
    "dlqConfig": {
      "description": "Dead letter queue configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "description": "Enable DLQ",
          "type": "boolean"
        },
        "queueName": {
          "type": "string",
          "description": "Dead letter queue/topic name"
        },
        "maxRetries": {
          "default": 3,
          "description": "Max retries before DLQ",
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "retryDelayMs": {
          "default": 60000,
          "description": "Retry delay in ms",
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "enabled",
        "queueName",
        "maxRetries",
        "retryDelayMs"
      ],
      "additionalProperties": false
    },
    "routingKey": {
      "description": "Routing key pattern",
      "type": "string"
    },
    "messageFilter": {
      "description": "Message filter criteria",
      "type": "object",
      "properties": {
        "headers": {
          "description": "Filter by message headers",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "attributes": {
          "description": "Filter by message attributes",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "label",
    "topicName",
    "enabled",
    "mode",
    "messageFormat"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/integration/TopicQueue.json",
  "x-spec-version": "3.0.11"
}