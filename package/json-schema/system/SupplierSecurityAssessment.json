{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "supplierId": {
      "type": "string",
      "description": "Unique supplier identifier"
    },
    "supplierName": {
      "type": "string",
      "description": "Supplier display name"
    },
    "riskLevel": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "description": "Supplier risk classification"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "expired",
        "failed"
      ],
      "description": "Assessment status"
    },
    "assessedBy": {
      "type": "string",
      "description": "Assessor user ID or team"
    },
    "assessedAt": {
      "type": "number",
      "description": "Assessment timestamp"
    },
    "validUntil": {
      "type": "number",
      "description": "Assessment validity expiry timestamp"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Requirement identifier"
          },
          "description": {
            "type": "string",
            "description": "Requirement description"
          },
          "controlReference": {
            "description": "ISO 27001 control reference",
            "type": "string"
          },
          "mandatory": {
            "default": true,
            "description": "Whether this requirement is mandatory",
            "type": "boolean"
          },
          "compliant": {
            "description": "Whether the supplier meets this requirement",
            "type": "boolean"
          },
          "evidence": {
            "description": "Compliance evidence or assessment notes",
            "type": "string"
          }
        },
        "required": [
          "id",
          "description",
          "mandatory"
        ],
        "additionalProperties": false,
        "description": "Individual supplier security requirement"
      },
      "description": "Security requirements and their compliance status"
    },
    "overallCompliant": {
      "type": "boolean",
      "description": "Whether supplier meets all mandatory requirements"
    },
    "dataClassificationsShared": {
      "description": "Data classifications shared with supplier",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "pii",
          "phi",
          "pci",
          "financial",
          "confidential",
          "internal",
          "public"
        ],
        "description": "Data classification level"
      }
    },
    "servicesProvided": {
      "description": "Services provided by this supplier",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "certifications": {
      "description": "Supplier certifications (e.g., ISO 27001, SOC 2)",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remediationItems": {
      "description": "Remediation items for non-compliant requirements",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirementId": {
            "type": "string",
            "description": "Non-compliant requirement ID"
          },
          "action": {
            "type": "string",
            "description": "Required remediation action"
          },
          "deadline": {
            "type": "number",
            "description": "Remediation deadline timestamp"
          },
          "status": {
            "default": "pending",
            "description": "Remediation status",
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "completed"
            ]
          }
        },
        "required": [
          "requirementId",
          "action",
          "deadline",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "metadata": {
      "description": "Custom metadata key-value pairs",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "supplierId",
    "supplierName",
    "riskLevel",
    "status",
    "assessedBy",
    "assessedAt",
    "validUntil",
    "requirements",
    "overallCompliant"
  ],
  "additionalProperties": false,
  "description": "Supplier security assessment record per ISO 27001:2022 A.5.19–A.5.21",
  "$id": "https://schema.objectstack.io/v3.0.11/system/SupplierSecurityAssessment.json",
  "x-spec-version": "3.0.11"
}