{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "package": {
      "description": "Filter by owning package",
      "type": "string"
    },
    "tags": {
      "description": "Filter by object tags",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "includeSystem": {
      "default": false,
      "description": "Include system-level objects",
      "type": "boolean"
    },
    "includeAbstract": {
      "default": false,
      "description": "Include abstract base objects",
      "type": "boolean"
    },
    "hasFieldType": {
      "description": "Filter to objects containing a specific field type",
      "type": "string"
    },
    "hasRelationships": {
      "description": "Filter to objects with lookup/master_detail fields",
      "type": "boolean"
    },
    "searchQuery": {
      "description": "Free-text search across name, label, and description",
      "type": "string"
    }
  },
  "required": [
    "includeSystem",
    "includeAbstract"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/studio/ObjectFilter.json",
  "x-spec-version": "3.0.11"
}