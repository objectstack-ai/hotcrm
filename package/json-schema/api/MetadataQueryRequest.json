{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "types": {
      "description": "Filter by metadata types",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "object",
          "field",
          "trigger",
          "validation",
          "hook",
          "view",
          "page",
          "dashboard",
          "app",
          "action",
          "report",
          "flow",
          "workflow",
          "approval",
          "datasource",
          "translation",
          "router",
          "function",
          "service",
          "permission",
          "profile",
          "role",
          "agent"
        ]
      }
    },
    "namespaces": {
      "description": "Filter by namespaces",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "packageId": {
      "description": "Filter by owning package",
      "type": "string"
    },
    "search": {
      "description": "Full-text search query",
      "type": "string"
    },
    "scope": {
      "description": "Filter by scope",
      "type": "string",
      "enum": [
        "system",
        "platform",
        "user"
      ]
    },
    "state": {
      "description": "Filter by lifecycle state",
      "type": "string",
      "enum": [
        "draft",
        "active",
        "archived",
        "deprecated"
      ]
    },
    "tags": {
      "description": "Filter by tags",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sortBy": {
      "default": "name",
      "description": "Sort field",
      "type": "string",
      "enum": [
        "name",
        "type",
        "updatedAt",
        "createdAt"
      ]
    },
    "sortOrder": {
      "default": "asc",
      "description": "Sort direction",
      "type": "string",
      "enum": [
        "asc",
        "desc"
      ]
    },
    "page": {
      "default": 1,
      "description": "Page number",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "pageSize": {
      "default": 50,
      "description": "Items per page",
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    }
  },
  "required": [
    "sortBy",
    "sortOrder",
    "page",
    "pageSize"
  ],
  "additionalProperties": false,
  "description": "Metadata query with filtering, sorting, and pagination",
  "$id": "https://schema.objectstack.io/v3.0.11/api/MetadataQueryRequest.json",
  "x-spec-version": "3.0.11"
}