{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sort": {
      "default": true,
      "description": "Allow users to sort records",
      "type": "boolean"
    },
    "search": {
      "default": true,
      "description": "Allow users to search records",
      "type": "boolean"
    },
    "filter": {
      "default": true,
      "description": "Allow users to filter records",
      "type": "boolean"
    },
    "rowHeight": {
      "default": true,
      "description": "Allow users to toggle row height/density",
      "type": "boolean"
    },
    "addRecordForm": {
      "default": false,
      "description": "Add records through a form instead of inline",
      "type": "boolean"
    },
    "buttons": {
      "description": "Custom action button IDs to show in the toolbar",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "sort",
    "search",
    "filter",
    "rowHeight",
    "addRecordForm"
  ],
  "additionalProperties": false,
  "description": "User action toggles for the view toolbar",
  "$id": "https://schema.objectstack.io/v3.0.11/ui/UserActionsConfig.json",
  "x-spec-version": "3.0.11"
}