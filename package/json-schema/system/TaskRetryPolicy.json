{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "maxRetries": {
      "default": 3,
      "description": "Maximum retry attempts",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "backoffStrategy": {
      "default": "exponential",
      "description": "Backoff strategy between retries",
      "type": "string",
      "enum": [
        "fixed",
        "linear",
        "exponential"
      ]
    },
    "initialDelayMs": {
      "default": 1000,
      "description": "Initial retry delay in milliseconds",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "maxDelayMs": {
      "default": 60000,
      "description": "Maximum retry delay in milliseconds",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "backoffMultiplier": {
      "default": 2,
      "description": "Multiplier for exponential backoff",
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "required": [
    "maxRetries",
    "backoffStrategy",
    "initialDelayMs",
    "maxDelayMs",
    "backoffMultiplier"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/system/TaskRetryPolicy.json",
  "x-spec-version": "3.0.11"
}