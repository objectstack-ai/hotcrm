{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Changelog entry ID"
    },
    "object": {
      "type": "string",
      "description": "Object name"
    },
    "recordId": {
      "type": "string",
      "description": "Record ID"
    },
    "actor": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "user",
            "system",
            "service",
            "automation"
          ],
          "description": "Actor type"
        },
        "id": {
          "type": "string",
          "description": "Actor ID"
        },
        "name": {
          "description": "Actor display name",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false,
      "description": "Who made the change"
    },
    "changes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "Field machine name"
          },
          "fieldLabel": {
            "description": "Field display label",
            "type": "string"
          },
          "oldValue": {
            "description": "Previous value"
          },
          "newValue": {
            "description": "New value"
          },
          "oldDisplayValue": {
            "description": "Human-readable old value",
            "type": "string"
          },
          "newDisplayValue": {
            "description": "Human-readable new value",
            "type": "string"
          }
        },
        "required": [
          "field"
        ],
        "additionalProperties": false
      },
      "description": "Field-level changes"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "description": "When the change occurred"
    },
    "source": {
      "description": "Change source (e.g., \"API\", \"UI\", \"automation\")",
      "type": "string"
    }
  },
  "required": [
    "id",
    "object",
    "recordId",
    "actor",
    "changes",
    "timestamp"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/ChangelogEntry.json",
  "x-spec-version": "3.0.11"
}