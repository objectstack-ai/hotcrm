{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": true,
      "description": "Enable REST API plugin",
      "type": "boolean"
    },
    "basePath": {
      "default": "/api",
      "description": "Base path for all API routes",
      "type": "string"
    },
    "version": {
      "default": "v1",
      "description": "API version identifier",
      "type": "string"
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "prefix": {
            "type": "string",
            "pattern": "^\\/",
            "description": "URL path prefix for this route group"
          },
          "service": {
            "type": "string",
            "description": "Core service name (metadata, data, auth, etc.)"
          },
          "category": {
            "type": "string",
            "enum": [
              "discovery",
              "metadata",
              "data",
              "batch",
              "permission",
              "analytics",
              "automation",
              "workflow",
              "ui",
              "realtime",
              "notification",
              "ai",
              "i18n"
            ],
            "description": "Primary category for this route group"
          },
          "methods": {
            "description": "Protocol method names implemented",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "endpoints": {
            "description": "Endpoint definitions",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "method": {
                  "type": "string",
                  "enum": [
                    "GET",
                    "POST",
                    "PUT",
                    "DELETE",
                    "PATCH",
                    "HEAD",
                    "OPTIONS"
                  ],
                  "description": "HTTP method for this endpoint"
                },
                "path": {
                  "type": "string",
                  "description": "URL path pattern (e.g., /api/v1/data/:object/:id)"
                },
                "handler": {
                  "type": "string",
                  "description": "Protocol method name or handler identifier"
                },
                "category": {
                  "type": "string",
                  "enum": [
                    "discovery",
                    "metadata",
                    "data",
                    "batch",
                    "permission",
                    "analytics",
                    "automation",
                    "workflow",
                    "ui",
                    "realtime",
                    "notification",
                    "ai",
                    "i18n"
                  ],
                  "description": "Route category"
                },
                "public": {
                  "default": false,
                  "description": "Is publicly accessible without authentication",
                  "type": "boolean"
                },
                "permissions": {
                  "description": "Required permissions (e.g., [\"data.read\", \"object.account.read\"])",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "summary": {
                  "description": "Short description for OpenAPI",
                  "type": "string"
                },
                "description": {
                  "description": "Detailed description for OpenAPI",
                  "type": "string"
                },
                "tags": {
                  "description": "OpenAPI tags for grouping",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "requestSchema": {
                  "description": "Request schema name (for validation)",
                  "type": "string"
                },
                "responseSchema": {
                  "description": "Response schema name (for documentation)",
                  "type": "string"
                },
                "timeout": {
                  "description": "Request timeout in milliseconds",
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "rateLimit": {
                  "description": "Rate limit policy name",
                  "type": "string"
                },
                "cacheable": {
                  "default": false,
                  "description": "Whether response can be cached",
                  "type": "boolean"
                },
                "cacheTtl": {
                  "description": "Cache TTL in seconds",
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "method",
                "path",
                "handler",
                "category",
                "public",
                "cacheable"
              ],
              "additionalProperties": false
            }
          },
          "middleware": {
            "description": "Middleware stack for this route group",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z_][a-z0-9_]*$",
                  "description": "Middleware name (snake_case)"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "authentication",
                    "authorization",
                    "logging",
                    "validation",
                    "transformation",
                    "error",
                    "custom"
                  ],
                  "description": "Middleware type"
                },
                "enabled": {
                  "default": true,
                  "description": "Whether middleware is enabled",
                  "type": "boolean"
                },
                "order": {
                  "default": 100,
                  "description": "Execution order priority",
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "config": {
                  "description": "Middleware configuration object",
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "paths": {
                  "description": "Path filtering",
                  "type": "object",
                  "properties": {
                    "include": {
                      "description": "Include path patterns (glob)",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "exclude": {
                      "description": "Exclude path patterns (glob)",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "name",
                "type",
                "enabled",
                "order"
              ],
              "additionalProperties": false
            }
          },
          "authRequired": {
            "default": true,
            "description": "Whether authentication is required by default",
            "type": "boolean"
          },
          "documentation": {
            "description": "Documentation metadata for this route group",
            "type": "object",
            "properties": {
              "title": {
                "description": "Route group title",
                "type": "string"
              },
              "description": {
                "description": "Route group description",
                "type": "string"
              },
              "tags": {
                "description": "OpenAPI tags",
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "prefix",
          "service",
          "category",
          "authRequired"
        ],
        "additionalProperties": false
      },
      "description": "Route registrations"
    },
    "validation": {
      "description": "Request validation configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Enable automatic request validation",
          "type": "boolean"
        },
        "mode": {
          "default": "strict",
          "description": "How to handle validation errors",
          "type": "string",
          "enum": [
            "strict",
            "permissive",
            "strip"
          ]
        },
        "validateBody": {
          "default": true,
          "description": "Validate request body against schema",
          "type": "boolean"
        },
        "validateQuery": {
          "default": true,
          "description": "Validate query string parameters",
          "type": "boolean"
        },
        "validateParams": {
          "default": true,
          "description": "Validate URL path parameters",
          "type": "boolean"
        },
        "validateHeaders": {
          "default": false,
          "description": "Validate request headers",
          "type": "boolean"
        },
        "includeFieldErrors": {
          "default": true,
          "description": "Include field-level error details in response",
          "type": "boolean"
        },
        "errorPrefix": {
          "description": "Custom prefix for validation error messages",
          "type": "string"
        },
        "schemaRegistry": {
          "description": "Schema registry name to use for validation",
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "mode",
        "validateBody",
        "validateQuery",
        "validateParams",
        "validateHeaders",
        "includeFieldErrors"
      ],
      "additionalProperties": false
    },
    "responseEnvelope": {
      "description": "Response envelope configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Enable automatic response envelope wrapping",
          "type": "boolean"
        },
        "includeMetadata": {
          "default": true,
          "description": "Include meta object in responses",
          "type": "boolean"
        },
        "includeTimestamp": {
          "default": true,
          "description": "Include timestamp in response metadata",
          "type": "boolean"
        },
        "includeRequestId": {
          "default": true,
          "description": "Include requestId in response metadata",
          "type": "boolean"
        },
        "includeDuration": {
          "default": false,
          "description": "Include request duration in ms",
          "type": "boolean"
        },
        "includeTraceId": {
          "default": false,
          "description": "Include distributed traceId",
          "type": "boolean"
        },
        "customMetadata": {
          "description": "Additional metadata fields to include",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "skipIfWrapped": {
          "default": true,
          "description": "Skip wrapping if response already has success field",
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "includeMetadata",
        "includeTimestamp",
        "includeRequestId",
        "includeDuration",
        "includeTraceId",
        "skipIfWrapped"
      ],
      "additionalProperties": false
    },
    "errorHandling": {
      "description": "Error handling configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Enable standardized error handling",
          "type": "boolean"
        },
        "includeStackTrace": {
          "default": false,
          "description": "Include stack traces in error responses",
          "type": "boolean"
        },
        "logErrors": {
          "default": true,
          "description": "Log errors to system logger",
          "type": "boolean"
        },
        "exposeInternalErrors": {
          "default": false,
          "description": "Expose internal error details in responses",
          "type": "boolean"
        },
        "includeRequestId": {
          "default": true,
          "description": "Include requestId in error responses",
          "type": "boolean"
        },
        "includeTimestamp": {
          "default": true,
          "description": "Include timestamp in error responses",
          "type": "boolean"
        },
        "includeDocumentation": {
          "default": true,
          "description": "Include documentation URLs for errors",
          "type": "boolean"
        },
        "documentationBaseUrl": {
          "description": "Base URL for error documentation",
          "type": "string",
          "format": "uri"
        },
        "customErrorMessages": {
          "description": "Custom error messages by error code",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "redactFields": {
          "description": "Field names to redact from error details",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "enabled",
        "includeStackTrace",
        "logErrors",
        "exposeInternalErrors",
        "includeRequestId",
        "includeTimestamp",
        "includeDocumentation"
      ],
      "additionalProperties": false
    },
    "openApi": {
      "description": "OpenAPI documentation configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Enable automatic OpenAPI documentation generation",
          "type": "boolean"
        },
        "version": {
          "default": "3.0.3",
          "description": "OpenAPI specification version",
          "type": "string",
          "enum": [
            "3.0.0",
            "3.0.1",
            "3.0.2",
            "3.0.3",
            "3.1.0"
          ]
        },
        "title": {
          "default": "ObjectStack API",
          "description": "API title",
          "type": "string"
        },
        "description": {
          "description": "API description",
          "type": "string"
        },
        "apiVersion": {
          "default": "1.0.0",
          "description": "API version",
          "type": "string"
        },
        "outputPath": {
          "default": "/api/docs/openapi.json",
          "description": "URL path to serve OpenAPI JSON",
          "type": "string"
        },
        "uiPath": {
          "default": "/api/docs",
          "description": "URL path to serve documentation UI",
          "type": "string"
        },
        "uiFramework": {
          "default": "swagger-ui",
          "description": "Documentation UI framework",
          "type": "string",
          "enum": [
            "swagger-ui",
            "redoc",
            "rapidoc",
            "elements"
          ]
        },
        "includeInternal": {
          "default": false,
          "description": "Include internal endpoints in documentation",
          "type": "boolean"
        },
        "generateSchemas": {
          "default": true,
          "description": "Auto-generate schemas from Zod definitions",
          "type": "boolean"
        },
        "includeExamples": {
          "default": true,
          "description": "Include request/response examples",
          "type": "boolean"
        },
        "servers": {
          "description": "Server URLs for API",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "description": "Server URL"
              },
              "description": {
                "description": "Server description",
                "type": "string"
              }
            },
            "required": [
              "url"
            ],
            "additionalProperties": false
          }
        },
        "contact": {
          "description": "API contact information",
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "email": {
              "type": "string",
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            }
          },
          "additionalProperties": false
        },
        "license": {
          "description": "API license information",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "License name"
            },
            "url": {
              "description": "License URL",
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "securitySchemes": {
          "description": "Security scheme definitions",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "apiKey",
                  "http",
                  "oauth2",
                  "openIdConnect"
                ]
              },
              "scheme": {
                "type": "string"
              },
              "bearerFormat": {
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "enabled",
        "version",
        "title",
        "apiVersion",
        "outputPath",
        "uiPath",
        "uiFramework",
        "includeInternal",
        "generateSchemas",
        "includeExamples"
      ],
      "additionalProperties": false
    },
    "globalMiddleware": {
      "description": "Global middleware stack",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_]*$",
            "description": "Middleware name (snake_case)"
          },
          "type": {
            "type": "string",
            "enum": [
              "authentication",
              "authorization",
              "logging",
              "validation",
              "transformation",
              "error",
              "custom"
            ],
            "description": "Middleware type"
          },
          "enabled": {
            "default": true,
            "description": "Whether middleware is enabled",
            "type": "boolean"
          },
          "order": {
            "default": 100,
            "description": "Execution order priority",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "config": {
            "description": "Middleware configuration object",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "paths": {
            "description": "Path filtering",
            "type": "object",
            "properties": {
              "include": {
                "description": "Include path patterns (glob)",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "exclude": {
                "description": "Exclude path patterns (glob)",
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "type",
          "enabled",
          "order"
        ],
        "additionalProperties": false
      }
    },
    "cors": {
      "description": "CORS configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "origins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "DELETE",
              "PATCH",
              "HEAD",
              "OPTIONS"
            ]
          }
        },
        "credentials": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "credentials"
      ],
      "additionalProperties": false
    },
    "performance": {
      "description": "Performance optimization settings",
      "type": "object",
      "properties": {
        "enableCompression": {
          "default": true,
          "description": "Enable response compression",
          "type": "boolean"
        },
        "enableETag": {
          "default": true,
          "description": "Enable ETag generation",
          "type": "boolean"
        },
        "enableCaching": {
          "default": true,
          "description": "Enable HTTP caching",
          "type": "boolean"
        },
        "defaultCacheTtl": {
          "default": 300,
          "description": "Default cache TTL in seconds",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "enableCompression",
        "enableETag",
        "enableCaching",
        "defaultCacheTtl"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "enabled",
    "basePath",
    "version",
    "routes"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/RestApiPluginConfig.json",
  "x-spec-version": "3.0.11"
}