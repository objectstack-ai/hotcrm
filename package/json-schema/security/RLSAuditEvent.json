{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of the evaluation"
    },
    "userId": {
      "type": "string",
      "description": "User ID whose access was evaluated"
    },
    "operation": {
      "type": "string",
      "enum": [
        "select",
        "insert",
        "update",
        "delete"
      ],
      "description": "Database operation being performed"
    },
    "object": {
      "type": "string",
      "description": "Target object name"
    },
    "policyName": {
      "type": "string",
      "description": "Name of the RLS policy evaluated"
    },
    "granted": {
      "type": "boolean",
      "description": "Whether access was granted"
    },
    "evaluationDurationMs": {
      "type": "number",
      "description": "Policy evaluation duration in milliseconds"
    },
    "matchedCondition": {
      "description": "Which USING/CHECK clause matched",
      "type": "string"
    },
    "rowCount": {
      "description": "Number of rows affected",
      "type": "number"
    },
    "metadata": {
      "description": "Additional audit event metadata",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "timestamp",
    "userId",
    "operation",
    "object",
    "policyName",
    "granted",
    "evaluationDurationMs"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/security/RLSAuditEvent.json",
  "x-spec-version": "3.0.11"
}