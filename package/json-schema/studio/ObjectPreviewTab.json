{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Tab key"
    },
    "label": {
      "type": "string",
      "description": "Tab display label"
    },
    "icon": {
      "description": "Lucide icon name",
      "type": "string"
    },
    "enabled": {
      "default": true,
      "description": "Whether this tab is available",
      "type": "boolean"
    },
    "order": {
      "default": 0,
      "description": "Sort order (lower = higher)",
      "type": "number"
    }
  },
  "required": [
    "key",
    "label",
    "enabled",
    "order"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/studio/ObjectPreviewTab.json",
  "x-spec-version": "3.0.11"
}