{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$",
      "description": "Agent unique identifier"
    },
    "label": {
      "type": "string",
      "description": "Agent display name"
    },
    "avatar": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "description": "The persona/role (e.g. \"Senior Support Engineer\")"
    },
    "instructions": {
      "type": "string",
      "description": "System Prompt / Prime Directives"
    },
    "model": {
      "type": "object",
      "properties": {
        "provider": {
          "default": "openai",
          "type": "string",
          "enum": [
            "openai",
            "azure_openai",
            "anthropic",
            "local"
          ]
        },
        "model": {
          "type": "string",
          "description": "Model name (e.g. gpt-4, claude-3-opus)"
        },
        "temperature": {
          "default": 0.7,
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "maxTokens": {
          "type": "number"
        },
        "topP": {
          "type": "number"
        }
      },
      "required": [
        "provider",
        "model",
        "temperature"
      ],
      "additionalProperties": false
    },
    "lifecycle": {
      "description": "State machine defining the agent conversation follow and constraints",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Unique Machine ID"
        },
        "description": {
          "type": "string"
        },
        "contextSchema": {
          "description": "Zod Schema for the machine context/memory",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "initial": {
          "type": "string",
          "description": "Initial State ID"
        },
        "states": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          },
          "description": "State Nodes"
        },
        "on": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "target": {
                    "description": "Target State ID",
                    "type": "string"
                  },
                  "cond": {
                    "description": "Condition (Guard) required to take this path",
                    "anyOf": [
                      {
                        "type": "string",
                        "description": "Guard Name (e.g., \"isManager\", \"amountGT1000\")"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string"
                          },
                          "params": {
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {}
                          }
                        },
                        "required": [
                          "type"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "actions": {
                    "description": "Actions to execute during transition",
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "string",
                          "description": "Action Name"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string"
                            },
                            "params": {
                              "type": "object",
                              "propertyNames": {
                                "type": "string"
                              },
                              "additionalProperties": {}
                            }
                          },
                          "required": [
                            "type"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "description": {
                    "description": "Human readable description of this rule",
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "target": {
                      "description": "Target State ID",
                      "type": "string"
                    },
                    "cond": {
                      "description": "Condition (Guard) required to take this path",
                      "anyOf": [
                        {
                          "type": "string",
                          "description": "Guard Name (e.g., \"isManager\", \"amountGT1000\")"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string"
                            },
                            "params": {
                              "type": "object",
                              "propertyNames": {
                                "type": "string"
                              },
                              "additionalProperties": {}
                            }
                          },
                          "required": [
                            "type"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "actions": {
                      "description": "Actions to execute during transition",
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "string",
                            "description": "Action Name"
                          },
                          {
                            "type": "object",
                            "properties": {
                              "type": {
                                "type": "string"
                              },
                              "params": {
                                "type": "object",
                                "propertyNames": {
                                  "type": "string"
                                },
                                "additionalProperties": {}
                              }
                            },
                            "required": [
                              "type"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      }
                    },
                    "description": {
                      "description": "Human readable description of this rule",
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            ]
          }
        }
      },
      "required": [
        "id",
        "initial",
        "states"
      ],
      "additionalProperties": false
    },
    "tools": {
      "description": "Available tools",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "action",
              "flow",
              "query",
              "vector_search"
            ]
          },
          "name": {
            "type": "string",
            "description": "Reference name (Action Name, Flow Name)"
          },
          "description": {
            "description": "Override description for the LLM",
            "type": "string"
          }
        },
        "required": [
          "type",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "knowledge": {
      "description": "RAG access",
      "type": "object",
      "properties": {
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Topics/Tags to recruit knowledge from"
        },
        "indexes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Vector Store Indexes"
        }
      },
      "required": [
        "topics",
        "indexes"
      ],
      "additionalProperties": false
    },
    "active": {
      "default": true,
      "type": "boolean"
    },
    "access": {
      "description": "Who can chat with this agent",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tenantId": {
      "description": "Tenant/Organization ID",
      "type": "string"
    },
    "visibility": {
      "default": "organization",
      "type": "string",
      "enum": [
        "global",
        "organization",
        "private"
      ]
    },
    "planning": {
      "description": "Autonomous reasoning and planning configuration",
      "type": "object",
      "properties": {
        "strategy": {
          "default": "react",
          "description": "Autonomous reasoning strategy",
          "type": "string",
          "enum": [
            "react",
            "plan_and_execute",
            "reflexion",
            "tree_of_thought"
          ]
        },
        "maxIterations": {
          "default": 10,
          "description": "Maximum planning loop iterations",
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "allowReplan": {
          "default": true,
          "description": "Allow dynamic re-planning based on intermediate results",
          "type": "boolean"
        }
      },
      "required": [
        "strategy",
        "maxIterations",
        "allowReplan"
      ],
      "additionalProperties": false
    },
    "memory": {
      "description": "Agent memory management",
      "type": "object",
      "properties": {
        "shortTerm": {
          "description": "Short-term / working memory",
          "type": "object",
          "properties": {
            "maxMessages": {
              "default": 50,
              "description": "Max recent messages in working memory",
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maxTokens": {
              "description": "Max tokens for short-term context window",
              "type": "integer",
              "minimum": 100,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "maxMessages"
          ],
          "additionalProperties": false
        },
        "longTerm": {
          "description": "Long-term / persistent memory",
          "type": "object",
          "properties": {
            "enabled": {
              "default": false,
              "description": "Enable long-term memory persistence",
              "type": "boolean"
            },
            "store": {
              "default": "vector",
              "description": "Long-term memory storage backend",
              "type": "string",
              "enum": [
                "vector",
                "database",
                "redis"
              ]
            },
            "maxEntries": {
              "description": "Max entries in long-term memory",
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "enabled",
            "store"
          ],
          "additionalProperties": false
        },
        "reflectionInterval": {
          "description": "Reflect every N interactions to improve behavior",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "guardrails": {
      "description": "Safety guardrails for the agent",
      "type": "object",
      "properties": {
        "maxTokensPerInvocation": {
          "description": "Token budget per single invocation",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxExecutionTimeSec": {
          "description": "Max execution time in seconds",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "blockedTopics": {
          "description": "Forbidden topics or action names",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "structuredOutput": {
      "description": "Structured output format and validation configuration",
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "json_object",
            "json_schema",
            "regex",
            "grammar",
            "xml"
          ],
          "description": "Expected output format"
        },
        "schema": {
          "description": "JSON Schema definition for output",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "strict": {
          "default": false,
          "description": "Enforce exact schema compliance",
          "type": "boolean"
        },
        "retryOnValidationFailure": {
          "default": true,
          "description": "Retry generation when output fails validation",
          "type": "boolean"
        },
        "maxRetries": {
          "default": 3,
          "description": "Maximum retries on validation failure",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fallbackFormat": {
          "description": "Fallback format if primary format fails",
          "type": "string",
          "enum": [
            "json_object",
            "json_schema",
            "regex",
            "grammar",
            "xml"
          ]
        },
        "transformPipeline": {
          "description": "Post-processing steps applied to output",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "trim",
              "parse_json",
              "validate",
              "coerce_types"
            ],
            "description": "Post-processing step for structured output"
          }
        }
      },
      "required": [
        "format",
        "strict",
        "retryOnValidationFailure",
        "maxRetries"
      ],
      "additionalProperties": false
    },
    "developmentConfig": {
      "type": "object",
      "properties": {
        "specificationSource": {
          "type": "string",
          "description": "Path to ObjectStack specification"
        },
        "codeGeneration": {
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "description": "Enable code generation",
              "type": "boolean"
            },
            "targets": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "frontend",
                  "backend",
                  "api",
                  "database",
                  "tests",
                  "documentation",
                  "infrastructure"
                ],
                "description": "Code generation target"
              },
              "description": "Code generation targets"
            },
            "templateRepo": {
              "description": "Template repository for scaffolding",
              "type": "string"
            },
            "styleGuide": {
              "description": "Code style guide to follow",
              "type": "string"
            },
            "includeTests": {
              "default": true,
              "description": "Generate tests with code",
              "type": "boolean"
            },
            "includeDocumentation": {
              "default": true,
              "description": "Generate documentation",
              "type": "boolean"
            },
            "validationMode": {
              "default": "strict",
              "description": "Code validation strictness",
              "type": "string",
              "enum": [
                "strict",
                "moderate",
                "permissive"
              ]
            }
          },
          "required": [
            "enabled",
            "targets",
            "includeTests",
            "includeDocumentation",
            "validationMode"
          ],
          "additionalProperties": false,
          "description": "Code generation settings"
        },
        "testing": {
          "description": "Testing configuration",
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "description": "Enable automated testing",
              "type": "boolean"
            },
            "testTypes": {
              "default": [
                "unit",
                "integration"
              ],
              "description": "Types of tests to run",
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "unit",
                  "integration",
                  "e2e",
                  "performance",
                  "security",
                  "accessibility"
                ]
              }
            },
            "coverageThreshold": {
              "default": 80,
              "description": "Minimum test coverage percentage",
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "framework": {
              "description": "Testing framework (e.g., vitest, jest, playwright)",
              "type": "string"
            },
            "preCommitTests": {
              "default": true,
              "description": "Run tests before committing",
              "type": "boolean"
            },
            "autoFix": {
              "default": false,
              "description": "Attempt to auto-fix failing tests",
              "type": "boolean"
            }
          },
          "required": [
            "enabled",
            "testTypes",
            "coverageThreshold",
            "preCommitTests",
            "autoFix"
          ],
          "additionalProperties": false
        },
        "linting": {
          "description": "Code linting configuration",
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "autoFix": {
              "default": true,
              "type": "boolean"
            },
            "rules": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "enabled",
            "autoFix"
          ],
          "additionalProperties": false
        },
        "formatting": {
          "description": "Code formatting configuration",
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "autoFormat": {
              "default": true,
              "type": "boolean"
            },
            "config": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "enabled",
            "autoFormat"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "specificationSource",
        "codeGeneration"
      ],
      "additionalProperties": false,
      "description": "Development configuration"
    },
    "pipelines": {
      "description": "CI/CD pipelines",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Pipeline name"
          },
          "trigger": {
            "type": "string",
            "enum": [
              "push",
              "pull_request",
              "release",
              "schedule",
              "manual"
            ],
            "description": "Pipeline trigger"
          },
          "branches": {
            "description": "Branches to run pipeline on",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Pipeline stage name"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "build",
                    "test",
                    "lint",
                    "security_scan",
                    "deploy",
                    "smoke_test",
                    "rollback"
                  ],
                  "description": "Stage type"
                },
                "order": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "Execution order"
                },
                "parallel": {
                  "default": false,
                  "description": "Can run in parallel with other stages",
                  "type": "boolean"
                },
                "commands": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Commands to execute"
                },
                "env": {
                  "description": "Stage-specific environment variables",
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "timeout": {
                  "default": 600,
                  "description": "Stage timeout in seconds",
                  "type": "integer",
                  "minimum": 60,
                  "maximum": 9007199254740991
                },
                "retryOnFailure": {
                  "default": false,
                  "description": "Retry stage on failure",
                  "type": "boolean"
                },
                "maxRetries": {
                  "default": 0,
                  "description": "Maximum retry attempts",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 5
                }
              },
              "required": [
                "name",
                "type",
                "order",
                "parallel",
                "commands",
                "timeout",
                "retryOnFailure",
                "maxRetries"
              ],
              "additionalProperties": false
            },
            "description": "Pipeline stages"
          },
          "notifications": {
            "description": "Pipeline notifications",
            "type": "object",
            "properties": {
              "onSuccess": {
                "default": false,
                "type": "boolean"
              },
              "onFailure": {
                "default": true,
                "type": "boolean"
              },
              "channels": {
                "description": "Notification channels (e.g., slack, email)",
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "onSuccess",
              "onFailure"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "trigger",
          "stages"
        ],
        "additionalProperties": false
      }
    },
    "versionManagement": {
      "description": "Version management configuration",
      "type": "object",
      "properties": {
        "scheme": {
          "default": "semver",
          "description": "Versioning scheme",
          "type": "string",
          "enum": [
            "semver",
            "calver",
            "custom"
          ]
        },
        "autoIncrement": {
          "default": "patch",
          "description": "Auto-increment strategy",
          "type": "string",
          "enum": [
            "major",
            "minor",
            "patch",
            "none"
          ]
        },
        "prefix": {
          "default": "v",
          "description": "Version tag prefix",
          "type": "string"
        },
        "generateChangelog": {
          "default": true,
          "description": "Generate changelog automatically",
          "type": "boolean"
        },
        "changelogFormat": {
          "default": "conventional",
          "description": "Changelog format",
          "type": "string",
          "enum": [
            "conventional",
            "keepachangelog",
            "custom"
          ]
        },
        "tagReleases": {
          "default": true,
          "description": "Create Git tags for releases",
          "type": "boolean"
        }
      },
      "required": [
        "scheme",
        "autoIncrement",
        "prefix",
        "generateChangelog",
        "changelogFormat",
        "tagReleases"
      ],
      "additionalProperties": false
    },
    "deploymentStrategy": {
      "description": "Deployment strategy",
      "type": "object",
      "properties": {
        "type": {
          "default": "rolling",
          "description": "Deployment strategy",
          "type": "string",
          "enum": [
            "rolling",
            "blue_green",
            "canary",
            "recreate"
          ]
        },
        "canaryPercentage": {
          "default": 10,
          "description": "Canary deployment percentage",
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "healthCheckUrl": {
          "description": "Health check endpoint",
          "type": "string"
        },
        "healthCheckTimeout": {
          "default": 60,
          "description": "Health check timeout in seconds",
          "type": "integer",
          "minimum": 10,
          "maximum": 9007199254740991
        },
        "autoRollback": {
          "default": true,
          "description": "Automatically rollback on failure",
          "type": "boolean"
        },
        "smokeTests": {
          "description": "Smoke test commands to run post-deployment",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "canaryPercentage",
        "healthCheckTimeout",
        "autoRollback"
      ],
      "additionalProperties": false
    },
    "monitoring": {
      "description": "Monitoring configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Enable monitoring",
          "type": "boolean"
        },
        "metrics": {
          "default": [
            "performance",
            "errors",
            "availability"
          ],
          "description": "Metrics to monitor",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "performance",
              "errors",
              "usage",
              "availability",
              "latency"
            ]
          }
        },
        "alerts": {
          "description": "Alert configurations",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Alert name"
              },
              "metric": {
                "type": "string",
                "description": "Metric to monitor"
              },
              "threshold": {
                "type": "number",
                "description": "Alert threshold"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "info",
                  "warning",
                  "critical"
                ],
                "description": "Alert severity"
              }
            },
            "required": [
              "name",
              "metric",
              "threshold",
              "severity"
            ],
            "additionalProperties": false
          }
        },
        "integrations": {
          "description": "Monitoring service integrations",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "enabled",
        "metrics"
      ],
      "additionalProperties": false
