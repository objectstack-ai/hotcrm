{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "object": {
      "type": "string",
      "description": "Object name (e.g., \"account\")"
    },
    "recordId": {
      "type": "string",
      "description": "Record ID"
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "description": "Full-text search query against feed body content"
    },
    "type": {
      "description": "Filter by feed item category",
      "type": "string",
      "enum": [
        "all",
        "comments_only",
        "changes_only",
        "tasks_only"
      ]
    },
    "actorId": {
      "description": "Filter by actor user ID",
      "type": "string"
    },
    "dateFrom": {
      "description": "Filter feed items created after this timestamp",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "dateTo": {
      "description": "Filter feed items created before this timestamp",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "hasAttachments": {
      "description": "Filter for items with file attachments",
      "type": "boolean"
    },
    "pinnedOnly": {
      "description": "Return only pinned items",
      "type": "boolean"
    },
    "starredOnly": {
      "description": "Return only starred items",
      "type": "boolean"
    },
    "limit": {
      "default": 20,
      "description": "Maximum number of items to return",
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "cursor": {
      "description": "Cursor for pagination",
      "type": "string"
    }
  },
  "required": [
    "object",
    "recordId",
    "query",
    "limit"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/SearchFeedRequest.json",
  "x-spec-version": "3.0.11"
}