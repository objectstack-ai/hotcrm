{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "enum": [
        "openai",
        "cohere",
        "huggingface",
        "azure_openai",
        "local",
        "custom"
      ]
    },
    "model": {
      "type": "string",
      "description": "Model name (e.g., \"text-embedding-3-large\")"
    },
    "dimensions": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "Embedding vector dimensions"
    },
    "maxTokens": {
      "description": "Maximum tokens per embedding",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "batchSize": {
      "default": 100,
      "description": "Batch size for embedding",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "endpoint": {
      "description": "Custom endpoint URL",
      "type": "string",
      "format": "uri"
    },
    "apiKey": {
      "description": "API key",
      "type": "string"
    },
    "secretRef": {
      "description": "Reference to stored secret",
      "type": "string"
    }
  },
  "required": [
    "provider",
    "model",
    "dimensions",
    "batchSize"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/EmbeddingModel.json",
  "x-spec-version": "3.0.11"
}