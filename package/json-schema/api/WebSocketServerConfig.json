{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": false,
      "description": "Enable WebSocket server",
      "type": "boolean"
    },
    "path": {
      "default": "/ws",
      "description": "WebSocket endpoint path",
      "type": "string"
    },
    "heartbeatInterval": {
      "default": 30000,
      "description": "Heartbeat interval in milliseconds",
      "type": "number"
    },
    "reconnectAttempts": {
      "default": 5,
      "description": "Maximum reconnection attempts for clients",
      "type": "number"
    },
    "presence": {
      "default": false,
      "description": "Enable presence tracking",
      "type": "boolean"
    },
    "cursorSharing": {
      "default": false,
      "description": "Enable collaborative cursor sharing",
      "type": "boolean"
    }
  },
  "required": [
    "enabled",
    "path",
    "heartbeatInterval",
    "reconnectAttempts",
    "presence",
    "cursorSharing"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/WebSocketServerConfig.json",
  "x-spec-version": "3.0.11"
}