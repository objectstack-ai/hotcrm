{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": false,
      "description": "Enable file versioning",
      "type": "boolean"
    },
    "maxVersions": {
      "description": "Maximum versions to retain",
      "type": "number",
      "minimum": 1,
      "maximum": 100
    },
    "retentionDays": {
      "description": "Version retention period in days",
      "type": "number",
      "minimum": 1
    }
  },
  "required": [
    "enabled"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/integration/FileVersioningConfig.json",
  "x-spec-version": "3.0.11"
}