{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "commands": {
      "description": "Command discovery configuration",
      "type": "object",
      "properties": {
        "strategy": {
          "description": "Command discovery strategy",
          "type": "string",
          "enum": [
            "pattern",
            "explicit",
            "single"
          ]
        },
        "target": {
          "description": "Target directory for command files",
          "type": "string"
        },
        "glob": {
          "description": "Glob pattern for command file matching",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "topicSeparator": {
      "description": "Character separating topic and command names",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "oclif plugin configuration section",
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/OclifPluginConfig.json",
  "x-spec-version": "3.0.11"
}