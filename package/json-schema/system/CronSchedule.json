{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "cron"
    },
    "expression": {
      "type": "string",
      "description": "Cron expression (e.g., \"0 0 * * *\" for daily at midnight)"
    },
    "timezone": {
      "default": "UTC",
      "description": "Timezone for cron execution (e.g., \"America/New_York\")",
      "type": "string"
    }
  },
  "required": [
    "type",
    "expression",
    "timezone"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/system/CronSchedule.json",
  "x-spec-version": "3.0.11"
}