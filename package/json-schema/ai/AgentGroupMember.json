{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "agentId": {
      "type": "string",
      "description": "Agent identifier (reference to AgentSchema.name)"
    },
    "role": {
      "type": "string",
      "enum": [
        "coordinator",
        "specialist",
        "critic",
        "executor"
      ],
      "description": "Agent role within the group"
    },
    "capabilities": {
      "description": "List of capabilities this agent contributes",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "description": "Agent IDs this agent depends on for input",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "priority": {
      "description": "Execution priority (0 = highest)",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "agentId",
    "role"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/AgentGroupMember.json",
  "x-spec-version": "3.0.11"
}