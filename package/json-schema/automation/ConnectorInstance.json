{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Instance ID"
    },
    "connectorId": {
      "type": "string",
      "description": "Connector ID"
    },
    "name": {
      "type": "string",
      "description": "Instance name"
    },
    "description": {
      "description": "Instance description",
      "type": "string"
    },
    "credentials": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {},
      "description": "Encrypted credentials"
    },
    "config": {
      "description": "Additional config",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "active": {
      "default": true,
      "description": "Instance active status",
      "type": "boolean"
    },
    "createdAt": {
      "description": "Creation time",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "lastTestedAt": {
      "description": "Last test time",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "testStatus": {
      "default": "unknown",
      "description": "Connection test status",
      "type": "string",
      "enum": [
        "unknown",
        "success",
        "failed"
      ]
    }
  },
  "required": [
    "id",
    "connectorId",
    "name",
    "credentials",
    "active",
    "testStatus"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/automation/ConnectorInstance.json",
  "x-spec-version": "3.0.11"
}