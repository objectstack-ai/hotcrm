{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "apiKey",
        "http",
        "oauth2",
        "openIdConnect"
      ],
      "description": "Security type"
    },
    "scheme": {
      "description": "HTTP auth scheme (bearer, basic, etc.)",
      "type": "string"
    },
    "bearerFormat": {
      "description": "Bearer token format (e.g., JWT)",
      "type": "string"
    },
    "name": {
      "description": "API key parameter name",
      "type": "string"
    },
    "in": {
      "description": "API key location",
      "type": "string",
      "enum": [
        "header",
        "query",
        "cookie"
      ]
    },
    "flows": {
      "description": "OAuth2 flows",
      "type": "object",
      "properties": {
        "implicit": {},
        "password": {},
        "clientCredentials": {},
        "authorizationCode": {}
      },
      "additionalProperties": false
    },
    "openIdConnectUrl": {
      "description": "OpenID Connect discovery URL",
      "type": "string",
      "format": "uri"
    },
    "description": {
      "description": "Security scheme description",
      "type": "string"
    }
  },
  "required": [
    "type"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/OpenApiSecurityScheme.json",
  "x-spec-version": "3.0.11"
}