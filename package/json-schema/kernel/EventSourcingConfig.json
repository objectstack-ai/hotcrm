{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": false,
      "description": "Enable event sourcing",
      "type": "boolean"
    },
    "snapshotInterval": {
      "default": 100,
      "description": "Create snapshot every N events",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "snapshotRetention": {
      "default": 10,
      "description": "Number of snapshots to retain",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "retention": {
      "default": 365,
      "description": "Days to retain events",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "aggregateTypes": {
      "description": "Aggregate types to enable event sourcing for",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "storage": {
      "description": "Event store configuration",
      "type": "object",
      "properties": {
        "type": {
          "default": "database",
          "description": "Storage backend",
          "type": "string",
          "enum": [
            "database",
            "file",
            "s3",
            "eventstore"
          ]
        },
        "options": {
          "description": "Storage-specific options",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "enabled",
    "snapshotInterval",
    "snapshotRetention",
    "retention"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/EventSourcingConfig.json",
  "x-spec-version": "3.0.11"
}