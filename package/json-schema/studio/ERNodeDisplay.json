{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "showFields": {
      "default": true,
      "description": "Show field list inside entity nodes",
      "type": "boolean"
    },
    "maxFieldsVisible": {
      "default": 8,
      "description": "Max fields visible before \"N more...\" collapse",
      "type": "number"
    },
    "showFieldTypes": {
      "default": true,
      "description": "Show field type badges",
      "type": "boolean"
    },
    "showRequiredIndicator": {
      "default": true,
      "description": "Show required field indicators",
      "type": "boolean"
    },
    "showRecordCount": {
      "default": false,
      "description": "Show live record count on nodes",
      "type": "boolean"
    },
    "showIcon": {
      "default": true,
      "description": "Show object icon on node header",
      "type": "boolean"
    },
    "showDescription": {
      "default": true,
      "description": "Show description tooltip on hover",
      "type": "boolean"
    }
  },
  "required": [
    "showFields",
    "maxFieldsVisible",
    "showFieldTypes",
    "showRequiredIndicator",
    "showRecordCount",
    "showIcon",
    "showDescription"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/studio/ERNodeDisplay.json",
  "x-spec-version": "3.0.11"
}