{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Parameter name"
    },
    "type": {
      "type": "string",
      "enum": [
        "string",
        "number",
        "boolean",
        "object",
        "array"
      ]
    },
    "description": {
      "type": "string",
      "description": "Parameter description for AI consumption"
    },
    "required": {
      "default": false,
      "type": "boolean"
    },
    "default": {},
    "enum": {
      "description": "Allowed values",
      "type": "array",
      "items": {}
    },
    "pattern": {
      "description": "Regex validation pattern (for strings)",
      "type": "string"
    },
    "minimum": {
      "description": "Minimum value (for numbers)",
      "type": "number"
    },
    "maximum": {
      "description": "Maximum value (for numbers)",
      "type": "number"
    },
    "minLength": {
      "description": "Minimum length (for strings/arrays)",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maxLength": {
      "description": "Maximum length (for strings/arrays)",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "properties": {
      "description": "Properties for object types",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#"
      }
    },
    "items": {
      "description": "Item schema for array types",
      "$ref": "#"
    }
  },
  "required": [
    "name",
    "type",
    "description",
    "required"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/MCPToolParameter.json",
  "x-spec-version": "3.0.11"
}