{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "operations": {
      "description": "Enable/disable operations",
      "type": "object",
      "properties": {
        "create": {
          "default": true,
          "description": "Enable create operation",
          "type": "boolean"
        },
        "read": {
          "default": true,
          "description": "Enable read operation",
          "type": "boolean"
        },
        "update": {
          "default": true,
          "description": "Enable update operation",
          "type": "boolean"
        },
        "delete": {
          "default": true,
          "description": "Enable delete operation",
          "type": "boolean"
        },
        "list": {
          "default": true,
          "description": "Enable list operation",
          "type": "boolean"
        }
      },
      "required": [
        "create",
        "read",
        "update",
        "delete",
        "list"
      ],
      "additionalProperties": false
    },
    "patterns": {
      "description": "Custom URL patterns for operations",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "create",
          "read",
          "update",
          "delete",
          "list"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "DELETE",
              "PATCH",
              "HEAD",
              "OPTIONS"
            ],
            "description": "HTTP method"
          },
          "path": {
            "type": "string",
            "description": "URL path pattern"
          },
          "summary": {
            "description": "Operation summary",
            "type": "string"
          },
          "description": {
            "description": "Operation description",
            "type": "string"
          }
        },
        "required": [
          "method",
          "path"
        ],
        "additionalProperties": false
      },
      "required": [
        "create",
        "read",
        "update",
        "delete",
        "list"
      ]
    },
    "dataPrefix": {
      "default": "/data",
      "description": "URL prefix for data endpoints",
      "type": "string"
    },
    "objectParamStyle": {
      "default": "path",
      "description": "How object name is passed (path param or query param)",
      "type": "string",
      "enum": [
        "path",
        "query"
      ]
    }
  },
  "required": [
    "dataPrefix",
    "objectParamStyle"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/CrudEndpointsConfig.json",
  "x-spec-version": "3.0.11"
}