{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique message ID"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "description": "ISO 8601 timestamp"
    },
    "role": {
      "type": "string",
      "enum": [
        "system",
        "user",
        "assistant",
        "function",
        "tool"
      ]
    },
    "content": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "text"
              },
              "text": {
                "type": "string",
                "description": "Text content"
              },
              "metadata": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "type",
              "text"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "image"
              },
              "imageUrl": {
                "type": "string",
                "format": "uri",
                "description": "Image URL"
              },
              "detail": {
                "default": "auto",
                "type": "string",
                "enum": [
                  "low",
                  "high",
                  "auto"
                ]
              },
              "metadata": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "type",
              "imageUrl",
              "detail"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "file"
              },
              "fileUrl": {
                "type": "string",
                "format": "uri",
                "description": "File attachment URL"
              },
              "mimeType": {
                "type": "string",
                "description": "MIME type"
              },
              "fileName": {
                "type": "string"
              },
              "metadata": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "type",
              "fileUrl",
              "mimeType"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "code"
              },
              "text": {
                "type": "string",
                "description": "Code snippet"
              },
              "language": {
                "default": "text",
                "type": "string"
              },
              "metadata": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "type",
              "text",
              "language"
            ],
            "additionalProperties": false
          }
        ]
      },
      "description": "Message content (multimodal array)"
    },
    "functionCall": {
      "description": "Legacy function call",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Function name"
        },
        "arguments": {
          "type": "string",
          "description": "JSON string of function arguments"
        },
        "result": {
          "description": "Function execution result",
          "type": "string"
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    "toolCalls": {
      "description": "Tool calls",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Tool call ID"
          },
          "type": {
            "default": "function",
            "type": "string",
            "enum": [
              "function"
            ]
          },
          "function": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Function name"
              },
              "arguments": {
                "type": "string",
                "description": "JSON string of function arguments"
              },
              "result": {
                "description": "Function execution result",
                "type": "string"
              }
            },
            "required": [
              "name",
              "arguments"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "type",
          "function"
        ],
        "additionalProperties": false
      }
    },
    "toolCallId": {
      "description": "Tool call ID this message responds to",
      "type": "string"
    },
    "name": {
      "description": "Name of the function/user",
      "type": "string"
    },
    "tokens": {
      "description": "Token usage for this message",
      "type": "object",
      "properties": {
        "prompt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Input tokens"
        },
        "completion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Output tokens"
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Total tokens"
        }
      },
      "required": [
        "prompt",
        "completion",
        "total"
      ],
      "additionalProperties": false
    },
    "cost": {
      "description": "Cost for this message in USD",
      "type": "number",
      "minimum": 0
    },
    "pinned": {
      "default": false,
      "description": "Prevent removal during pruning",
      "type": "boolean"
    },
    "importance": {
      "description": "Importance score for pruning",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "embedding": {
      "description": "Vector embedding for semantic search",
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "metadata": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "id",
    "timestamp",
    "role",
    "content",
    "pinned"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/ConversationMessage.json",
  "x-spec-version": "3.0.11"
}