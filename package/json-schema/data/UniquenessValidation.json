{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$",
      "description": "Unique rule name (snake_case)"
    },
    "label": {
      "description": "Human-readable label for the rule listing",
      "type": "string"
    },
    "description": {
      "description": "Administrative notes explaining the business reason",
      "type": "string"
    },
    "active": {
      "default": true,
      "type": "boolean"
    },
    "events": {
      "default": [
        "insert",
        "update"
      ],
      "description": "Validation contexts",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "insert",
          "update",
          "delete"
        ]
      }
    },
    "priority": {
      "default": 100,
      "description": "Execution priority (lower runs first, default: 100)",
      "type": "integer",
      "minimum": 0,
      "maximum": 9999
    },
    "tags": {
      "description": "Categorization tags (e.g., \"compliance\", \"billing\")",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "severity": {
      "default": "error",
      "type": "string",
      "enum": [
        "error",
        "warning",
        "info"
      ]
    },
    "message": {
      "type": "string",
      "description": "Error message to display to the user"
    },
    "type": {
      "type": "string",
      "const": "unique"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Fields that must be combined unique"
    },
    "scope": {
      "description": "Formula condition for scope (e.g. active = true)",
      "type": "string"
    },
    "caseSensitive": {
      "default": true,
      "type": "boolean"
    }
  },
  "required": [
    "name",
    "active",
    "events",
    "priority",
    "severity",
    "message",
    "type",
    "fields",
    "caseSensitive"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/data/UniquenessValidation.json",
  "x-spec-version": "3.0.11"
}