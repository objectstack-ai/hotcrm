{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "namespace": {
      "type": "string",
      "description": "Namespace prefix"
    },
    "packageId": {
      "type": "string",
      "description": "Owning package ID"
    },
    "registeredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "description": "Registration timestamp"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "disabled",
        "reserved"
      ],
      "description": "Namespace status"
    }
  },
  "required": [
    "namespace",
    "packageId",
    "registeredAt",
    "status"
  ],
  "additionalProperties": false,
  "description": "Namespace ownership entry in the registry",
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/NamespaceRegistryEntry.json",
  "x-spec-version": "3.0.11"
}