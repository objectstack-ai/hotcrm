{
  "name": "@hotcrm/financial-services",
  "version": "1.0.0",
  "type": "module",
  "description": "Financial Services module - Wealth Management, Portfolio, KYC, Compliance, and Advisory",
  "license": "MIT",
  "main": "./dist/plugin.js",
  "types": "./dist/plugin.d.ts",
