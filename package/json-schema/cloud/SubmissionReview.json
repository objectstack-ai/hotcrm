{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Review ID"
    },
    "submissionId": {
      "type": "string",
      "description": "Submission being reviewed"
    },
    "reviewerId": {
      "type": "string",
      "description": "Platform reviewer ID"
    },
    "decision": {
      "description": "Final decision",
      "type": "string",
      "enum": [
        "approved",
        "rejected",
        "changes-requested"
      ]
    },
    "criteria": {
      "description": "Review checklist results",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Criterion ID"
          },
          "category": {
            "type": "string",
            "enum": [
              "security",
              "performance",
              "quality",
              "ux",
              "documentation",
              "policy",
              "compatibility"
            ]
          },
          "description": {
            "type": "string"
          },
          "required": {
            "default": true,
            "type": "boolean"
          },
          "passed": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "category",
          "description",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "rejectionReasons": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "security-vulnerability",
          "policy-violation",
          "quality-below-standard",
          "misleading-metadata",
          "incompatible",
          "duplicate",
          "insufficient-documentation",
          "other"
        ]
      }
    },
    "feedback": {
      "description": "Detailed review feedback (Markdown)",
      "type": "string"
    },
    "internalNotes": {
      "description": "Internal reviewer notes",
      "type": "string"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "id",
    "submissionId",
    "reviewerId"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/cloud/SubmissionReview.json",
  "x-spec-version": "3.0.11"
}