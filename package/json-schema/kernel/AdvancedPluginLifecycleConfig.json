{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "health": {
      "type": "object",
      "properties": {
        "interval": {
          "default": 30000,
          "description": "How often to perform health checks (default: 30s)",
          "type": "integer",
          "minimum": 1000,
          "maximum": 9007199254740991
        },
        "timeout": {
          "default": 5000,
          "description": "Maximum time to wait for health check response",
          "type": "integer",
          "minimum": 100,
          "maximum": 9007199254740991
        },
        "failureThreshold": {
          "default": 3,
          "description": "Consecutive failures needed to mark unhealthy",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "successThreshold": {
          "default": 1,
          "description": "Consecutive successes needed to mark healthy",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "checkMethod": {
          "description": "Method name to call for health check",
          "type": "string"
        },
        "autoRestart": {
          "default": false,
          "description": "Automatically restart plugin on health check failure",
          "type": "boolean"
        },
        "maxRestartAttempts": {
          "default": 3,
          "description": "Maximum restart attempts before giving up",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "restartBackoff": {
          "default": "exponential",
          "description": "Backoff strategy for restart delays",
          "type": "string",
          "enum": [
            "fixed",
            "linear",
            "exponential"
          ]
        }
      },
      "required": [
        "interval",
        "timeout",
        "failureThreshold",
        "successThreshold",
        "autoRestart",
        "maxRestartAttempts",
        "restartBackoff"
      ],
      "additionalProperties": false
    },
    "hotReload": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "watchPatterns": {
          "description": "Glob patterns to watch for changes",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "debounceDelay": {
          "default": 1000,
          "description": "Wait time after change detection before reload",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "preserveState": {
          "default": true,
          "description": "Keep plugin state across reloads",
          "type": "boolean"
        },
        "stateStrategy": {
          "default": "memory",
          "description": "How to preserve state during reload",
          "type": "string",
          "enum": [
            "memory",
            "disk",
            "distributed",
            "none"
          ]
        },
        "distributedConfig": {
          "description": "Configuration for distributed state management",
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "redis",
                "etcd",
                "custom"
              ],
              "description": "Distributed state backend provider"
            },
            "endpoints": {
              "description": "Backend connection endpoints",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "keyPrefix": {
              "description": "Prefix for all keys (e.g., \"plugin:my-plugin:\")",
              "type": "string"
            },
            "ttl": {
              "description": "State expiration time in seconds",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "auth": {
              "type": "object",
              "properties": {
                "username": {
                  "type": "string"
                },
                "password": {
                  "type": "string"
                },
                "token": {
                  "type": "string"
                },
                "certificate": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "replication": {
              "type": "object",
              "properties": {
                "enabled": {
                  "default": true,
                  "type": "boolean"
                },
                "minReplicas": {
                  "default": 1,
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "enabled",
                "minReplicas"
              ],
              "additionalProperties": false
            },
            "customConfig": {
              "description": "Provider-specific configuration",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "provider"
          ],
          "additionalProperties": false
        },
        "shutdownTimeout": {
          "default": 30000,
          "description": "Maximum time to wait for graceful shutdown",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "beforeReload": {
          "description": "Hook names to call before reload",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "afterReload": {
          "description": "Hook names to call after reload",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "enabled",
        "debounceDelay",
        "preserveState",
        "stateStrategy",
        "shutdownTimeout"
      ],
      "additionalProperties": false
    },
    "degradation": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "fallbackMode": {
          "default": "minimal",
          "type": "string",
          "enum": [
            "minimal",
            "cached",
            "readonly",
            "offline",
            "disabled"
          ]
        },
        "criticalDependencies": {
          "description": "Plugin IDs that are required for operation",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optionalDependencies": {
          "description": "Plugin IDs that are nice to have but not required",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "degradedFeatures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "feature": {
                "type": "string",
                "description": "Feature name"
              },
              "enabled": {
                "type": "boolean",
                "description": "Whether feature is available in degraded mode"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "feature",
              "enabled"
            ],
            "additionalProperties": false
          }
        },
        "autoRecovery": {
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "retryInterval": {
              "default": 60000,
              "description": "Interval between recovery attempts (ms)",
              "type": "integer",
              "minimum": 1000,
              "maximum": 9007199254740991
            },
            "maxAttempts": {
              "default": 5,
              "description": "Maximum recovery attempts before giving up",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "enabled",
            "retryInterval",
            "maxAttempts"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "enabled",
        "fallbackMode"
      ],
      "additionalProperties": false
    },
    "updates": {
      "type": "object",
      "properties": {
        "mode": {
          "default": "manual",
          "type": "string",
          "enum": [
            "manual",
            "automatic",
            "scheduled",
            "rolling"
          ]
        },
        "autoUpdateConstraints": {
          "type": "object",
          "properties": {
            "major": {
              "default": false,
              "description": "Allow major version updates",
              "type": "boolean"
            },
            "minor": {
              "default": true,
              "description": "Allow minor version updates",
              "type": "boolean"
            },
            "patch": {
              "default": true,
              "description": "Allow patch version updates",
              "type": "boolean"
            }
          },
          "required": [
            "major",
            "minor",
            "patch"
          ],
          "additionalProperties": false
        },
        "schedule": {
          "type": "object",
          "properties": {
            "cron": {
              "type": "string"
            },
            "timezone": {
              "default": "UTC",
              "type": "string"
            },
            "maintenanceWindow": {
              "default": 60,
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "timezone",
            "maintenanceWindow"
          ],
          "additionalProperties": false
        },
        "rollback": {
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "automatic": {
              "default": true,
              "type": "boolean"
            },
            "keepVersions": {
              "default": 3,
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "timeout": {
              "default": 30000,
              "type": "integer",
              "minimum": 1000,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "enabled",
            "automatic",
            "keepVersions",
            "timeout"
          ],
          "additionalProperties": false
        },
        "validation": {
          "type": "object",
          "properties": {
            "checkCompatibility": {
              "default": true,
              "type": "boolean"
            },
            "runTests": {
              "default": false,
              "type": "boolean"
            },
            "testSuite": {
              "type": "string"
            }
          },
          "required": [
            "checkCompatibility",
            "runTests"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "properties": {
        "maxMemory": {
          "description": "Maximum memory in bytes",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "maxCpu": {
          "description": "Maximum CPU percentage",
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "maxConnections": {
          "description": "Maximum concurrent connections",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "timeout": {
          "description": "Operation timeout in milliseconds",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "observability": {
      "type": "object",
      "properties": {
        "enableMetrics": {
          "default": true,
          "type": "boolean"
        },
        "enableTracing": {
          "default": true,
          "type": "boolean"
        },
        "enableProfiling": {
          "default": false,
          "type": "boolean"
        },
        "metricsInterval": {
          "default": 60000,
          "description": "Metrics collection interval in ms",
          "type": "integer",
          "minimum": 1000,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "enableMetrics",
        "enableTracing",
        "enableProfiling",
        "metricsInterval"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/AdvancedPluginLifecycleConfig.json",
  "x-spec-version": "3.0.11"
}