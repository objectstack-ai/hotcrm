    "2xl": {
      "description": "2X large breakpoint (e.g., 1536px)",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ui/Breakpoints.json",
  "x-spec-version": "3.0.11"
