{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "uploadId": {
      "type": "string",
      "description": "Multipart upload session ID"
    },
    "chunkIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Zero-based chunk index"
    },
    "resumeToken": {
      "type": "string",
      "description": "Resume token from initiate response"
    }
  },
  "required": [
    "uploadId",
    "chunkIndex",
    "resumeToken"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/UploadChunkRequest.json",
  "x-spec-version": "3.0.11"
}