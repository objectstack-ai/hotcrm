{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "default": "cron",
      "type": "string",
      "enum": [
        "cron",
        "interval",
        "daily",
        "weekly",
        "monthly"
      ]
    },
    "cron": {
      "description": "Cron expression (required if type is \"cron\")",
      "type": "string"
    },
    "interval": {
      "description": "Interval in minutes (required if type is \"interval\")",
      "type": "number"
    },
    "time": {
      "description": "Time of day for daily schedules (HH:MM format)",
      "type": "string"
    },
    "dayOfWeek": {
      "description": "Day of week for weekly (0=Sunday)",
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "dayOfMonth": {
      "description": "Day of month for monthly",
      "type": "integer",
      "minimum": 1,
      "maximum": 31
    },
    "timezone": {
      "default": "UTC",
      "type": "string"
    }
  },
  "required": [
    "type",
    "timezone"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/WorkflowSchedule.json",
  "x-spec-version": "3.0.11"
}