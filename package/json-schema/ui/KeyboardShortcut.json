{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Key combination (e.g., \"Ctrl+S\", \"Alt+N\", \"Escape\")"
    },
    "action": {
      "type": "string",
      "description": "Action identifier to invoke when shortcut is triggered"
    },
    "description": {
      "description": "Human-readable description of what the shortcut does",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Translation key (e.g., \"views.task_list.label\")"
            },
            "defaultValue": {
              "description": "Fallback value when translation key is not found",
              "type": "string"
            },
            "params": {
              "description": "Interpolation parameters (e.g., { count: 5 })",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        }
      ]
    },
    "scope": {
      "default": "global",
      "description": "Scope in which this shortcut is active",
      "type": "string",
      "enum": [
        "global",
        "view",
        "form",
        "modal",
        "list"
      ]
    }
  },
  "required": [
    "key",
    "action",
    "scope"
  ],
  "additionalProperties": false,
  "description": "Keyboard shortcut binding",
  "$id": "https://schema.objectstack.io/v3.0.11/ui/KeyboardShortcut.json",
  "x-spec-version": "3.0.11"
}