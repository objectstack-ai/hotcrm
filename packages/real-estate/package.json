{
  "name": "@hotcrm/real-estate",
  "version": "1.0.0",
  "type": "module",
  "description": "Real Estate module - Property Management, Listings, Showings, Offers, and Commission Tracking",
  "license": "MIT",
  "main": "./dist/plugin.js",
  "types": "./dist/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "objectstack dev",
    "start": "objectstack serve",
    "build": "pnpm exec tsc && objectstack compile",
    "typecheck": "tsc --noEmit",
    "test": "objectstack test"
  },
  "keywords": [
    "real-estate",
    "property",
    "listing",
    "showing",
    "commission"
  ],
  "author": "HotCRM Team",
  "dependencies": {
    "@objectstack/spec": "^3.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@objectstack/cli": "^3.0.3",
    "typescript": "^5.9.3"
  }
}
