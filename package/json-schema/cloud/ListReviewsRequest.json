{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "listingId": {
      "type": "string",
      "description": "Listing to get reviews for"
    },
    "sortBy": {
      "default": "newest",
      "type": "string",
      "enum": [
        "newest",
        "oldest",
        "highest",
        "lowest",
        "most-helpful"
      ]
    },
    "rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "page": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "pageSize": {
      "default": 10,
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    }
  },
  "required": [
    "listingId",
    "sortBy",
    "page",
    "pageSize"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/cloud/ListReviewsRequest.json",
  "x-spec-version": "3.0.11"
}