{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": true,
      "type": "boolean"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "cpu-usage",
          "memory-usage",
          "response-time",
          "error-rate",
          "throughput",
          "latency",
          "connection-count",
          "queue-depth"
        ]
      }
    },
    "algorithm": {
      "default": "hybrid",
      "type": "string",
      "enum": [
        "statistical",
        "machine-learning",
        "heuristic",
        "hybrid"
      ]
    },
    "sensitivity": {
      "default": "medium",
      "description": "How aggressively to detect anomalies",
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "timeWindow": {
      "default": 300,
      "description": "Historical data window for anomaly detection",
      "type": "integer",
      "minimum": 60,
      "maximum": 9007199254740991
    },
    "confidenceThreshold": {
      "default": 80,
      "description": "Minimum confidence to flag as anomaly",
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "alertOnDetection": {
      "default": true,
      "type": "boolean"
    }
  },
  "required": [
    "enabled",
    "metrics",
    "algorithm",
    "sensitivity",
    "timeWindow",
    "confidenceThreshold",
    "alertOnDetection"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/AnomalyDetectionConfig.json",
  "x-spec-version": "3.0.11"
}