{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$",
      "description": "Prompt template name (snake_case)"
    },
    "description": {
      "description": "Prompt description",
      "type": "string"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant"
            ],
            "description": "Message role"
          },
          "content": {
            "type": "string",
            "description": "Message content (can include {{variable}} placeholders)"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "additionalProperties": false
      },
      "description": "Prompt message sequence"
    },
    "arguments": {
      "description": "Dynamic arguments for the prompt",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Argument name"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "default": "string",
            "type": "string",
            "enum": [
              "string",
              "number",
              "boolean"
            ]
          },
          "required": {
            "default": false,
            "type": "boolean"
          },
          "default": {}
        },
        "required": [
          "name",
          "type",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "category": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "version": {
      "default": "1.0.0",
      "type": "string"
    }
  },
  "required": [
    "name",
    "messages",
    "version"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/MCPPrompt.json",
  "x-spec-version": "3.0.11"
}