      "type": "string",
      "description": "Notification title"
    },
    "body": {
      "type": "string",
      "description": "Notification body"
    },
    "icon": {
      "description": "Notification icon URL",
      "type": "string",
      "format": "uri"
    },
    "badge": {
      "description": "Badge count",
      "type": "number"
    },
