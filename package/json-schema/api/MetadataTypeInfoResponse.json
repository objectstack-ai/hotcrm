{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "success": {
      "type": "boolean",
      "description": "Operation success status"
    },
    "error": {
      "description": "Error details if success is false",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Error code (e.g. validation_error)"
        },
        "message": {
          "type": "string",
          "description": "Readable error message"
        },
        "category": {
          "description": "Error category (e.g. validation, authorization)",
          "type": "string"
        },
        "details": {
          "description": "Additional error context (e.g. field validation errors)"
        },
        "requestId": {
          "description": "Request ID for tracking",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "meta": {
      "description": "Response metadata",
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "string"
        },
        "duration": {
          "type": "number"
        },
        "requestId": {
          "type": "string"
        },
        "traceId": {
          "type": "string"
        }
      },
      "required": [
        "timestamp"
      ],
      "additionalProperties": false
    },
    "data": {
      "description": "Type info",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "Metadata type identifier"
        },
        "label": {
          "type": "string",
          "description": "Display label"
        },
        "description": {
          "description": "Description",
          "type": "string"
        },
        "filePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "File glob patterns"
        },
        "supportsOverlay": {
          "type": "boolean",
          "description": "Overlay support"
        },
        "domain": {
          "type": "string",
          "description": "Protocol domain"
        }
      },
      "required": [
        "type",
        "label",
        "filePatterns",
        "supportsOverlay",
        "domain"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "success"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/MetadataTypeInfoResponse.json",
  "x-spec-version": "3.0.11"
}