{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "modelId": {
      "type": "string",
      "description": "Model from registry"
    },
    "systemPrompt": {
      "description": "System prompt override",
      "type": "string"
    },
    "includeSchema": {
      "default": true,
      "description": "Include object schema in prompt",
      "type": "boolean"
    },
    "includeExamples": {
      "default": true,
      "description": "Include examples in prompt",
      "type": "boolean"
    },
    "enableIntentDetection": {
      "default": true,
      "type": "boolean"
    },
    "intentThreshold": {
      "default": 0.7,
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "enableEntityRecognition": {
      "default": true,
      "type": "boolean"
    },
    "entityRecognitionModel": {
      "type": "string"
    },
    "enableFuzzyMatching": {
      "default": true,
      "description": "Fuzzy match field names",
      "type": "boolean"
    },
    "fuzzyMatchThreshold": {
      "default": 0.8,
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "enableTimeframeDetection": {
      "default": true,
      "type": "boolean"
    },
    "defaultTimeframe": {
      "description": "Default timeframe if not specified",
      "type": "string"
    },
    "enableCaching": {
      "default": true,
      "type": "boolean"
    },
    "cacheTTL": {
      "default": 3600,
      "description": "Cache TTL in seconds",
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "modelId",
    "includeSchema",
    "includeExamples",
    "enableIntentDetection",
    "intentThreshold",
    "enableEntityRecognition",
    "enableFuzzyMatching",
    "fuzzyMatchThreshold",
    "enableTimeframeDetection",
    "enableCaching",
    "cacheTTL"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/NLQModelConfig.json",
  "x-spec-version": "3.0.11"
}