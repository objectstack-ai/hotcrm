{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "success": {
      "type": "boolean",
      "description": "Operation success status"
    },
    "error": {
      "description": "Error details if success is false",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Error code (e.g. validation_error)"
        },
        "message": {
          "type": "string",
          "description": "Readable error message"
        },
        "category": {
          "description": "Error category (e.g. validation, authorization)",
          "type": "string"
        },
        "details": {
          "description": "Additional error context (e.g. field validation errors)"
        },
        "requestId": {
          "description": "Request ID for tracking",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "meta": {
      "description": "Response metadata",
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "string"
        },
        "duration": {
          "type": "number"
        },
        "requestId": {
          "type": "string"
        },
        "traceId": {
          "type": "string"
        }
      },
      "required": [
        "timestamp"
      ],
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Feed item ID"
        },
        "type": {
          "type": "string",
          "enum": [
            "comment",
            "field_change",
            "task",
            "event",
            "email",
            "call",
            "note",
            "file",
            "record_create",
            "record_delete",
            "approval",
            "sharing",
            "system"
          ],
          "description": "Activity type"
        },
        "object": {
          "type": "string",
          "description": "Object name (e.g., \"account\")"
        },
        "recordId": {
          "type": "string",
          "description": "Record ID this feed item belongs to"
        },
        "actor": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "user",
                "system",
                "service",
                "automation"
              ],
              "description": "Actor type"
            },
            "id": {
              "type": "string",
              "description": "Actor ID"
            },
            "name": {
              "description": "Actor display name",
              "type": "string"
            },
            "avatarUrl": {
              "description": "Actor avatar URL",
              "type": "string",
              "format": "uri"
            },
            "source": {
              "description": "Source application (e.g., \"Omni\", \"API\", \"Studio\")",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false,
          "description": "Who performed this action"
        },
        "body": {
          "description": "Rich text body (Markdown supported)",
          "type": "string"
        },
        "mentions": {
          "description": "Mentioned users/teams/records",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "user",
                  "team",
                  "record"
                ],
                "description": "Mention target type"
              },
              "id": {
                "type": "string",
                "description": "Target ID"
              },
              "name": {
                "type": "string",
                "description": "Display name for rendering"
              },
              "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Character offset in body text"
              },
              "length": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991,
                "description": "Length of mention token in body text"
              }
            },
            "required": [
              "type",
              "id",
              "name",
              "offset",
              "length"
            ],
            "additionalProperties": false
          }
        },
        "changes": {
          "description": "Field-level changes",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "description": "Field machine name"
              },
              "fieldLabel": {
                "description": "Field display label",
                "type": "string"
              },
              "oldValue": {
                "description": "Previous value"
              },
              "newValue": {
                "description": "New value"
              },
              "oldDisplayValue": {
                "description": "Human-readable old value",
                "type": "string"
              },
              "newDisplayValue": {
                "description": "Human-readable new value",
                "type": "string"
              }
            },
            "required": [
              "field"
            ],
            "additionalProperties": false
          }
        },
        "reactions": {
          "description": "Emoji reactions on this item",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "emoji": {
                "type": "string",
                "description": "Emoji character or shortcode (e.g., \"👍\", \":thumbsup:\")"
              },
              "userIds": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Users who reacted"
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991,
                "description": "Total reaction count"
              }
            },
            "required": [
              "emoji",
              "userIds",
              "count"
            ],
            "additionalProperties": false
          }
        },
        "parentId": {
          "description": "Parent feed item ID for threaded replies",
          "type": "string"
        },
        "replyCount": {
          "default": 0,
          "description": "Number of replies",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pinned": {
          "default": false,
          "description": "Whether the feed item is pinned to the top of the timeline",
          "type": "boolean"
        },
        "pinnedAt": {
          "description": "Timestamp when the item was pinned",
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "pinnedBy": {
          "description": "User ID who pinned the item",
          "type": "string"
        },
        "starred": {
          "default": false,
          "description": "Whether the feed item is starred/bookmarked by the current user",
          "type": "boolean"
        },
        "starredAt": {
          "description": "Timestamp when the item was starred",
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "visibility": {
          "default": "public",
          "description": "Visibility: public (all users), internal (team only), private (author + mentioned)",
          "type": "string",
          "enum": [
            "public",
            "internal",
            "private"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "description": "Last update timestamp",
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "editedAt": {
          "description": "When comment was last edited",
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "isEdited": {
          "default": false,
          "description": "Whether comment has been edited",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "type",
        "object",
        "recordId",
        "actor",
        "replyCount",
        "pinned",
        "starred",
        "visibility",
        "createdAt",
        "isEdited"
      ],
      "additionalProperties": false,
      "description": "The updated feed item"
    }
  },
  "required": [
    "success",
    "data"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/UpdateFeedItemResponse.json",
  "x-spec-version": "3.0.11"
}