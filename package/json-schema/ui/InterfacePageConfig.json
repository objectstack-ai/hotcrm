{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "source": {
      "description": "Source object name for the page",
      "type": "string"
    },
    "levels": {
      "description": "Number of hierarchy levels to display",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "filterBy": {
      "description": "Page-level filter criteria",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "Field name to filter on"
          },
          "operator": {
            "type": "string",
            "description": "Filter operator (e.g. equals, not_equals, contains, this_quarter)"
          },
          "value": {
            "description": "Filter value",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    }
                  ]
                }
              }
            ]
          }
        },
        "required": [
          "field",
          "operator"
        ],
        "additionalProperties": false,
        "description": "View filter rule"
      }
    },
    "appearance": {
      "description": "Appearance and visualization configuration",
      "type": "object",
      "properties": {
        "showDescription": {
          "default": true,
          "description": "Show the view description text",
          "type": "boolean"
        },
        "allowedVisualizations": {
          "description": "Whitelist of visualization types users can switch between (e.g. [\"grid\", \"gallery\", \"kanban\"])",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "grid",
              "kanban",
              "gallery",
              "calendar",
              "timeline",
              "gantt",
              "map"
            ],
            "description": "Visualization type that users can switch to"
          }
        }
      },
      "required": [
        "showDescription"
      ],
      "additionalProperties": false
    },
    "userFilters": {
      "description": "User filter configuration",
      "type": "object",
      "properties": {
        "elements": {
          "description": "Visualization element types available in user filter bar",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "grid",
              "gallery",
              "kanban"
            ]
          }
        },
        "tabs": {
          "description": "User-configurable tabs",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 2,
                "pattern": "^[a-z][a-z0-9_]*$",
                "description": "Tab identifier (snake_case)"
              },
              "label": {
                "description": "Display label",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "description": "Translation key (e.g., \"views.task_list.label\")"
                      },
                      "defaultValue": {
                        "description": "Fallback value when translation key is not found",
                        "type": "string"
                      },
                      "params": {
                        "description": "Interpolation parameters (e.g., { count: 5 })",
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "number"
                            },
                            {
                              "type": "boolean"
                            }
                          ]
                        }
                      }
                    },
                    "required": [
                      "key"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "icon": {
                "description": "Tab icon name",
                "type": "string"
              },
              "view": {
                "description": "Referenced list view name from listViews",
                "type": "string"
              },
              "filter": {
                "description": "Tab-specific filter criteria",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "description": "Field name to filter on"
                    },
                    "operator": {
                      "type": "string",
                      "description": "Filter operator (e.g. equals, not_equals, contains, this_quarter)"
                    },
                    "value": {
                      "description": "Filter value",
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        },
                        {
                          "type": "array",
                          "items": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "number"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  "required": [
                    "field",
                    "operator"
                  ],
                  "additionalProperties": false,
                  "description": "View filter rule"
                }
              },
              "order": {
                "description": "Tab display order",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "pinned": {
                "default": false,
                "description": "Pin tab (cannot be removed by users)",
                "type": "boolean"
              },
              "isDefault": {
                "default": false,
                "description": "Set as the default active tab",
                "type": "boolean"
              },
              "visible": {
                "default": true,
                "description": "Tab visibility",
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "pinned",
              "isDefault",
              "visible"
            ],
            "additionalProperties": false,
            "description": "Tab configuration for multi-tab view interface"
          }
        }
      },
      "additionalProperties": false
    },
    "userActions": {
      "description": "User action toggles",
      "type": "object",
      "properties": {
        "sort": {
          "default": true,
          "description": "Allow users to sort records",
          "type": "boolean"
        },
        "search": {
          "default": true,
          "description": "Allow users to search records",
          "type": "boolean"
        },
        "filter": {
          "default": true,
          "description": "Allow users to filter records",
          "type": "boolean"
        },
        "rowHeight": {
          "default": true,
          "description": "Allow users to toggle row height/density",
          "type": "boolean"
        },
        "addRecordForm": {
          "default": false,
          "description": "Add records through a form instead of inline",
          "type": "boolean"
        },
        "buttons": {
          "description": "Custom action button IDs to show in the toolbar",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "sort",
        "search",
        "filter",
        "rowHeight",
        "addRecordForm"
      ],
      "additionalProperties": false
    },
    "addRecord": {
      "description": "Add record entry point configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Show the add record entry point",
          "type": "boolean"
        },
        "position": {
          "default": "bottom",
          "description": "Position of the add record button",
          "type": "string",
          "enum": [
            "top",
            "bottom",
            "both"
          ]
        },
        "mode": {
          "default": "inline",
          "description": "How to add a new record",
          "type": "string",
          "enum": [
            "inline",
            "form",
            "modal"
          ]
        },
        "formView": {
          "description": "Named form view to use when mode is \"form\" or \"modal\"",
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "position",
        "mode"
      ],
      "additionalProperties": false
    },
    "showRecordCount": {
      "description": "Show record count at page bottom",
      "type": "boolean"
    },
    "allowPrinting": {
      "description": "Allow users to print the page",
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "description": "Interface-level page configuration (Airtable parity)",
  "$id": "https://schema.objectstack.io/v3.0.11/ui/InterfacePageConfig.json",
  "x-spec-version": "3.0.11"
}