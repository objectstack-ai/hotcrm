{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workerName": {
      "type": "string",
      "description": "Worker name"
    },
    "totalProcessed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Total tasks processed"
    },
    "succeeded": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Successful tasks"
    },
    "failed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Failed tasks"
    },
    "active": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Currently active tasks"
    },
    "avgExecutionMs": {
      "description": "Average execution time in milliseconds",
      "type": "number",
      "minimum": 0
    },
    "uptimeMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Worker uptime in milliseconds"
    },
    "queues": {
      "description": "Per-queue statistics",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "pending": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Pending tasks"
          },
          "active": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Active tasks"
          },
          "completed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Completed tasks"
          },
          "failed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Failed tasks"
          }
        },
        "required": [
          "pending",
          "active",
          "completed",
          "failed"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "workerName",
    "totalProcessed",
    "succeeded",
    "failed",
    "active",
    "uptimeMs"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/system/WorkerStats.json",
  "x-spec-version": "3.0.11"
}