{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "connector": {
      "type": "string",
      "description": "GitHub connector name"
    },
    "repository": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string",
          "description": "Repository owner"
        },
        "name": {
          "type": "string",
          "description": "Repository name"
        }
      },
      "required": [
        "owner",
        "name"
      ],
      "additionalProperties": false,
      "description": "Repository configuration"
    },
    "featureBranch": {
      "default": "develop",
      "description": "Default feature branch",
      "type": "string"
    },
    "pullRequest": {
      "description": "Pull request settings",
      "type": "object",
      "properties": {
        "autoCreate": {
          "default": true,
          "description": "Automatically create PRs",
          "type": "boolean"
        },
        "autoMerge": {
          "default": false,
          "description": "Automatically merge PRs when checks pass",
          "type": "boolean"
        },
        "requireReviews": {
          "default": true,
          "description": "Require reviews before merge",
          "type": "boolean"
        },
        "deleteBranchOnMerge": {
          "default": true,
          "description": "Delete feature branch after merge",
          "type": "boolean"
        }
      },
      "required": [
        "autoCreate",
        "autoMerge",
        "requireReviews",
        "deleteBranchOnMerge"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "connector",
    "repository",
    "featureBranch"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/GitHubIntegration.json",
  "x-spec-version": "3.0.11"
}