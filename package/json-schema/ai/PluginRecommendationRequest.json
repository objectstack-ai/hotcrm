{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "context": {
      "type": "object",
      "properties": {
        "installedPlugins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "industry": {
          "type": "string"
        },
        "useCases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "teamSize": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "budget": {
          "type": "string",
          "enum": [
            "free",
            "low",
            "medium",
            "high",
            "unlimited"
          ]
        }
      },
      "additionalProperties": false
    },
    "criteria": {
      "type": "object",
      "properties": {
        "prioritize": {
          "type": "string",
          "enum": [
            "popularity",
            "rating",
            "compatibility",
            "features",
            "cost",
            "support"
          ]
        },
        "certifiedOnly": {
          "default": false,
          "type": "boolean"
        },
        "minRating": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "maxResults": {
          "default": 10,
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": [
        "certifiedOnly",
        "maxResults"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "context"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/PluginRecommendationRequest.json",
  "x-spec-version": "3.0.11"
}