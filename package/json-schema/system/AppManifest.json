{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$",
      "description": "App identifier (snake_case)"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "description": "App display label"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "App version (semver)"
    },
    "description": {
      "description": "App description",
      "type": "string"
    },
    "minKernelVersion": {
      "description": "Minimum required kernel version",
      "type": "string"
    },
    "objects": {
      "default": [],
      "description": "Object names provided",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "views": {
      "default": [],
      "description": "View names provided",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "flows": {
      "default": [],
      "description": "Flow names provided",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hasSeedData": {
      "default": false,
      "description": "Whether app includes seed data",
      "type": "boolean"
    },
    "seedData": {
      "default": [],
      "description": "Seed data records",
      "type": "array",
      "items": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    },
    "dependencies": {
      "default": [],
      "description": "Required app dependencies",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "name",
    "label",
    "version",
    "objects",
    "views",
    "flows",
    "hasSeedData",
    "seedData",
    "dependencies"
  ],
  "additionalProperties": false,
  "description": "App manifest for marketplace installation",
  "$id": "https://schema.objectstack.io/v3.0.11/system/AppManifest.json",
  "x-spec-version": "3.0.11"
}