{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "stream": {
      "default": "stdout",
      "type": "string",
      "enum": [
        "stdout",
        "stderr"
      ]
    },
    "colors": {
      "default": true,
      "type": "boolean"
    },
    "prettyPrint": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "stream",
    "colors",
    "prettyPrint"
  ],
  "additionalProperties": false,
  "description": "Console destination configuration",
  "$id": "https://schema.objectstack.io/v3.0.11/system/ConsoleDestinationConfig.json",
  "x-spec-version": "3.0.11"
}