{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "enum": [
        "stopped",
        "starting",
        "running",
        "stopping",
        "error"
      ],
      "description": "Current server state"
    },
    "uptime": {
      "description": "Server uptime in milliseconds",
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "server": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Listening port"
        },
        "host": {
          "type": "string",
          "description": "Bound host"
        },
        "url": {
          "description": "Full server URL",
          "type": "string"
        }
      },
      "required": [
        "port",
        "host"
      ],
      "additionalProperties": false
    },
    "connections": {
      "type": "object",
      "properties": {
        "active": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Active connections"
        },
        "total": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Total connections handled"
        }
      },
      "required": [
        "active",
        "total"
      ],
      "additionalProperties": false
    },
    "requests": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Total requests processed"
        },
        "success": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Successful requests"
        },
        "errors": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Failed requests"
        }
      },
      "required": [
        "total",
        "success",
        "errors"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "state"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/system/ServerStatus.json",
  "x-spec-version": "3.0.11"
}