{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "owner": {
      "description": "Owner team or person",
      "type": "string"
    },
    "status": {
      "default": "active",
      "description": "API lifecycle status",
      "type": "string",
      "enum": [
        "active",
        "deprecated",
        "experimental",
        "beta"
      ]
    },
    "tags": {
      "default": [],
      "description": "Classification tags",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pluginSource": {
      "description": "Source plugin name",
      "type": "string"
    },
    "custom": {
      "description": "Custom metadata fields",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "status",
    "tags"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/ApiMetadata.json",
  "x-spec-version": "3.0.11"
}