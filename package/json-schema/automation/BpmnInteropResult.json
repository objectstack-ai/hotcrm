{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "success": {
      "type": "boolean",
      "description": "Whether the operation completed successfully"
    },
    "diagnostics": {
      "default": [],
      "description": "Diagnostic messages from the operation",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error"
            ],
            "description": "Diagnostic severity"
          },
          "message": {
            "type": "string",
            "description": "Diagnostic message"
          },
          "bpmnElementId": {
            "description": "BPMN element ID related to this diagnostic",
            "type": "string"
          },
          "nodeId": {
            "description": "ObjectStack node ID related to this diagnostic",
            "type": "string"
          }
        },
        "required": [
          "severity",
          "message"
        ],
        "additionalProperties": false,
        "description": "Diagnostic message from BPMN import/export"
      }
    },
    "mappedCount": {
      "default": 0,
      "description": "Number of elements successfully mapped",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "unmappedCount": {
      "default": 0,
      "description": "Number of elements that could not be mapped",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "success",
    "diagnostics",
    "mappedCount",
    "unmappedCount"
  ],
  "additionalProperties": false,
  "description": "Result of a BPMN import/export operation",
  "$id": "https://schema.objectstack.io/v3.0.11/automation/BpmnInteropResult.json",
  "x-spec-version": "3.0.11"
}