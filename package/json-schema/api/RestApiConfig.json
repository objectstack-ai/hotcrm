{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "default": "v1",
      "description": "API version (e.g., v1, v2, 2024-01)",
      "type": "string",
      "pattern": "^[a-zA-Z0-9_\\-\\.]+$"
    },
    "basePath": {
      "default": "/api",
      "description": "Base URL path for API",
      "type": "string"
    },
    "apiPath": {
      "description": "Full API path (defaults to {basePath}/{version})",
      "type": "string"
    },
    "enableCrud": {
      "default": true,
      "description": "Enable automatic CRUD endpoint generation",
      "type": "boolean"
    },
    "enableMetadata": {
      "default": true,
      "description": "Enable metadata API endpoints",
      "type": "boolean"
    },
    "enableUi": {
      "default": true,
      "description": "Enable UI API endpoints (Views, Menus, Layouts)",
      "type": "boolean"
    },
    "enableBatch": {
      "default": true,
      "description": "Enable batch operation endpoints",
      "type": "boolean"
    },
    "enableDiscovery": {
      "default": true,
      "description": "Enable API discovery endpoint",
      "type": "boolean"
    },
    "documentation": {
      "description": "OpenAPI/Swagger documentation config",
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Enable API documentation",
          "type": "boolean"
        },
        "title": {
          "default": "ObjectStack API",
          "description": "API documentation title",
          "type": "string"
        },
        "description": {
          "description": "API description",
          "type": "string"
        },
        "version": {
          "description": "Documentation version",
          "type": "string"
        },
        "termsOfService": {
          "description": "Terms of service URL",
          "type": "string"
        },
        "contact": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "email": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "license": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "enabled",
        "title"
      ],
      "additionalProperties": false
    },
    "responseFormat": {
      "description": "Response format options",
      "type": "object",
      "properties": {
        "envelope": {
          "default": true,
          "description": "Wrap responses in standard envelope",
          "type": "boolean"
        },
        "includeMetadata": {
          "default": true,
          "description": "Include response metadata (timestamp, requestId)",
          "type": "boolean"
        },
        "includePagination": {
          "default": true,
          "description": "Include pagination info in list responses",
          "type": "boolean"
        }
      },
      "required": [
        "envelope",
        "includeMetadata",
        "includePagination"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "basePath",
    "enableCrud",
    "enableMetadata",
    "enableUi",
    "enableBatch",
    "enableDiscovery"
  ],
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/api/RestApiConfig.json",
  "x-spec-version": "3.0.11"
}