{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "direction": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "up",
          "down",
          "left",
          "right"
        ]
      },
      "description": "Allowed swipe directions"
    },
    "threshold": {
      "description": "Minimum distance in pixels to recognize swipe",
      "type": "number"
    },
    "velocity": {
      "description": "Minimum velocity (px/ms) to trigger swipe",
      "type": "number"
    }
  },
  "required": [
    "direction"
  ],
  "additionalProperties": false,
  "description": "Swipe gesture recognition settings",
  "$id": "https://schema.objectstack.io/v3.0.11/ui/SwipeGestureConfig.json",
  "x-spec-version": "3.0.11"
}