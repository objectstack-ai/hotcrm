{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "includePatterns": {
      "description": "File patterns to include (glob)",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excludePatterns": {
      "description": "File patterns to exclude (glob)",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "minFileSize": {
      "description": "Minimum file size in bytes",
      "type": "number",
      "minimum": 0
    },
    "maxFileSize": {
      "description": "Maximum file size in bytes",
      "type": "number",
      "minimum": 1
    },
    "allowedExtensions": {
      "description": "Allowed file extensions",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockedExtensions": {
      "description": "Blocked file extensions",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/integration/FileFilterConfig.json",
  "x-spec-version": "3.0.11"
}