{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "object": {
      "description": "Object name (for object-specific navigation)",
      "type": "string"
    },
    "recordId": {
      "description": "Record ID (for detail page)",
      "type": "string"
    },
    "viewType": {
      "type": "string",
      "enum": [
        "list",
        "form",
        "detail",
        "kanban",
        "calendar",
        "gantt"
      ]
    },
    "dashboardId": {
      "description": "Dashboard ID",
      "type": "string"
    },
    "reportId": {
      "description": "Report ID",
      "type": "string"
    },
    "appName": {
      "description": "App name",
      "type": "string"
    },
    "mode": {
      "description": "Form mode",
      "type": "string",
      "enum": [
        "new",
        "edit",
        "view"
      ]
    },
    "openInNewTab": {
      "description": "Open in new tab",
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "$id": "https://schema.objectstack.io/v3.0.11/ai/NavigationActionParams.json",
  "x-spec-version": "3.0.11"
}