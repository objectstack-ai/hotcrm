{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "coverField": {
      "description": "Attachment/image field to display as card cover",
      "type": "string"
    },
    "coverFit": {
      "default": "cover",
      "description": "Image fit mode for card cover",
      "type": "string",
      "enum": [
        "cover",
        "contain"
      ]
    },
    "cardSize": {
      "default": "medium",
      "description": "Card size in gallery view",
      "type": "string",
      "enum": [
        "small",
        "medium",
        "large"
      ]
    },
    "titleField": {
      "description": "Field to display as card title",
      "type": "string"
    },
    "visibleFields": {
      "description": "Fields to display on card body",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "coverFit",
    "cardSize"
  ],
  "additionalProperties": false,
  "description": "Gallery/card view configuration",
  "$id": "https://schema.objectstack.io/v3.0.11/ui/GalleryConfig.json",
  "x-spec-version": "3.0.11"
}