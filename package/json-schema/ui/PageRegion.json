{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Region name (e.g. \"sidebar\", \"main\", \"header\")"
    },
    "width": {
      "type": "string",
      "enum": [
        "small",
        "medium",
        "large",
        "full"
      ]
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "page:header",
                  "page:footer",
                  "page:sidebar",
                  "page:tabs",
                  "page:accordion",
                  "page:card",
                  "page:section",
                  "record:details",
                  "record:highlights",
                  "record:related_list",
                  "record:activity",
                  "record:chatter",
                  "record:path",
                  "app:launcher",
                  "nav:menu",
                  "nav:breadcrumb",
                  "global:search",
                  "global:notifications",
                  "user:profile",
                  "ai:chat_window",
                  "ai:suggestion",
                  "element:text",
                  "element:number",
                  "element:image",
                  "element:divider",
                  "element:button",
                  "element:filter",
                  "element:form",
                  "element:record_picker"
                ]
              },
              {
                "type": "string"
              }
            ],
            "description": "Component Type (Standard enum or custom string)"
          },
          "id": {
            "description": "Unique instance ID",
            "type": "string"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "description": "Translation key (e.g., \"views.task_list.label\")"
                  },
                  "defaultValue": {
                    "description": "Fallback value when translation key is not found",
                    "type": "string"
                  },
                  "params": {
                    "description": "Interpolation parameters (e.g., { count: 5 })",
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "key"
                ],
                "additionalProperties": false
              }
            ],
            "description": "Display label: plain string or i18n translation object"
          },
          "properties": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {},
            "description": "Component props passed to the widget. See component.zod.ts for schemas."
          },
          "events": {
            "description": "Event handlers map",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "style": {
            "description": "Inline styles or utility classes",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "className": {
            "description": "CSS class names",
            "type": "string"
          },
          "visibility": {
            "description": "Visibility filter/formula",
            "type": "string"
          },
          "dataSource": {
            "description": "Per-element data binding for multi-object pages",
            "type": "object",
            "properties": {
              "object": {
                "type": "string",
                "description": "Object to query"
              },
              "view": {
                "description": "Named view to apply",
                "type": "string"
              },
              "filter": {
                "description": "Additional filter criteria",
                "$ref": "#/$defs/__schema0"
              },
              "sort": {
                "description": "Sort order",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "description": "Field name to sort by"
                    },
                    "order": {
                      "type": "string",
                      "enum": [
                        "asc",
                        "desc"
                      ],
                      "description": "Sort direction"
                    }
                  },
                  "required": [
                    "field",
                    "order"
                  ],
                  "additionalProperties": false,
                  "description": "Sort field and direction pair"
                }
              },
              "limit": {
                "description": "Max records to display",
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "object"
            ],
            "additionalProperties": false
          },
          "responsive": {
            "description": "Responsive layout configuration",
            "type": "object",
            "properties": {
              "breakpoint": {
                "description": "Minimum breakpoint for visibility",
                "type": "string",
                "enum": [
                  "xs",
                  "sm",
                  "md",
                  "lg",
                  "xl",
                  "2xl"
                ]
              },
              "hiddenOn": {
                "description": "Hide on these breakpoints",
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "xs",
                    "sm",
                    "md",
                    "lg",
                    "xl",
                    "2xl"
                  ]
                }
              },
              "columns": {
                "description": "Grid columns per breakpoint",
                "type": "object",
                "properties": {
                  "xs": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 12
                  },
                  "sm": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 12
                  },
                  "md": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 12
                  },
                  "lg": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 12
                  },
                  "xl": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 12
                  },
                  "2xl": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 12
                  }
                },
                "additionalProperties": false
              },
              "order": {
                "description": "Display order per breakpoint",
                "type": "object",
                "properties": {
                  "xs": {
                    "type": "number"
                  },
                  "sm": {
                    "type": "number"
                  },
                  "md": {
                    "type": "number"
                  },
                  "lg": {
                    "type": "number"
                  },
                  "xl": {
                    "type": "number"
                  },
                  "2xl": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "aria": {
            "description": "ARIA accessibility attributes",
            "type": "object",
            "properties": {
              "ariaLabel": {
                "description": "Accessible label for screen readers (WAI-ARIA aria-label)",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "description": "Translation key (e.g., \"views.task_list.label\")"
                      },
                      "defaultValue": {
                        "description": "Fallback value when translation key is not found",
                        "type": "string"
                      },
                      "params": {
                        "description": "Interpolation parameters (e.g., { count: 5 })",
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "number"
                            },
                            {
                              "type": "boolean"
                            }
                          ]
                        }
                      }
                    },
                    "required": [
                      "key"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "ariaDescribedBy": {
                "description": "ID of element providing additional description (WAI-ARIA aria-describedby)",
                "type": "string"
              },
              "role": {
                "description": "WAI-ARIA role attribute (e.g., \"dialog\", \"navigation\", \"alert\")",
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "type",
          "properties"
        ],
        "additionalProperties": false
      },
      "description": "Components in this region"
    }
  },
  "required": [
    "name",
    "components"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "allOf": [
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "$and": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            },
            "$or": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            },
            "$not": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "$id": "https://schema.objectstack.io/v3.0.11/ui/PageRegion.json",
  "x-spec-version": "3.0.11"
}