{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "directory": {
      "description": "Project root directory (defaults to current working directory)",
      "type": "string"
    },
    "outDir": {
      "description": "Output directory for the built artifact (defaults to ./dist)",
      "type": "string"
    },
    "format": {
      "default": "tgz",
      "description": "Archive format for the artifact",
      "type": "string",
      "enum": [
        "tgz",
        "zip"
      ]
    },
    "sign": {
      "default": false,
      "description": "Whether to digitally sign the artifact",
      "type": "boolean"
    },
    "privateKeyPath": {
      "description": "Path to RSA/ECDSA private key file for signing",
      "type": "string"
    },
    "signAlgorithm": {
      "description": "Signing algorithm to use",
      "type": "string",
      "enum": [
        "RSA-SHA256",
        "RSA-SHA384",
        "RSA-SHA512",
        "ECDSA-SHA256"
      ]
    },
    "checksumAlgorithm": {
      "default": "sha256",
      "description": "Hash algorithm for file checksums",
      "type": "string",
      "enum": [
        "sha256",
        "sha384",
        "sha512"
      ]
    },
    "includeData": {
      "default": true,
      "description": "Whether to include seed data in the artifact",
      "type": "boolean"
    },
    "includeLocales": {
      "default": true,
      "description": "Whether to include locale/translation files",
      "type": "boolean"
    }
  },
  "required": [
    "format",
    "sign",
    "checksumAlgorithm",
    "includeData",
    "includeLocales"
  ],
  "additionalProperties": false,
  "description": "Options for the os plugin build command",
  "$id": "https://schema.objectstack.io/v3.0.11/kernel/PluginBuildOptions.json",
  "x-spec-version": "3.0.11"
}