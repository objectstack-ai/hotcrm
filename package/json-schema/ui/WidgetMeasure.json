{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "valueField": {
      "type": "string",
      "description": "Field to aggregate"
    },
    "aggregate": {
      "default": "count",
      "description": "Aggregate function",
      "type": "string",
      "enum": [
        "count",
        "sum",
        "avg",
        "min",
        "max"
      ]
    },
    "label": {
      "description": "Measure display label",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Translation key (e.g., \"views.task_list.label\")"
            },
            "defaultValue": {
              "description": "Fallback value when translation key is not found",
              "type": "string"
            },
            "params": {
              "description": "Interpolation parameters (e.g., { count: 5 })",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        }
      ]
    },
    "format": {
      "description": "Number format string",
      "type": "string"
    }
  },
  "required": [
    "valueField",
    "aggregate"
  ],
  "additionalProperties": false,
  "description": "Widget measure definition",
  "$id": "https://schema.objectstack.io/v3.0.11/ui/WidgetMeasure.json",
  "x-spec-version": "3.0.11"
}