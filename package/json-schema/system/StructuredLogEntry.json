{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "description": "ISO 8601 timestamp"
    },
    "level": {
      "type": "string",
      "enum": [
        "trace",
        "debug",
        "info",
        "warn",
        "error",
        "fatal"
      ],
      "description": "Log severity level"
    },
    "message": {
      "type": "string",
      "description": "Log message"
    },
    "context": {
      "description": "Structured context",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "error": {
      "description": "Error details",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "stack": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "additionalProperties": false
    },
    "trace": {
      "description": "Distributed tracing context",
      "type": "object",
      "properties": {
        "traceId": {
          "type": "string",
          "description": "Trace ID"
        },
        "spanId": {
          "type": "string",
          "description": "Span ID"
        },
        "parentSpanId": {
          "description": "Parent span ID",
          "type": "string"
        },
        "traceFlags": {
          "description": "Trace flags",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "traceId",
        "spanId"
      ],
      "additionalProperties": false
    },
    "source": {
      "description": "Source information",
      "type": "object",
      "properties": {
        "service": {
          "description": "Service name",
          "type": "string"
        },
        "component": {
          "description": "Component name",
          "type": "string"
        },
        "file": {
          "description": "Source file",
          "type": "string"
        },
        "line": {
          "description": "Line number",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "function": {
          "description": "Function name",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "host": {
      "description": "Host information",
      "type": "object",
      "properties": {
        "hostname": {
          "type": "string"
        },
        "pid": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "ip": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "description": "Environment (e.g., production, staging)",
      "type": "string"
    },
    "user": {
      "description": "User context",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "request": {
      "description": "Request context",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "userAgent": {
          "type": "string"
        },
        "ip": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "labels": {
      "description": "Custom labels",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "metadata": {
      "description": "Additional metadata",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "timestamp",
    "level",
    "message"
  ],
  "additionalProperties": false,
  "description": "Structured log entry",
  "$id": "https://schema.objectstack.io/v3.0.11/system/StructuredLogEntry.json",
  "x-spec-version": "3.0.11"
}